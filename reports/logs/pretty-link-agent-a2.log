   713	  public function save_bulk_edit() {
   714	    if( ! check_ajax_referer( 'prli_admin_link_list_nonce', false, false ) || ! PrliUtils::is_authorized() ) {
   715	      wp_send_json_error( esc_html__('Security check failed.', 'pretty-link'), 403 );
   716	    }
   717	
   718	    global $prli_link;
   719	
   720	    $post_ids = (isset($_POST['post_ids']) && !empty($_POST['post_ids'])) ? $_POST['post_ids'] : array();
   721	
   722	    if(!empty($post_ids) && is_array($post_ids)) {
   723	      foreach($post_ids as $post_id) {
   724	        $post_type = get_post_type($post_id);
   725	
   726	        if($post_type != PrliLink::$cpt) { return; }
   727	
   728	        $tracking = ($_POST['tracking'] == 'no-change') ? '' : ( ($_POST['tracking'] == 'on') ? true : false );
   729	        $nofollow = ($_POST['nofollow'] == 'no-change') ? '' : ( ($_POST['nofollow'] == 'on') ? true : false );
   730	        $sponsored = ($_POST['sponsored'] == 'no-change') ? '' : ( ($_POST['sponsored'] == 'on') ? true : false );
   731	
   732	        if($tracking === '' && $nofollow === '' && $sponsored === '') { return; } // Nothing to change
   733	
   734	        $id = $prli_link->get_link_from_cpt($post_id);
   735	        $link = $prli_link->getOne($id);
   736	
   737	        prli_update_pretty_link(
   738	          $link->id,
   739	          $link->url,
   740	          $link->slug,
   741	          $link->name,
   742	          $link->description,
   743	          null,// group_id deprecated
   744	          $tracking,
   745	          $nofollow,
   746	          $sponsored,
   747	          $link->redirect_type,
   748	          $link->param_forwarding,
   749	          '' // param_struct deprecated
   750	        );
   751	      }
   752	    }
   753	  }
