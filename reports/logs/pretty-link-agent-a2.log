   681	  public function save_quick_edit($post_id, $post) {
   682	    global $prli_link;
   683	
   684	    if(defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) { return $post_id; }
   685	    if(isset($post->post_type) && $post->post_type == 'revision') { return $post_id; }
   686	    if(!isset($_POST['action']) || $_POST['action'] != 'inline-save') { return $post_id; } // This action is set when doing Quick Edit save
   687	
   688	    if($post->post_type == PrliLink::$cpt) {
   689	      $id = $prli_link->get_link_from_cpt($post->ID);
   690	      $link = $prli_link->getOne($id);
   691	
   692	      $tracking = ($_POST['prli_quick_edit_tracking'] == 'no-change') ? '' : ( ($_POST['prli_quick_edit_tracking'] == 'on') ? true : false );
   693	      $nofollow = ($_POST['prli_quick_edit_nofollow'] == 'no-change') ? '' : ( ($_POST['prli_quick_edit_nofollow'] == 'on') ? true : false );
   694	      $sponsored = ($_POST['prli_quick_edit_sponsored'] == 'no-change') ? '' : ( ($_POST['prli_quick_edit_sponsored'] == 'on') ? true : false );
   695	
   696	      prli_update_pretty_link(
   697	        $link->id,
   698	        $link->url,
   699	        $link->slug,
   700	        sanitize_text_field(stripslashes($_POST['post_title'])),
   701	        $link->description,
   702	        null,// group_id deprecated
   703	        $tracking,
   704	        $nofollow,
   705	        $sponsored,
   706	        $link->redirect_type,
   707	        $link->param_forwarding,
   708	        '' // param_struct deprecated
   709	      );
   710	    }
   711	  }
