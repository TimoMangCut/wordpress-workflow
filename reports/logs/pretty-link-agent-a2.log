   824	  public static function install_addons() {
   825	    global $plp_update;
   826	
   827	    $data = self::get_request_data('prli_onboarding_install_addons');
   828	
   829	    if(empty($data['addon_slug'])) {
   830	      wp_send_json_error(__('Bad request.', 'pretty-link'));
   831	    }
   832	
   833	    if(!current_user_can('publish_posts')) {
   834	      wp_send_json_error(__('Sorry, you don\'t have permission to do this.', 'pretty-link'));
   835	    }
   836	
   837	    $features_data = PrliOnboardingHelper::get_selected_features_data();
   838	    if(!isset($features_data['addons_installed'])){
   839	      $features_data['addons_installed'] = array();
   840	    }
   841	
   842	    if(!isset($features_data['addons_upgrade_failed'])){
   843	      $features_data['addons_upgrade_failed'] = array();
   844	    }
   845	
   846	    if(!empty($features_data['addons_not_installed'])) {
   847	      if(in_array($data['addon_slug'], $features_data['addons_not_installed'], true)) {
   848	        $license_addons = $plp_update->addons(true, true, true);
   849	
   850	        // lets try to install and activate add-on.
   851	        foreach ($features_data['addons_not_installed'] as $i => $addon_slug) {
   852	          if($addon_slug == $data['addon_slug']) {
   853	            $response = self::maybe_install_activate_addons($license_addons, $addon_slug);
   854	            $next_addon = isset($features_data['addons_not_installed'][$i + 1]) ? $features_data['addons_not_installed'][$i + 1] : '';
   855	
   856	            if(1 === (int) $response) {
   857	              $features_data['addons_installed'][] = $addon_slug;
   858	              $features_data['addons_installed'] = array_unique($features_data['addons_installed']);
   859	
   860	              PrliOnboardingHelper::set_selected_features($features_data);
   861	              wp_send_json_success(array('addon_slug' => $addon_slug, 'message' => '', 'status' => 1, 'next_addon' => $next_addon));
   862	            }
   863	            else {
   864	              $features_data['addons_upgrade_failed'][] = $addon_slug;
   865	              $features_data['addons_upgrade_failed'] = array_unique($features_data['addons_upgrade_failed']);
   866	
   867	              PrliOnboardingHelper::set_selected_features($features_data);
   868	              wp_send_json_success(array('addon_slug' => $addon_slug, 'message' => esc_html__('Unable to install. Please download and install manually.', 'pretty-link'), 'status' => 0, 'next_addon' => $next_addon));
   869	            }
   870	          }
   871	        }
   872	      }
   873	    }
   874	  }
