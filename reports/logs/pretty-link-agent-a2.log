   807	  private static function install_plugin_silently($url, $args) {
   808	    require_once ABSPATH . 'wp-admin/includes/class-wp-upgrader.php';
   809	
   810	    if(!function_exists('request_filesystem_credentials')) {
   811	      require_once ABSPATH . 'wp-admin/includes/file.php';
   812	    }
   813	
   814	    $skin = new Automatic_Upgrader_Skin();
   815	    $upgrader = new Plugin_Upgrader($skin);
   816	
   817	    if(!$skin->request_filesystem_credentials(false, WP_PLUGIN_DIR)) {
   818	      return new WP_Error('no_filesystem_access', __('Failed to get filesystem access', 'pretty-link'));
   819	    }
   820	
   821	    return $upgrader->install($url, $args);
   822	  }
