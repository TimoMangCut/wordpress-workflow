    95	    public static function checkAddonsUpdateTransient(): bool
    96	    {
    97	        $updateCheck = get_transient(self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->pluginId . '-mosh-addons-update-check');
