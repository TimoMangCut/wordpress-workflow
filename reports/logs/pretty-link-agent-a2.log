   755	  /**
   756	  * Append row actions to list page
   757	  * @see add_filter('post_row_actions')
   758	  * @param array $actions Current row actions
   759	  * @param WP_Post current Post
   760	  * @return array filtered row actions
   761	  */
   762	  public function add_row_actions($actions, $post) {
   763	    global $prli_link;
   764	
   765	    if($post->post_type === PrliLink::$cpt) {
   766	      $id = $prli_link->get_link_from_cpt($post->ID);
   767	      $link = $prli_link->getOne($id);
   768	
   769	      if(empty($link)) { return $actions; }
   770	
   771	      $new_actions = array();
   772	      $new_actions['edit']  = $actions['edit'];
   773	      $new_actions['trash'] = $actions['trash'];
   774	      $new_actions['inline hide-if-no-js'] = $actions['inline hide-if-no-js'];
   775	      $new_actions['reset'] = PrliLinksHelper::link_action_reset($link, __('Reset', 'pretty-link'));
   776	
   777	      if( $link->redirect_type !== 'pixel' ) {
   778	        $new_actions['tweet'] = PrliLinksHelper::link_action_tweet($link, __('Tweet', 'pretty-link'));
   779	        $new_actions['email'] = PrliLinksHelper::link_action_email($link, __('Email', 'pretty-link'));
   780	
   781	        if($link->redirect_type !== 'prettypay_link_stripe') {
   782	          $new_actions['url'] = PrliLinksHelper::link_action_visit_target($link, __('Target &raquo;', 'pretty-link'));
   783	        }
   784	
   785	        $new_actions['pl'] = PrliLinksHelper::link_action_visit_pretty_link($link, $link->prettypay_link ? __('PrettyPay™ Link &raquo;', 'pretty-link') : __('Pretty Link &raquo;', 'pretty-link'));
   786	      }
   787	
   788	      $plp_update = new PrliUpdateController();
   789	
   790	      if($plp_update->is_installed()) {
   791	        global $plp_options, $prli_link_meta;
   792	
   793	        $plp_links_ctrl = new PlpLinksController();
   794	
   795	        if ($plp_options->generate_qr_codes) {
   796	          $new_actions['qr'] = $plp_links_ctrl->qr_code_link($link->id);
   797	        }
   798	
   799	        $dynamic_redirection = $prli_link_meta->get_link_meta($link->id, 'prli_dynamic_redirection', true);
   800	
   801	        if ($dynamic_redirection == 'rotate') {
   802	          $enable_split_test = $prli_link_meta->get_link_meta($link->id, 'prli-enable-split-test', true);
   803	
   804	          if ($enable_split_test) {
   805	            $new_actions['report'] = sprintf(
   806	              '<a href="%s" title="%s">%s</a>',
   807	              esc_url(admin_url('admin.php?page=plp-reports&action=display-split-test-report&id=') . $link->id),
   808	              esc_attr__('View Split Test Report', 'pretty-link'),
   809	              esc_html__('View Split Test Report', 'pretty-link')
   810	            );
   811	          }
   812	        }
   813	
   814	        if($plp_options->enable_link_health && !in_array($link->redirect_type, array('pixel', 'prettypay_link_stripe'), true)) {
   815	          $new_actions['link_health'] = $plp_links_ctrl->health_status_link($link->id);
   816	        }
   817	      }
   818	
   819	      $actions = $new_actions;
   820	    }
   821	
   822	    return $actions;
   823	  }
