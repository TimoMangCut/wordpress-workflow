   861	  public function ajax_quick_create() {
   862	    if (!PrliUtils::is_post_request() || !isset($_POST['url'], $_POST['slug']) || !is_string($_POST['url']) || !is_string($_POST['slug'])) {
   863	      wp_send_json_error(array('message' => __('Bad request', 'pretty-link')));
   864	    }
   865	
   866	    if (!PrliUtils::is_authorized()) {
   867	      wp_send_json_error(array('message' => __('Insufficient permissions', 'pretty-link')));
   868	    }
   869	
   870	    if (!check_ajax_referer('prli_quick_create', false, false)) {
   871	      wp_send_json_error(array('message' => __('Security check failed', 'pretty-link')));
   872	    }
   873	
   874	    global $prli_link, $prli_options;
   875	
   876	    $errors = $prli_link->validate($_POST);
   877	
   878	    if (count($errors)) {
   879	      wp_send_json_error(array('message' => $errors[0]));
   880	    }
   881	
   882	    $_POST['redirect_type'] = $prli_options->link_redirect_type;
   883	
   884	    if ($prli_options->link_track_me) {
   885	      $_POST['track_me'] = 'on';
   886	    }
   887	
   888	    if ($prli_options->link_nofollow) {
   889	      $_POST['nofollow'] = 'on';
   890	    }
   891	
   892	    if ($prli_options->link_sponsored) {
   893	      $_POST['sponsored'] = 'on';
   894	    }
   895	
   896	    $link_id = $prli_link->create($_POST);
   897	    $link = $prli_link->getOne($link_id);
   898	
   899	    if (!$link) {
   900	      wp_send_json_error(array('message' => __('An error occurred creating the link', 'pretty-link')));
   901	    }
   902	
   903	    $location = add_query_arg(array(
   904	      'post_type' => PrliLink::$cpt,
   905	      'message' => 6
   906	    ), admin_url('edit.php'));
   907	
   908	    wp_send_json_success([
   909	      'redirect' => esc_url_raw($location)
   910	    ]);
   911	  }
