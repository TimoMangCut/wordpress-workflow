   104	    /**
   105	     * Returns the modified transient with add-ons updates.
   106	     *
   107	     * @param  array  $products  The products to check.
   108	     * @param  object $transient The transient to update.
   109	     * @return object The modified transient.
   110	     */
   111	    public static function getTransientWithAddonsUpdates(array $products, object $transient)
   112	    {
   113	        foreach ($products ?? [] as $product) {
   114	            if (! isset($transient->checked[$product->main_file])) {
   115	                continue;
   116	            }
   117	
   118	            $versionLatest = $product->_embedded->{'version-latest'}->number ?? '';
   119	            $urlLatest     = $product->_embedded->{'version-latest'}->url ?? '';
   120	
   121	            $item = (object) [
   122	                'id'          => $product->main_file,
   123	                'slug'        => $product->slug,
   124	                'plugin'      => $product->main_file,
   125	                'new_version' => $versionLatest,
   126	                'package'     => $urlLatest,
   127	                'icons'       => [
   128	                    'png' => $product->image,
   129	                ],
   130	            ];
   131	            if (
   132	                version_compare(
   133	                    $transient->checked[$product->main_file],
   134	                    $versionLatest,
   135	                    '>='
   136	                )
   137	            ) {
   138	                $transient->no_update[$product->main_file] = $item;
   139	            } else {
   140	                $transient->response[$product->main_file] = $item;
   141	            }
   142	        }
   143	        return $transient;
   144	    }
