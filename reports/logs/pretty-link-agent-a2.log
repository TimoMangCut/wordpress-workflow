    34	    /**
    35	     * Update the plugins transient with the available add-ons.
    36	     *
    37	     * @param  object $transient The plugins transient.
    38	     * @return object The plugins transient.
    39	     */
    40	    public static function addonsUpdatePlugins($transient)
    41	    {
    42	        // If the license key is not set, return the transient.
    43	        if (! self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->getLicenseKey()) {
    44	            return $transient;
    45	        }
    46	
    47	        // If the license is not active, return the transient.
    48	        if (! self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->getLicenseActivationStatus()) {
    49	            return $transient;
    50	        }
    51	
    52	        $transientCheck = self::checkAddonsUpdateTransient();
    53	        if ($transientCheck !== false) {
    54	            $productsTransient = get_transient(self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->pluginId . '-mosh-products');
    55	            return ($productsTransient->products ?? false) ? self::getTransientWithAddonsUpdates($productsTransient->products, $transient) : $transient;
    56	        }
    57	
    58	        if (! is_object($transient)) {
    59	            return $transient;
    60	        }
    61	
    62	        if (! isset($transient->response) || ! is_array($transient->response)) {
    63	            $transient->response = [];
    64	        }
    65	
    66	        $products = self::getAddons(false);
    67	
    68	        if ($products instanceof Response && $products->isError()) {
    69	            // Set transient to expire in 30 minutes so we don't keep checking..
    70	            set_transient(self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->pluginId . '-mosh-addons-update-check', null, 30 * MINUTE_IN_SECONDS);
    71	            return $transient;
    72	        }
    73	
    74	        if (! is_array($products->products ?? null)) {
    75	            return $transient;
    76	        }
    77	
    78	        $transient = self::getTransientWithAddonsUpdates($products->products, $transient);
    79	
    80	        // Create a transient that expires every 30 minutes. We only want this to run once every 30 minutes.
    81	        set_transient(
    82	            self::getContainer()->get(MothershipService::CONNECTION_PLUGIN_SERVICE_ID)->pluginId . '-mosh-addons-update-check',
    83	            null,
    84	            30 * MINUTE_IN_SECONDS
    85	        );
    86	
    87	        return $transient;
    88	    }
