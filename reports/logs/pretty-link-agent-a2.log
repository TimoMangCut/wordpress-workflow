   122	  public function ajax_addon_install() {
   123	    if(!isset($_POST['plugin'])) {
   124	      wp_send_json_error(__('Bad request.', 'pretty-link'));
   125	    }
   126	
   127	    if(!current_user_can('install_plugins') || !current_user_can('activate_plugins')) {
   128	      wp_send_json_error(__('Sorry, you don\'t have permission to do this.', 'pretty-link'));
   129	    }
   130	
   131	    if(!check_ajax_referer('prli_addons', false, false)) {
   132	      wp_send_json_error(__('Security check failed.', 'pretty-link'));
   133	    }
   134	
   135	    $type = isset($_POST['type']) ? sanitize_key($_POST['type']) : 'add-on';
   136	
   137	    if($type == 'plugin') {
   138	      $error = esc_html__('Could not install plugin.', 'pretty-link');
   139	    } else {
   140	      $error = esc_html__('Could not install add-on.', 'pretty-link');
   141	    }
   142	
   143	    // Set the current screen to avoid undefined notices
   144	    set_current_screen('pretty-link_page_pretty-link-addons');
   145	
   146	    // Prepare variables
   147	    $url = esc_url_raw(
   148	      add_query_arg(
   149	        array(
   150	          'page' => 'pretty-link-addons',
   151	        ),
   152	        admin_url('admin.php')
   153	      )
   154	    );
   155	
   156	    $creds = request_filesystem_credentials($url, '', false, false, null);
   157	
   158	    // Check for file system permissions
   159	    if(false === $creds) {
   160	      wp_send_json_error($error);
   161	    }
   162	
   163	    if(!WP_Filesystem($creds)) {
   164	      wp_send_json_error($error);
   165	    }
   166	
   167	    // We do not need any extra credentials if we have gotten this far, so let's install the plugin
   168	    require_once ABSPATH . 'wp-admin/includes/class-wp-upgrader.php';
   169	
   170	    // Do not allow WordPress to search/download translations, as this will break JS output
   171	    remove_action('upgrader_process_complete', array('Language_Pack_Upgrader', 'async_upgrade'), 20);
   172	
   173	    // Create the plugin upgrader with our custom skin
   174	    $installer = new Plugin_Upgrader(new PrliAddonInstallSkin());
   175	
   176	    $plugin = wp_unslash($_POST['plugin']);
   177	    $installer->install($plugin);
   178	
   179	    // Flush the cache and return the newly installed plugin basename
   180	    wp_cache_flush();
   181	
   182	    if($installer->plugin_info()) {
   183	      $plugin_basename = $installer->plugin_info();
   184	
   185	      // Activate the plugin silently
   186	      $activated = activate_plugin($plugin_basename);
   187	
   188	      if(!is_wp_error($activated)) {
   189	        wp_send_json_success(
   190	          array(
