   491	/**
   492	 * Pre-process SVG files uploaded via REST API
   493	 *
   494	 * @param array $file File data before processing
   495	 * @param array $request The full request payload
   496	 * @return array|WP_Error Modified file data or error
   497	 */
   498	function bodhi_svgs_rest_pre_upload($file, $request) {
   499	    if ($file['type'] === 'image/svg+xml') {
   500	        // Randomize filename for REST API uploads
   501	        $ext = pathinfo($file['name'], PATHINFO_EXTENSION);
   502	        $random_name = wp_generate_password(12, false) . '.' . $ext;
   503	        $file['name'] = sanitize_file_name($random_name);
   504	
   505	        // Force sanitization
   506	        if (!bodhi_svgs_sanitize($file['tmp_name'])) {
   507	            return new WP_Error(
   508	                'svg_sanitization_failed',
   509	                __('SVG sanitization failed for security reasons.', 'svg-support'),
   510	                array('status' => 400)
   511	            );
   512	        }
   513	    }
   514	    return $file;
   515	}
