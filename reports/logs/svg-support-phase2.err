        "plugins/kubio/lib/AI/SDApi/sd-endpoints.php:8-65",
        "plugins/kubio/lib/api/update-settings-flags.php:69-132",
        "plugins/kubio/lib/api/entity.php:16-24",
        "plugins/kubio/lib/integrations/third-party-themes/templates-importer.php:355-379"
      ],
      "reasoning": "The reviewed AI, settings, entity-save, and third-party theme import routes consistently enforce current_user_can('edit_theme_options') in permission_callback, so the IR 'unknown auth' labeling overstated their exposure."
    }
  ],
