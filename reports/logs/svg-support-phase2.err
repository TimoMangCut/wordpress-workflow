   437			if ( $ext == 'svg' ) {
   438	
   439				// return empty array
   440				$sources = array();
   441	
   442				return $sources;
   443	
   444			} else {
   445	
   446				return $sources;
   447	
   448			}
   449	
   450		} else {
   451	
   452			return $sources;
   453	
   454		}
   455	
   456	}
