   527	function bodhi_svgs_rest_insert_attachment($prepared_attachment, $request) {
   528	    if ($request->get_header('content-type') !== 'image/svg+xml') {
   529	        return $prepared_attachment;
   530	    }
   531	    
   532	    global $bodhi_svgs_options;
   533	    $user = wp_get_current_user();
   534	    $current_user_roles = (array) $user->roles;
   535	    $sanitize_on_upload_roles_array = (array) $bodhi_svgs_options['sanitize_on_upload_roles'];
   536	    
   537	    $should_sanitize = empty(array_intersect($sanitize_on_upload_roles_array, $current_user_roles));
   538	    
   539	    if ($should_sanitize) {
   540	        $file_path = get_attached_file($prepared_attachment->ID);
   541	        if (!$file_path) {
   542	            global $bodhi_last_upload_info;
   543	            if (isset($bodhi_last_upload_info['file'])) {
   544	                $file_path = $bodhi_last_upload_info['file'];
   545	            }
   546	        }
   547	        
   548	        if ($file_path && file_exists($file_path)) {
   549	            global $sanitizer;
   550	            $file_content = file_get_contents($file_path);
   551	            
   552	            if ($file_content !== false) {
   553	                $clean_svg = $sanitizer->sanitize($file_content);
   554	                if ($clean_svg !== false) {
   555	                    file_put_contents($file_path, $clean_svg);
   556	                }
   557	            }
   558	        }
   559	    }
   560	    
   561	    return $prepared_attachment;
   562	}
