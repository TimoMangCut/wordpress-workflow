     6	function bodhi_svgs_cleanup_duplicate_meta() {
     7	    global $wpdb;
     8	    
     9	    // Delete all but the latest inline_featured_image meta per post
    10	    $wpdb->query("
    11	        DELETE pm FROM {$wpdb->postmeta} pm
    12	        JOIN (
    13	            SELECT post_id, meta_id FROM (
    14	                SELECT post_id, meta_id,
    15	                        ROW_NUMBER() OVER (PARTITION BY post_id ORDER BY meta_id DESC) AS row_num
    16	                FROM {$wpdb->postmeta}
    17	                WHERE meta_key = 'inline_featured_image'
    18	            ) as duplicates
    19	            WHERE row_num > 1
    20	        ) to_delete ON pm.meta_id = to_delete.meta_id
    21	    ");
    22	
    23	    // Delete all inline_featured_image meta entries that aren't explicitly set to 1
    24	    $wpdb->query("
    25	        DELETE FROM {$wpdb->postmeta} 
    26	        WHERE meta_key = 'inline_featured_image' 
    27	        AND (meta_value = '' OR meta_value = '0' OR meta_value IS NULL)
    28	    ");
    29	} 
