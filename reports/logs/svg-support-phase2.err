    14	function bodhi_svgs_wpallimport_handle_svg( $attachment_id ) {
    15		// Get the file path of the uploaded attachment.
    16		$file_path = get_attached_file( $attachment_id );
    17		$file_mime = get_post_mime_type( $attachment_id );
    18	
    19		// Check if the file is an SVG.
    20		if ( $file_mime === 'image/svg+xml' ) {
    21			// Sanitize the SVG file.
    22			if ( ! bodhi_svgs_sanitize_svg_on_import( $file_path ) ) {
    23				// Log the error without deleting the attachment.
    24				// error_log( sprintf( 'SVG Sanitization failed for attachment ID %d during WP All Import.', $attachment_id ) );
    25			}
    26	
    27			// Generate attachment metadata for the SVG.
    28			$metadata = wp_generate_attachment_metadata( $attachment_id, $file_path );
    29			if ( ! empty( $metadata ) ) {
    30				if ( ! wp_update_attachment_metadata( $attachment_id, $metadata ) ) {
    31					// error_log( sprintf( 'Failed to update metadata for SVG attachment ID %d during WP All Import.', $attachment_id ) );
    32				}
    33			} else {
    34				// error_log( sprintf( 'Failed to generate metadata for SVG attachment ID %d during WP All Import.', $attachment_id ) );
    35			}
    36		}
    37	}
    38	
    39	/**
    40	 * This function handles sanitization and any other processing needed for SVG files.
    41	 *
    42	 * @param string $file_path The file path of the SVG to be processed.
    43	 * @return bool True if sanitization was successful, false otherwise.
    44	 */
    45	function bodhi_svgs_sanitize_svg_on_import( $file_path ) {
    46		// Check if the SVG file exists and is valid.
    47		if ( file_exists( $file_path ) && is_readable( $file_path ) ) {
    48			// Use the existing sanitize function.
    49			if ( bodhi_svgs_sanitize( $file_path ) ) {
    50				// Recalculate dimensions and regenerate metadata.
    51				$dimensions = bodhi_svgs_get_dimensions( $file_path );
    52				$metadata = array(
    53					'width'  => intval( $dimensions->width ),
    54					'height' => intval( $dimensions->height ),
    55					'file'   => basename( $file_path ),
    56				);
    57				return true;
    58			} else {
    59				// error_log( sprintf( 'Sanitization failed for SVG file at path %s.', $file_path ) );
    60				return false;
    61			}
    62		}
    63	
    64		// error_log( sprintf( 'SVG file at path %s is either missing or not readable.', $file_path ) );
    65		return false;
    66	}
