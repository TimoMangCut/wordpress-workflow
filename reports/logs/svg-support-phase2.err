   459	/**
   460	 * Fix for division by zero error for SVGs. (Proposed by @starsis)
   461	 *
   462	 * This function ensures that SVGs do not cause division by zero errors by providing default
   463	 * dimensions if they are missing.
   464	 *
   465	 * @param array  $image         The image data.
   466	 * @param int    $attachment_id The attachment ID.
   467	 * @param string $size          The requested image size.
   468	 * @param bool   $icon          Whether the image is an icon.
   469	 *
   470	 * @return array The modified image data.
   471	 */
   472	function bodhi_svgs_dimension_fallback( $image, $attachment_id, $size, $icon ) {
   473	
   474		// only manipulate for svgs
   475		if ( get_post_mime_type($attachment_id) == 'image/svg+xml' ) {
   476	
   477			if ( isset($image[1]) && $image[1] === 0 ) {
   478				$image[1] = 1;
   479			}
   480			if ( isset($image[2]) && $image[2] === 0 ) {
   481				$image[2] = 1;
   482			}
   483	
   484		}
   485	
   486		return $image;
   487	
   488	}
