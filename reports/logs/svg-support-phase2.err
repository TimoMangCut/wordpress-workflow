   315		// First quick check - if it's clearly not an SVG, return early
   316		if (!empty($file_name) && strtolower(pathinfo($file_name, PATHINFO_EXTENSION)) !== 'svg') {
   317			return $file;
   318		}
   319	
   320		// Multiple validation checks for SVG
   321		if ( $file_path && file_exists( $file_path ) ) {
   322			// 1. Check MIME type using fileinfo
   323			$finfo = finfo_open( FILEINFO_MIME_TYPE );
   324			$real_mime = finfo_file( $finfo, $file_path );
   325			finfo_close( $finfo );
   326	
   327			// 2. Read first bytes of the file to check for SVG header
   328			$file_content = file_get_contents( $file_path );
   329			
   330			// Check for XML declaration and SVG tag
   331			$pattern1 = '/^[\s\n]*(?:<\?xml[^>]*>[\s\n]*)?(?:<!--.*?-->[\s\n]*)*(?:<!DOCTYPE[^>]*>[\s\n]*)?(?:<!--.*?-->[\s\n]*)*<svg[^>]*>/is';
   332			$pattern2 = '/^[\s\n]*(?:<!--.*?-->[\s\n]*)*<svg[^>]*>/is';
   333	
   334			$match1 = preg_match( $pattern1, $file_content );
   335			$match2 = preg_match( $pattern2, $file_content );
   336			$has_closing = strpos( $file_content, '</svg>' ) !== false;
   337	
   338			$is_svg_content = ( $match1 || $match2 ) && $has_closing;
   339	
   340			// If content validation fails OR (mime type isn't SVG AND isn't a plain text file containing SVG)
   341			if ( !$is_svg_content || 
   342				( $real_mime !== 'image/svg+xml' && 
   343				  $real_mime !== 'image/svg' && 
   344				  !( $real_mime === 'text/plain' && $is_svg_content ) ) ) {
   345				$file['error'] = __( 'File is not a valid SVG.', 'svg-support' );
   346				return $file;
   347			}
   348		}
   349	
   350		// Now we know it's an SVG, continue with security checks
   351		if (!defined('REST_REQUEST') && !wp_verify_nonce(
   352			sanitize_text_field(wp_unslash($_REQUEST['_wpnonce'] ?? '')), 
   353			'media-form'
   354		)) {
   355			$file['error'] = __('Security check failed.', 'svg-support');
   356			return $file;
   357		}
   358	
   359		// Get the roles that do not require SVG sanitization
   360		$sanitize_on_upload_roles_array = (array) $bodhi_svgs_options['sanitize_on_upload_roles'];
   361		$user = wp_get_current_user();
   362		$current_user_roles = (array) $user->roles;
   363	
   364		// Check if the current user's roles intersect with the roles that do not need sanitization
   365		$no_sanitize_needed = array_intersect($sanitize_on_upload_roles_array, $current_user_roles);
   366	
   367		// Check if the user has the capability to upload SVGs
   368		$can_upload_files = current_user_can('upload_files');
   369	
   370		// Force sanitize unless user is in roles that bypass sanitization
   371		if ($can_upload_files && empty($no_sanitize_needed)) {
   372			global $sanitizer;
   373			
   374			// Read file contents
   375			$file_content = file_get_contents($file_path);
   376			if ($file_content === false) {
   377				$file['error'] = __("Unable to read SVG file for sanitization.", 'svg-support');
   378				return $file;
   379			}
   380	
   381			// Sanitize the content
   382			$clean_svg = $sanitizer->sanitize($file_content);
   383			
   384			if ($clean_svg === false) {
   385				$file['error'] = __("Sorry, this file couldn't be sanitized for security reasons and wasn't uploaded.", 'svg-support');
   386				return $file;
   387			}
   388	
   389			// Write sanitized content back
   390			$write_result = file_put_contents($file_path, $clean_svg);
   391			if ($write_result === false) {
   392				$file['error'] = __("Unable to save sanitized SVG file.", 'svg-support');
   393				return $file;
   394			}
   395		}
   396	
   397		return $file;
   398	}
