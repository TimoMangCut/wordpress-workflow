   430	function bodhi_svgs_disable_srcset( $sources ) {
   431	
   432		$first_element = reset($sources);
   433		if ( isset($first_element) && !empty($first_element['url']) ) {
   434	
   435			$ext = pathinfo(reset($sources)['url'], PATHINFO_EXTENSION);
