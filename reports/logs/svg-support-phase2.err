   200	/**
   201	 * Sanitize SVG files.
   202	 *
   203	 * This function sanitizes SVG files by removing potentially harmful elements and attributes.
   204	 * It also optionally minifies the SVG content and re-encodes it if it was originally gzipped.
   205	 *
   206	 * @param string $file The file path of the SVG to sanitize.
   207	 *
   208	 * @return bool True if the file was successfully sanitized, false otherwise.
   209	 */
   210	function bodhi_svgs_sanitize( $file ){
   211	
   212		global $sanitizer;
   213	
   214		$sanitizer->setAllowedTags( new bodhi_svg_tags() );
   215		$sanitizer->setAllowedAttrs( new bodhi_svg_attributes() );
   216	
   217		$dirty = '';
   218	
   219		// Using WP_Filesystem to read the SVG file content
   220		if ( ! function_exists( 'WP_Filesystem' ) ) {
   221			require_once ABSPATH . 'wp-admin/includes/file.php';
   222		}
   223		global $wp_filesystem;
   224		WP_Filesystem();
   225		$dirty = $wp_filesystem->get_contents( $file );
   226	
   227		// Try to decode if gzipped is enabled
   228		if ( $is_zipped = bodhi_svgs_is_gzipped( $dirty ) ) {
   229	
   230			$dirty = gzdecode( $dirty );
   231	
   232			// Return on failure, since we can't read file
   233			if ( $dirty === false ) {
   234				return false;
   235			}
   236	
   237		}
   238	
   239		// Remove remote references since they are dangerous and lead to injection
   240		$sanitizer->removeRemoteReferences(true);
   241	
   242		// Enable minify in library if its enabled in admin panel
   243		bodhi_svgs_minify();
   244	
   245		$clean = $sanitizer->sanitize( $dirty );
   246	
   247		if ( $clean === false ) {
   248			return false;
   249		}
   250	
   251		// If the file was gzipped, we need to re-zip it
   252		if ( $is_zipped ) {
   253			$clean = gzencode( $clean );
   254		}
   255	
   256		// Use WP_Filesystem to write the sanitized content back
   257		if ( ! $wp_filesystem->put_contents( $file, $clean, FS_CHMOD_FILE ) ) {
   258			return false;
   259		}
