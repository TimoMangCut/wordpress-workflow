     6	 * Additionally provides a fix for WP 4.7.1 - 4.7.2 upload issues and for Avada theme.
     7	 */
     8	if ( ! defined( 'ABSPATH' ) ) {
     9		exit; // Exit if accessed directly
    10	}
    11	
    12	/**
    13	 * Add Mime Types
    14	 */
    15	function bodhi_svgs_upload_mimes( $mimes = array() ) {
    16	    global $bodhi_svgs_options;
    17	
    18	    // Ensure the option is set
    19	    if ( !isset($bodhi_svgs_options['restrict']) ) {
    20	        return $mimes;
    21	    }
    22	
    23	    // Get the allowed roles from settings
    24	    $allowed_roles_array = (array) $bodhi_svgs_options['restrict'];
    25	    
    26	    // Get the current user and their roles
    27	    $user = wp_get_current_user();
    28	    $current_user_roles = (array) $user->roles;
    29	
    30	    // For multisite, add network admin to allowed roles
    31	    if (is_multisite() && is_super_admin()) {
    32	        $current_user_roles[] = 'administrator';
    33	    }
    34	
    35	    // Check if the user has the capability or the role
    36	    $is_role_allowed = array_intersect($allowed_roles_array, $current_user_roles);
    37	    if ( empty($is_role_allowed) || !current_user_can('upload_files') ) {
    38	        return $mimes;
    39	    }
    40	
    41	    // Allow SVG file upload
    42	    $mimes['svg'] = 'image/svg+xml';
    43	    $mimes['svgz'] = 'image/svg+xml';
    44	
    45	    return $mimes;
    46	}
    47	add_filter( 'upload_mimes', 'bodhi_svgs_upload_mimes', 99 );
    48	
    49	/**
    50	 * Check Mime Types
    51	 */
    52	function bodhi_svgs_upload_check( $checked, $file, $filename, $mimes ) {
    53	
    54	    if ( ! $checked['type'] ) {
    55	
    56	        $check_filetype = wp_check_filetype( $filename, $mimes );
    57	        $ext = $check_filetype['ext'];
    58	        $type = $check_filetype['type'];
    59	        $proper_filename = $filename;
    60	
    61	        // Check if the file is an SVG or SVGZ
    62	        if ( ( $ext === 'svg' || $ext === 'svgz' ) && $type === 'image/svg+xml' ) {
    63	            $checked = compact( 'ext', 'type', 'proper_filename' );
    64	        }
    65	    }
    66	
    67	    return $checked;
    68	}
    69	add_filter( 'wp_check_filetype_and_ext', 'bodhi_svgs_upload_check', 10, 4 );
    70	
    71	
    72	/**
    73	 * Mime Check fix for WP 4.7.1 / 4.7.2
    74	 *
    75	 * Fixes uploads for these 2 versions of WordPress.
    76	 * Issue was fixed in 4.7.3 core.
    77	 */
    78	function bodhi_svgs_allow_svg_upload( $data, $file, $filename, $mimes ) {
    79	
    80		global $wp_version;
    81		// Corrected the version check condition
    82		if ( version_compare($wp_version, '4.7.1', '>=') && version_compare($wp_version, '4.7.3', '<') ) {
    83			$filetype = wp_check_filetype( $filename, $mimes );
    84	
    85			// Check if the file is an SVG or SVGZ
    86			if ( ( $filetype['ext'] === 'svg' || $filetype['ext'] === 'svgz' ) && $filetype['type'] === 'image/svg+xml' ) {
    87				return [
    88					'ext'             => $filetype['ext'],
    89					'type'            => $filetype['type'],
    90					'proper_filename' => $data['proper_filename']
    91				];
    92			}
    93		}
    94	
    95		return $data;
    96	}
    97	add_filter( 'wp_check_filetype_and_ext', 'bodhi_svgs_allow_svg_upload', 10, 4 );
    98	
    99	function bodhi_svgs_multisite_settings($mimes) {
   100	    // Check if this is a multisite installation
   101	    if (is_multisite()) {
   102	        // Get the site ID
   103	        $blog_id = get_current_blog_id();
   104	        
   105	        // Allow SVG on main site
   106	        if (is_main_site()) {
   107	            return $mimes;
   108	        }
   109	        
   110	        // For subsites, check if upload_files capability is allowed
   111	        if (get_site_option('upload_space_check_disabled')) {
   112	            return $mimes;
   113	        }
   114	    }
   115	    return $mimes;
   116	}
   117	add_filter('upload_mimes', 'bodhi_svgs_multisite_settings', 98);
