   348		/**
   349		 * Retrieve file size and type restrictions from field settings.
   350		 *
   351		 * @since 2.2.2
   352		 *
   353		 * @return array{max_size:int, extensions:string[]} Field-level upload restrictions.
   354		 */
   355		private function get_field_restrictions() {
   356	
   357			$max_size   = 5 * 1024 * 1024; // 5MB default
   358			$extensions = array();
   359	
   360			$field_key   = empty( $_POST['field_key'] ) ? '' : sanitize_text_field( wp_unslash( $_POST['field_key'] ) ); // phpcs:ignore WordPress.Security.NonceVerification.Missing
   361			$checkout_id = empty( $_POST['checkout_id'] ) ? 0 : absint( $_POST['checkout_id'] ); // phpcs:ignore WordPress.Security.NonceVerification.Missing
   362	
   363			if ( empty( $field_key ) || empty( $checkout_id ) ) {
   364				return compact( 'max_size', 'extensions' );
   365			}
   366	
   367			$field_type   = ( 0 === strpos( $field_key, 'shipping_' ) ) ? 'shipping' : 'billing';
   368			$saved_fields = get_post_meta( $checkout_id, 'wcf_field_order_' . $field_type, true );
   369	
   370			if ( ! is_array( $saved_fields ) || empty( $saved_fields[ $field_key ] ) || ! is_array( $saved_fields[ $field_key ] ) ) {
   371				return compact( 'max_size', 'extensions' );
   372			}
   373	
   374			$custom_attributes = empty( $saved_fields[ $field_key ]['custom_attributes'] ) || ! is_array( $saved_fields[ $field_key ]['custom_attributes'] )
   375				? array()
   376				: $saved_fields[ $field_key ]['custom_attributes'];
   377	
   378			if ( empty( $custom_attributes ) ) {
   379				return compact( 'max_size', 'extensions' );
   380			}
   381	
   382			if ( ! empty( $custom_attributes['file_size'] ) && is_scalar( $custom_attributes['file_size'] ) ) {
   383				$max_size = max( 1, absint( $custom_attributes['file_size'] ) ) * 1024 * 1024;
   384			}
   385	
   386			if ( ! empty( $custom_attributes['accepted_file_types'] ) ) {
   387				$extensions = $this->normalize_extension_list( $custom_attributes['accepted_file_types'] );
   388			}
   389	
   390			return compact( 'max_size', 'extensions' );
   391		}
   392	
   393		/**
   394		 * Normalize accepted file types into a lowercase extension list.
   395		 *
   396		 * @since 2.2.2
   397		 *
   398		 * @param string $raw Raw accepted file types value.
   399		 * @return array Normalized extensions.
   400		 */
   401		private function normalize_extension_list( $raw ) {
   402	
   403			if ( ! is_string( $raw ) || '' === trim( $raw ) ) {
   404				return array();
   405			}
   406	
   407			$extensions = array_map( 'strtolower', array_map( 'trim', explode( ',', $raw ) ) );
   408			
