   169			// Check if the product is an order bump before removing it.
   170			if ( ! empty( $product_key ) ) {
   171				$cart_item = WC()->cart->get_cart_item( $product_key );
   172				if ( isset( $cart_item['cartflows_bump'] ) && $cart_item['cartflows_bump'] ) {
