   293		public function upload_checkout_file() {
   294	
   295			if ( ! check_ajax_referer( 'wcf-file-upload', 'security', false ) ) {
   296				wp_send_json_error(
   297					array( 'error' => __( 'Nonce validation failed.', 'cartflows' ) )
   298				);
   299			}
   300	
   301			if ( empty( $_FILES['wcf_checkout_file']['tmp_name'] ) ) {
   302				wp_send_json_error(
   303					array( 'error' => __( 'No file uploaded.', 'cartflows' ) )
   304				);
   305			}
   306	
   307			if ( ! function_exists( 'wp_handle_upload' ) ) {
   308				require_once ABSPATH . 'wp-admin/includes/file.php';
   309			}
   310	
   311			$file         = $_FILES['wcf_checkout_file']; // phpcs:ignore WordPress.Security.ValidatedSanitizedInput, WordPress.Security.NonceVerification.Missing
   312			$file['name'] = sanitize_file_name( $file['name'] );
   313			$file['ext']  = strtolower( pathinfo( $file['name'], PATHINFO_EXTENSION ) );
   314	
   315			$master_allowed = Cartflows_Helper::get_allowed_file_extensions();
   316	
   317			$restrictions = $this->get_field_restrictions();
   318	
   319			$allowed_extensions = empty( $restrictions['extensions'] )
   320				? $master_allowed
   321				: array_values( array_intersect( $master_allowed, $restrictions['extensions'] ) );
   322	
   323			if ( ! in_array( $file['ext'], $allowed_extensions, true ) ) {
   324				wp_send_json_error( array( 'error' => __( 'File type is not allowed.', 'cartflows' ) ) );
   325			}
   326	
   327			if ( (int) $file['size'] > $restrictions['max_size'] ) {
   328				wp_send_json_error( array( 'error' => __( 'File size exceeds the allowed limit.', 'cartflows' ) ) );
   329			}
   330	
   331			$check = wp_check_filetype_and_ext( $file['tmp_name'], $file['name'], wp_get_mime_types() );
   332	
   333			if ( empty( $check['ext'] ) || $check['ext'] !== $file['ext'] ) {
   334				wp_send_json_error( array( 'error' => __( 'Invalid or corrupted file.', 'cartflows' ) ) );
   335			}
   336	
   337			$result = $this->move_uploaded_file( $file );
   338	
   339			wp_send_json_success(
   340				array(
   341					'success'  => true,
   342					'url'      => esc_url_raw( $result['url'] ),
   343					'filename' => sanitize_file_name( basename( $result['file'] ) ),
   344				)
   345			);
