   175				}
   176				
   177				WC()->cart->remove_cart_item( $product_key );
   178				$msg = "<div class='woocommerce-message'>" . $product_title . __( ' has been removed.', 'cartflows' ) . '</div>';
   179			} else {
   180				$msg = "<div class='woocommerce-message'>" . __( 'Sorry there was a problem removing ', 'cartflows' ) . $product_title;
   181			}
   182	
   183			foreach ( WC()->cart->get_cart() as $cart_item_key => $values ) {
   184				if ( $values['data']->needs_shipping() ) {
