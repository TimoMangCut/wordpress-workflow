    public function register_routes(): void {
        register_rest_route(
            HOSTINGER_REACH_PLUGIN_REST_API_BASE,
            'integrations',
            array(
                'methods'             => 'GET',
                'callback'            => array( $this->handler, 'get_integrations_handler' ),
                'permission_callback' => '__return_true',
            )
        );

        register_rest_route(
            HOSTINGER_REACH_PLUGIN_REST_API_BASE,
            'integrations',
