    65	    }
    66	
    67	    public function handle_wp_error( WP_Error $error ): WP_REST_Response {
    68	        $response   = new WP_REST_Response();
    69	        $error_data = $error->get_error_data() ?? array( 'status' => WP_Http::BAD_REQUEST );
    70	        if ( current_user_can( 'manage_options' ) ) {
    71	            $response->set_data( array( 'errors' => $error->get_error_code() ) );
    72	        } else {
    73	            $response->set_data( array( 'errors' => $this->get_generic_error_message() ) );
    74	        }
    75	
    76	        $response->set_status( $error_data['status'] );
    77	        return $response;
    78	    }
    79	
    80	    public function handle_response( array $response ): WP_REST_Response {
    81	        $wp_response = new WP_REST_Response();
    82	        $wp_response->set_status( wp_remote_retrieve_response_code( $response ) );
    83	        $body = wp_remote_retrieve_body( $response );
    84	        $wp_response->set_data( json_decode( $body ? $body : '', true ) );
    85	        return $wp_response;
    86	    }
    87	}

