    39	 *
    40	 * @param WP_REST_Request $data
    41	 * @return void
    42	 */
    43	function kubio_get_api_key( WP_REST_Request $data ) {
    44		$key = Flags::get( 'kubio_cloud_api_key' );
    45	
    46		if ( empty( $key ) ) {
    47	
    48			wp_send_json_error( __( 'Api key not found', 'kubio' ) );
    49	
    50		}
    51	
    52		$response = wp_remote_get(
