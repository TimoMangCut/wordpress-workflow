   310		public static function removeTrailingSlashFromUrl( $url ) {
   311			$last_character = substr( $url, -1 );
   312			if ( $last_character === '/' ) {
   313				$url = substr( $url, 0, -1 );
   314			}
   315			return $url;
   316		}
