   157					}
   158					$template_parts[] = $template_part_block['attrs']['slug'];
   159				}
   160	
   161				$wp_templates[ $key ]->template_parts = $template_parts;
   162			}
   163	
   164			foreach ( $wp_template_parts as $template_part ) {
