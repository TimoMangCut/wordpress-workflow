   367	    private function get_elementor_form_ids_from_content( string $content ): array {
   368	        $form_ids = array();
   369	        $pattern  = '/<form id="' . SubscriptionFormElementorWidget::FORM_ID_PREFIX . '(\d+)"/';
   370	        preg_match_all( $pattern, $content, $matches );
   371	        foreach ( $matches[1] as $form_id ) {
   372	            $form_ids[] = SubscriptionFormElementorWidget::FORM_ID_PREFIX . $form_id;
   373	        }
   374	
   375	        return $form_ids;
   376	    }
   377	
   378	    private function get_elementor_form_ids_from_actions(): array {
   379	        $form_ids = array();
   380	        $actions  = json_decode( wp_unslash( $_POST['actions'] ?? '' ), true );
   381	        $status   = $actions['save_builder']['data']['status'] ?? 'draft';
   382	        $elements = $actions['save_builder']['data']['elements'] ?? array();
   383	
   384	        if ( ! empty( $elements ) && $status === 'publish' ) {
   385	            foreach ( $elements as $element ) {
   386	                $form_ids = array_merge( $form_ids, $this->find_form_widget( $element ) );
   387	            }
   388	        }
   389	
   390	        return $form_ids;
