   349	    private function update_form_repository( array $form_ids, int $post_id ): void {
   350	        if ( empty( $form_ids ) ) {
   351	            update_option( Functions::HOSTINGER_REACH_HAS_FORMS, true );
   352	        }
   353	        foreach ( $form_ids as $form_id ) {
   354	            $form = array(
   355	                'form_id' => $form_id,
   356	                'type'    => self::INTEGRATION_NAME,
   357	            );
   358	
   359	            if ( $this->form_repository->exists( $form_id ) ) {
   360	                $this->form_repository->update( $form );
