    16	    const SUPPORT_TOOLKIT_BACKUP_NUMBER = 10;
    17	    const SUPPORT_TOOLKIT_PREFIX        = 'duplicator_support_toolkit_';
    18	
    19	    /**
    20	     * Returns true if the diagnostic data can be downloaded
    21	     *
    22	     * @return bool true if diagnostic info can be downloaded
    23	     */
    24	    public static function isAvailable()
    25	    {
    26	        return ZipArchiveExtended::isPhpZipAvailable();
    27	    }
    28	
    29	    /**
    30	     * Returns the diagnostic data download URL if available,
    31	     * empty string otherwise.
    32	     *
    33	     * @return string
    34	     */
    35	    public static function getSupportToolkitDownloadUrl()
    36	    {
    37	        if (!self::isAvailable()) {
    38	            return '';
    39	        }
    40	
    41	        return admin_url('admin-ajax.php') . '?' . http_build_query([
    42	            'action' => 'duplicator_download_support_toolkit',
    43	            'nonce'  => wp_create_nonce('duplicator_download_support_toolkit'),
    44	        ]);
    45	    }
    46	
    47	    /**
    48	     * Generates a support toolkit zip file
    49	     *
    50	     * @return string The path to the generated zip file
    51	     */
    52	    public static function getToolkit()
    53	    {
    54	        $tempZipFilePath = DUP_Settings::getSsdirTmpPath() . '/' .
    55	            self::SUPPORT_TOOLKIT_PREFIX . date('YmdHis') . '_' .
    56	            SnapUtil::generatePassword(16, false, false) . '.zip';
    57	        $zip             = new ZipArchiveExtended($tempZipFilePath);
    58	
    59	        if ($zip->open() === false) {
    60	            throw new Exception(__('Failed to create zip file', 'duplicator'));
    61	        }
    62	
    63	        // Trace log
    64	        if (DUP_Settings::Get('trace_log_enabled')) {
    65	            $zip->addFile(DUP_Log::getTraceFilepath());
    66	        }
    67	
    68	        // Debug log (if it exists)
    69	        if (WP_DEBUG_LOG !== false) {
    70	            if (is_bool(WP_DEBUG_LOG) && WP_DEBUG_LOG === true) {
    71	                $zip->addFile(
    72	                    trailingslashit(wp_normalize_path(realpath(WP_CONTENT_DIR))) . 'debug.log',
    73	                    '',
    74	                    10 * MB_IN_BYTES
    75	                );
    76	            } elseif (is_string(WP_DEBUG_LOG) && strlen(WP_DEBUG_LOG) > 0) {
    77	                //The path can be relative too so resolve via safepath
    78	                $zip->addFile(
    79	                    SnapIO::safePath(WP_DEBUG_LOG, true),
    80	                    '',
    81	                    10 * MB_IN_BYTES
    82	                );
    83	            }
    84	        }
    85	
    86	        //phpinfo (as html)
    87	        $zip->addFileFromString('phpinfo.html', self::getPhpInfo());
    88	
    89	        //custom server settings info (as html)
    90	        $zip->addFileFromString('serverinfo.txt', self::getPlainServerSettings());
    91	
    92	        //Last 10 backup build logs
    93	        DUP_Package::by_status_callback(
    94	            function (DUP_Package $package) use ($zip) {
    95	                $file_path = DUP_Settings::getSsdirLogsPath() . "/" . $package->getLogFilename();
    96	                $zip->addFile($file_path);
    97	            },
    98	            [],
    99	            self::SUPPORT_TOOLKIT_BACKUP_NUMBER,
   100	            0,
   101	            '`id` DESC'
   102	        );
   103	
   104	        return $tempZipFilePath;
   105	    }
   106	
   107	    /**
   108	     * Returns the contents of the "Server Settings" section in "Tools" > "General" in plain text format
   109	     *
   110	     * @return string
   111	     */
   112	    private static function getPlainServerSettings()
   113	    {
   114	        $result = '';
   115	
   116	        foreach (DUP_Server::getServerSettingsData() as $section) {
   117	            $result .= $section['title'] . "\n";
   118	            $result .= str_repeat('=', 50) . "\n";
   119	            foreach ($section['settings'] as $data) {
   120	                $result .= str_pad($data['logLabel'], 20, ' ', STR_PAD_RIGHT) . ' ' . $data['value'] . "\n";
   121	            }
   122	            $result .= "\n\n";
   123	        }
   124	
   125	        return $result;
   126	    }
   127	
   128	    /**
   129	     * Returns the output of phpinfo as a string
   130	     *
   131	     * @return string
   132	     */
   133	    private static function getPhpInfo()
   134	    {
   135	        ob_start();
   136	        SnapUtil::phpinfo();
   137	        $phpInfo = ob_get_clean();
   138	
   139	        return $phpInfo === false ? '' : $phpInfo;
   140	    }
   141	}

