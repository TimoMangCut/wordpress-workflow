+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 41,
+          "note": "The handler verifies the `duplicator_reset_all_settings` nonce and throws on failure."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 45,
+          "note": "The handler enforces `DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW)`."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 55,
+          "note": "Package deletion starts only after both guards succeed."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 60,
+          "note": "The remaining state changes reset the active package id and clean temporary files."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Phase 1's unresolved callback mapping suggested that `duplicator_reset_all_settings` might delete packages and clear state without nonce or capability enforcement.",
+        "trace": "Direct source review shows the callback at `class.web.services.php:35-80`, where nonce validation and `export` capability enforcement happen before the destructive calls.",
+        "defenses": "Both CSRF and authorization checks are present and fail closed via exception.",
+        "refutation": "The anomaly came from unresolved callback metadata, not from the live function body. The live callback does not expose a lower-privilege destructive path.",
+        "conclusion": "Rejected as a false positive."
+      },
+      "reopen_if": "Show another registration of `duplicator_reset_all_settings` that resolves to a different callback without the guards above."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-004",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Set-admin-notice-viewed only updates the current user's own notice map after guard checks",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_duplicator_set_admin_notice_viewed"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 158,
+          "note": "The handler enforces `export` capability."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 160,
+          "note": "The handler verifies the `duplicator_set_admin_notice_viewed` nonce."
