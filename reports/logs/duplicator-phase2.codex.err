@@ -0,0 +1,468 @@
+{
+  "plugin_slug": "duplicator",
+  "analysis_summary": {
+    "phase": "phase2",
+    "plugin_version": "1.5.16",
+    "ir_entry_points_reviewed": 28,
+    "phase1_anomalies_reviewed": 9,
+    "focus": [
+      "Validated the Phase 1 AJAX candidates first, then traced the highest-value file and plugin-install sinks directly in source: trace-log download, installer download, support-toolkit download, package scan/build/delete, reset-all, and one-click upgrade.",
+      "Checked each candidate for exact nonce, capability, path, and storage defenses instead of treating `wp_ajax_*` registration or sink presence as a finding by itself.",
+      "Reviewed the low-friction auth surfaces that remained after Phase 1: capability-less notice-dismiss handlers, capability-less support-toolkit download wrapper, and the `wp_ajax_nopriv_duplicator_lite_run_one_click_upgrade` route."
+    ],
+    "result": "No Patchstack-eligible true positive or evidence-backed REVIEW finding was confirmed in Duplicator 1.5.16 after direct source validation.",
+    "key_observation": "The meaningful file-operation and state-changing flows are either blocked by `DUP_Util::hasCapability('export')` plus a nonce, or by an export-only one-time token handshake. The remaining capability-less handlers only update the current user's dismiss state or depend on a nonce that the bundled UI exposes only on a `manage_options` page.",
+    "assumptions": [
+      "This review treats the default Duplicator capability boundary as intended behavior. Administrator-controlled remapping through filters such as `wpfront_user_role_editor_duplicator_translate_capability` is configuration, not a plugin auth bypass."
+    ],
+    "tooling_notes": [
+      "Phase 1 IR and Semgrep were treated as signal sources only and revalidated against source.",
+      "The Psalm SARIF artifact existed only as `{ \"status\": \"error\", \"exit_code\": 1 }` and provided no corroborating data."
+    ]
+  },
+  "overall_risk": "none",
+  "total_findings_analyzed": 10,
+  "true_positives": 0,
+  "false_positives": 10,
+  "needs_review": 0,
+  "findings": [],
+  "negative_findings": [
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-001",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Trace-log download is not missing a capability check",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_DUP_CTRL_Tools_getTraceLog"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.tools.php",
+          "line_number": 138,
+          "note": "The handler first requires `check_ajax_referer('DUP_CTRL_Tools_getTraceLog', 'nonce')`."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.tools.php",
+          "line_number": 139,
+          "note": "The handler then enforces `Dup_Util::hasCapability('export')` before reading or streaming the zip."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.tools.php",
+          "line_number": 153,
+          "note": "The file-read sink (`fopen`) happens only after the nonce and capability checks."
+        },
+        {
+          "file_path": "plugins/duplicator/classes/utilities/class.u.php",
+          "line_number": 508,
+          "note": "`hasCapability()` calls `current_user_can()` and dies or throws on failure."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Phase 1 flagged `getTraceLog()` as an authenticated file-read endpoint without a capability gate, which would make the trace archive downloadable by any logged-in user with a valid nonce.",
+        "trace": "The AJAX handler reaches the zip/file sinks only after `check_ajax_referer()` at `ctrl.tools.php:138` and `Dup_Util::hasCapability('export')` at `ctrl.tools.php:139`.",
+        "defenses": "Nonce validation gates CSRF, and `DUP_Util::hasCapability()` maps to `current_user_can()` and hard-fails on denial.",
+        "refutation": "I traced the live code instead of the IR label and found the capability check immediately before the sinks. The missing-capability hypothesis does not survive direct source review.",
+        "conclusion": "Rejected as a false positive. The file-read sink is protected by both nonce and capability checks."
+      },
+      "reopen_if": "Show a code path that reaches `getTraceLog()` without executing `Dup_Util::hasCapability('export')`, or show a bundled low-privilege path that intentionally grants `export` contrary to the plugin's intended boundary."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-002",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "The `check_ajax_referer(..., false)` pattern in active-package-info does not bypass nonce validation",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_duplicator_active_package_info"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.package.php",
+          "line_number": 283,
+          "note": "The handler requires `DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW)` before continuing."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.package.php",
+          "line_number": 284,
+          "note": "The `check_ajax_referer(..., false)` result is tested explicitly."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.package.php",
+          "line_number": 285,
+          "note": "Nonce failure immediately throws before any package data is returned."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/ctrl.package.php",
+          "line_number": 299,
+          "note": "The handler only reads package-running state after the explicit exception guard."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Because the handler uses `check_ajax_referer(..., false)`, execution might continue after a failed nonce check and disclose package status to a lower-privileged caller.",
+        "trace": "The function calls `hasCapability('export')`, then tests the boolean result of `check_ajax_referer(..., false)`, and throws on failure before any response fields are populated from live package state.",
+        "defenses": "The code combines a capability gate with an explicit exception on nonce failure.",
+        "refutation": "The risky version of this pattern is 'call with `$die=false` and ignore the return value'. Duplicator does not ignore it here; it turns failure into an exception before the data sink.",
+        "conclusion": "Rejected as a false positive. The nonce pattern is intentional and still blocks unauthorized execution."
+      },
+      "reopen_if": "Show a branch where nonce failure is ignored and the function still reaches the success payload construction."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-003",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Reset-all-settings is not an unguarded destructive AJAX action",
+      "entry_point_ids": [
