   323	/**
   324	 * Controller for Tools
   325	 *
   326	 * @package Duplicator\ctrls
   327	 */
   328	class DUP_CTRL_Package extends DUP_CTRL_Base
   329	{
   330	    /**
   331	     *  Init this instance of the object
   332	     */
   333	    public function __construct()
   334	    {
   335	        add_action('wp_ajax_DUP_CTRL_Package_addQuickFilters', array($this, 'addQuickFilters'));
   336	        add_action('wp_ajax_DUP_CTRL_Package_getActivePackageStatus', array($this, 'getActivePackageStatus'));
   337	    }
   338	
   339	    /**
   340	     * Removed all reserved installer files names
   341	     *
   342	     * @param string $_POST['dir_paths']        A semi-colon separated list of directory paths
   343	     *
   344	     * @return string   Returns all of the active directory filters as a ";" separated string
   345	     */
   346	    public function addQuickFilters()
   347	    {
   348	        DUP_Handler::init_error_handler();
   349	        check_ajax_referer('DUP_CTRL_Package_addQuickFilters', 'nonce');
   350	        $result    = new DUP_CTRL_Result($this);
   351	        $inputData = array(
   352	            'dir_paths'  => sanitize_textarea_field($_POST['dir_paths'] ?? ''),
   353	            'file_paths' => sanitize_textarea_field($_POST['file_paths'] ?? '')
   354	        );
   355	        try {
   356	            DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW);
   357	            //CONTROLLER LOGIC
   358	            $package = DUP_Package::getActive();
   359	            //DIRS
   360	            $dir_filters = ($package->Archive->FilterOn && strlen($package->Archive->FilterDirs) > 0)
   361	                ? $package->Archive->FilterDirs . ';' . $inputData['dir_paths'] : $inputData['dir_paths'];
   362	            $dir_filters = $package->Archive->parseDirectoryFilter($dir_filters);
   363	            $changed     = $package->Archive->saveActiveItem($package, 'FilterDirs', $dir_filters);
   364	            //FILES
   365	            $file_filters = ($package->Archive->FilterOn && strlen($package->Archive->FilterFiles) > 0)
   366	                ? $package->Archive->FilterFiles . ';' . $inputData['file_paths'] : $inputData['file_paths'];
   367	            $file_filters = $package->Archive->parseFileFilter($file_filters);
   368	            $changed      = $package->Archive->saveActiveItem($package, 'FilterFiles', $file_filters);
   369	            if (!$package->Archive->FilterOn && !empty($package->Archive->FilterExts)) {
   370	                $changed = $package->Archive->saveActiveItem($package, 'FilterExts', '');
   371	            }
   372	
   373	            $changed = $package->Archive->saveActiveItem($package, 'FilterOn', 1);
   374	            //Result
   375	            $package              = DUP_Package::getActive();
   376	            $payload['dirs-in']   = esc_html(sanitize_text_field($inputData['dir_paths']));
   377	            $payload['dir-out']   = esc_html($package->Archive->FilterDirs);
   378	            $payload['files-in']  = esc_html(sanitize_text_field($inputData['file_paths']));
   379	            $payload['files-out'] = esc_html($package->Archive->FilterFiles);
   380	            //RETURN RESULT
   381	            $test = ($changed) ? DUP_CTRL_Status::SUCCESS : DUP_CTRL_Status::FAILED;
   382	            $result->process($payload, $test);
   383	        } catch (Exception $exc) {
   384	            $result->processError($exc);
   385	        }
   386	    }
   387	
   388	    /**
   389	     * Get active package status
   390	     *
   391	     * <code>
   392	     * //JavaScript Ajax Request
   393	     * Duplicator.Package.getActivePackageStatus()
   394	     * </code>
   395	     */
   396	    public function getActivePackageStatus()
   397	    {
   398	        DUP_Handler::init_error_handler();
   399	        check_ajax_referer('DUP_CTRL_Package_getActivePackageStatus', 'nonce');
   400	        $result = new DUP_CTRL_Result($this);
   401	        try {
   402	            DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW);
   403	        //CONTROLLER LOGIC
   404	            $active_package_id = DUP_Settings::Get('active_package_id');
   405	            $package           = DUP_Package::getByID($active_package_id);
   406	            $payload           = array();
   407	            if ($package != null) {
   408	                $test              = DUP_CTRL_Status::SUCCESS;
   409	                $payload['status'] = $package->Status;
   410	            } else {
   411	                $test = DUP_CTRL_Status::FAILED;
   412	            }
   413	
   414	            //RETURN RESULT
   415	            return $result->process($payload, $test);
   416	        } catch (Exception $exc) {
   417	            $result->processError($exc);
   418	        }
   419	    }
   420	}

