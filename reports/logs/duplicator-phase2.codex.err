+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 193,
+          "note": "The callback rejects invalid or missing nonces."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 199,
+          "note": "The requested option name is checked against a fixed switch whitelist."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Views/AdminNotices.php",
+          "line_number": 21,
+          "note": "The only reachable option keys are fixed plugin notice keys such as `duplicator_activate_plugins_after_installation` and `duplicator_is_enable_notice_dismissed`."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Because the endpoint calls `delete_option()` and `update_option()`, a caller might be able to write arbitrary options or suppress a security-relevant state check.",
+        "trace": "The endpoint gates on `export` capability and a nonce, sanitizes the requested notice value, then switches over a hard-coded set of plugin notice option constants before calling `delete_option()` or `update_option(true)`.",
+        "defenses": "The sink key is not attacker-controlled; it must match one of four fixed plugin constants.",
+        "refutation": "I could not make request data escape the switch whitelist into a generic option write. The resulting state change only dismisses plugin notices. Patchstack also treats notice-only CSRF/BAC effects as non-actionable unless they create additional security impact.",
+        "conclusion": "Rejected as a false positive."
+      },
+      "reopen_if": "Show a bundled path that lets attacker input reach `update_option()` or `delete_option()` with a non-whitelisted key, or demonstrate a concrete security impact from one of the four fixed notice options."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-006",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Installer download is not an arbitrary file-read sink",
