    83	    public static function duplicator_download_installer()
    84	    {
    85	        check_ajax_referer('duplicator_download_installer', 'nonce');
    86	
    87	        $packageId = SnapUtil::sanitizeIntInput(INPUT_GET, 'id');
    88	        $hash      = SnapUtil::sanitizeTextInput(INPUT_GET, 'hash');
    89	
    90	        try {
    91	            DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW);
    92	
    93	            if (!$packageId || !$hash) {
    94	                throw new Exception(__('Invalid request.', 'duplicator'));
    95	            }
    96	
    97	            if (($package = DUP_Package::getByID($packageId)) == null) {
    98	                throw new Exception(__('Invalid request.', 'duplicator'));
    99	            }
   100	
   101	            if ($hash !== $package->Hash) {
   102	                throw new Exception(__('Invalid request.', 'duplicator'));
   103	            }
   104	
   105	            $fileName     = $package->getInstDownloadName();
   106	            $realFileName = $package->Installer->File;
   107	            $backupDir    = DUP_Settings::getSsdirPath();
   108	
   109	            if (DUP_STR::endsWith($realFileName, '.php')) {
   110	                $realFileName = basename($realFileName, '.php') . DUP_Installer::INSTALLER_SERVER_EXTENSION;
   111	            }
   112	            $filepath = "{$backupDir}/{$realFileName}";
   113	
   114	            // Process download
   115	            if (!file_exists($filepath)) {
   116	                throw new Exception(__('INVALID REQUEST: File not found, please check the backup folder for file.', 'duplicator'));
   117	            }
   118	
   119	            // Clean output buffer
   120	            if (ob_get_level() !== 0 && @ob_end_clean() === false) {
   121	                @ob_clean();
   122	            }
   123	
   124	            header('Content-Description: File Transfer');
   125	            header('Content-Type: application/octet-stream');
   126	            header('Content-Disposition: attachment; filename="' . $fileName . '"');
   127	            header('Expires: 0');
   128	            header('Cache-Control: must-revalidate');
   129	            header('Pragma: public');
   130	            header('Content-Length: ' . filesize($filepath));
   131	            flush(); // Flush system output buffer
   132	
   133	            try {
   134	                $fp = @fopen($filepath, 'r');
   135	                if (false === $fp) {
   136	                    throw new Exception('Fail to open the file ' . $filepath);
   137	                }
   138	                while (!feof($fp) && ($data = fread($fp, DUPLICATOR_BUFFER_READ_WRITE_SIZE)) !== false) {
   139	                    echo $data;
   140	                }
   141	                @fclose($fp);
   142	            } catch (Exception $e) {
   143	                readfile($filepath);
   144	            }
   145	            exit;
   146	        } catch (Exception $ex) {
   147	            //Prevent brute force
   148	            sleep(2);
   149	            wp_die($ex->getMessage());
   150	        }
   151	    }
