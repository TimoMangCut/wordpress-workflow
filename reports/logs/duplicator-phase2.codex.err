   491	    const SECURE_ISSUE_DIE    = 'die';
   492	    const SECURE_ISSUE_THROW  = 'throw';
   493	    const SECURE_ISSUE_RETURN = 'return';
   494	
   495	    /**
   496	     * Does the current user have the capability
   497	     *
   498	     * @param type $permission
   499	     * @param type $exit    //  SECURE_ISSUE_DIE die script with die function
   500	     *                          SECURE_ISSUE_THROW throw an exception if fail
   501	     *                          SECURE_ISSUE_RETURN return false if fail
   502	     *
   503	     * @return boolean      // return false is fail and $exit is SECURE_ISSUE_THROW
   504	     *                      // true if success
   505	     *
   506	     * @throws Exception    // thow exception if $exit is SECURE_ISSUE_THROW
   507	     */
   508	    public static function hasCapability($permission = 'read', $exit = self::SECURE_ISSUE_DIE)
   509	    {
   510	        $capability = apply_filters('wpfront_user_role_editor_duplicator_translate_capability', $permission);
   511	
   512	        if (!current_user_can($capability)) {
   513	            $exitMsg = __('You do not have sufficient permissions to access this page.', 'duplicator');
   514	            DUP_LOG::Trace('You do not have sufficient permissions to access this page. PERMISSION: ' . $permission);
   515	
   516	            switch ($exit) {
   517	                case self::SECURE_ISSUE_THROW:
   518	                    throw new Exception($exitMsg);
   519	                case self::SECURE_ISSUE_RETURN:
   520	                    return false;
   521	                case self::SECURE_ISSUE_DIE:
   522	                default:
   523	                    wp_die($exitMsg);
   524	            }
   525	        }
   526	        return true;

