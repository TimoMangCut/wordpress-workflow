   187	    public static function admin_notice_to_dismiss()
   188	    {
   189	        try {
   190	            DUP_Util::hasCapability('export', DUP_Util::SECURE_ISSUE_THROW);
   191	
   192	            $nonce = SnapUtil::sanitizeTextInput(INPUT_POST, 'nonce', false);
   193	            if ($nonce === false || !wp_verify_nonce($nonce, 'duplicator_admin_notice_to_dismiss')) {
   194	                DUP_Log::trace('Security issue');
   195	                throw new Exception('Security issue');
   196	            }
   197	
   198	            $noticeToDismiss = SnapUtil::sanitizeTextInput(INPUT_POST, 'notice', false);
   199	            switch ($noticeToDismiss) {
   200	                case AdminNotices::OPTION_KEY_ACTIVATE_PLUGINS_AFTER_INSTALL:
   201	                case AdminNotices::OPTION_KEY_NEW_NOTICE_TEMPLATE:
   202	                    delete_option($noticeToDismiss);
   203	                    break;
   204	                case AdminNotices::OPTION_KEY_IS_ENABLE_NOTICE_DISMISSED:
   205	                case AdminNotices::OPTION_KEY_IS_MU_NOTICE_DISMISSED:
   206	                    update_option($noticeToDismiss, true);
   207	                    break;
   208	                default:
   209	                    throw new Exception('Notice invalid');
   210	            }
   211	        } catch (Exception $e) {
   212	            wp_send_json_error($e->getMessage());
   213	        }
   214	
   215	        wp_send_json_success();
   216	    }
   217	}

