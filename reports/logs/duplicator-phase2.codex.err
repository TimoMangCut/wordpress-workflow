+          "line_number": 101,
+          "note": "The request-supplied `hash` must strictly match `$package->Hash`."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 106,
+          "note": "The downloaded file name comes from package metadata, not directly from request input."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 109,
+          "note": "If the metadata ends in `.php`, the code replaces it with the fixed installer server extension after `basename()`."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 134,
+          "note": "The file-read sink (`fopen`/`readfile`) is reached only after those validations."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "The AJAX endpoint might let a low-privilege user download arbitrary files from the backup directory or elsewhere on disk.",
+        "trace": "The request only supplies `id` and `hash`. The code resolves the package object by id, requires a strict hash match, derives the real filename from the package's stored installer metadata, and then streams that file from the snapshot directory.",
+        "defenses": "Nonce, capability, package existence, strict package-hash comparison, and filename derivation from server-side package metadata.",
+        "refutation": "I did not find any user-controlled path concatenation into `$filepath`. The request does not directly supply a path or filename, and the code validates package ownership via the package hash before the file-read sink.",
+        "conclusion": "Rejected as a false positive. This is a guarded package-file download, not arbitrary file read."
+      },
+      "reopen_if": "Show a path where attacker input directly controls `$realFileName` or where `$package->Hash` is exposed to a lower-privileged actor without already crossing the plugin's intended boundary."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-007",
+      "state": "REJECTED",
+      "verdict": "FP",
