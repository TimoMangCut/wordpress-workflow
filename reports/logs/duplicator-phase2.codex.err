+          "line_number": 148,
+          "note": "`generateConnectOTH()` uses `AjaxWrapper::json()` with the `duplicator_generate_connect_oth` nonce."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/ServicesEducation.php",
+          "line_number": 152,
+          "note": "The same call also enforces `export` capability."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/ServicesEducation.php",
+          "line_number": 168,
+          "note": "The generated one-time token is stored server-side with a 10-minute expiry."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/ServicesEducation.php",
+          "line_number": 301,
+          "note": "`oneClickUpgrade()` refuses execution unless the OTH option exists and is still valid."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/ServicesEducation.php",
+          "line_number": 316,
+          "note": "The request-supplied package must decrypt under the stored token."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/ServicesEducation.php",
+          "line_number": 333,
+          "note": "The OTH is deleted after use to prevent replay."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Core/Bootstrap.php",
+          "line_number": 407,
+          "note": "The nonce for `generateConnectOTH()` is localized broadly on admin pages, but the server-side `export` capability check remains in force."
+        },
+        {
+          "file_path": "plugins/duplicator/src/Ajax/AjaxWrapper.php",
+          "line_number": 64,
+          "note": "`AjaxWrapper::json()` always calls `DUP_Util::hasCapability()` when a capability argument is supplied."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "The `wp_ajax_nopriv_duplicator_lite_run_one_click_upgrade` route could let an unauthenticated or subscriber-level attacker install and activate Duplicator Pro by posting a crafted package blob.",
+        "trace": "The nopriv route does reach high-impact sinks such as `Plugin_Upgrader->install()`, `deactivate_plugins()`, and a generated activation redirect. But before that, the payload must decrypt with a server-stored one-time token that is only generated by `generateConnectOTH()`, and that generator is guarded by both a nonce and `export` capability.",
+        "defenses": "Export-only token generation, 10-minute TTL, server-side token storage, single-use deletion, and payload decryption before the installer sink.",
+        "refutation": "I specifically checked whether the broad `admin_enqueue_scripts` nonce exposure weakened this flow. It does not: the nonce alone is insufficient because `generateConnectOTH()` still enforces `export`. I also did not find any alternate read of `duplicator_one_click_upgrade_oth` or any lower-privileged code path that exposes the token needed to craft a valid encrypted package.",
+        "conclusion": "Rejected as a false positive. The unauthenticated callback is part of an export-initiated handshake, not a standalone public install/activate primitive."
+      },
+      "reopen_if": "Show a bundled path that discloses the stored OTH token to a lower-privileged actor, bypasses the `export` gate on `generateConnectOTH()`, or reaches the installer sink with an invalid/missing token."
+    }
+  ],
+  "out_of_scope": []
+}

