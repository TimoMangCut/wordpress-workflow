+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 171,
+          "note": "The stored state is loaded from `get_user_meta(get_current_user_id(), ...)`."
+        },
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 180,
+          "note": "The sink updates only the current user's meta array."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "The unresolved AJAX registration could have allowed any logged-in user to tamper with shared admin-notice state.",
+        "trace": "The real callback requires `export`, verifies the nonce, validates that the requested notice id already exists in the current user's notice array, then writes back to `update_user_meta(get_current_user_id(), ...)`.",
+        "defenses": "Capability check, nonce check, and current-user scoping of the persisted sink.",
+        "refutation": "I did not find any cross-user identifier, arbitrary meta key, or shared option write in this flow. The only state change is for the invoking user's own notice record.",
+        "conclusion": "Rejected as a false positive. The flow is not a privilege boundary break."
+      },
+      "reopen_if": "Show a path where attacker input controls another user's id or the meta key being updated."
+    },
+    {
+      "finding_id": "DUPLICATOR-P2-NEG-005",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Admin-notice dismissal is not an arbitrary option-update primitive",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_duplicator_admin_notice_to_dismiss"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/duplicator/ctrls/class.web.services.php",
+          "line_number": 190,
+          "note": "The callback first enforces `export` capability."
