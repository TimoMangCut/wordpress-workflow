    if ( empty( $_POST['nonce'] ) || ! wp_verify_nonce( $_POST['nonce'], 'pl_dismiss_upgrade_header' ) ) {
      die();
    }

    if(!PrliUtils::is_authorized()) {
      wp_send_json_error(esc_html__('Insufficient permissions', 'pretty-link'));
      return;
