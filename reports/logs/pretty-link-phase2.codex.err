/Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH/reports/phase2/pretty-link-phase2.codex.json
diff --git a//Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH/reports/phase2/pretty-link-phase2.codex.json b//Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH/reports/phase2/pretty-link-phase2.codex.json
