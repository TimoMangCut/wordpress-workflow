+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliStripeController.php",
+          "line_number": 510,
+          "note": "`a99_f33_9c7()` disables certificate verification when contacting prettylinks.com."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/models/PrliUtils.php",
+          "line_number": 856,
+          "note": "`get_page_title()` disables certificate verification for title-fetch requests as well."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "A network attacker who can intercept outbound HTTPS traffic could tamper with service responses and influence stored connection state because multiple remote requests explicitly disable certificate validation.",
+        "trace": "During the Authenticator connect flow, the plugin disables TLS verification, accepts the returned JSON body, and stores fields such as `prli_authenticator_account_email`, `prli_authenticator_secret_token`, and `prli_authenticator_user_uuid` without an application-level signature on that response.",
