+      "verdict": "OUT_OF_SCOPE",
+      "title": "Outbound service calls disable TLS certificate verification",
+      "vuln_type": "Improper Certificate Validation / Active Network MITM",
+      "cwe_id": "CWE-295",
+      "severity": "medium",
+      "auth_required": "active network attacker; not a low-privilege WordPress user",
+      "confidence": "high",
