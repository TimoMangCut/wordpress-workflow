index 0000000000000000000000000000000000000000..86ad7270862aa6b9dde756bd8ff58997bd482a98
--- /dev/null
+++ b//Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH/reports/phase2/pretty-link-phase2.codex.json
@@ -0,0 +1,397 @@
+{
+  "plugin_slug": "pretty-link",
+  "analysis_summary": {
+    "phase": "phase2",
+    "plugin_version": "3.6.21",
+    "ir_entry_points_reviewed": 68,
+    "phase1_anomalies_reviewed": 33,
+    "focus": [
+      "Validated the unauthenticated and low-privileged entry points called out by Phase 1: bookmarklet/init routes, XML-RPC, public invoice rendering, click-report download routing, Authenticator connect/disconnect, and Stripe connect AJAX handlers.",
+      "Traced the main high-value sink families to exact code lines: update_option()/set_transient(), wp_remote_get()/wp_remote_post()/wp_remote_request(), wp_redirect(), and CSV output paths.",
+      "Refuted Semgrep and IR over-taint around option updates by checking real option-key construction, nonce enforcement, capability gates, and whether the resulting state change crosses a meaningful security boundary."
+    ],
+    "result": "No Patchstack-eligible true positive or evidence-backed REVIEW finding was confirmed in Pretty Links 3.6.21 after direct source validation.",
+    "key_observation": "The interesting web-facing surfaces are either protected by user-bound nonces plus administrator/authorized-user gates, or they depend on secret values such as the bookmarklet token or a Stripe checkout session ID that are not exposed to low-privileged attackers by the shipped plugin.",
+    "tooling_notes": [
+      "Phase 1 IR and Semgrep were treated as signal sources only and were revalidated against source.",
+      "The Psalm SARIF artifact existed only as `{\"status\":\"error\",\"exit_code\":1}` and provided no corroborating data."
+    ]
+  },
+  "overall_risk": "none",
+  "total_findings_analyzed": 0,
+  "true_positives": 0,
+  "false_positives": 0,
+  "needs_review": 0,
+  "findings": [],
+  "negative_findings": [
+    {
+      "finding_id": "NEG-001",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Authenticator connect flow is not a web-reachable SSRF or arbitrary option-update primitive",
+      "entry_point_ids": [
+        "ep_init_init"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliAuthenticatorController.php",
+          "line_number": 78,
+          "note": "process_connect() only runs when `?prli-connect=true` is present."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliAuthenticatorController.php",
+          "line_number": 83,
+          "note": "The request must carry a valid `prli-connect` nonce before any network or storage action."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliAuthenticatorController.php",
+          "line_number": 88,
+          "note": "The callback exits unless `PrliUtils::is_authorized()` is true."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliAuthenticatorController.php",
+          "line_number": 96,
+          "note": "The remote request uses the fixed host `PRLI_AUTH_SERVICE_URL`; only `site_uuid` is interpolated into the path."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliAuthenticatorController.php",
+          "line_number": 109,
+          "note": "All writes target fixed plugin-owned option names such as `prli_authenticator_account_email` and `prli_authenticator_secret_token`."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Phase 1 and Semgrep suggested that `process_connect()` may let an attacker drive SSRF through `site_uuid` or perform privilege escalation through `update_option()`.",
+        "trace": "The init handler `PrliAuthenticatorController::process_connect()` reads `$_GET['site_uuid']` and `$_GET['auth_code']`, sanitizes both, sends a request to `PRLI_AUTH_SERVICE_URL . \"/api/tokens/{$site_uuid}\"`, decodes the response, and stores only fixed Pretty Links connection options.",
+        "defenses": "The code requires a valid nonce at `PrliAuthenticatorController.php:83`, then requires `PrliUtils::is_authorized()` at line 88. The sink writes are hard-coded plugin option keys, not user-controlled option names.",
+        "refutation": "I could not find attacker control over the remote scheme, host, or option key. The only variable segment in the request is the path component under a fixed service domain. That defeats the Semgrep SSRF hypothesis. The option-update hypothesis also fails because the code never concatenates user input into the option names and only touches Pretty Links-owned connection fields.",
+        "conclusion": "Rejected as a false positive for web exploitation. The remaining concern is the disabled TLS verification on outbound requests, which is tracked separately as an out-of-scope network-MITM hardening issue."
+      },
+      "reopen_if": "Show a bundled path that lets a low-privileged or unauthenticated user mint a valid `prli-connect` nonce, or demonstrate control of the remote host/option key rather than only the path segment and returned values."
+    },
+    {
+      "finding_id": "NEG-002",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Stripe connect AJAX handlers do not expose arbitrary option updates or subscriber-level credential takeover",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_prli_stripe_connect_update_creds",
+        "ep_ajax_priv_wp_ajax_prli_stripe_connect_refresh",
+        "ep_ajax_priv_wp_ajax_prli_stripe_connect_disconnect"
+      ],
+      "evidence": [
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
+          "line_number": 99,
+          "note": "`process_update_creds()` requires a valid `stripe-update-creds` nonce."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
+          "line_number": 114,
+          "note": "`process_update_creds()` exits unless `PrliUtils::is_authorized()` is true."
+        },
+        {
+          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
+          "line_number": 139,
