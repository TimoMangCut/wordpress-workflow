    31	  public function api_version($args) {
    32	    $username = $args[0];
    33	    $password = $args[1];
    34	
    35	    if ( !get_option( 'enable_xmlrpc' ) )
    36	      return new IXR_Error( 401, __( 'Sorry, XML-RPC Not enabled for this website' , 'pretty-link') );
    37	
    38	    if (!user_pass_ok($username, $password))
    39	      return new IXR_Error( 401, __( 'Sorry, Login failed' , 'pretty-link') );
    40	
    41	    // make sure user is an admin
    42	    $userdata = get_userdatabylogin( $username );
    43	    if( !isset($userdata->user_level) or
    44	        (int)$userdata->user_level < 8 )
    45	      return new IXR_Error( 401, __( 'Sorry, you must be an administrator to access this resource' , 'pretty-link') );
    46	
    47	    return prli_api_version();
    48	  }
