   132	
   133	    $site_uuid = get_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_SITE_UUID );
   134	
   135	    $payload = array(
   136	      'site_uuid' => $site_uuid
   137	    );
   138	
   139	    $method_id = PrliStripeConnect::get_method_id();
   140	    $jwt = PrliAuthenticatorController::generate_jwt( $payload );
   141	
   142	    // Make sure the request came from the Connect service
   143	    $response = wp_remote_get( PRLI_STRIPE_SERVICE_URL . "/api/credentials/".$method_id, array(
   144	      'headers' => PrliUtils::jwt_header($jwt, PRLI_STRIPE_SERVICE_DOMAIN)
   145	    ) );
   146	
   147	    $creds = json_decode( wp_remote_retrieve_body( $response ), true );
   148	
   149	    update_option( 'prli_stripe_status', 1 );
   150	    update_option( 'prli_stripe_test_secret_key', sanitize_text_field( $creds['test_secret_key'] ) );
   151	    update_option( 'prli_stripe_test_publishable_key', sanitize_text_field( $creds['test_publishable_key'] ) );
   152	    update_option( 'prli_stripe_live_secret_key', sanitize_text_field( $creds['live_secret_key'] ) );
   153	    update_option( 'prli_stripe_live_publishable_key', sanitize_text_field( $creds['live_publishable_key'] ) );
   154	
   155	    update_option( 'prli_stripe_connect_status', 'connected' );
   156	    update_option( 'prli_stripe_service_account_id', sanitize_text_field( $creds['service_account_id'] ) );
   157	    update_option( 'prli_stripe_service_account_name', sanitize_text_field( $creds['service_account_name'] ) );
   158	  }
   159	
   160	  /**
   161	  * Process a request to refresh tokens
   162	  *
   163	  * @return void
   164	  */
   165	  public function process_refresh_tokens() {
   166	
   167	    // Security check
   168	    if ( ! isset( $_GET['_wpnonce'] ) || ! wp_verify_nonce( $_GET['_wpnonce'], 'stripe-refresh' ) ) {
   169	      wp_die(__('Sorry, the refresh failed.', 'pretty-link'));
   170	    }
   171	
   172	    // Make sure we have a method ID
   173	    if ( ! isset( $_GET['method-id'] ) ) {
   174	      wp_die(__('Sorry, the refresh failed.', 'pretty-link'));
   175	    }
   176	
   177	    // Make sure the user is authorized
   178	    if ( ! PrliUtils::is_authorized() ) {
   179	      wp_die(__('Sorry, you don\'t have permission to do this.', 'pretty-link'));
   180	    }
   181	
   182	    $method_id = PrliStripeConnect::get_method_id();
   183	    $site_uuid = get_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_SITE_UUID );
   184	
   185	    $payload = array(
   186	      'site_uuid' => $site_uuid
   187	    );
   188	
   189	    $jwt = PrliAuthenticatorController::generate_jwt( $payload );
   190	
   191	    // Send request to Connect service
   192	    $response = wp_remote_post( PRLI_STRIPE_SERVICE_URL . "/api/refresh/{$method_id}", array(
   193	      'headers' => PrliUtils::jwt_header($jwt, PRLI_STRIPE_SERVICE_DOMAIN),
   194	    ) );
   195	
   196	    $body = json_decode( wp_remote_retrieve_body( $response ), true );
   197	
   198	    if ( ! isset( $body['connect_status'] ) || 'refreshed' !== $body['connect_status'] ) {
   199	      wp_die(__('Sorry, the refresh failed.', 'pretty-link'));
   200	    }
   201	
   202	    update_option( 'prli_stripe_status', 1 );
   203	    update_option( 'prli_stripe_test_secret_key', sanitize_text_field( $body['test_secret_key'] ) );
   204	    update_option( 'prli_stripe_test_publishable_key', sanitize_text_field( $body['test_publishable_key'] ) );
   205	    update_option( 'prli_stripe_live_secret_key', sanitize_text_field( $body['live_secret_key'] ) );
   206	    update_option( 'prli_stripe_live_publishable_key', sanitize_text_field( $body['live_publishable_key'] ) );
   207	
   208	    update_option( 'prli_stripe_connect_status', 'connected' );
   209	    update_option( 'prli_stripe_service_account_id', sanitize_text_field( $body['service_account_id'] ) );
   210	    update_option( 'prli_stripe_service_account_name', sanitize_text_field( $body['service_account_name'] ) );
   211	
   212	    $redirect_url = add_query_arg( array(
   213	        'stripe-action' => 'refreshed'
   214	      ), admin_url('edit.php?post_type=pretty-link&page=pretty-link-options') ) . '#payments';
   215	
   216	    wp_redirect($redirect_url);
   217	    exit;
   218	  }
