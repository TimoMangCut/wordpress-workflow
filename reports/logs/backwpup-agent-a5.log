   271		/**
   272		 * Return whether this table can be upgraded.
   273		 *
   274		 * @since 1.0.0
   275		 *
   276		 * @return bool True if table can be upgraded. False if not.
   277		 */
   278		public function is_upgradeable() {
   279	
   280			// Bail if global and upgrading global tables is not allowed
   281			if ( $this->is_global() && ! wp_should_upgrade_global_tables() ) {
   282				return false;
   283			}
   284	
   285			// Kinda weird, but assume it is
   286			return true;
   287		}
