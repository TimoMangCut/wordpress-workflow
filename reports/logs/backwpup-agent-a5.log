   214		/**
   215		 * Maybe upgrade the database table. Handles creation & schema changes.
   216		 *
   217		 * Hooked to the `admin_init` action.
   218		 *
   219		 * @since 1.0.0
   220		 */
   221		public function maybe_upgrade() {
   222	
   223			// Bail if not upgradeable
   224			if ( ! $this->is_upgradeable() ) {
   225				return;
   226			}
   227	
   228			// Bail if upgrade not needed
   229			if ( ! $this->needs_upgrade() ) {
   230				return;
   231			}
   232	
   233			// Upgrade
   234			if ( $this->exists() ) {
   235				$this->upgrade();
   236	
   237			// Install
   238			} else {
   239				$this->install();
   240			}
   241		}
