   447		/**
   448		 * Get the basic cron expression.
   449		 *
   450		 * @param string     $basic_expression Basic expression.
   451		 * @param int|string $hours            Hours of the cron.
   452		 * @param int        $minutes          Minutes of the cron.
   453		 * @param int        $day_of_week      Day of the week default = 0.
   454		 * @param string     $day_of_month     Day of the month.
   455		 *
   456		 * @return string Cron expression.
   457		 * @throws InvalidArgumentException If the cron expression is unsupported.
   458		 */
   459		public static function get_basic_cron_expression( string $basic_expression, $hours = 0, int $minutes = 0, int $day_of_week = 0, string $day_of_month = '1' ): string {
   460			$cron = '';
   461			switch ( $basic_expression ) {
   462				case 'monthly':
   463					$cron = implode( ' ', [ $minutes, $hours, $day_of_month, '*', '*' ] );
   464					break;
   465				case 'weekly':
   466					$cron = implode( ' ', [ $minutes, $hours, '*', '*', $day_of_week ] );
   467					break;
   468				case 'daily':
   469					$cron = implode( ' ', [ $minutes, $hours, '*', '*', '*' ] );
   470					break;
   471				case 'hourly':
   472					$cron = implode( ' ', [ $minutes, '*', '*', '*', '*' ] );
   473					break;
   474			}
   475			return $cron;
   476		}
