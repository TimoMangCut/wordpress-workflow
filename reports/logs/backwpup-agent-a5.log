   323		/**
   324		 * Uninstall a database table
   325		 *
   326		 * Drops the table and deletes the version information if successful and/or
   327		 * the table does not exist anymore.
   328		 *
   329		 * @since 1.0.0
   330		 */
   331		public function uninstall() {
   332	
   333			// Try to drop the table
   334			$dropped = $this->drop();
   335	
   336			// Delete the DB version if drop was successful or table does not exist
   337			if ( ( true === $dropped ) || ! $this->exists() ) {
   338				$this->delete_db_version();
   339			}
   340		}
