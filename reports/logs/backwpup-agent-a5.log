   305		/**
   306		 * Install a database table
   307		 *
   308		 * Creates the table and sets the version information if successful.
   309		 *
   310		 * @since 1.0.0
   311		 */
   312		public function install() {
   313	
   314			// Try to create the table
   315			$created = $this->create();
   316	
   317			// Set the DB version if create was successful
   318			if ( true === $created ) {
   319				$this->set_db_version();
   320			}
   321		}
