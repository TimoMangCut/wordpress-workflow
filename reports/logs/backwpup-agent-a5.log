   921		/**
   922		 * Add class hooks to the parent application actions.
   923		 *
   924		 * @since 1.0.0
   925		 */
   926		private function add_hooks() {
   927	
   928			// Add table to the global database object
   929			add_action( 'switch_blog', array( $this, 'switch_blog'   ) );
   930			add_action( 'admin_init',  array( $this, 'maybe_upgrade' ) );
   931		}
   932	
   933		/**
