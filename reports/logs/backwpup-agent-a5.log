   778		/** Private ***************************************************************/
   779	
   780		/**
   781		 * Setup the necessary table variables.
   782		 *
   783		 * @since 1.0.0
   784		 */
   785		private function setup() {
   786	
   787			// Bail if no database interface is available
   788			if ( ! $this->get_db() ) {
   789				return;
   790			}
   791	
   792			// Sanitize the database table name
   793			$this->name = $this->sanitize_table_name( $this->name );
   794	
   795			// Bail if database table name was garbage
   796			if ( false === $this->name ) {
   797				return;
   798			}
   799	
   800			// Separator
   801			$glue = '_';
   802	
   803			// Setup the prefixed name
   804			$this->prefixed_name = $this->apply_prefix( $this->name, $glue );
   805	
   806			// Maybe create database key
   807			if ( empty( $this->db_version_key ) ) {
   808				$this->db_version_key = implode(
   809					$glue,
   810					array(
   811						sanitize_key( $this->db_global ),
   812						$this->prefixed_name,
   813						'version'
   814					)
   815				);
   816			}
   817		}
   818	
   819		/**
   820		 * Set this table up in the database interface.
   821		 *
   822		 * This must be done directly because the database interface does not
   823		 * have a common mechanism for manipulating them safely.
   824		 *
   825		 * @since 1.0.0
   826		 */
   827		private function set_db_interface() {
   828	
   829			// Get the database once, to avoid duplicate function calls
   830			$db = $this->get_db();
   831	
   832			// Bail if no database
   833			if ( empty( $db ) ) {
   834				return;
   835			}
   836	
   837			// Set variables for global tables
   838			if ( $this->is_global() ) {
   839				$site_id = 0;
   840				$tables  = 'ms_global_tables';
   841	
   842			// Set variables for per-site tables
   843			} else {
   844				$site_id = null;
   845				$tables  = 'tables';
   846			}
   847	
   848			// Set the table prefix and prefix the table name
   849			$this->table_prefix  = $db->get_blog_prefix( $site_id );
   850	
   851			// Get the prefixed table name
   852			$prefixed_table_name = "{$this->table_prefix}{$this->prefixed_name}";
   853	
   854			// Set the database interface
   855			$db->{$this->prefixed_name} = $this->table_name = $prefixed_table_name;
   856	
   857			// Create the array if it does not exist
   858			if ( ! isset( $db->{$tables} ) ) {
   859				$db->{$tables} = array();
   860			}
   861	
   862			// Add the table to the global table array
   863			$db->{$tables}[] = $this->prefixed_name;
   864	
   865			// Charset
   866			if ( ! empty( $db->charset ) ) {
   867				$this->charset_collation = "DEFAULT CHARACTER SET {$db->charset}";
   868			}
   869	
   870			// Collation
   871			if ( ! empty( $db->collate ) ) {
   872				$this->charset_collation .= " COLLATE {$db->collate}";
   873			}
   874		}
   875	
   876		/**
   877		 * Set the database version for the table.
   878		 *
   879		 * @since 1.0.0
   880		 *
   881		 * @param mixed $version Database version to set when upgrading/creating
   882		 */
   883		private function set_db_version( $version = '' ) {
   884	
   885			// If no version is passed during an upgrade, use the current version
   886			if ( empty( $version ) ) {
   887				$version = $this->version;
   888			}
   889	
   890			// Update the DB version
   891			$this->is_global()
   892				? update_network_option( get_main_network_id(), $this->db_version_key, $version )
   893				:         update_option(                        $this->db_version_key, $version );
   894	
   895			// Set the DB version
   896			$this->db_version = $version;
   897		}
   898	
   899		/**
   900		 * Get the table version from the database.
   901		 *
   902		 * @since 1.0.0
   903		 */
   904		private function get_db_version() {
   905			$this->db_version = $this->is_global()
   906				? get_network_option( get_main_network_id(), $this->db_version_key, false )
   907				:         get_option(                        $this->db_version_key, false );
   908		}
   909	
   910		/**
   911		 * Delete the table version from the database.
   912		 *
   913		 * @since 1.0.0
   914		 */
   915		private function delete_db_version() {
   916			$this->db_version = $this->is_global()
   917				? delete_network_option( get_main_network_id(), $this->db_version_key )
   918				:         delete_option(                        $this->db_version_key );
   919		}
