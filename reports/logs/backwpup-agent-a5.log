   243		/**
   244		 * Return whether this table needs an upgrade.
   245		 *
   246		 * @since 1.0.0
   247		 *
   248		 * @param mixed $version Database version to check if upgrade is needed
   249		 *
   250		 * @return bool True if table needs upgrading. False if not.
   251		 */
   252		public function needs_upgrade( $version = false ) {
   253	
   254			// Use the current table version if none was passed
   255			if ( empty( $version ) ) {
   256				$version = $this->version;
   257			}
   258	
   259			// Get the current database version
   260			$this->get_db_version();
   261	
   262			// Is the database table up to date?
   263			$is_current = version_compare( $this->db_version, $version, '>=' );
   264	
   265			// Return false if current, true if out of date
   266			return ( true === $is_current )
   267				? false
   268				: true;
   269		}
