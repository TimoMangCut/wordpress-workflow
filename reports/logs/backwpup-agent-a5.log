   347								$range[] = $i;
   348							}
   349						}
   350						if ( 'hours' === $cronarraykey ) {
   351							for ( $i = 0; $i <= 23; $i = $i + $step ) {
   352								$range[] = $i;
   353							}
   354						}
   355						if ( 'mday' === $cronarraykey ) {
   356							for ( $i = $step; $i <= 31; $i = $i + $step ) {
   357								$range[] = $i;
   358							}
   359						}
   360						if ( 'mon' === $cronarraykey ) {
   361							for ( $i = $step; $i <= 12; $i = $i + $step ) {
   362								$range[] = $i;
   363							}
   364						}
   365						if ( 'wday' === $cronarraykey ) {
   366							for ( $i = 0; $i <= 6; $i = $i + $step ) {
