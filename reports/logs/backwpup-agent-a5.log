   331							$step = 5;
   332						}
   333						$range = [];
   334	
   335						for ( $i = $first; $i <= $last; $i = $i + $step ) {
   336							$range[] = $i;
   337						}
   338						$cron[ $cronarraykey ] = array_merge( $cron[ $cronarraykey ], $range );
