   663		/** Upgrades **************************************************************/
   664	
   665		/**
   666		 * Upgrade this database table.
   667		 *
   668		 * @since 1.0.0
   669		 *
   670		 * @return bool
   671		 */
   672		public function upgrade() {
   673	
   674			// Get pending upgrades
   675			$upgrades = $this->get_pending_upgrades();
   676	
   677			// Bail if no upgrades
   678			if ( empty( $upgrades ) ) {
   679				$this->set_db_version();
   680	
   681				// Return, without failure
   682				return true;
   683			}
   684	
   685			// Default result
   686			$result = false;
   687	
   688			// Try to do the upgrades
   689			foreach ( $upgrades as $version => $callback ) {
   690	
   691				// Do the upgrade
   692				$result = $this->upgrade_to( $version, $callback );
   693	
   694				// Bail if an error occurs, to avoid skipping upgrades
   695				if ( ! $this->is_success( $result ) ) {
   696					return false;
   697				}
   698			}
   699	
   700			// Success/fail
   701			return $this->is_success( $result );
   702		}
   703	
   704		/**
   705		 * Return array of upgrades that still need to run.
   706		 *
   707		 * @since 1.1.0
   708		 *
   709		 * @return array Array of upgrade callbacks, keyed by their db version.
   710		 */
   711		public function get_pending_upgrades() {
   712	
   713			// Default return value
   714			$upgrades = array();
   715	
   716			// Bail if no upgrades, or no database version to compare to
   717			if ( empty( $this->upgrades ) || empty( $this->db_version ) ) {
   718				return $upgrades;
   719			}
   720	
   721			// Loop through all upgrades, and pick out the ones that need doing
   722			foreach ( $this->upgrades as $version => $callback ) {
   723				if ( true === version_compare( $version, $this->db_version, '>' ) ) {
   724					$upgrades[ $version ] = $callback;
   725				}
   726			}
   727	
   728			// Return
   729			return $upgrades;
   730		}
   731	
   732		/**
   733		 * Upgrade to a specific database version.
   734		 *
   735		 * @since 1.0.0
   736		 *
   737		 * @param mixed  $version  Database version to check if upgrade is needed
   738		 * @param string $callback Callback function or class method to call
   739		 *
   740		 * @return bool
   741		 */
   742		public function upgrade_to( $version = '', $callback = '' ) {
   743	
   744			// Bail if no upgrade is needed
   745			if ( ! $this->needs_upgrade( $version ) ) {
   746				return false;
   747			}
   748	
   749			// Allow self-named upgrade callbacks
   750			if ( empty( $callback ) ) {
   751				$callback = $version;
   752			}
   753	
   754			// Is the callback... callable?
   755			$callable = $this->get_callable( $callback );
   756	
   757			// Bail if no callable upgrade was found
   758			if ( empty( $callable ) ) {
   759				return false;
   760			}
   761	
   762			// Do the upgrade
   763			$result  = call_user_func( $callable );
   764			$success = $this->is_success( $result );
   765	
   766			// Bail if upgrade failed
   767			if ( true !== $success ) {
   768				return false;
   769			}
   770	
   771			// Set the database version to this successful version
   772			$this->set_db_version( $version );
   773	
   774			// Return success
   775			return true;
   776		}
