   351		public function exists() {
   352	
   353			// Get the database interface
   354			$db = $this->get_db();
   355	
   356			// Bail if no database interface is available
   357			if ( empty( $db ) ) {
   358				return false;
   359			}
   360	
   361			// Query statement
   362			$query    = "SHOW TABLES LIKE %s";
   363			$like     = $db->esc_like( $this->table_name );
   364			$prepared = $db->prepare( $query, $like );
   365			$result   = $db->get_var( $prepared );
