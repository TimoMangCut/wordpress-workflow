   301	        $response = $this->post(
   302	            'contacts',
   303	            $args
   304	        );
   305	
   306	        if ( is_wp_error( $response ) ) {
   307	            do_action( 'hostinger_reach_imports_contact_failed' );
   308	
   309	            return $this->handle_wp_error( $response );
   310	        }
   311	
   312	        do_action( 'hostinger_reach_contacts_imported', count( $contacts ), $group );
   313	
   314	        return $this->handle_response( $response );
   315	    }
