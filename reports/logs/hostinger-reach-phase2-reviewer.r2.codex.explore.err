   145	            'hostinger_reach_ui_tooltip_ctor_info'                    => __( 'Click-to-open rate tells you what percent of opens resulted in a click too. A good CTOR is 6-17%, depending on your industry.', 'hostinger-reach' ),
   146	            'hostinger_reach_forms_modal_title'                       => __( 'Select page', 'hostinger-reach' ),
