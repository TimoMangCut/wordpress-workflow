   317	    public function post_webhook_event( array $webhook_payload ): WP_REST_Response {
   318	        if ( ! $this->get_connection_status_handler() ) {
   319	            $this->api_key_manager->clear_token();
   320	
   321	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action' ) );
   322	        }
   323	
   324	        if ( ! isset( $webhook_payload['name'] ) ) {
   325	            return $this->handle_wp_error( new WP_Error( 'Bad request', 'Missing parameter [name] in the WebHook data' ) );
   326	        }
   327	
   328	        if ( ! isset( $webhook_payload['contact']['email'] ) ) {
   329	            return $this->handle_wp_error( new WP_Error( 'Bad request', 'Missing parameter [contact.email] in the WebHook data' ) );
   330	        }
   331	
   332	        $webhook_payload['timestamp'] = gmdate( 'Y-m-d\TH:i:s\Z' );
   333	
   334	        $response = $this->post(
   335	            'webhooks',
   336	            $webhook_payload
   337	        );
   338	
   339	        if ( is_wp_error( $response ) ) {
   340	            return $this->handle_wp_error( $response );
   341	        }
   342	
   343	        return $this->handle_response( $response );
   344	    }
   345	
   346	    public function get_tags_handler(): WP_REST_Response {
   347	        if ( ! $this->get_connection_status_handler() ) {
   348	            $this->api_key_manager->clear_token();
   349	
   350	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action', array( 'status' => 403 ) ) );
   351	        }
   352	
   353	        $response = $this->get( 'tags' );
   354	
   355	        if ( is_wp_error( $response ) ) {
   356	            return $this->handle_wp_error( $response );
   357	        }
   358	
   359	        return $this->handle_response( $response );
   360	    }
   361	
   362	    public function post_tags_handler( WP_REST_Request $request ): WP_REST_Response {
   363	        $nonce = $request->get_header( 'X-WP-Nonce' );
   364	        if ( ! wp_verify_nonce( $nonce, 'wp_rest' ) || ! $this->get_connection_status_handler() ) {
   365	            $this->api_key_manager->clear_token();
   366	
   367	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action', array( 'status' => 403 ) ) );
   368	        }
   369	
   370	        $names = $request->get_param( 'names' );
   371	        if ( empty( $names ) ) {
   372	            return $this->handle_wp_error( new WP_Error( 'names_empty', 'Names parameter cannot be empty.' ) );
   373	        }
   374	
   375	        $response = $this->post(
   376	            'tags',
   377	            array(
   378	                'names' => $names,
   379	            )
   380	        );
   381	
   382	        if ( is_wp_error( $response ) ) {
   383	            return $this->handle_wp_error( $response );
   384	        }
   385	
   386	        return $this->handle_response( $response );
   387	    }
   388	
   389	    private function parse_contact( array $data ): array {
   390	        $contact = array(
   391	            'email' => sanitize_email( $data['email'] ),
   392	        );
   393	
   394	        if ( ! empty( $data['name'] ) ) {
   395	            $contact['name'] = $data['name'];
   396	        }
   397	
   398	        if ( ! empty( $data['surname'] ) ) {
   399	            $contact['surname'] = $data['surname'];
   400	        }
   401	
   402	        $metadata = $data['metadata'] ?? array();
   403	        if ( ! is_array( $metadata ) ) {
   404	            $metadata = array();
   405	        }
   406	
   407	        // phpcs:ignore WordPress.WP.CapitalPDangit.MisspelledInText -- Internal metadata key.
   408	        $metadata['platform'] = 'wordpress';
   409	
   410	        if ( ! isset( $metadata['plugin'] ) ) {
   411	            $metadata['plugin'] = ReachFormIntegration::INTEGRATION_NAME;
   412	        }
   413	
   414	        $contact['metadata'] = $metadata;
   415	
   416	        return $contact;
   417	    }
   418	
   419	    private function set_api_base_name(): void {
   420	        if ( $this->get_functions()->is_staging() ) {
   421	            $this->hostinger_auth_url = 'https://auth.hostinger.dev/login';
   422	            $this->reach_domain       = 'https://reach.hostinger.dev/';
   423	        } else {
   424	            $this->hostinger_auth_url = 'https://auth.hostinger.com/login';
   425	            $this->reach_domain       = 'https://reach.hostinger.com/';
   426	        }
   427	
   428	        $this->api_base_name = $this->reach_domain . 'api/public/v1/';
   429	    }
   430	
   431	    private function get_tag_ids( string $tag_names, string $group_name ): array {
   432	        if ( empty( $tag_names ) && empty( $group_name ) ) {
   433	            return array();
   434	        }
   435	
   436	        $tag_names = explode( ',', $tag_names );
   437	        $tag_ids   = array();
   438	        $handler   = $this->get_tags_handler();
   439	        $tags_data = $handler->get_data();
   440	        $tags      = $tags_data['data'] ?? array();
   441	
   442	        foreach ( $tags as $tag ) {
   443	            if ( in_array( $tag['value'], $tag_names, true ) || $tag['value'] === $group_name ) {
   444	                $tag_ids[] = $tag['uuid'];
   445	            }
   446	        }
   447	
   448	        return $tag_ids;
   449	    }
   450	
   451	    private function create_tag_from_group( string $group ): string {
   452	        if ( empty( $group ) ) {
   453	            return '';
   454	        }
   455	
   456	        $response = $this->post(
   457	            'tags',
   458	            array(
   459	                'names' => array( $group ),
   460	            )
   461	        );
   462	
   463	        if ( is_wp_error( $response ) ) {
   464	            return '';
   465	        }
   466	
   467	        $body = wp_remote_retrieve_body( $response );
   468	        $body = json_decode( $body, true );
   469	        return $body['data'][0]['uuid'] ?? '';
   470	    }
   471	}

