   291	        $contacts = array();
   292	        foreach ( $contacts_data as $contact_data ) {
   293	            $contacts[] = $this->parse_contact( $contact_data );
   294	        }
   295	
   296	        $args = array(
   297	            'groupName' => $group,
   298	            'contacts'  => $contacts,
   299	        );
