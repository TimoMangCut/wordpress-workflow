+        "source_anchor": "src/Admin/Notices/AddFormNotice.php:43",
+        "sink_anchor": "src/Admin/Notices/AddFormNotice.php:59",
+        "auth_required": "authenticated user with a valid nonce from the AddFormNotice admin UI",
+        "vuln_type": "Missing capability check on authenticated AJAX notice action",
+        "severity": "low",
+        "patchstack_eligible": false,
