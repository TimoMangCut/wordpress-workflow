   418	function kubio_get_installed_theme() {
   419		$themes       = wp_get_themes();
   420		$kubio_themes = array( 'kubio', 'elevate-wp' );
   421		$intersect    = array_values( array_intersect( array_keys( $themes ), $kubio_themes ) );
