   143		private function remove_deleted_items( $items, $menu_id ) {
   144			$menu_items     = wp_get_nav_menu_items( $menu_id );
   145			$menu_items_ids = array_map(
   146				function ( $item ) {
   147					return $item->ID;
   148				},
   149				$menu_items
   150			);
   151	
   152			if ( ! is_array( $menu_items_ids ) ) {
   153				return;
   154			}
   155	
   156			$current_ids = array_map(
   157				function ( $items ) {
   158					return intval( $items->id );
   159				},
   160				$items
   161			);
   162	
   163			foreach ( $menu_items_ids as $menu_items_id ) {
   164				if ( ! in_array( $menu_items_id, $current_ids ) ) {
   165					wp_delete_post( $menu_items_id, true );
   166				}
   167			}
   168		}
   169	
   170		private function items_list_to_tree( $items, $parent = null ) {
   171			$parent_id = $parent ? $parent->id : 0;
   172			if ( ! $parent ) {
   173				$parent = array(
   174					'children' => array(),
   175				);
   176			}
   177	
   178			$children = array();
   179	
   180			foreach ( $items as $item ) {
   181				if ( $item->parent === $parent_id ) {
   182					$children[] = (object) array(
   183						'item'     => $item,
   184						'children' => $this->items_list_to_tree( $items, $item ),
   185					);
   186				}
   187			}
   188	
   189			return $children;
   190		}
   191	
   192		private function update_menu_items( $items, $menu_id, $parent_id = 0 ) {
   193	
   194			foreach ( $items as $item ) {
   195				$children = $item->children;
   196				$item     = $item->item;
   197				$id       = $item->id > 0 ? $item->id : 0;
   198				$args     = (array) $item;
   199	
   200				$id = wp_update_nav_menu_item(
   201					$menu_id,
   202					$id,
   203					array(
   204						'menu-item-type'      => $args['type'],
   205						'menu-item-object-id' => $args['objectId'],
   206						'menu-item-object'    => $args['object'],
   207						'menu-item-position'  => $args['order'],
   208						'menu-item-title'     => $args['label'],
   209						'menu-item-url'       => $args['url'] ? $args['url'] : '#',
   210						'menu-item-target'    => $args['target'],
   211						'menu-item-status'    => 'publish',
   212						'menu-item-parent-id' => $parent_id,
   213					)
   214				);
   215	
   216				$this->update_menu_items( $children, $menu_id, $id );
   217			}
   218		}
   219	
   220		private function get_menu_items( $term_id ) {
   221	
   222			$menu_items = wp_get_nav_menu_items( $term_id );
   223			$items      = array();
   224	
   225			if ( ! is_array( $menu_items ) ) {
   226				return $menu_items;
   227			}
   228	
   229			$orders        = array();
   230			$order         = 0;
   231			$processed_ids = array();
   232			foreach ( $menu_items as $item ) {
   233				$item_id = intval( $item->ID );
   234	
   235				if ( in_array( $item_id, $processed_ids ) ) {
   236					continue;
   237				}
   238	
   239				++$order;
   240				$orders[ $item_id ] = $order;
   241				$processed_ids[]    = $item_id;
   242	
   243				foreach ( $menu_items as $item2 ) {
   244					$item2_id = intval( $item2->ID );
   245					if ( in_array( $item2_id, $processed_ids ) ) {
   246						continue;
   247					}
   248	
   249					$parent_id = intval( $item2->menu_item_parent );
   250					if ( $parent_id && $parent_id === $item_id ) {
   251						++$order;
   252						$orders[ $item2_id ] = $order;
   253						$processed_ids[]     = $item2_id;
   254					}
   255				}
   256			}
   257	
   258			foreach ( $menu_items as $item ) {
   259				/** @type object $item */
   260				$items[] = (object) array(
   261					'id'       => intval( $item->ID ),
   262					'parent'   => intval( $item->menu_item_parent ),
   263					'label'    => $item->title,
   264					'url'      => $item->url,
   265					'target'   => $item->target,
   266					'object'   => $item->object,
   267					'type'     => $item->type,
   268					'objectId' => intval( $item->object_id ),
   269					// used for initial load
   270					'order'    => $orders[ intval( $item->ID ) ],
   271				);
   272			}
   273	
   274			return $items;
   275		}
