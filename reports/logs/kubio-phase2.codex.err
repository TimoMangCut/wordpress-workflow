   120			! method_exists( '\FloatingContact\Features\Widgets\FCWidget', 'updateParams' )
   121		) {
   122			wp_send_json_error(__('Required class or functions are missing', 'kubio'), 400);
   123		}
   124	
   125		try {
   126			$id = $request->get_param( 'widgetId' );
   127			$params = $request->get_param( 'params' );
   128			$phoneNr = LodashBasic::get($params, 'phone.phoneNr');
   129			$whatsappNr = LodashBasic::get($params, 'whatsapp.phoneNr');
   130			$widgetParams = [
   131				'phone' => [
   132					'phoneNr' => $phoneNr
   133				],
   134				'whatsapp' => [
   135					'phoneNr' => $whatsappNr
   136				]
   137			];
   138			ob_start();
   139			try {
   140				$widget = \FloatingContact\Features\Widgets\FCWidget::findById($id);
   141	
   142				if(!$widget) {
   143					wp_send_json_error(__('Widget not found', 'kubio'), 404);
   144				}
   145				$widget->updateParams($widgetParams);
   146	
   147				wp_send_json_success();
