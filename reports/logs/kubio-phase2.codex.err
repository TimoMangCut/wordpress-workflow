   277		/**
   278		 * @param WP_REST_Request $request
   279		 *
   280		 * @return array|WP_Error|WP_REST_Response
   281		 */
   282		public function get_item( $request ) {
   283			$id = intval( $request->get_param( 'id' ) );
   284	
   285			if ( $id <= 0 ) {
   286				return $this->new_menu( $request );
   287			}
   288	
   289			$location = $request->get_param( 'location' );
   290			$menu     = wp_get_nav_menu_object( $id );
   291	
   292			return array(
   293				'id'       => $id,
   294				'location' => $location,
   295				'data'     => json_encode(
   296					array(
   297						'blocks' => false,
   298						'menu'   => $menu,
   299						'items'  => $this->get_menu_items( $id ),
   300					)
   301				),
   302			);
   303		}
   304	
   305		private function new_menu( $request ) {
   306			$id       = intval( $request->get_param( 'id' ) );
   307			$location = $request->get_param( 'location' );
   308			$label    = $request->get_param( 'label' );
   309			$label    = $label ? $label : 'New Menu';
   310	
   311			$term_base = array(
   312				'name'     => $label,
   313				'taxonomy' => 'nav_menu',
   314				'parent'   => 0,
   315			);
   316	
   317			return array(
   318				'id'       => $id,
   319				'location' => $location,
   320				'data'     => json_encode(
   321					array(
   322						'blocks' => false,
   323						'menu'   => array_merge(
   324							$term_base,
   325							array(
   326								'slug' => wp_unique_term_slug( sanitize_title( $label ), (object) $term_base ),
   327							)
   328						),
   329						'items'  => array(),
   330					)
   331				),
   332			);
   333		}
