   184	function kubio_get_template_part_id_by_slug( $slug ) {
   185		$stylesheet          = get_stylesheet();
   186		$template_part_query = new WP_Query(
   187			array(
   188				'post_type'      => 'wp_template_part',
   189				'post_status'    => array( 'publish' ),
   190				'post_name__in'  => array( $slug ),
   191				'posts_per_page' => 1,
   192				'no_found_rows'  => true,
   193				// phpcs:ignore WordPress.DB.SlowDBQuery.slow_db_query_tax_query
   194				'tax_query'      => array(
   195					array(
   196						'taxonomy' => 'wp_theme',
   197						'field'    => 'name',
   198						'terms'    => array( $stylesheet ),
   199					),
   200				),
   201			)
   202		);
   203	
   204		return $template_part_query->have_posts() ? $template_part_query->next_post()->ID : null;
   205	}
