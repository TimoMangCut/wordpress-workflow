   339		public function set_menu_to_location( $request ) {
   340			$location = $request->get_param( 'location' );
   341			$id       = $request->get_param( 'id' );
   342	
   343			$locations              = get_nav_menu_locations();
   344			$locations[ $location ] = $id;
   345			set_theme_mod( 'nav_menu_locations', $locations );
   346	
   347			return true;
   348		}
   349	}

