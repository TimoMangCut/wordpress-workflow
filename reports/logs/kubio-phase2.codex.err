    71	function kubio_ai_api_generate_images( WP_REST_Request $request ) {
    72		$image_generate = new Kubio\Ai\KubioImageGenerate();
    73		$image_style    = Kubio\Ai\KubioImagePrompts::parse_style_and_type( $request['imageType'], $request['imageStyle'] );
    74		$data           = array(
    75			'width'        => intval( $request['imageSize'][0] ),
    76			'height'       => intval( $request['imageSize'][1] ),
    77			'samples'      => $request['numberOfImages'],
    78			'style_preset' => $image_style['style_preset'],
    79			'sampler'      => 'K_DPMPP_2M',
    80			'steps'        => 50,
    81			'cfg_scale'    => 14,
    82		);
    83	
    84		$response = $image_generate->samples(
    85			$data,
    86			array( $request['imagePrompt'], $image_style['image_prompt'] )
    87		);
    88	
    89		return $response;
    90	}
    91	
    92	function kubio_ai_api_image_variations( WP_REST_Request $request ) {
    93		$image_generate = new Kubio\Ai\KubioImageGenerate();
    94		$image          = new Kubio\Ai\KubioImageManager();
    95		$image_style    = Kubio\Ai\KubioImagePrompts::parse_style_and_type( $request['imageType'], $request['imageStyle'] );
    96	
    97		$data = array(
    98			'samples'        => $request['numberOfImages'],
    99			'style_preset'   => $image_style['style_preset'],
   100			'image_strength' => 0.35,
   101			'init_image'     => $image->get_file_contents( $request['currentSelectedImage'] ),
   102		);
   103	
   104		return $image_generate->variations(
   105			$data,
   106			array( $request['imagePrompt'], $image_style['image_prompt'] )
   107		);
   108	}
   109	
   110	function kubio_ai_api_image_mask( WP_REST_Request $request ) {
   111		$image_generate = new Kubio\Ai\KubioImageGenerate();
   112		$image          = new Kubio\Ai\KubioImageManager();
   113	
   114		$data = array(
   115			'samples'     => 1,
   116			'mask_source' => 'MASK_IMAGE_BLACK',
   117			'mask_image'  => $request['maskImage'],
   118			'init_image'  => $image->get_file_contents( $request['currentSelectedImage'] ),
   119		);
   120	
   121		return $image_generate->mask(
   122			$data,
   123			$request['imagePrompt']
   124		);
   125	}
   126	
   127	function kubio_ai_search_images( WP_REST_Request $request ) {
