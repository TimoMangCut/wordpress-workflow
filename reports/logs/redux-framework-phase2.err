   552			 *
   553			 * @since       1.0.0
   554			 * @access      private
   555			 * @return      void
   556			 */
   557			private function download_schemes() {
   558				if ( ! Redux_Rate_Limiter::check( 'color_schemes' ) ) {
   559					wp_die( 'Rate limit exceeded. Please try again later.' );
   560				}

