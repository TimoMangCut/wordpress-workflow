   252			/**
   253			 * Adds the appropriate mime types to WordPress
   254			 *
   255			 * @param array $existing_mimes Mine array.
   256			 *
   257			 * @return array
   258			 */
   259			public function custom_upload_mimes( array $existing_mimes = array() ): array {
   260				$existing_mimes['ttf']   = 'font/ttf';
   261				$existing_mimes['otf']   = 'font/otf';
   262				$existing_mimes['eot']   = 'application/vnd.ms-fontobject';
   263				$existing_mimes['woff']  = 'application/font-woff';
   264				$existing_mimes['woff2'] = 'application/font-woff2';
   265				$existing_mimes['svg']   = 'image/svg+xml';
   266				$existing_mimes['zip']   = 'application/zip';
   267	
   268				return $existing_mimes;
   269			}
