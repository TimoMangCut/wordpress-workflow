   255					case 'AuthorURI':
   256						// If you ultimately print this inside an href, escape at that final context instead.
   257						// Here we assume the plain text output of the URL.
   258						return esc_url( $value );
   259	
   260					default:
   261						return esc_html( $value );
   262				}
   263			}
