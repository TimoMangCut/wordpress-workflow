6513761)),color-stop(100%,rgb(227.1055045872,89.4926605505,80.1944954128))) !important;background-image:-webkit-linear-gradient(top,rgb(232.0183486239,118.6422018349,110.9816513761),rgb(227.1055045872,89.4926605505,80.1944954128)) !important;background-image:-linear-gradient(top,rgb(232.0183486239,118.6422018349,110.9816513761),rgb(227.1055045872,89.4926605505,80.1944954128)) !important;filter:progid:DXImageTransform.Microsoft.gradient(startColorstr="rgb(232.0183486239, 118.6422018349, 110.9816513761)",endColorstr="rgb(227.1055045872, 89.4926605505, 80.1944954128)",GradientType=0) !important}#redux-footer #redux-share a{color:#e14d43}#redux-footer #redux-share a:hover{color:rgb(163.8532110092,34.8623853211,26.1467889908)}
