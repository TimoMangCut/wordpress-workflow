   252			/**
   253			 * Delete widget area.
   254			 */
   255			public function redux_delete_widget_area_area() {
   256				if ( ! is_user_logged_in() && ! is_admin() && ! current_user_can( $this->parent->args['page_permissions'] ) ) {
   257					wp_die( esc_html__( 'You do not have permission to perform this action.', 'redux-framework' ) );
   258				}
   259	
   260				if ( isset( $_POST ) && isset( $_POST['_wpnonce'] ) && wp_verify_nonce( sanitize_key( wp_unslash( $_POST['_wpnonce'] ) ), 'delete-redux-widget_area-nonce' ) ) {
   261					if ( isset( $_POST['name'] ) && ! empty( sanitize_text_field( wp_unslash( $_POST['name'] ) ) ) ) {
   262						$name               = sanitize_text_field( wp_unslash( $_POST['name'] ) );
   263						$this->widget_areas = $this->get_widget_areas();
   264						$key                = array_search( $name, $this->widget_areas, true );
   265	
   266						if ( $key >= 0 ) {
   267							unset( $this->widget_areas[ $key ] );
   268							$this->save_widget_areas();
   269						}
   270	
   271						echo 'widget_area-deleted';
   272					}
   273				}
   274	
   275				die();
   276			}
