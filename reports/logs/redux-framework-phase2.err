   399	
   400				// Add to (and/or create) JSON scheme file.
   401				Redux_Color_Scheme_Functions::set_scheme_data( 'Default', $data );
   402	
   403				// Set default scheme.
   404				Redux_Color_Scheme_Functions::set_current_scheme_id( 'Default' );
