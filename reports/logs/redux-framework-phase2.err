   197				Redux_Color_Scheme_Functions::$parent = $this->parent;
   198	
   199				// Prep storage.
   200				$upload_dir = Redux_Color_Scheme_Functions::$upload_dir;
   201	
   202				// Set upload_dir cookie.
   203				setcookie( 'redux_color_scheme_upload_dir', $upload_dir, 0, '/' );
   204	
   205				return $data;
   206			}
