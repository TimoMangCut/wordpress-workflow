   877			/**
   878			 * Render Order Detail Form HTML.
   879			 *
   880			 * @param array $attributes Array of block attributes.
   881			 *
   882			 * @since 1.6.15
   883			 */
   884			public function render_html( $attributes ) {
   885	
   886				$advanced_classes = Cartflows_Gb_Helper::get_instance()->generate_advanced_setting_classes( $attributes );
   887				$zindex_wrap = $advanced_classes[ 'zindex_wrap'];
   888	
   889				$main_classes = array(
   890					'cf-block-' . $attributes['block_id'],
   891					$advanced_classes[ 'desktop_class'],
   892					$advanced_classes[ 'tab_class'],
   893					$advanced_classes[ 'mob_class'],
   894					$advanced_classes[ 'zindex_extention_enabled'] ? 'uag-blocks-common-selector' : '',
   895				);
   896	
   897				if ( isset( $attributes['className'] ) ) {
   898					$main_classes[] = $attributes['className'];
   899				}
   900	
   901				$classes = array(
   902					'wpcf__order-detail-form',
   903				);
   904	
   905				$this->dynamic_option_filters( $attributes );
   906	
   907				ob_start();
   908	
   909				?>
   910					<div class = "<?php echo esc_attr( implode( ' ', $main_classes ) ); ?>" style="<?php echo esc_html( implode( '', $zindex_wrap ) ); ?>">
   911						<div class = "<?php echo esc_attr( implode( ' ', $classes ) ); ?>">
   912							<?php echo do_shortcode( '[cartflows_order_details]' ); ?>
   913						</div>
   914					</div>
   915					<?php
   916	
   917					return ob_get_clean();
   918			}
   919	
   920			/**
   921			 * Dynamic options of elementor and add filters.
   922			 *
   923			 * @param array $attributes Array of block attributes.
   924			 *
   925			 * @since 1.6.15
   926			 */
   927			public function dynamic_option_filters( $attributes ) {
   928	
   929				self::$settings = $attributes;
   930	
   931				if ( ! empty( self::$settings['thanyouText'] ) ) {
   932	
   933					add_filter(
   934						'cartflows_thankyou_meta_wcf-tq-text',
   935						function( $text ) {
   936	
   937							$text = self::$settings['thanyouText'];
   938	
   939							return $text;
   940						},
   941						10,
   942						1
   943					);
   944				}
   945	
   946	
   947				if ( ! empty( self::$settings['layout'] ) ) {
   948	
   949					add_filter(
   950						'cartflows_thankyou_meta_wcf-tq-layout',
   951						function( $text ) {
   952	
   953							$text = self::$settings['layout'];
   954	
   955							return $text;
   956						},
   957						10,
   958						1
   959					);
   960				}

