   150		public function restore_cart_data() {
   151	
   152			global $post;
   153	
   154			$active_checkout = isset( $_COOKIE[ CARTFLOWS_ACTIVE_CHECKOUT ] ) ? intval( $_COOKIE[ CARTFLOWS_ACTIVE_CHECKOUT ] ) : false; // phpcs:ignore WordPressVIPMinimum.Variables.RestrictedVariables.cache_constraints___COOKIE
   155	
   156			if ( $post && $post->ID && $active_checkout ) {
   157	
   158				$checkout_id = $post->ID;
   159	
   160				if ( $checkout_id !== $active_checkout ) {
   161	
   162					$user_key = WC()->session->get_customer_id();
   163	
   164					$cart_data = get_transient( 'wcf_user_' . $user_key . '_checkout_' . $checkout_id );
   165	
   166					if ( $cart_data ) {
   167						WC()->cart->empty_cart();
   168	
   169						foreach ( $cart_data as $key => $item ) {
   170							WC()->cart->add_to_cart( $item['product_id'], $item['quantity'], $item['variation_id'], $item['variation'], $item );
   171						}
   172	
   173						$expiration_time = 30;
   174						// Need to update the active checkout id.
   175						setcookie( CARTFLOWS_ACTIVE_CHECKOUT, $checkout_id, time() + $expiration_time * MINUTE_IN_SECONDS, '/', COOKIE_DOMAIN, CARTFLOWS_HTTPS, true ); //phpcs:ignore WordPressVIPMinimum.Functions.RestrictedFunctions.cookies_setcookie
   176	
   177						// Prepare the cart data with cart item key. Need to update in product options.
   178						add_filter( 'woocommerce_update_order_review_fragments', array( $this, 'prepare_required_cart_data' ), 10, 1 );
   179	
   180					}
   181				}
   182			}
   183		}
