   681		 * Gets subtotal - subtotal is shown before discounts, but with localised taxes.
   682		 *
   683		 * @param int $order order.
   684		 * @return float
   685		 */
   686		public function get_subtotal_to_display( $order ) {
   687			$tax_display = get_option( 'woocommerce_tax_display_cart' );
   688			$subtotal    = (float) $order->get_subtotal();
   689		
   690			if ( 'incl' === $tax_display ) {
   691				$subtotal_taxes = 0;
   692				foreach ( $order->get_items() as $item ) {
   693					$subtotal_taxes += wc_round_tax_total( (float) $item->get_subtotal_tax() );
   694				}
   695				$subtotal += $subtotal_taxes;
   696			}
   697		
   698			return $subtotal;
   699		}
   700	}

