   475				$notice_out  = '<p class="woocommerce-notice">' . __( 'WooCommerce functions do not exist. If you are in an IFrame, please reload it.', 'cartflows' ) . '</p>';
   476				$notice_out .= '<button onClick="location.reload()">' . __( 'Click Here to Reload', 'cartflows' ) . '</button>';
   477	
   478				return $notice_out;
   479			}
   480	
   481			$atts = shortcode_atts(
   482				array(
   483					'id' => 0,
   484				),
   485				$atts
   486			);
   487	
   488			$checkout_id = intval( $atts['id'] );
   489			
   490			$show_checkout_demo = false;
   491	
   492			if ( is_admin() ) {
   493	
   494				$show_checkout_demo = apply_filters( 'cartflows_show_demo_checkout', false );
   495	
   496				if ( $show_checkout_demo && 0 === $checkout_id && isset( $_POST['id'] ) ) { //phpcs:ignore WordPress.Security.NonceVerification.Missing
   497					$checkout_id = intval( $_POST['id'] ); //phpcs:ignore WordPress.Security.NonceVerification.Missing
   498				}
   499			}
   500			if ( empty( $checkout_id ) ) {
   501	
   502				if ( ! _is_wcf_checkout_type() && false === $show_checkout_demo ) {
   503	
   504					$error_html  = '<h4>' . __( 'Checkout ID not found', 'cartflows' ) . '</h4>';
   505					$error_html .= '<p>' . sprintf(
   506						/* translators: %1$1s, %2$2s Link to article */
   507						__( 'It seems that this is not the CartFlows Checkout page where you have added this shortcode. Please refer to this %1$1sarticle%2$2s to know more.', 'cartflows' ),
   508						'<a href="https://cartflows.com/docs/resolve-checkout-id-not-found-error/?utm_source=dashboard&utm_medium=free-cartflows&utm_campaign=docs" target="_blank">',
   509						'</a>'
   510					) . '</p>';
   511	
   512					return $error_html;
   513				}
   514	
   515				global $post;
   516	
   517				$checkout_id = intval( $post->ID );
   518			}
   519	
   520			$output = '';
   521	
   522			ob_start();
   523	
   524			do_action( 'cartflows_checkout_form_before', $checkout_id );
   525	
   526			$checkout_layout = wcf()->options->get_checkout_meta_value( $checkout_id, 'wcf-checkout-layout' );
   527	
   528			$template_default = CARTFLOWS_CHECKOUT_DIR . 'templates/embed/checkout-template-simple.php';
   529	
   530			$template_layout = apply_filters( 'cartflows_checkout_layout_template', $checkout_layout );
   531	
   532			if ( file_exists( $template_layout ) ) {
   533				include $template_layout;
   534			} else {
   535				include $template_default;
   536			}
   537	
   538			$output .= ob_get_clean();
   539	
   540			return $output;
   541		}
