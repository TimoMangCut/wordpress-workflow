   334		 *
   335		 * @param string $product_name product name.
   336		 * @param object $cart_item cart item.
   337		 * @param string $cart_item_key cart item key.
   338		 * @return string
   339		 */
   340		public function modify_order_review_item_summary( $product_name, $cart_item, $cart_item_key ) {
   341	
   342			if ( wp_doing_ajax() && isset( $_GET['wcf_checkout_id'] ) ) { // phpcs:ignore WordPress.Security.NonceVerification.Recommended
   343	
   344				$checkout_id = _get_wcf_checkout_id();
   345	
   346				if ( ! $checkout_id ) {
   347					$checkout_id = isset( $_GET['wcf_checkout_id'] ) && ! empty( $_GET['wcf_checkout_id'] ) ? intval( wp_unslash( $_GET['wcf_checkout_id'] ) ) : 0; // phpcs:ignore WordPress.Security.NonceVerification.Recommended
   348				}
   349	
   350				if ( ! empty( $checkout_id ) ) {
   351	
   352					$is_remove_product_option = wcf()->options->get_checkout_meta_value( $checkout_id, 'wcf-remove-product-field' );
   353					$show_product_image       = wcf()->options->get_checkout_meta_value( $checkout_id, 'wcf-order-review-show-product-images' );
   354	
   355					$remove_label = '';
   356					$image        = '';
   357	
   358					if ( 'yes' === $is_remove_product_option ) {
   359						$remove_label = apply_filters(
   360							'woocommerce_cart_item_remove_link',
   361							sprintf(
   362								'<a href="#" rel="nofollow" class="wcf-remove-product cartflows-icon cartflows-circle-cross" data-id="%s" data-item-key="%s"></a>',
   363								esc_attr( $cart_item['product_id'] ),
   364								$cart_item_key
   365							),
   366							$cart_item_key
   367						);
   368					}
   369	
   370					if ( 'yes' === $show_product_image ) {
   371	
   372						// Get product object.
   373						$_product = apply_filters( 'woocommerce_cart_item_product', $cart_item['data'], $cart_item, $cart_item_key );
   374	
   375						// Get product thumbnail.
   376						$thumbnail = $_product->get_image();
   377	
   378						// Add wrapper to image and add some css.
   379						$image = '<div class="wcf-product-thumbnail">' . $thumbnail . $remove_label . ' </div>';
   380						$image = apply_filters( 'cartflows_checkout_order_review_item_image', $image, $thumbnail, $remove_label, $cart_item, $checkout_id );
   381					} else {
   382						/**
   383						 * If no product image is enabled but remove_label is enabled
   384						 * then add the remove label outside image's div else blank will be added.
   385						*/
   386						$image = $remove_label;
   387					}
   388	
   389					$product_name = '<div class="wcf-product-image"> ' . $image . ' <div class="wcf-product-name">' . $product_name . '</div></div>';
   390				}
   391			}
   392	
   393			return apply_filters( 'cartflows_checkout_order_review_item_summary', $product_name, $cart_item );
   394		}
