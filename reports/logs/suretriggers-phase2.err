+          "note": "AuthController::save_connection() is reachable on admin_init."
+        },
+        {
+          "file_path": "plugins/suretriggers/src/Controllers/AuthController.php",
+          "line_number": 104,
+          "note": "The handler exits unless sure-trigger-connect-nonce verifies."
+        },
+        {
+          "file_path": "plugins/suretriggers/src/Controllers/AuthController.php",
+          "line_number": 108,
+          "note": "The handler also exits unless current_user_can('administrator')."
+        },
+        {
+          "file_path": "plugins/suretriggers/src/Controllers/AuthController.php",
+          "line_number": 120,
+          "note": "Only after those checks does the code reach SaasApiToken::save() and OptionController::set_option()."
+        }
+      ],
+      "reasoning": {
+        "hypothesis": "Because admin_init is broadly reachable in WordPress, a lower-privileged user might be able to set or reset the OttoKit connection through query parameters.",
+        "trace": "The admin_init handler reads GET parameters, validates the connect nonce at AuthController.php:104-105, validates the administrator capability at AuthController.php:108-109, and only then saves the access key and connected email at AuthController.php:120-123.",
+        "defenses": "Both a valid connect nonce and the administrator role/capability marker are required before any connection-state write occurs.",
+        "refutation": "I traced the nonce source back to Loader::get_localized_array() at Loader.php:515. Although delegated OttoKit viewers can receive UI data, the sink itself still rejects them because save_connection() requires current_user_can('administrator').",
+        "conclusion": "The admin_init path is not a low-privilege connection takeover in the shipped plugin."
+      },
+      "reopen_conditions": "Reopen if a bundled path lets non-admin users satisfy the administrator check or if the connect nonce becomes exposed in a reusable admin context without the corresponding privilege boundary."
