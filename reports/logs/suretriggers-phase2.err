			plugin_dir_url( SURE_TRIGGERS_FILE ) . 'assets/js/st-rating.js',
			[ 'jquery' ],
			defined( 'SURE_TRIGGERS_VER' ) ? SURE_TRIGGERS_VER : '1.0.0',
			true
		);
		
		// Localize script with AJAX URL and nonce.
