    83		/**
    84		 * Create WP Connection.
    85		 * 
    86		 * @param WP_REST_Request $request Request data.
    87		 * @return WP_REST_Response
    88		 */
    89		public function create_wp_connection( $request ) {
    90	
    91			$user_agent     = $request->get_header( 'user-agent' );
    92			$allowed_agents = [ 'OttoKit', 'SureTriggers' ];
    93			if ( ! in_array( $user_agent, $allowed_agents, true ) ) {
    94				return new WP_REST_Response(
    95					[
    96						'success' => false,
    97						'data'    => 'Unauthorized',
    98					],
    99					403
   100				);
   101			}
   102			$params = wp_unslash( $request->get_json_params() );
   103	
   104			$username = isset( $params['wp-username'] ) ? sanitize_user( $params['wp-username'] ) : '';
   105			$password = isset( $params['wp-password'] ) ? $params['wp-password'] : '';
   106	
   107			if ( empty( $username ) || empty( $password ) ) {
   108				return new WP_REST_Response(
   109					[
   110						'success' => false,
   111						'data'    => 'Authentication failed.',
   112					],
   113					401
   114				);
   115			}
   116	
   117			$user = wp_authenticate_application_password( null, $username, $password );
   118	
   119			if ( ! ( $user instanceof \WP_User ) ) {
   120				return new WP_REST_Response(
   121					[
   122						'success' => false,
   123						'data'    => 'Authentication failed.',
   124					],
   125					403
   126				);
   127			}
   128	
   129			if ( ! user_can( $user, 'administrator' ) ) {
   130				return new WP_REST_Response(
   131					[
   132						'success' => false,
   133						'data'    => 'Not allowed to perform this action.',
   134					],
   135					403
   136				);
   137			}
   138	
   139			$connection_status  = isset( $params['connection-status'] ) ? sanitize_text_field( $params['connection-status'] ) : false;
   140			$access_key         = isset( $params['sure-triggers-access-key'] ) ? sanitize_text_field( $params['sure-triggers-access-key'] ) : '';
   141			$connected_email_id = isset( $params['connected_email'] ) ? sanitize_email( $params['connected_email'] ) : '';
   142	
   143			if ( empty( $connection_status ) ) {
   144				return new WP_REST_Response(
   145					[
   146						'success' => false,
   147						'data'    => 'Connection denied.',
   148					],
   149					403
   150				);
   151			}
   152	
   153			if ( empty( $access_key ) ) {
   154				return new WP_REST_Response(
   155					[
   156						'success' => false,
   157						'data'    => 'Invalid access key.',
   158					],
   159					403
   160				);
   161			}       
   162	
   163			$response = self::verify_user_token( $access_key );
   164			if ( empty( $response ) || is_wp_error( $response ) || 200 !== wp_remote_retrieve_response_code( $response ) ) {
   165				return new WP_REST_Response(
   166					[
   167						'success' => false,
   168						'data'    => 'Verification failed.',
   169					],
   170					403
   171				);
   172			}
   173			
   174			SaasApiToken::save( $access_key );
   175			OptionController::set_option( 'connected_email_key', $connected_email_id );
   176	
   177			return new WP_REST_Response(
   178				[
   179					'success' => true,
   180					'data'    => 'Connected successfully.',
   181				],
   182				200
   183			);
   184		}
