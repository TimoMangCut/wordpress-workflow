   389			$nps_form_status = self::get_nps_survey_dismiss_status( strval( $request['plugin_slug'] ) );
   390	
   391			// Add dismiss timespan.
   392			$nps_form_status['dismiss_timespan'] = $request['dismiss_timespan'];
   393	
   394			// Add dismiss date.
   395			$nps_form_status['dismiss_time'] = time();
   396	
   397			// Update dismiss count.
   398			$nps_form_status['dismiss_count'] += 1;
   399			$nps_form_status['dismiss_step']   = $request['current_step'];
   400	
   401			// Dismiss Permanantly.
   402			if ( $nps_form_status['dismiss_count'] >= 2 ) {
   403				$nps_form_status['dismiss_permanently'] = true;
   404			}
   405	
   406			update_option( self::get_nps_id( strval( $request['plugin_slug'] ) ), $nps_form_status );
   407	
   408			wp_send_json_success(
   409				array(
   410					'status' => true,
   411				)
   412			);
   413		}
