// Prevent multiple inclusions of this file.
if ( defined( 'NPS_SURVEY_SCRIPT_LOADED' ) ) {
	return;
}
define( 'NPS_SURVEY_SCRIPT_LOADED', true );

/**
 * Nps_Survey
 */
class Nps_Survey {
	/**
	 * Instance
	 *
	 * @access private
