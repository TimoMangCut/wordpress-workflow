   187				}
   188			}
   189	
   190			$response = array(
   191				'need_shipping' => $needs_shipping,
   192				'msg'           => $msg,
   193				'is_order_bump' => $is_order_bump,
   194				'order_bump_id' => $order_bump_id,
   195			);
   196	
   197			echo wp_json_encode( $response );
   198			wp_die();
   199		}
