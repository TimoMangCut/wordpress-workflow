+      "finding_id": "BWPUP-P2-001",
+      "vuln_type": "Broken Access Control",
+      "minimum_role_capability": "plugin-defined read-only role backwpup_check",
+      "status_transition": "UNCERTAIN -> keep",
+      "original_status": "UNCERTAIN",
+      "verdict_change": "keep",
+      "suggested_field_corrections": {
