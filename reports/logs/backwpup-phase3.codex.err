   124		 */
   125		public static function clsx( ...$classes ) {
   126			return implode( ' ', array_filter( $classes ) );
   127		}
   128	
   129		/**
   130		 * Process backup items.
   131		 *
   132		 * @param array  $items    The list of backup items.
   133		 * @param array  $job_data The job data to merge with each item.
   134		 * @param string $dest     The destination of the backup.
   135		 * @param int    $page     The current page for pagination.
   136		 *
   137		 * @return array The processed items.
   138		 */
   139		public static function process_backup_items( array $items, array $job_data, string $dest, int $page ): array {
   140			array_walk(
   141				$items,
   142				function ( &$item ) use ( $job_data, $dest, $page ) {
   143					$item = array_merge( $item, $job_data, [ 'stored_on' => $dest ] );
   144	
   145					// Parse the filename to get the type of backup.
   146					$filename = pathinfo( $item['filename'] )['filename'];
   147					if ( stripos( $item['filename'], '.tar.gz' ) === strlen( $item['filename'] ) - 7 ) {
   148						$filename = substr( $item['filename'], 0, -7 );
   149					} elseif ( stripos( $item['filename'], '.tar.bz2' ) === strlen( $item['filename'] ) - 8 ) {
   150						$filename = substr( $item['filename'], 0, -8 );
   151					}
   152					$filename_parts = explode( '_', $filename );
   153	
   154					if ( count( $filename_parts ) > 1 ) {
   155						$item['data'] = (array) explode( '-', end( $filename_parts ) );
   156					}
   157	
   158					$local_file      = untrailingslashit( BackWPup::get_plugin_data( 'TEMP' ) ) . "/{$item['filename']}";
   159					$downloadurl     = wp_nonce_url( $item['downloadurl'], 'backwpup_action_nonce' );
   160					$downloadhref    = '#TB_inline?height=300&inlineId=tb_download_file&width=640&height=412';
   161					$downloadtrigger = 'download-backup';
   162	
   163					// Add the download URL and dataset.
   164					$item['dataset-download'] = [
   165						'data-jobid'       => $job_data['id'],
   166						'data-destination' => $dest,
   167						'data-file'        => $item['file'],
   168						'data-local-file'  => $local_file,
   169						'data-nonce'       => wp_create_nonce( 'backwpup_action_nonce' ),
   170						'data-url'         => $downloadurl,
   171						'data-href'        => $downloadhref,
   172					];
   173					$item['download-trigger'] = $downloadtrigger;
   174	
   175					// If the user can restore, add the restore URL.
   176					if ( current_user_can( 'backwpup_restore' ) && ! empty( $item['restoreurl'] ) ) {
   177						$item['dataset-restore'] = [
   178							'label'    => __( 'Restore Backup', 'backwpup' ),
   179							'data-url' => wp_nonce_url(
   180								add_query_arg(
   181									[
   182										'step'             => 1,
   183										'trigger_download' => 1,
   184									],
   185									$item['restoreurl']
   186								),
   187								'restore-backup_' . $job_data['id']
   188							),
   189						];
   190					} elseif ( current_user_can( 'backwpup_restore' ) ) {
   191						$item['dataset-restore'] = [
   192							'label'    => __( 'Restore Backup', 'backwpup' ),
   193							'data-url' => network_admin_url( 'admin.php?page=backwpuprestore' ),
   194						];
   195					}
   196	
   197					// If the user can delete, add the delete URL.
   198					if ( current_user_can( 'backwpup_backups_delete' ) ) {
   199						$item['dataset-delete'] = [
   200							'data-url' => wp_nonce_url(
   201								add_query_arg(
   202									[
   203										'page'          => 'backwpupbackups',
   204										'action'        => 'delete',
   205										'jobdest-top'   => $job_data['id'] . '_' . $dest,
   206										'backupfiles[]' => esc_attr( $item['file'] ),
   207										'paged'         => $page,
   208									],
   209									network_admin_url( 'admin.php' )
   210								),
   211								'bulk-backups'
   212							),
   213						];
   214					}
   215				}
   216			);
   217	
   218			return $items;
   219		}
