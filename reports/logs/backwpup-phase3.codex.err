   193		 */
   194		public function authenticate_cloud( WP_REST_Request $request ) {
   195			$params = $request->get_params();
   196			$html   = '';
   197			$status = 200;
   198			try {
   199				if ( ! isset( $params['cloud_name'] ) ) {
   200					throw new Exception( __( 'No cloud name set.', 'backwpup' ) );
   201				}
   202				$provider = $this->cloud_provider_manager->get_provider( $params['cloud_name'] );
   203				$html     = $provider->authenticate( $request );
   204			} catch ( Exception $e ) {
   205				$html   = $this->helpers_adapter->component(
   206					'alerts/info',
   207					[
   208						'type'    => 'alert',
   209						'font'    => 'xs',
   210						'content' => $e->getMessage(),
   211					]
   212				);
   213				$status = 400;
   214			}
   215			return rest_ensure_response( new \WP_REST_Response( $html, $status ) );
   216		}
