  1777			}
  1778	
  1779			if ( 'runext' === $starttype ) {
  1780				$query_args['_nonce']        = md5( get_site_option( 'backwpup_cfg_jobrunauthkey' ) . $jobid );
  1781				$query_args['doing_wp_cron'] = null;
  1782				if ( ! empty( $authurl ) ) {
