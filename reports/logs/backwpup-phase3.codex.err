   148		/**
   149		 * Starts the backup process.
   150		 *
   151		 * This function is triggered by a WP REST API request to initiate a backup.
   152		 * If a job ID is provided, it will start the backup for that job. Otherwise, it will start the backup for the file job.
   153		 *
   154		 * @param WP_REST_Request $request
   155		 * @return WP_REST_Response|WP_Error|WP_HTTP_Response The response object on success, or WP_Error on failure.
   156		 */
   157		public function start_backup( WP_REST_Request $request ) {
   158			$params = $request->get_params();
   159	
   160			if ( ! empty( $params['first_backup'] ) ) {
   161				if ( false === get_site_transient( 'backwpup_first_backup' ) ) {
   162					set_site_transient( 'backwpup_first_backup', true, HOUR_IN_SECONDS );
   163				} else {
   164					return new WP_REST_Response(
   165						[
   166							'status' => 301,
   167							'url'    => network_admin_url( 'admin.php?page=backwpup' ),
   168						],
   169						200,
   170						[ 'Content-Type' => 'text/json' ]
   171					);
   172				}
   173			}
   174	
   175			$create_backup_now_job = true;
   176			$jobs                  = $this->job_adapter->get_jobs();
   177			foreach ( $jobs as $job ) {
   178				if (
   179					isset( $job['backup_now'] ) && true === $job['backup_now']
   180					&& ! empty( $job['activetype'] )
   181				) {
   182					$create_backup_now_job = false;
   183				}
   184			}
   185	
   186			$jobid = $params['job_id'] ?? false;
   187			if ( $create_backup_now_job && false === $jobid ) {
   188				$jobid = $this->get_job_id_when_no_available_job();
   189			}
   190	
   191			// check temp folder.
   192			$temp_folder_message = $this->file_adapter->check_folder( $this->backwpup_adapter->get_plugin_data( 'TEMP' ), true );
   193			if ( ! empty( $temp_folder_message ) ) {
   194				return new WP_HTTP_Response(
   195					[
   196						'status'  => 500,
   197						'message' => $temp_folder_message,
   198					],
   199					200,
   200					[ 'Content-Type' => 'text/json' ]
   201				);
   202			}
   203	
   204			// check log folder.
   205			$log_folder         = get_site_option( 'backwpup_cfg_logfolder' );
   206			$log_folder         = $this->file_adapter->get_absolute_path( $log_folder );
   207			$log_folder_message = $this->file_adapter->check_folder( $log_folder );
   208			if ( ! empty( $log_folder_message ) ) {
   209				return new WP_HTTP_Response(
   210					[
   211						'status'  => 500,
   212						'message' => $log_folder_message,
   213					],
   214					200,
   215					[ 'Content-Type' => 'text/json' ]
   216				);
   217			}
   218	
   219			// check backup destinations.
   220			$job_types    = $this->backwpup_adapter->get_job_types();
   221			$job_data     = $this->option_adapter->get_job( $jobid );
   222			$creates_file = false;
   223			foreach ( $job_types as $id => $job_type_class ) {
   224				if ( in_array( $id, $job_data['type'], true ) && $job_type_class->creates_file() ) {
   225					$creates_file = true;
   226					break;
   227				}
   228			}
   229			if ( $creates_file ) {
   230				$destinations = 0;
   231				foreach ( $job_data['destinations'] as $dest_key ) {
   232					$dest = $this->backwpup_adapter->get_destination( $dest_key );
   233					if ( ! $dest || ! $dest->can_run( $job_data ) ) {
   234						continue;
   235					}
   236					++$destinations;
   237				}
   238	
   239				if ( ! $destinations ) {
   240					return new WP_HTTP_Response(
   241						[
   242							'status'  => 500,
   243							// translators: %s: Job name.
   244							'message' => sprintf( __( 'No backup destination available for "%s" or properly configured!', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   245						],
   246						200,
   247						[ 'Content-Type' => 'text/json' ]
   248					);
   249				}
   250			}
   251	
   252			// check if wp cron is working.
   253			$current_time    = time() - HOUR_IN_SECONDS;
   254			$next_cron_times = array_keys( _get_cron_array() );
   255			sort( $next_cron_times );
   256			if ( isset( $next_cron_times[0] ) && $next_cron_times[0] < $current_time ) {
   257				\BackWPup_Admin::message( __( 'WP-Cron does not seem to be working properly, because it has not run in the last hour. Please check your server settings.', 'backwpup' ), true );
   258			}
   259	
   260			$this->job_adapter->get_jobrun_url( 'runnow', $jobid );
   261	
   262			sleep( 1 ); // Wait for the job to start.
   263			$start_file_name = trailingslashit( $this->backwpup_adapter->get_plugin_data( 'TEMP' ) ) . '.backwpup_job_started';
   264			if ( file_exists( $start_file_name ) ) {
   265				wp_delete_file( $start_file_name );
   266			} else {
   267				return new WP_HTTP_Response(
   268					[
   269						'status'  => 500,
   270						'message' => __( 'The backup process could not be started! Please try to contact our support.', 'backwpup' ),
   271					],
   272					200,
   273					[ 'Content-Type' => 'text/json' ]
   274				);
   275			}
   276	
   277			if ( file_exists( $this->backwpup_adapter->get_plugin_data( 'running_file' ) ) ) {
   278				return new WP_HTTP_Response(
   279					[
   280						'status'  => 200,
   281						// translators: %s: Job name.
   282						'message' => sprintf( __( 'Job "%s" started.', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   283					],
   284					200,
   285					[ 'Content-Type' => 'text/json' ]
   286				);
   287			}
   288	
   289			return new WP_HTTP_Response(
   290				[
   291					'status'  => 201,
   292					// translators: %s: Job name.
   293					'message' => sprintf( __( 'Job "%s" executed.', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   294				],
   295				200,
   296				[ 'Content-Type' => 'text/json' ]
   297			);
   298		}
   299	
   300		/**
   301		 * Start backup process for when jobs are deleted
   302		 *
   303		 * @return int
   304		 */
   305		private function get_job_id_when_no_available_job(): int {
   306			$job_id = get_site_option( 'backwpup_backup_now_job_id', 0 );
   307			if ( $job_id < 1 ) {
   308				$job_id = $this->option_adapter->next_job_id();
   309				update_site_option( 'backwpup_backup_now_job_id', $job_id );
   310				$this->option_adapter->update( $job_id, 'type', $this->job_types_adapter->get_type_job_both() );
   311			}
   312	
   313			$this->backup_now_default_values( $job_id, true );
   314	
   315			return $job_id;
   316		}
   317	
   318		/**
   319		 * Generate backup default values
   320		 *
   321		 * @param int  $next_job_id The next job id.
   322		 * @param bool $backup_now Check if it's a temp job or back up now.
   323		 *
   324		 * @return void
   325		 */
   326		private function backup_now_default_values( int $next_job_id, bool $backup_now = false ): void {
   327			$backup_now_job_values = [
   328				'jobid'              => $next_job_id,
   329				'name'               => 'Backup Now',
   330				'destinations'       => [ 'FOLDER' ],
   331				'activetype'         => '',
   332				'backupsyncnodelete' => false,
   333				'tempjob'            => true,
   334			];
   335	
   336			if ( $backup_now ) {
   337				$backup_now_job_values['tempjob']    = false;
   338				$backup_now_job_values['backup_now'] = true;
   339			}
   340	
   341			$default_values                    = $this->option_adapter->defaults_job();
   342			$default_destination_folder_values = $this->backwpup_adapter->get_destination( 'FOLDER' )->option_defaults();
   343	
   344			$bwp_job_values = array_merge( $default_values, $default_destination_folder_values, $backup_now_job_values );
   345	
   346			foreach ( $bwp_job_values as $key => $value ) {
   347				$this->option_adapter->update( $next_job_id, $key, $value );
   348			}
   349		}
   350	
   351		/**
   352		 * Process bulk actions.
   353		 *
   354		 * @param WP_REST_Request $request The REST request object containing the parameters.
   355		 *
   356		 * @return WP_REST_Response The response object containing the status and message.
   357		 *
   358		 * @throws Exception If an error occurs during the process.
   359		 */
   360		public function process_bulk_actions( WP_REST_Request $request ): \WP_REST_Response {
   361			$params   = $request->get_params();
   362			$response = [
   363				'success' => [],
   364				'errors'  => [],
   365			];
   366			$action   = $params['action'];
   367			switch ( $action ) {
   368				case 'delete':
   369					$backups = $params['backups'];
   370					foreach ( $backups as $backup ) {
   371						try {
   372							$this->delete_backup( $backup );
   373							$response['success'][] = $backup;
   374						} catch ( Exception $e ) {
   375							$response['errors'][] = [
   376								'backup' => $backup,
   377								'error'  => $e->getMessage(),
   378							];
   379						}
   380					}
   381					$response['message'] = __( 'Bulk action processed.', 'backwpup' );
   382					break;
   383			}
   384	
   385			return rest_ensure_response( $response );
   386		}
   387	
   388		/**
   389		 * Delete a single backup.
   390		 *
   391		 * @param array $backup The backup data.
   392		 *
   393		 * @throws Exception If an error occurs during deletion.
   394		 */
   395		private function delete_backup( $backup ) {
   396			if ( empty( $backup['dataset']['data-url'] ) ) {
   397				throw new Exception( __( 'Invalid backup data.', 'backwpup' ) ); // @phpcs:ignore
   398			}
   399	
   400			// Parse the dataset URL.
   401			$query = wp_parse_url( $backup['dataset']['data-url'], PHP_URL_QUERY );
   402			parse_str( $query, $params );
   403	
   404			// Validate required params.
   405			if ( empty( $params['jobdest-top'] ) || empty( $params['backupfiles'] ) ) {
   406				throw new Exception( __( 'Missing required parameters.', 'backwpup' ) ); // @phpcs:ignore
   407			}
   408	
   409			$jobdest = sanitize_text_field( $params['jobdest-top'] );
   410			$file    = esc_attr( $params['backupfiles'][0] ); // Handle array format.
   411	
   412			[$jobid, $dest] = explode( '_', $jobdest );
   413			$dest_class     = $this->backwpup_adapter->get_destination( $dest );
   414	
   415			if ( ! $dest_class ) {
   416				throw new Exception( __( 'Invalid destination class.', 'backwpup' ) ); // @phpcs:ignore
   417			}
   418	
   419			// Perform the deletion.
   420			$dest_class->file_delete( $jobdest, $file );
   421	
   422			/**
   423			 * Fires after deleting backups.
   424			 *
   425			 * @param array $params['backupfiles'] Backup file deleted.
   426			 * @param string $dest Destination.
   427			 */
   428			do_action( 'backwpup_after_delete_backups', $params['backupfiles'], $dest );
   429		}
   430	}

