   255		/**
   256		 * Save and test the cloud connection.
   257		 *
   258		 * @param WP_REST_Request $request
   259		 * @throws Exception If the cloud name is not set or the cloud is not found.
   260		 * @return \WP_REST_Response The response object containing the HTML content and status.
   261		 */
   262		public function cloud_save_and_test( WP_REST_Request $request ) {
   263			$params = $request->get_params();
   264	
   265			$return = [];
   266			$status = 200;
   267			try {
   268				if ( ! isset( $params['cloud_name'] ) || '' === $params['cloud_name'] ) {
   269					throw new Exception( __( 'Cloud not set', 'backwpup' ) );
   270				}
   271				$cloud = $this->backwpup_adapter->get_destination( $params['cloud_name'] );
   272				if ( null === $cloud ) {
   273					throw new Exception( __( 'Cloud not found', 'backwpup' ) );
   274				}
   275				// If no job ID is set, it's from onboarding so we use only the first back job id.
   276				if ( ! isset( $params['job_id'] ) || '' === $params['job_id'] ) {
   277					$first_backup_job_id = get_site_option( Plugin::FIRST_JOB_ID, false );
   278					if ( false === $first_backup_job_id ) {
   279						throw new Exception( __( 'Files job not found', 'backwpup' ) );
   280					}
   281					$jobs = [
   282						$first_backup_job_id,
   283					];
   284				} else {
   285					$jobs = [ $params['job_id'] ];
   286				}
   287	
   288				$should_be_connected = true;
   289				if ( isset( $params['delete_auth'] ) && 'true' === $params['delete_auth'] ) {
   290					$should_be_connected = false;
   291				}
   292				$cloud->edit_form_post_save( $jobs );
   293				if ( $should_be_connected !== $cloud->can_run( $this->option_adapter->get_job( $jobs[0] ) ) ) {
   294					throw new Exception( __( 'Connection failed', 'backwpup' ) );
   295				}
   296				$return['message']   = __( 'Connection successful', 'backwpup' );
   297				$return['connected'] = $should_be_connected;
   298			}
   299			catch ( Exception $e ) {
   300				$return['error'] = $e->getMessage();
   301				$status          = 422;
   302			}
   303	
   304			return rest_ensure_response( new \WP_REST_Response( $return, $status ) );
   305		}
