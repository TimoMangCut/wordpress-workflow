   373		/**
   374		 * Update job.
   375		 *
   376		 * @param WP_REST_Request $request The request object.
   377		 *
   378		 * @return WP_REST_Response
   379		 * @throws Exception If the job title update fails.
   380		 */
   381		public function update_job( WP_REST_Request $request ): WP_REST_Response {
   382			$params = $request->get_params();
   383			$return = [];
   384			$status = 200;
   385	
   386			try {
   387				if ( isset( $params['job_id'] ) && isset( $params['activ'] ) ) {
   388					$job_id = $params['job_id'];
   389					$activ  = $params['activ'];
   390	
   391					if ( ! $activ ) {
   392						$this->job_adapter->disable_job( $job_id );
   393						$next_backup_label = __( 'No backup scheduled', 'backwpup' );
   394					} else {
   395						$this->job_adapter->enable_job( $job_id );
   396						$this->job_adapter->schedule_job( $job_id );
   397						$cron_next         = $this->cron_adapter->cron_next( $this->option_adapter->get( $job_id, 'cron' ) );
   398						$next_backup_label = sprintf(
   399							__( '%1$s at %2$s', 'backwpup' ), // phpcs:ignore WordPress.WP.I18n.MissingTranslatorsComment
   400							wp_date( get_option( 'date_format' ), $cron_next ),
   401							wp_date( get_option( 'time_format' ), $cron_next )
   402						);
   403					}
   404	
   405					$return['message'] = $next_backup_label;
   406				} else {
   407					if ( isset( $params['job_id'] ) && 0 !== $params['job_id'] && isset( $params['storage_destinations'] ) ) {
   408						$jobs = [ $params['job_id'] ];
   409					} else {
   410						$first_job_id = get_site_option( Plugin::FIRST_JOB_ID, false );
   411						if ( false === $first_job_id ) {
   412							throw new Exception( __( 'First job not found', 'backwpup' ) );
   413						}
   414						$jobs = [ $first_job_id ];
   415					}
   416					foreach ( $jobs as $a_job ) {
   417						$this->option_adapter->update( $a_job, 'destinations', $params['storage_destinations'] );
   418					}
   419					$return['message'] = __( 'Backup updated.', 'backwpup' );
   420				}
   421			} catch ( Exception $e ) {
   422				$status          = 500;
   423				$return['error'] = $e->getMessage();
   424			}
   425	
   426			return rest_ensure_response( $return );
   427		}
