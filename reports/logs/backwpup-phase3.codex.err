    85		/**
    86		 * Registers the REST API routes for the Backups API.
    87		 *
    88		 * This method is responsible for defining the endpoints and their
    89		 * corresponding callbacks for the Backups API within the BackWPup Pro plugin.
    90		 *
    91		 * @return void
    92		 */
    93		public function register_routes(): void {
    94			register_rest_route(
    95				'backwpup/v1',
    96				'/startbackup',
    97				[
    98					'methods'             => 'POST',
    99					'callback'            => [ $this, 'start_backup' ],
   100					'permission_callback' => [ $this, 'has_permission' ],
   101					'args'                => [
   102						'job_id'       => [
   103							'required'          => false,
   104							'validate_callback' => function ( $param ) {
   105								return is_numeric( $param ) && $param > 0;
   106							},
   107							'sanitize_callback' => 'absint',
   108						],
   109						'first_backup' => [
   110							'required'          => false,
   111							'validate_callback' => function ( $param ) {
   112								return filter_var( $param, FILTER_VALIDATE_BOOLEAN );
   113							},
   114							'sanitize_callback' => function ( $param ) {
   115								return filter_var( $param, FILTER_VALIDATE_BOOLEAN );
   116							},
   117						],
   118					],
   119				]
   120			);
   121	
   122			register_rest_route(
   123				'backwpup/v1',
   124				'/process_bulk_actions',
   125				[
   126					'methods'             => 'POST',
   127					'callback'            => [ $this, 'process_bulk_actions' ],
   128					'permission_callback' => [ $this, 'has_permission' ],
   129					'args'                => [
   130						'action'  => [
   131							'required'          => true,
   132							'validate_callback' => function ( $param ) {
   133								return in_array( $param, [ 'delete' ], true );
   134							},
   135							'sanitize_callback' => 'sanitize_text_field',
   136						],
   137						'backups' => [
   138							'required'          => true,
   139							'validate_callback' => function ( $param ) {
   140								return is_array( $param ) && ! empty( $param );
   141							},
   142						],
   143					],
   144				]
   145			);
   146		}
