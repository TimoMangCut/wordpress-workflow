   142		/**
   143		 * Check if the cloud is authenticated.
   144		 *
   145		 * @param WP_REST_Request $request The request object.
   146		 * @throws Exception If the cloud name is not set.
   147		 * @throws Exception If there is no backup job.
   148		 * @return WP_HTTP_Response
   149		 */
   150		public function cloud_is_authenticated( WP_REST_Request $request ) {
   151			$params = $request->get_params();
   152			$status = 200;
   153			try {
   154				if ( ! isset( $params['job_id'] ) || '' === $params['job_id'] ) {
   155					$job_id = get_site_option( Plugin::FIRST_JOB_ID, false );
   156					if ( false === $job_id ) {
   157						throw new Exception( __( 'No backup jobs set.', 'backwpup' ) );
   158					}
   159				} else {
   160					$job_id = $params['job_id'];
   161				}
   162				if ( ! isset( $params['cloud_name'] ) ) {
   163					throw new Exception( __( 'No cloud name set.', 'backwpup' ) );
   164				}
   165				$provider = $this->cloud_provider_manager->get_provider( $params['cloud_name'] );
   166				$html     = $provider->is_authenticated( $job_id );
   167			} catch ( Exception $e ) {
   168				$html   = $this->helpers_adapter->component(
   169					'alerts/info',
   170					[
   171						'type'    => 'alert',
   172						'font'    => 'xs',
   173						'content' => $e->getMessage(),
   174					]
   175				);
   176				$status = 500;
   177			}
   178			return new WP_HTTP_Response( $html, $status, [ 'Content-Type' => 'text/html' ] );
   179		}
