   130		 * @param WP_REST_Request $request The REST API request object containing parameters.
   131		 *
   132		 * @return WP_REST_Response The response object containing the backups HTML or an error message.
   133		 *
   134		 * The function performs the following steps:
   135		 * - Retrieves pagination parameters (`page` and `length`) from the request.
   136		 * - Fetches job IDs and iterates through each job to gather backup data.
   137		 * - Processes backup items for each destination associated with a job.
   138		 * - Ensures backups are unique by filtering duplicates based on `stored_on` and `filename`.
   139		 * - Sorts backups by their timestamp in descending order.
   140		 * - Paginates the backups based on the provided `page` and `length` parameters.
   141		 * - Generates HTML for the backups table rows and includes a hidden input for the total number of backups.
   142		 * - Returns a JSON response with the generated HTML or an error message if no backups are found.
   143		 *
   144		 * @throws \WP_Error If there is an issue with the request or processing backups.
   145		 */
   146		public function get_backups_list( WP_REST_Request $request ) {
   147			$params                  = $request->get_params();
   148			$page                    = empty( $params['page'] ) ? 1 : $params['page'];
   149			$length                  = empty( $params['length'] ) ? 10 : $params['length'];
   150			$jobs_ids                = $this->option_adapter->get_job_ids();
   151			$backups                 = [];
   152			$registered_destinations = $this->get_registered_destinations();
   153	
   154			foreach ( $jobs_ids as $a_job_id ) {
   155				$job = $this->option_adapter->get_job( $a_job_id );
   156				if ( ! $job ) {
   157					continue;
   158				}
   159				$dests    = $job['destinations'] ?? [];
   160				$job_data = [
   161					'id'       => $a_job_id,
   162					'name'     => $job['name'],
   163					'type'     => $job['activetype'],
   164					'data'     => [ 'Unknown' ],
   165					'logfile'  => $job['logfile'],
   166					'last_run' => $job['lastrun'] ?? null,
   167				];
   168				foreach ( $dests as $dest ) {
   169					if ( empty( $registered_destinations[ $dest ]['class'] ) ) {
   170						continue;
   171					}
   172					$dest_object = $this->backwpup_adapter->get_destination( $dest );
   173					if ( is_array( $dest_object ) ) {
   174						continue;
   175					}
   176					$items   = $dest_object->file_get_list( $a_job_id . '_' . $dest );
   177					$items   = $this->helpers_adapter->process_backup_items( $items, $job_data, $dest, $page );
   178					$backups = array_merge( $backups, $items );
   179				}
   180			}
   181			if ( 0 !== count( $jobs_ids ) ) {
   182				$default_location = $this->backwpup_adapter->get_destination( 'FOLDER' );
   183				if ( ! is_array( $default_location ) ) {
   184					$items   = $default_location->file_get_list();
   185					$items   = $this->helpers_adapter->process_backup_items( $items, $job_data, 'FOLDER', $page );
   186					$backups = array_merge( $backups, $items );
   187				}
   188			}
   189			$unique_backups = [];
   190			foreach ( $backups as $item ) {
   191				$key = $item['stored_on'] . '|' . $item['filename'];
   192				if ( ! isset( $seen[ $key ] ) ) {
   193					$seen[ $key ]     = true;
   194					$unique_backups[] = $item;
   195				}
   196			}
   197			$backups = $unique_backups;
   198			usort(
   199				$backups,
   200				function ( $a, $b ) {
   201					return $b['time'] <=> $a['time'];
   202				}
   203			);
   204	
   205			$backups         = wpm_apply_filters_typed( 'array', 'backwpup_backups_list', $backups );
   206			$nb_totalbackups = count( $backups );
   207			$total_pages     = ceil( $nb_totalbackups / $length );
   208			if ( $page > $total_pages ) {
   209				$page = $total_pages;
   210			}
   211			$start        = $page * $length - $length;
   212			$backups_list = array_slice( $backups, $start, $length );
   213			$html         = '';
   214	
   215			foreach ( $backups_list as $backup ) {
   216				if ( 'wpcron' === $backup['type'] ) {
   217					$backup['type'] = __( 'Scheduled', 'backwpup' );
   218				}
   219				$html .= $this->helpers_adapter->component( 'table-row-backups', [ 'backup' => $backup ], true );
   220			}
   221			$html .= $this->helpers_adapter->component(
   222				'form/hidden',
   223				[
   224					'name'  => 'nb_backups',
   225					'value' => $nb_totalbackups,
   226				],
   227				true
   228			);
   229	
   230			if ( empty( $html ) ) {
   231				return rest_ensure_response(
   232					[
   233						'success' => false,
   234						'data'    => '',
   235						'message' => __( 'No backups found.', 'backwpup' ),
   236						'page'    => 1,
   237					]
   238				);
   239			}
   240	
   241			return rest_ensure_response(
   242				[
   243					'success' => true,
   244					'data'    => $html,
   245					'page'    => $page,
   246				]
   247			);
   248		}
   249	
   250		/**
