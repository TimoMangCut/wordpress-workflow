     3	namespace Hostinger\Reach\Api\Handlers;
     4	
     5	use Hostinger\Reach\Dto\PluginData;
     6	use Hostinger\Reach\Functions;
     7	use Hostinger\Reach\Integrations\ImportManager;
     8	use Hostinger\Reach\Integrations\Integration;
     9	use Hostinger\Reach\Integrations\PluginManager;
    10	use Hostinger\Reach\Integrations\Reach\ReachFormIntegration;
    11	use Hostinger\Reach\Providers\IntegrationsProvider;
    12	use WP_Error;
    13	use WP_REST_Request;
    14	use WP_REST_Response;
    15	
    16	if ( ! defined( 'ABSPATH' ) ) {
    17	    die;
    18	}
    19	
    20	class IntegrationsApiHandler extends ApiHandler {
    21	    public const INTEGRATIONS_OPTION_NAME = 'hostinger_reach_integrations';
    22	
    23	    public PluginManager $plugin_manager;
    24	    public ImportManager $import_manager;
    25	
    26	    public function __construct( Functions $functions, PluginManager $plugin_manager, ImportManager $import_manager ) {
    27	        parent::__construct( $functions );
    28	        $this->plugin_manager = $plugin_manager;
    29	        $this->import_manager = $import_manager;
    30	    }
    31	
    32	    public static function get_integrations(): array {
    33	        return apply_filters( 'hostinger_reach_integrations', IntegrationsProvider::INTEGRATIONS );
    34	    }
    35	
    36	    public function init_hooks(): void {
    37	        add_action( 'init', array( $this, 'trigger_active_integrations' ) );
    38	    }
    39	
    40	    public function trigger_active_integrations(): void {
    41	        do_action( 'hostinger_reach_integrations_loaded', $this->get_integrations_data() );
    42	    }
    43	
    44	    public function is_active( string $integration_name ): bool {
    45	        $data = $this->get_integrations_data();
    46	
    47	        return $data[ $integration_name ][ Integration::INTEGRATION_IS_ACTIVE ] ?? false;
    48	    }
    49	
    50	    public function is_import_enabled( string $integration_name ): bool {
    51	        $data = $this->get_integrations_data();
    52	
    53	        $is_active      = $data[ $integration_name ][ Integration::INTEGRATION_IS_ACTIVE ] ?? false;
    54	        $import_enabled = $data[ $integration_name ][ Integration::INTEGRATION_IMPORT_ENABLED ] ?? false;
    55	
    56	        return $is_active && $import_enabled;
    57	    }
    58	
    59	    public function get_integrations_handler(): WP_REST_Response {
    60	        return $this->handle_response(
    61	            array(
    62	                'response' => array(
    63	                    'code' => 200,
    64	                ),
    65	                'body'     => wp_json_encode( $this->get_integrations_data() ),
    66	            )
    67	        );
    68	    }
    69	
    70	    public function post_integrations_handler( WP_REST_Request $request ): WP_REST_Response {
    71	        $is_active         = $request->get_param( Integration::INTEGRATION_IS_ACTIVE );
    72	        $integration       = $request->get_param( 'integration' );
    73	        $integrations_data = $this->get_integrations_data();
    74	        $integration_data  = $integrations_data[ $integration ] ?? array();
    75	        $has_download_url  = ! empty( $integration_data['download_url'] ?? false );
    76	        $has_download_url  = ! empty( $integration_data['download_url'] ?? false );
    77	        $current_is_active = $integration_data[ Integration::INTEGRATION_IS_ACTIVE ] ?? false;
    78	        $should_update     = ! $is_active || $this->activate_integration( $integration, $has_download_url );
    79	
    80	        if ( $current_is_active === $is_active ) {
    81	            $should_update = false;
    82	        }
    83	
    84	        if ( $should_update ) {
    85	            $this->save_integration( $integration, array( Integration::INTEGRATION_IS_ACTIVE => $is_active ) );
    86	        }
    87	
    88	        return $this->handle_response(
    89	            array(
    90	                'response' => array(
    91	                    'code' => 200,
    92	                ),
    93	            )
    94	        );
    95	    }
    96	
    97	    public function post_import_handler( WP_REST_Request $request ): WP_REST_Response {
    98	        $integrations = $request->get_param( 'integrations' );
    99	        $this->import_manager->import( $integrations );
   100	
   101	        return $this->handle_response(
   102	            array(
   103	                'response' => array(
   104	                    'code' => 200,
   105	                ),
   106	            )
   107	        );
   108	    }
   109	
   110	    public function get_import_handler( WP_REST_Request $request ): WP_REST_Response {
   111	        $integration = $request->get_param( 'integration' );
   112	
   113	        if ( ! $this->is_import_enabled( $integration ) ) {
   114	            return $this->handle_wp_error(
   115	                new WP_Error(
   116	                    'import_not_available',
   117	                    __( 'Importing is not available for this integration', 'hostinger-reach' )
   118	                )
   119	            );
   120	        }
   121	
   122	        $status = $this->import_manager->get_status( $integration );
   123	
   124	        return $this->handle_response(
   125	            array(
   126	                'response' => array(
   127	                    'code' => 200,
   128	                ),
   129	                'body'     => wp_json_encode( $status ),
   130	            )
   131	        );
   132	    }
   133	
   134	    public function activate_integration( string $integration_name, bool $can_install ): bool {
   135	        $integration_class = self::get_integrations()[ $integration_name ];
   136	        if ( ! isset( $integration_class ) ) {
   137	            return false;
   138	        }
   139	
   140	        if ( $can_install ) {
   141	            $installed = $this->plugin_manager->install( $integration_name );
   142	            if ( is_wp_error( $installed ) ) {
   143	                return false;
   144	            }
   145	        }
   146	
   147	        $activated = $this->plugin_manager->activate( $integration_name );
   148	        if ( $activated ) {
   149	            do_action( 'hostinger_reach_integration_activated', $integration_name );
   150	            update_option( Functions::HOSTINGER_REACH_HAS_USER_ACTION, true );
   151	        }
   152	
   153	        return $activated;
   154	    }
   155	
   156	    public function get_integration_data( string $integration_name ): array {
   157	        $integrations_data = get_option( self::INTEGRATIONS_OPTION_NAME, array() );
   158	
   159	        return $integrations_data[ $integration_name ] ?? array();
   160	    }
   161	
   162	    public function get_integrations_data(): array {
   163	        $available_integrations       = self::get_integrations();
   164	        $integrations_state           = get_option( self::INTEGRATIONS_OPTION_NAME, array() );
   165	        $available_integrations_state = array_intersect_key( $integrations_state, $available_integrations );
   166	        $integrations                 = array();
   167	
   168	        foreach ( $available_integrations as $integration_name => $integration_class ) {
   169	            $plugin = $this->plugin_manager->get_plugin( $integration_name );
   170	
   171	            if ( ! $plugin instanceof PluginData ) {
   172	                continue;
   173	            }
   174	
   175	            $is_hostinger_reach                = $integration_name === ReachFormIntegration::INTEGRATION_NAME;
   176	            $integrations[ $integration_name ] = $plugin->to_array();
   177	            $is_active_by_default              = $integrations[ $integration_name ][ Integration::INTEGRATION_IS_ACTIVE ] ?? false;
   178	            $is_plugin_active                  = $is_hostinger_reach || $this->plugin_manager->is_active( $integration_name );
   179	            $is_integration_active             = $available_integrations_state[ $integration_name ][ Integration::INTEGRATION_IS_ACTIVE ] ?? $is_active_by_default;
   180	            $is_active                         = $is_plugin_active && $is_integration_active;
   181	            $import_enabled                    = $integrations[ $integration_name ][ Integration::INTEGRATION_IMPORT_ENABLED ] ?? false;
   182	
   183	            $integrations[ $integration_name ] = array_merge(
   184	                $integrations[ $integration_name ],
   185	                array(
   186	                    'is_plugin_active'                      => $is_plugin_active,
   187	                    Integration::INTEGRATION_IMPORT_ENABLED => $import_enabled,
   188	                    Integration::INTEGRATION_IS_ACTIVE      => $is_hostinger_reach || $is_active,
   189	                    'can_deactivate'                        => ! $is_hostinger_reach,
   190	                    'is_go_to_plugin_visible'               => ! $is_hostinger_reach,
   191	                    'import_status'                         => $this->import_manager->get_status( $integration_name ),
   192	                    'is_installable'                        => $this->plugin_manager->is_installed( $integration_name ) || ! empty( $integrations[ $integration_name ]['download_url'] ),
   193	                )
   194	            );
   195	
   196	        }
   197	
   198	        return $integrations;
   199	    }
   200	
   201	    private function save_integration( string $integration_name, array $data ): bool {
   202	        $integrations_data                      = $this->get_integrations_data();
   203	        $integrations_data[ $integration_name ] = $data;
   204	
   205	        return $this->save_integrations_data( $integrations_data );
   206	    }
   207	
   208	
   209	    private function save_integrations_data( array $data ): bool {
   210	        return update_option( self::INTEGRATIONS_OPTION_NAME, $data );
   211	    }
   212	}

