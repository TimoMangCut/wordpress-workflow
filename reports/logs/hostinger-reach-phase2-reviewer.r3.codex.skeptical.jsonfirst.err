    44	    public function handle_ajax_action(): void {
    45	        if ( ! current_user_can( 'manage_options' ) ) {
    46	            wp_die( -1, 403 );
    47	        }
    48	
    49	        check_ajax_referer( self::NOTICE_ACTION, 'nonce' );
