   202	        $nonce = $request->get_header( 'X-WP-Nonce' );
   203	        if ( ! wp_verify_nonce( $nonce, 'wp_rest' ) ) {
   204	            return false;
   205	        }
   206	
   207	        return true;
   208	    }
