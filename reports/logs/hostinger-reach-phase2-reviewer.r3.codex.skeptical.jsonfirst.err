   134	
   135	    public function init_active_integration( array $integrations ): void {
   136	        $integration_is_active = $integrations[ $this->get_name() ][ self::INTEGRATION_IS_ACTIVE ] ?? false;
   137	
   138	        if ( $integration_is_active ) {
