   227	            $this->api_key_manager->clear_token();
   228	            $this->resource_id_manager->clear_resource_id();
   229	
   230	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action', array( 'status' => 403 ) ) );
   231	        }
   232	
   233	        $response = $this->get( 'overview' );
   234	
   235	        if ( is_wp_error( $response ) ) {
   236	            return $this->handle_wp_error( $response );
   237	        }
   238	
   239	        return $this->handle_response( $response );
   240	    }

