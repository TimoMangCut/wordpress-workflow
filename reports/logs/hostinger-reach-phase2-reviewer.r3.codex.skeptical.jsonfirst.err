plugins/hostinger-reach/frontend/dist/optinmonster.js:1:!function(){const t=window.XMLHttpRequest;t&&(window.XMLHttpRequest=function(){const n=new t;let o="";const e=n.open;n.open=function(t,n){return o=String(n||""),e.apply(this,arguments)};const r=n.send;return n.send=function(t){return function(t){if(!t)return!1;try{const n=new URL(t,window.location.href);return"api.omappapi.com"===n.hostname&&n.pathname.startsWith("/v2/optin/")}catch(t){return!1}}(o)&&function(t,n){if(!n||!window?.hostinger_reach_optinmonster_data?.nonce||!window?.hostinger_reach_optinmonster_data?.restUrl)return;const o=JSON.parse(n);fetch(window.hostinger_reach_optinmonster_data.restUrl,{method:"POST",headers:{"Content-Type":"application/json","X-WP-Nonce":window.hostinger_reach_optinmonster_data.nonce},body:JSON.stringify({...o,formId:t}),credentials:"same-origin"}).catch(function(){console.error("Failed to forward OptinMonster data to Reach")})}(function(t){const n=t.match(/\/optin\/([^/?#]+)/);return n?n[1]:null}(o),t),r.apply(this,arguments)},n},window.XMLHttpRequest.prototype=t.prototype)}();
