     1	<?php
     2	namespace Hostinger\Reach\Api\Handlers;
     3	
     4	use Hostinger\Reach\Functions;
     5	use WP_Error;
     6	use WP_Http;
     7	use WP_REST_Response;
     8	
     9	if ( ! defined( 'ABSPATH' ) ) {
    10	    die;
    11	}
    12	
    13	class ApiHandler {
    14	    private array $default_headers = array();
    15	    protected string $api_base_name;
    16	    private Functions $functions;
    17	
    18	    public function __construct( Functions $functions ) {
    19	        $this->functions = $functions;
    20	    }
    21	
    22	    public function get_functions(): Functions {
    23	        return $this->functions;
    24	    }
    25	
    26	    public function get_api_basename(): string {
    27	        return $this->api_base_name;
    28	    }
    29	
    30	
    31	    public function get_default_headers(): array {
    32	        return $this->default_headers;
    33	    }
    34	
    35	    public function get_generic_error_message(): string {
    36	        return __( 'Something went wrong. Please try again.', 'hostinger-reach' );
    37	    }
    38	
    39	
    40	    public function get( string $endpoint, array $params = array(), array $headers = array(), int $timeout = 120 ): WP_Error|array {
    41	        $url          = $this->get_api_basename() . $endpoint;
    42	        $request_args = array(
    43	            'method'  => 'GET',
    44	            'headers' => array_merge( $this->get_default_headers(), $headers ),
    45	            'timeout' => $timeout,
    46	        );
    47	
    48	        if ( ! empty( $params ) ) {
    49	            $url = add_query_arg( $params, $url );
    50	        }
    51	
    52	        return wp_remote_get( $url, $request_args );
    53	    }
    54	
    55	    public function post( string $endpoint, array $params = array(), array $headers = array(), int $timeout = 120 ): mixed {
    56	        $url          = $this->get_api_basename() . $endpoint;
    57	        $request_args = array(
    58	            'method'  => 'POST',
    59	            'timeout' => $timeout,
    60	            'headers' => array_merge( $this->get_default_headers(), $headers ),
    61	            'body'    => $params,
    62	        );
    63	
    64	        return wp_remote_post( $url, $request_args );
    65	    }
    66	
    67	    public function handle_wp_error( WP_Error $error ): WP_REST_Response {
    68	        $response   = new WP_REST_Response();
    69	        $error_data = $error->get_error_data() ?? array( 'status' => WP_Http::BAD_REQUEST );
    70	        if ( current_user_can( 'manage_options' ) ) {
    71	            $response->set_data( array( 'errors' => $error->get_error_code() ) );
    72	        } else {
    73	            $response->set_data( array( 'errors' => $this->get_generic_error_message() ) );
    74	        }
    75	
    76	        $response->set_status( $error_data['status'] );
    77	        return $response;
    78	    }
    79	
    80	    public function handle_response( array $response ): WP_REST_Response {
    81	        $wp_response = new WP_REST_Response();
    82	        $wp_response->set_status( wp_remote_retrieve_response_code( $response ) );
    83	        $body = wp_remote_retrieve_body( $response );
    84	        $wp_response->set_data( json_decode( $body ? $body : '', true ) );
    85	        return $wp_response;
    86	    }
    87	}

