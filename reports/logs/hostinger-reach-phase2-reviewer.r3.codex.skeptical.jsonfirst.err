   282	    public function post_import_contacts( array $contacts_data ): WP_REST_Response {
   283	        if ( ! $this->get_connection_status_handler() ) {
   284	            $this->api_key_manager->clear_token();
   285	
   286	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action' ) );
   287	        }
   288	
   289	        $group = $contacts_data[0]['metadata']['group'] ?? HOSTINGER_REACH_DEFAULT_CONTACT_LIST;
   290	
   291	        $contacts = array();
   292	        foreach ( $contacts_data as $contact_data ) {
   293	            $contacts[] = $this->parse_contact( $contact_data );
   294	        }
   295	
   296	        $args = array(
   297	            'groupName' => $group,
   298	            'contacts'  => $contacts,
   299	        );
   300	
   301	        $response = $this->post(
   302	            'contacts',
   303	            $args
   304	        );
   305	
   306	        if ( is_wp_error( $response ) ) {
   307	            do_action( 'hostinger_reach_imports_contact_failed' );
   308	
   309	            return $this->handle_wp_error( $response );
   310	        }
   311	
   312	        do_action( 'hostinger_reach_contacts_imported', count( $contacts ), $group );
   313	
   314	        return $this->handle_response( $response );
   315	    }
