   130	
   131			if ( ! wcf()->utils->is_step_post_type() ) {
   132				return;
   133			}
   134	
   135			$compatibiliy = Cartflows_Compatibility::get_instance();
   136	
   137			// Do not redirect for page builder preview.
   138			if ( $compatibiliy->is_page_builder_preview() ) {
   139				return;
   140			}
   141	
   142			global $post;
   143	
   144			if ( is_singular() && ! is_front_page() && get_option( 'page_on_front' ) == $post->ID ) {
   145				wp_safe_redirect( site_url(), 301 );
