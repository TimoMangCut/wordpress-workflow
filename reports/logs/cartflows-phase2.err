   263	
   264			$email_address = isset( $_POST['email'] ) ? sanitize_email( wp_unslash( $_POST['email'] ) ) : false;
   265			$password      = isset( $_POST['password'] ) ? wp_unslash( $_POST['password'] ) : false; // phpcs:disable WordPress.Security.ValidatedSanitizedInput.InputNotSanitized
   266	
   267			$creds = array(
   268				'user_login'    => $email_address,
   269				'user_password' => $password,
   270				'remember'      => false,
   271			);
   272	
   273			$user = wp_signon( $creds, false );
   274	
   275			if ( ! is_wp_error( $user ) ) {
   276	
   277				$response = array(
   278					'success' => true,
   279				);
   280			} else {
   281				$response['error'] = wp_kses_post( $user->get_error_message() );
   282			}
   283	
   284			wp_send_json_success( $response );
   285		}
   286	
   287		/**
   288		 * Handle checkout file upload via AJAX.
   289		 *
   290		 * @since 2.2.2
   291		 * @return void
   292		 */
   293		public function upload_checkout_file() {
   294	
   295			if ( ! check_ajax_referer( 'wcf-file-upload', 'security', false ) ) {
   296				wp_send_json_error(
   297					array( 'error' => __( 'Nonce validation failed.', 'cartflows' ) )
   298				);
   299			}
   300	
   301			if ( empty( $_FILES['wcf_checkout_file']['tmp_name'] ) ) {
   302				wp_send_json_error(
   303					array( 'error' => __( 'No file uploaded.', 'cartflows' ) )
   304				);
   305			}
   306	
   307			if ( ! function_exists( 'wp_handle_upload' ) ) {
   308				require_once ABSPATH . 'wp-admin/includes/file.php';
   309			}
   310	
   311			$file         = $_FILES['wcf_checkout_file']; // phpcs:ignore WordPress.Security.ValidatedSanitizedInput, WordPress.Security.NonceVerification.Missing
   312			$file['name'] = sanitize_file_name( $file['name'] );
   313			$file['ext']  = strtolower( pathinfo( $file['name'], PATHINFO_EXTENSION ) );
   314	
   315			$master_allowed = Cartflows_Helper::get_allowed_file_extensions();
   316	
   317			$restrictions = $this->get_field_restrictions();
   318	
   319			$allowed_extensions = empty( $restrictions['extensions'] )
   320				? $master_allowed
   321				: array_values( array_intersect( $master_allowed, $restrictions['extensions'] ) );
   322	
   323			if ( ! in_array( $file['ext'], $allowed_extensions, true ) ) {
   324				wp_send_json_error( array( 'error' => __( 'File type is not allowed.', 'cartflows' ) ) );
   325			}
   326	
   327			if ( (int) $file['size'] > $restrictions['max_size'] ) {
   328				wp_send_json_error( array( 'error' => __( 'File size exceeds the allowed limit.', 'cartflows' ) ) );
   329			}
   330	
   331			$check = wp_check_filetype_and_ext( $file['tmp_name'], $file['name'], wp_get_mime_types() );
   332	
   333			if ( empty( $check['ext'] ) || $check['ext'] !== $file['ext'] ) {
   334				wp_send_json_error( array( 'error' => __( 'Invalid or corrupted file.', 'cartflows' ) ) );
   335			}
   336	
   337			$result = $this->move_uploaded_file( $file );
   338	
   339			wp_send_json_success(
   340				array(
   341					'success'  => true,
   342					'url'      => esc_url_raw( $result['url'] ),
   343					'filename' => sanitize_file_name( basename( $result['file'] ) ),
   344				)
   345			);
   346		}
   347	
   348		/**
   349		 * Retrieve file size and type restrictions from field settings.
   350		 *
   351		 * @since 2.2.2
   352		 *
   353		 * @return array{max_size:int, extensions:string[]} Field-level upload restrictions.
   354		 */
   355		private function get_field_restrictions() {
   356	
   357			$max_size   = 5 * 1024 * 1024; // 5MB default
   358			$extensions = array();
   359	
   360			$field_key   = empty( $_POST['field_key'] ) ? '' : sanitize_text_field( wp_unslash( $_POST['field_key'] ) ); // phpcs:ignore WordPress.Security.NonceVerification.Missing
   361			$checkout_id = empty( $_POST['checkout_id'] ) ? 0 : absint( $_POST['checkout_id'] ); // phpcs:ignore WordPress.Security.NonceVerification.Missing
   362	
   363			if ( empty( $field_key ) || empty( $checkout_id ) ) {
   364				return compact( 'max_size', 'extensions' );
   365			}
   366	
   367			$field_type   = ( 0 === strpos( $field_key, 'shipping_' ) ) ? 'shipping' : 'billing';
   368			$saved_fields = get_post_meta( $checkout_id, 'wcf_field_order_' . $field_type, true );
   369	
   370			if ( ! is_array( $saved_fields ) || empty( $saved_fields[ $field_key ] ) || ! is_array( $saved_fields[ $field_key ] ) ) {
   371				return compact( 'max_size', 'extensions' );
   372			}
   373	
   374			$custom_attributes = empty( $saved_fields[ $field_key ]['custom_attributes'] ) || ! is_array( $saved_fields[ $field_key ]['custom_attributes'] )
   375				? array()
   376				: $saved_fields[ $field_key ]['custom_attributes'];
   377	
   378			if ( empty( $custom_attributes ) ) {
   379				return compact( 'max_size', 'extensions' );
   380			}
   381	
   382			if ( ! empty( $custom_attributes['file_size'] ) && is_scalar( $custom_attributes['file_size'] ) ) {
   383				$max_size = max( 1, absint( $custom_attributes['file_size'] ) ) * 1024 * 1024;
   384			}
   385	
   386			if ( ! empty( $custom_attributes['accepted_file_types'] ) ) {
   387				$extensions = $this->normalize_extension_list( $custom_attributes['accepted_file_types'] );
   388			}
   389	
   390			return compact( 'max_size', 'extensions' );
   391		}
   392	
   393		/**
   394		 * Normalize accepted file types into a lowercase extension list.
   395		 *
   396		 * @since 2.2.2
   397		 *
   398		 * @param string $raw Raw accepted file types value.
   399		 * @return array Normalized extensions.
   400		 */
   401		private function normalize_extension_list( $raw ) {
   402	
   403			if ( ! is_string( $raw ) || '' === trim( $raw ) ) {
   404				return array();
   405			}
   406	
   407			$extensions = array_map( 'strtolower', array_map( 'trim', explode( ',', $raw ) ) );
   408			
   409			return array_values( array_filter( $extensions ) );
   410		}
   411	
   412		/**
   413		 * Move the uploaded file into the WordPress uploads directory.
   414		 *
   415		 * @since 2.2.2
   416		 *
   417		 * @param array $file Normalized file data.
   418		 * @return array Upload result.
   419		 */
   420		private function move_uploaded_file( array $file ) {
   421	
   422			$upload_dir   = wp_upload_dir();
   423			$file['name'] = wp_unique_filename( $upload_dir['path'], 'wcf_' . wp_generate_uuid4() . '.' . $file['ext'] );
   424	
   425			$result = wp_handle_upload(
   426				$file,
   427				array(
   428					'test_form' => false,
   429					'mimes'     => wp_get_mime_types(),
   430				)
   431			);
   432	
   433			if ( isset( $result['error'] ) ) {
   434				wp_send_json_error(
   435					array( 'error' => esc_html( $result['error'] ) )
   436				);
   437			}
   438	
   439			return $result;
   440		}

