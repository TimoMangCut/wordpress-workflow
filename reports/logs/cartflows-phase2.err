   103		/**
   104		 * Apply coupon on submit of custom coupon form.
   105		 */
   106		public function apply_coupon() {
   107			$response = '';
   108	
   109			if ( ! check_ajax_referer( 'wcf-apply-coupon', 'security', false ) ) {
   110				$response_data = array(
   111					'status' => false,
   112					'error'  => __( 'Nonce validation failed', 'cartflows' ),
   113				);
   114				wp_send_json_error( $response_data );
   115			}
   116	
   117			// Update the billing email before adding a coupon required for coupon conditions.
   118			$this->update_billing_email();
   119	
   120			ob_start();
   121	
   122			if ( ! empty( $_POST['coupon_code'] ) ) {
   123				$result = WC()->cart->add_discount( sanitize_text_field( wp_unslash( $_POST['coupon_code'] ) ) );
   124			} else {
   125				wc_add_notice( WC_Coupon::get_generic_coupon_error( WC_Coupon::E_WC_COUPON_PLEASE_ENTER ), 'error' );
   126			}
   127	
   128			$response = array(
   129				'status' => $result,
   130				'msg'    => wc_print_notices( true ),
   131			);
   132	
   133			ob_clean(); // Clearing the uncessary echo HTML.
   134			wp_send_json( $response );
   135	
   136			die();
   137		}
