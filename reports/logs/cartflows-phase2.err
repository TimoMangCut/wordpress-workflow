          "line_number": 99,
          "note": "`process_update_creds()` requires a valid `stripe-update-creds` nonce."
        },
        {
          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
          "line_number": 114,
          "note": "`process_update_creds()` exits unless `PrliUtils::is_authorized()` is true."
        },
        {
          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
          "line_number": 139,
          "note": "Credential retrieval ignores the request's `pmt` value and instead uses the fixed `PrliStripeConnect::get_method_id()`."
        },
        {
          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
          "line_number": 149,
          "note": "The updated option names are fixed Stripe-related keys such as `prli_stripe_test_secret_key` and `prli_stripe_connect_status`."
        },
        {
          "file_path": "plugins/pretty-link/app/controllers/PrliStripeConnectController.php",
          "line_number": 168,
          "note": "`process_refresh_tokens()` also requires its own nonce and authorized-user check before refreshing or storing tokens."
