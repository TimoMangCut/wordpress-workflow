mod\u00e8le"],"If you are using shortcodes, enable this design settings to apply styles.":["Si vous utilisez des codes courts, activez ces param\u00e8tres de conception pour appliquer les styles."],"Enable Design Settings":["Activer les param\u00e8tres de conception"],"Activate %s":["Activer %s"],"Activating %s":["Activation de %s"],"Successfully Activated!":["Activ\u00e9 avec succ\u00e8s !"],"Failed! Activation!":["\u00c9chec ! Activation !"],"Upgrade to Cartflows Pro":["Mettez \u00e0 niveau vers Cartflows Pro"],"Activate the License":["Activer la licence"],"Step Type: ":["Type d'\u00e9tape :"],"License is required!":["Une licence est requise !"],"Activate the license to modify this offer step's settings":["Activez la licence pour modifier les param\u00e8tres de cette \u00e9tape de l'offre"],"No product Selected":["Aucun produit s\u00e9lectionn\u00e9"],"Once you select the product, they will be displayed here.":["Une fois que vous s\u00e9lectionnez le produit, ils seront affich\u00e9s ici."],"Shipping Rate":["Tarif d'exp\u00e9dition"],"Once you have add product, it will be displayed here.":["Une fois que vous avez ajout\u00e9 un produit, il sera affich\u00e9 ici."],"Coupon will apply on checkout page":["Le coupon sera appliqu\u00e9 sur la page de paiement"],"AND":["ET"],"Please Update the CartFlows Pro to the latest version to use the conditional order bump feature.":["Veuillez mettre \u00e0 jour CartFlows Pro vers la derni\u00e8re version pour utiliser la fonctionnalit\u00e9 de vente incitative conditionnelle."],"Enable conditional order bump ":["Activer l'augmentation de commande conditionnelle"],"By enabling this option, you can create the conditions to display the order bump.":["En activant cette option, vous pouvez cr\u00e9er les conditions pour afficher le compl\u00e9ment de commande."],"Show this order bump if following conditions are true":["Afficher ce compl\u00e9ment de commande si les conditions suivantes sont remplies"],"Add Condition":["Ajouter une condition"],"OR":["OU"],"Add Conditions Group":["Ajouter un groupe de conditions"],"Order Bump Product Image":["Image du produit de l'augmentation de commande"],"Styles":["Styles"],"Conditions":["Conditions"],"Save Changes":["Enregistrer les modifications"],"You have made changes. Do you want to save the changes?":["Vous avez apport\u00e9 des modifications. Voulez-vous enregistrer les modifications ?"],"No product":["Aucun produit"],"Duplicate Order Bump":["Dupliquer l'augmentation de commande"],"Edit Order Bump":["Modifier l'augmentation de commande"],"Trash Order Bump":["Supprimer l'augmentation de commande"],"Do you really want to trash this order bump permanently?":["Voulez-vous vraiment supprimer d\u00e9finitivement ce compl\u00e9ment de commande ?"],"Delete Order Bump":["Supprimer l'augmentation de commande"],"Status":["Statut"],"Actions":["Actions"],"Create an order bump.":["Cr\u00e9er une offre compl\u00e9mentaire."],"Enter order bump name":["Entrez le nom de l'option suppl\u00e9mentaire"],"Please enter the order bump title":["Veuillez entrer le titre de l'augmentation de commande"],"Preview":["Aper\u00e7u"],"View in Full Screen":["Afficher en plein \u00e9cran"],"Exit Full Screen":["Quitter le mode plein \u00e9cran"],"Order Submitted":["Commande soumise"],"Special Offer":["Offre sp\u00e9ciale"],"Order Receipt":["Re\u00e7u de commande"],"Enable Checkout Offer":["Activer l'offre de paiement"],"Dynamic Conditions":["Conditions dynamiques"],"Please Update the CartFlows Pro to the latest version to use the dynamic offers feature.":["Veuillez mettre \u00e0 jour CartFlows Pro vers la derni\u00e8re version pour utiliser la fonctionnalit\u00e9 d'offres dynamiques."],"Enable Dynamic Offers":["Activer les offres dynamiques"],"Redirect to: ":["Rediriger vers :"],"Search for step\u2026":["Rechercher une \u00e9tape\u2026"],"If the following conditions are true":["Si les conditions suivantes sont vraies"],"Add Dynamic Offer":["Ajouter une offre dynamique"],"Search for default step\u2026":["Recherche de l'\u00e9tape par d\u00e9faut\u2026"],"If all of the above conditions failed.":["Si toutes les conditions ci-dessus \u00e9chouaient."],"Label":["\u00c9tiquette"],"ID":["ID"],"Enable":["Activer"],"Add New Field":["Ajouter un nouveau champ"],"Date & Time":["Date et heure"],"Add Custom Field":["Ajouter un champ personnalis\u00e9"],"TextArea":["Zone de texte"],"Number":["Nombre"],"Checkbox":["Case \u00e0 cocher"],"Radio":["Radio"],"Select":["S\u00e9lectionner"],"Hidden":["Cach\u00e9"],"Add To":["Ajouter \u00e0"],"Label %1$s*%2$s":["\u00c9tiquette %1$s*%2$s"],"Field value will store in this meta key. Add field id without prefix like \"billing_\" or \"shipping_\". %s Use \"_\" instead of spaces.":["La valeur du champ sera stock\u00e9e dans cette cl\u00e9 m\u00e9ta. Ajoutez l'identifiant du champ sans pr\u00e9fixe comme \"billing_\" ou \"shipping_\". %s Utilisez \"_\" au lieu des espaces."],"Min Value":["Valeur min"],"Max Value":["Valeur maximale"],"Enter your options separated by (|).":["Entrez vos options s\u00e9par\u00e9es par (|)."],"UnChecked":["Non coch\u00e9"],"Field Input Type":["Type de saisie de champ"],"Date":["Date"],"Time":["Temps"],"Min ":["Min"],"Max ":["Max"],"Show in Email":["Afficher dans l'e-mail"],"Billing Fields":["Champs de facturation"],"Shipping Fields":["Champs d'exp\u00e9dition"],"Delete Field":["Supprimer le champ"],"Are you really want to delete field?":["Voulez-vous vraiment supprimer le champ ?"],"Field Editor":["\u00c9diteur de champ"],"Label is required field":["L'\u00e9tiquette est un champ obligatoire"],"WooCommerce is Required!":["WooCommerce est requis !"],"To modify the %s step options, please install and activate the WooCommerce plugin.":["Pour modifier les options de l'\u00e9tape %s, veuillez installer et activer le plugin WooCommerce."],"Activating\u2026":["Activation\u2026"],"Activated":["Activ\u00e9"],"Funnel Settings":["Param\u00e8tres de l'entonnoir"],"Save Setting":["Enregistrer le param\u00e8tre"],"Disable Store Checkout":["D\u00e9sactiver le passage en caisse du magasin"],"Enable Store Checkout":["Activer le paiement en magasin"],"Edit Title":["Modifier le titre"],"Publish":["Publier"],"Do you really want to publish this funnel?":["Voulez-vous vraiment publier cet entonnoir ?"],"Draft Funnel":["Entonnoir de brouillon"],"Do you really want to draft this funnel?":["Voulez-vous vraiment r\u00e9diger cet entonnoir ?"],"Unique Visits":["Visites uniques"],"Conversion Rate":["Taux de conversion"],"Total number of orders.":["Nombre total de commandes."],"Grand total of all orders.":["Total g\u00e9n\u00e9ral de toutes les commandes."],"Average total of every order.":["Moyenne totale de chaque commande."],"Grand total of all order bumps.":["Total g\u00e9n\u00e9ral de tous les suppl\u00e9ments de commande."],"Export Flow":["Flux d'exportation"],"View Funnel":["Voir l'entonnoir"],"Open Funnel Settings":["Ouvrir les param\u00e8tres de l'entonnoir"],"Delete Store Checkout":["Supprimer le passage en caisse du magasin"],"Do you really want to delete store checkout?%1$1sNOTE: This action cannot be reversed.":["Voulez-vous vraiment supprimer le passage en caisse du magasin ?%1$1sREMARQUE : Cette action ne peut pas \u00eatre annul\u00e9e."],"archived_date":["date_archiv\u00e9e"],"%1$sNote:%2$s The orders which are placed by the admins are not considered while calculating the analytics.":["%1$sRemarque :%2$s Les commandes pass\u00e9es par les administrateurs ne sont pas prises en compte lors du calcul des analyses."],"Reset Analytics":["R\u00e9initialiser les analyses"],"Are you really want to reset funnel analytics?":["Voulez-vous vraiment r\u00e9initialiser l'analyse de l'entonnoir ?"],"Resetting":["R\u00e9initialisation"],"Automation for":["Automatisation pour"],"Create a distraction free, high-converting checkout experience without needing a page builder.":["Cr\u00e9ez une exp\u00e9rience de paiement sans distraction et \u00e0 haute conversion sans avoir besoin d'un constructeur de pages."],"Funnel Steps":["\u00c9tapes de l'entonnoir"],"Add New Step":["Ajouter une nouvelle \u00e9tape"],"No Steps Added.":["Aucune \u00e9tape ajout\u00e9e."],"Seems like there are no steps created or added in this flow":["Il semble qu'aucune \u00e9tape n'ait \u00e9t\u00e9 cr\u00e9\u00e9e ou ajout\u00e9e dans ce flux"],"Add new step":["Ajouter une nouvelle \u00e9tape"],"Select Step Type":["S\u00e9lectionner le type d'\u00e9tape"],"Activating WooCommerce..":["Activation de WooCommerce.."],"Installing WooCommerce..":["Installation de WooCommerce.."],"Successfully Installed!":["Installation r\u00e9ussie !"],"Installation Failed!":["\u00c9chec de l'installation !"],"Import Step":["\u00c9tape d'importation"],"Add multiple steps to your flows today with an upgraded CartFlows plan.":["Ajoutez plusieurs \u00e9tapes \u00e0 vos flux d\u00e8s aujourd'hui avec un plan CartFlows am\u00e9lior\u00e9."],"Get CartFlows Higher Plan":["Obtenez un plan sup\u00e9rieur de CartFlows"],"Add multiple steps to your flows by activating %s.":["Ajoutez plusieurs \u00e9tapes \u00e0 vos flux en activant %s."],"Add %1$s step to your flows by activating %2$s.":["Ajoutez l'\u00e9tape %1$s \u00e0 vos flux en activant %2$s."],"Add unlimited income boosting one-click %s to your flows when you upgrade to our CartFlows Higher plan today.":["Ajoutez des %s en un clic pour augmenter vos revenus de mani\u00e8re illimit\u00e9e \u00e0 vos flux lorsque vous passez \u00e0 notre plan CartFlows Higher d\u00e8s aujourd'hui."],"Add %1$s step to your flow by activating CartFlows license.":["Ajoutez l'\u00e9tape %1$s \u00e0 votre flux en activant la licence CartFlows."],"Access all of our pro templates by activating %s.":["Acc\u00e9dez \u00e0 tous nos mod\u00e8les pro en activant %s."],"Access all of our pro templates when you upgrade your plan to CartFlows Pro today.":["Acc\u00e9dez \u00e0 tous nos mod\u00e8les professionnels lorsque vous passez \u00e0 CartFlows Pro aujourd'hui."],"Get CartFlows Pro":["Obtenez CartFlows Pro"],"Add %1$s step to your flows by activating license.":["Ajoutez l'\u00e9tape %1$s \u00e0 vos flux en activant la licence."],"You need WooCommerce plugin installed and activated to import this step.":["Vous devez avoir le plugin WooCommerce install\u00e9 et activ\u00e9 pour importer cette \u00e9tape."],"Imported! Redirecting\u2026":["Import\u00e9 ! Redirection\u2026"]," Please sync the library and try importing the template again.":["Veuillez synchroniser la biblioth\u00e8que et essayer d'importer \u00e0 nouveau le mod\u00e8le."],"Import Failed! Try again.":["\u00c9chec de l'importation ! R\u00e9essayez."],"Create Step":["Cr\u00e9er une \u00e9tape"],"Creating Step..":["Cr\u00e9ation de l'\u00e9tape.."],"Step Created! Redirecting\u2026":["\u00c9tape cr\u00e9\u00e9e ! Redirection\u2026"],"Failed to Create Step!":["\u00c9chec de la cr\u00e9ation de l'\u00e9tape !"],"Activate license for adding more steps and other features.":["Activez la licence pour ajouter plus d'\u00e9tapes et d'autres fonctionnalit\u00e9s."],"Close the window":["Ferme la fen\u00eatre"],"Name Your Step":["Nommez votre \u00e9tape"],"Step Name":["Nom de l'\u00e9tape"],"Enter Step Name":["Entrez le nom de l'\u00e9tape"],"Learn How":["Apprenez comment"],"Create from Scratch":["Cr\u00e9er \u00e0 partir de z\u00e9ro"],"Step thumbnail image":["Image miniature de l'\u00e9tape"],"Import":["Importer"],"Back":["Retour"],"Sync Library":["Synchroniser la biblioth\u00e8que"],"Importing page %d":["Importation de la page %d"],"Sync Complete":["Synchronisation termin\u00e9e"],"Syncing Library\u2026":["Synchronisation de la biblioth\u00e8que\u2026"],"Library Synced":["Biblioth\u00e8que synchronis\u00e9e"],"Steps Library":["Biblioth\u00e8que des \u00e9tapes"],"Get CartFlows Higher plan":["Obtenez le plan sup\u00e9rieur de CartFlows"],"Activate license for adding more flows and other features.":["Activez la licence pour ajouter plus de flux et d'autres fonctionnalit\u00e9s."],"Importing Step..":["Importation de l'\u00e9tape.."],"Close":["Fermer"],"Error":["Erreur"],"Add unlimited income boosting one-click upsells to your flows by activating %s":["Ajoutez des upsells en un clic pour augmenter vos revenus de mani\u00e8re illimit\u00e9e \u00e0 vos flux en activant %s"],"Add unlimited income boosting one-click upsells to your flows when you upgrade to our CartFlows Plus or Pro plan today.":["Ajoutez des ventes incitatives en un clic pour augmenter vos revenus de mani\u00e8re illimit\u00e9e \u00e0 vos flux lorsque vous passez \u00e0 notre plan CartFlows Plus ou Pro d\u00e8s aujourd'hui."],"Access all of our pro templates by activating %s":["Acc\u00e9dez \u00e0 tous nos mod\u00e8les pro en activant %s"],"Templates for %s":["Mod\u00e8les pour %s"],"Please wait\u2026":["Veuillez patienter\u2026"],"Please wait. Duplicating funnel\u2026":["Veuillez patienter. Duplication de l'entonnoir\u2026"],"Please wait. Drafting funnel\u2026":["Veuillez patienter. Cr\u00e9ation de l'entonnoir\u2026"],"Please wait. Deleting funnel\u2026":["Veuillez patienter. Suppression de l'entonnoir\u2026"],"Please wait. Restoring funnel\u2026":["Veuillez patienter. Restauration de l'entonnoir\u2026"],"Please wait. Exporting\u2026":["Veuillez patienter. Exportation\u2026"],"Please wait. Duplicating step\u2026":["Veuillez patienter. Duplication de l'\u00e9tape\u2026"],"Please wait. Deleting step\u2026":["Veuillez patienter. Suppression de l'\u00e9tape\u2026"],"Please wait. Creating variation\u2026":["Veuillez patienter. Cr\u00e9ation de la variation\u2026"],"Please wait. Archiving variation\u2026":["Veuillez patienter. Archivage de la variation\u2026"],"Please wait. Declaring winner\u2026":["Veuillez patienter. D\u00e9claration du gagnant\u2026"],"Analytics":["Analytique"],"Draft":["Brouillon"],"Name":["Nom"],"Activating":["Activation"],"Failed":["\u00c9chou\u00e9"],"Remove Image":["Supprimer l'image"],"Unlock Premium Features with CartFlows PRO!":["D\u00e9bloquez les fonctionnalit\u00e9s premium avec CartFlows PRO !"],"Get the tools you need to create powerful sales funnels, increase conversions, and grow your business with ease.":["Obtenez les outils dont vous avez besoin pour cr\u00e9er des tunnels de vente puissants, augmenter les conversions et d\u00e9velopper votre entreprise en toute simplicit\u00e9."],"Select a Settings Tab":["S\u00e9lectionnez un onglet Param\u00e8tres"],"Free vs Pro":["Gratuit vs Pro"],"Increase Your Revenue with Smart Order Bumps":["Augmentez vos revenus avec des options de commande intelligentes"],"Boost sales with CartFlows\u2019 Order Bump! Offer personalized add-ons at checkout to increase revenue effortlessly. Quick to set up, no coding needed!":["Boostez les ventes avec l'Order Bump de CartFlows ! Proposez des options personnalis\u00e9es lors du paiement pour augmenter vos revenus sans effort. Rapide \u00e0 configurer, aucune programmation n\u00e9cessaire !"],"Show the Right Offer to the Right People \u2013 Automatically!":["Montrez la bonne offre aux bonnes personnes \u2013 automatiquement !"],"Personalize deals based on location, cart details, and more. Upgrade to CartFlows PRO and unlock this smart feature today!":["Personnalisez les offres en fonction de l'emplacement, des d\u00e9tails du panier et plus encore. Passez \u00e0 CartFlows PRO et d\u00e9bloquez cette fonctionnalit\u00e9 intelligente d\u00e8s aujourd'hui !"],"Boost Sales Instantly with Auto-Applied Coupons!":["Augmentez les ventes instantan\u00e9ment avec des coupons appliqu\u00e9s automatiquement !"],"No codes, no hassle\u2014discounts apply instantly at checkout. Upgrade to CartFlows PRO and start converting more customers today!":["Pas de codes, pas de tracas\u2014les r\u00e9ductions s'appliquent instantan\u00e9ment lors du paiement. Passez \u00e0 CartFlows PRO et commencez \u00e0 convertir plus de clients d\u00e8s aujourd'hui !"],"Give Your Customers More Choices, Boost Your Sales":["Offrez plus de choix \u00e0 vos clients, augmentez vos ventes"],"Make buying easier with flexible product options. Let customers make the right choices from your checkout. Upgrade to CartFlows PRO and start customizing today!":["Facilitez l'achat avec des options de produits flexibles. Laissez les clients faire les bons choix depuis votre caisse. Passez \u00e0 CartFlows PRO et commencez \u00e0 personnaliser d\u00e8s aujourd'hui !"],"Optin Product":["Produit d'adh\u00e9sion"],"Select free & virtual product only. Once you select a product, it will be displayed here.":["S\u00e9lectionnez uniquement un produit gratuit et virtuel. Une fois que vous avez s\u00e9lectionn\u00e9 un produit, il sera affich\u00e9 ici."],"Search for a Free & Virtual Product":["Rechercher un produit gratuit et virtuel"],"Please select a free & virtual product only.":["Veuillez s\u00e9lectionner uniquement un produit gratuit et virtuel."],"Free":["Gratuit"],"A\/B Testing":["Test A\/B"],"Optimize your sales with A\/B testing in CartFlows! Experiment with product pricing, page layouts, messaging, and design. Create variants, analyze results, and discover new ways to boost revenue.":["Optimisez vos ventes avec les tests A\/B dans CartFlows ! Exp\u00e9rimentez avec les prix des produits, les mises en page, les messages et le design. Cr\u00e9ez des variantes, analysez les r\u00e9sultats et d\u00e9couvrez de nouvelles fa\u00e7ons d'augmenter vos revenus."],"Modern Cart":["Chariot moderne"],"Enable Instant Layout":["Activer la disposition instantan\u00e9e"],"Disabled":["D\u00e9sactiv\u00e9"],"upgrading to PRO":["passer \u00e0 PRO"],"activating CartFlows Pro":["activation de CartFlows Pro"],"You're using":["Vous utilisez"],"CartFlows Free":["CartFlows Gratuit"],"To unlock more features, consider":["Pour d\u00e9bloquer plus de fonctionnalit\u00e9s, envisagez"],"Activate CartFlows Pro":["Activer CartFlows Pro"],"You can't edit this step directly because Instant Layout is turned on in the funnel settings. To make design changes, go to the Design tab inside this step's settings.":["Vous ne pouvez pas modifier cette \u00e9tape directement car la mise en page instantan\u00e9e est activ\u00e9e dans les param\u00e8tres de l'entonnoir. Pour apporter des modifications de conception, allez dans l'onglet Design \u00e0 l'int\u00e9rieur des param\u00e8tres de cette \u00e9tape."],"Use this setting to customize the style of the Instant %s Layout.":["Utilisez ce param\u00e8tre pour personnaliser le style de la mise en page Instantan\u00e9e %s."],"Turn this on to set up rules that decide when visitors should be redirected to a special offer or the next step.":["Activez ceci pour d\u00e9finir des r\u00e8gles qui d\u00e9terminent quand les visiteurs doivent \u00eatre redirig\u00e9s vers une offre sp\u00e9ciale ou l'\u00e9tape suivante."],"Your email address can't be edited when using the Modern Checkout Style.":["Votre adresse e-mail ne peut pas \u00eatre modifi\u00e9e lorsque vous utilisez le style de paiement moderne."],"The Company field won't be visible if you're using the Instant Layout Style.":["Le champ Soci\u00e9t\u00e9 ne sera pas visible si vous utilisez le style de mise en page instantan\u00e9e."],"Opt-in":["Participer"],"The product previously added as an Order Bump has been deleted. Please add a new product.":["Le produit pr\u00e9c\u00e9demment ajout\u00e9 en tant que compl\u00e9ment de commande a \u00e9t\u00e9 supprim\u00e9. Veuillez ajouter un nouveau produit."],"Choose a variation":["Choisissez une variation"],"For more information about order bump settings please %1$sClick here.%2$s":["Pour plus d'informations sur les param\u00e8tres de l'augmentation de commande, veuillez %1$scliquer ici.%2$s"],"Sum of all step views in this funnel.":["Somme de toutes les vues d'\u00e9tape dans cet entonnoir."],"Total upsell\/downsell revenue.":["Revenu total des ventes incitatives\/d\u00e9croissantes."],"Revenue per visit.":["Revenu par visite."],"Revenue per unique visitor.":["Revenu par visiteur unique."],"Sandbox Mode":["Mode Sandbox"],"Live Mode":["Mode en direct"],"Learn":["Apprendre"],"File Size (MB)":["Taille du fichier (Mo)"],"Accepted File Types":["Types de fichiers accept\u00e9s"],"Back to Webhooks":["Retour aux webhooks"],"Edit Webhook":["Modifier le webhook"],"Add New Webhook":["Ajouter un nouveau webhook"],"e.g. CRM Integration":["par ex. Int\u00e9gration CRM"],"Endpoint URL":["URL de l'endpoint"],"Events":["\u00c9v\u00e9nements"],"Select events that will trigger this webhook.":["S\u00e9lectionnez les \u00e9v\u00e9nements qui d\u00e9clencheront ce webhook."],"Select All":["Tout s\u00e9lectionner"],"Enabled":["Activ\u00e9"],"Max Retries":["Max. tentatives"],"Number of retry attempts for failed deliveries (0-5).":["Nombre de tentatives de r\u00e9essai pour les livraisons \u00e9chou\u00e9es (0-5)."],"Secret Key":["Cl\u00e9 secr\u00e8te"],"Used to sign webhook payloads (HMAC-SHA256).":["Utilis\u00e9e pour signer les charges utiles du webhook (HMAC-SHA256)."],"Copy to clipboard":["Copier dans le presse-papiers"],"Copied!":["Copi\u00e9 !"],"Please enter a webhook name.":["Veuillez entrer un nom de webhook."],"Please enter a webhook URL.":["Veuillez entrer une URL de webhook."],"Please enter a valid URL.":["Veuillez entrer une URL valide."],"Please select at least one event.":["Veuillez s\u00e9lectionner au moins un \u00e9v\u00e9nement."],"Failed to save webhook.":["\u00c9chec de l'enregistrement du webhook."],"Something went wrong.":["Quelque chose a mal tourn\u00e9."],"Update Webhook":["Mettre \u00e0 jour le Webhook"],"Create Webhook":["Cr\u00e9er un Webhook"],"Webhooks":["Webhooks"],"Send real-time event data to external services when key funnel events occur.":["Envoyer des donn\u00e9es d'\u00e9v\u00e9nements en temps r\u00e9el \u00e0 des services externes lorsque des \u00e9v\u00e9nements cl\u00e9s du funnel se produisent."],"No webhooks configured yet. Click \"Add New Webhook\" to get started.":["Aucun webhook configur\u00e9 pour le moment. Cliquez sur \"Ajouter un nouveau Webhook\" pour commencer."],"URL":["URL"],"Last Delivery":["Derni\u00e8re livraison"],"events":["\u00e9v\u00e9nements"],"Success":["Succ\u00e8s"],"Never triggered":["Jamais d\u00e9clench\u00e9"],"Test sent!":["Test envoy\u00e9 !"],"Send Test":["Envoyer un test"],"Are you sure you want to delete this webhook?":["\u00cates-vous s\u00fbr de vouloir supprimer ce webhook ?"],"Global CSS & Scripts":["CSS & Scripts globaux"],"Successfully Activated":["Activ\u00e9 avec succ\u00e8s"],"Activation Failed":["\u00c9chec de l'activation"],"File":["Fichier"],"Enter the maximum allowed file size. Default is 5MB.":["Entrez la taille de fichier maximale autoris\u00e9e. La valeur par d\u00e9faut est de 5 Mo."],"Enter comma-separated file extensions (e.g. jpg, png, gif)":["Entrez les extensions de fichier s\u00e9par\u00e9es par des virgules (par exemple, jpg, png, gif)"],"Invalid file type(s): %s":["Type(s) de fichier invalide(s) : %s"],"Delete Webhook":["Supprimer le Webhook"]}}}
