plugins/cartflows/languages/cartflows-it_IT-7e9426301d8b905cbde2a115e9c5e3ab.json:1:{"translation-revision-date":"2025-02-04T15:33:29+00:00","generator":"WP-CLI\/2.12.0","source":"admin-core\/assets\/build\/editor-app.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"(no title)":["(nessun titolo)"],"Thank You":["Grazie"],"Edit":["Modifica"],"Delete":["Elimina"],"Default":["Predefinito"],"Funnels":["Imbuti"],"Store Checkout":["Cassa del negozio"],"Automations":["Automazioni"],"Add-ons":["Componenti aggiuntivi"],"Dashboard":["Cruscotto"],"Yes":["S\u00ec"],"No":["No"],"Step":["Passo"],"Settings":["Impostazioni"],"Rollback to Previous Version":["Ripristina alla versione precedente"],"33%":["33%"],"50%":["50%"],"100%":["100%"],"Field ID":["ID del campo"],"Checked":["Controllato"],"Options":["Opzioni"],"Placeholder":["Segnaposto"],"Required":["Richiesto"],"Collapsible":["Pieghevole"],"Activate WooCommerce":["Attiva WooCommerce"],"Install WooCommerce":["Installa WooCommerce"],"General":["Generale"],"Text":["Testo"],"Type":["Digita"],"Width":["Larghezza"],"Shipping":["Spedizione"],"Order Bumps":["Incrementi d'ordine"],"Search for a coupon":["Cerca un coupon"],"Auto Apply Coupon":["Applica automaticamente il coupon"],"Product Options":["Opzioni del prodotto"],"Advanced":["Avanzato"],"Product":["Prodotto"],"Title":["Titolo"],"Content":["Contenuto"],"Total Visits":["Visite totali"],"Upgrade to CartFlows Pro":["Aggiorna a CartFlows Pro"],"Search Steps":["Passaggi di ricerca"],"Enable Custom Field Editor":["Abilita l'editor di campi personalizzati"],"Search for a Product":["Cerca un prodotto"],"Billing":["Fatturazione"],"Settings Saved":["Impostazioni salvate"],"Saving\u2026":["Salvataggio in corso\u2026"],"Save Settings":["Salva impostazioni"],"Regular Price of the product":["Prezzo normale del prodotto"],"Price after discount.":["Prezzo dopo lo sconto."],"Product Name":["Nome del prodotto"],"Use {{product_name}} and {{quantity}} to dynamically fetch respective product details.":["Usa {{product_name}} e {{quantity}} per recuperare dinamicamente i dettagli del rispettivo prodotto."],"Subtext":["Sottotesto"],"Use {{quantity}}, {{discount_value}}, {{discount_percent}} to dynamically fetch respective product details.":["Usa {{quantity}}, {{discount_value}}, {{discount_percent}} per recuperare dinamicamente i rispettivi dettagli del prodotto."],"Enable Highlight":["Abilita evidenziazione"],"Highlight Text":["Testo evidenziato"],"Create New Product":["Crea nuovo prodotto"],"Add":["Aggiungi"],"Once you have selected products, they will be displayed here.":["Una volta selezionati i prodotti, verranno visualizzati qui."],"Items":["Articoli"],"Quantity":["Quantit\u00e0"],"Discount":["Sconto"],"Adding\u2026":["Aggiungendo\u2026"],"Please search and select at-lease one product to add.":["Si prega di cercare e selezionare almeno un prodotto da aggiungere."],"Reset":["Reimposta"],"Image Preview":["Anteprima immagine"],"Upload a file":["Carica un file"],"or drag and drop":["o trascina e rilascia"],"PNG, JPG, GIF up to 10MB":["PNG, JPG, GIF fino a 10MB"],"Select Dates":["Seleziona date"],"Please upgrade to the %1$s CartFlows Pro %2$s to use %3$s feature.":["Si prega di eseguire l'upgrade a %1$s CartFlows Pro %2$s per utilizzare la funzione %3$s."],"Please upgrade to the %1$s CartFlows Higher Plan %2$s to use %3$s feature.":["Si prega di eseguire l'upgrade al %1$s piano superiore di CartFlows %2$s per utilizzare la funzione %3$s."],"Please upgrade to the CartFlows Higher Plan to use the %s feature.":["Si prega di eseguire l'upgrade al piano superiore di CartFlows per utilizzare la funzione %s."],"Role":["Ruolo"],"Access":["Accesso"],"For more information about the user role management please %1$sClick here.%2$s":["Per ulteriori informazioni sulla gestione dei ruoli utente, si prega di %1$sfare clic qui.%2$s"],"Are you sure you want to rollback to %1$s v%2$s?":["Sei sicuro di voler tornare a %1$s v%2$s?"],"Rollback":["Ripristina"],"Cancel":["Annulla"],"Experiencing an issue with the current version of CartFlows? Roll back to a previous version to help troubleshoot the problem.":["Stai riscontrando un problema con la versione attuale di CartFlows? Torna a una versione precedente per aiutare a risolvere il problema."],"Regenerate Now":["Rigenera ora"],"Reset Permalinks Settings":["Reimposta le impostazioni dei permalink"],"Activate License":["Attiva licenza"],"Deactivate License":["Disattiva licenza"],"Please enter a valid license key!":["Per favore, inserisci un codice di licenza valido!"],"Processing":["Elaborazione"],"Unknown error occurred while activating the license.":["Si \u00e8 verificato un errore sconosciuto durante l'attivazione della licenza."],"Facebook Pixel":["Pixel di Facebook"],"Google Analytics Pixel":["Pixel di Google Analytics"],"Google Ads Pixel":["Pixel di Google Ads"],"Tiktok Pixel":["Pixel di Tiktok"],"Pinterest Tag":["Tag di Pinterest"],"Snapchat Pixel":["Snapchat Pixel"],"Google Auto Address":["Indirizzo automatico di Google"],"Regenerate Inline CSS":["Rigenera CSS inline"]," Regenerating\u2026.":["Rigenerazione in corso\u2026."],"Regenerated":["Rigenerato"],"If you are using the CartFlows Shortcode and using the Design Settings, then this option will regenerate the steps inline CSS. To learn more, %1$1s Click here %2$2s.":["Se stai utilizzando lo Shortcode di CartFlows e le Impostazioni di Design, questa opzione rigenerer\u00e0 i passaggi del CSS inline. Per saperne di pi\u00f9, %1$1s fai clic qui %2$2s."],"Updating":["Aggiornamento"],"Permalinks reset successfully":["Permalink reimpostati con successo"],"For more information about the CartFlows Permalink settings please %1$sClick here.%2$s":["Per ulteriori informazioni sulle impostazioni del Permalink di CartFlows, si prega di %1$sfare clic qui.%2$s"],"Oops! You don't have access to this page.":["Ops! Non hai accesso a questa pagina."],"You don't have permission to access this page. Please reach out to your admin for help.":["Non hai il permesso di accedere a questa pagina. Contatta il tuo amministratore per assistenza."],"Back to Dashboard":["Torna alla Dashboard"],"Integrations":["Integrazioni"],"User Role Manager":["Gestore dei Ruoli Utente"],"Permalink":["Permalink"],"Version Control":["Controllo delle versioni"],"Order":["Ordine"],"License":["Licenza"],"Sync Knowledge Base":["Sincronizza la base di conoscenza"],"Knowledge Base":["Base di conoscenza"],"Search knowledge base":["Cerca nella base di conoscenza"],"No Docs Founds":["Nessun documento trovato"],"Please try syncing the docs library":["Per favore, prova a sincronizzare la libreria di documenti"],"Syncing\u2026":["Sincronizzazione in corso\u2026"],"Synced. Reloading..":["Sincronizzato. Ricaricamento in corso.."],"Need Help?":["Hai bisogno di aiuto?"],"We aim to answer all priority support requests within 2-3 hours.":["Miriamo a rispondere a tutte le richieste di supporto prioritario entro 2-3 ore."],"Get Support":["Ottieni supporto"],"All Documentation":["Tutta la documentazione"],"Browse documentation, reference material, and tutorials for CartFlows.":["Esplora la documentazione, il materiale di riferimento e i tutorial per CartFlows."],"View documentation":["Visualizza documentazione"],"Videos":["Video"],"Browse tutorial videos on our YouTube channel.":["Sfoglia i video tutorial sul nostro canale YouTube."],"Youtube Channel":["Canale Youtube"],"Support":["Supporto"],"What's New?":["Novit\u00e0?"],"Unlicensed":["Senza licenza"],"Licensed":["Concesso in licenza"],"Open Global Settings":["Apri Impostazioni Globali"],"Tutorial Videos":["Video tutorial"],"More Options":["Altre opzioni"],"Control":["Controllo"],"Variation-%d":["Variazione-%d"],"No Product Assigned":["Nessun prodotto assegnato"],"Store Checkout - Remove selected checkout product":["Cassa del negozio - Rimuovi il prodotto selezionato dal carrello"],"PRO":["PRO"],"Offer Accepted":["Offerta accettata"],"Offer Rejected":["Offerta rifiutata"],"Invalid Position":["Posizione non valida"],"Views":["Visualizzazioni"],"Conversions":["Conversioni"],"Revenue":["Entrate"],"Upgrade to Pro":["Passa a Pro"],"%s Step":["Passo %s"],"Step Editing is Disabled":["Modifica del passaggio disabilitata"],"Open Settings":["Apri Impostazioni"],"Duplicate Step":["Duplica passaggio"],"Do you want to duplicate this step? Are you sure?":["Vuoi duplicare questo passaggio? Sei sicuro?"],"Delete Step":["Elimina passaggio"],"Do you want to delete this step? Are you sure?":["Vuoi eliminare questo passaggio? Sei sicuro?"],"Declare Winner":["Dichiara vincitore"],"Do you want to declare this step as winner? Are you sure?":["Vuoi dichiarare questo passaggio come vincitore? Sei sicuro?"],"Archive Step":["Passaggio di archiviazione"],"Do you want to archive this step? Are you sure?":["Vuoi archiviare questo passaggio? Sei sicuro?"],"Saving..":["Salvataggio in corso.."],"Saved":["Salvato"],"Reloading..":["Ricaricamento in corso.."],"Split Test Testing":["Test di suddivisione"],"Stop Split Test":["Interrompi test diviso"],"Start Split Test":["Inizia il test diviso"],"Split Test":["Test diviso"],"Stopping\u2026":["Interrompendo\u2026"],"Starting\u2026":["Inizio\u2026"],"Reloading\u2026":["Ricaricamento\u2026"],"Split Test Settings":["Impostazioni del test diviso"],"Restore Archived Variation":["Ripristina variazione archiviata"],"Do you want to restore this archived variation? Are you sure?":["Vuoi ripristinare questa variazione archiviata? Sei sicuro?"],"Trash Archived Variation":["Variazione Archiviata del Cestino"],"This action will trash this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Questa azione eliminer\u00e0 definitivamente questa variazione archiviata e i suoi dati analitici. %1$s Vuoi eliminare questa variazione archiviata?"],"Hide Archived Variation":["Nascondi variazione archiviata"],"This action will hide this archived variation from the list of steps, but its analytics will be visible. %1$s Do you want to hide this archived variation?":["Questa azione nasconder\u00e0 questa variazione archiviata dall'elenco dei passaggi, ma le sue analisi saranno visibili. %1$s Vuoi nascondere questa variazione archiviata?"],"This action will delete this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Questa azione eliminer\u00e0 definitivamente questa variazione archiviata e i suoi dati analitici. %1$s Vuoi eliminare questa variazione archiviata?"],"Deleted On: ":["Eliminato il:"],"Archived On: ":["Archiviato il:"],"Archived Steps":["Passaggi archiviati"],"Edit Step Name":["Modifica il nome del passaggio"],"Save":["Salva"],"Update Template":["Aggiorna modello"],"Changing the template will permanently delete the current design in this step. Would you still like to proceed?":["Modificare il modello eliminer\u00e0 definitivamente il design attuale in questo passaggio. Vuoi comunque procedere?"],"Change Template":["Cambia modello"],"If you are using shortcodes, enable this design settings to apply styles.":["Se stai utilizzando i codici brevi, abilita queste impostazioni di design per applicare gli stili."],"Enable Design Settings":["Abilita impostazioni di design"],"Activate %s":["Attiva %s"],"Activating %s":["Attivazione di %s"],"Successfully Activated!":["Attivato con successo!"],"Failed! Activation!":["Fallito! Attivazione!"],"Upgrade to Cartflows Pro":["Aggiorna a Cartflows Pro"],"Activate the License":["Attiva la licenza"],"Step Type: ":["Tipo di passaggio:"],"License is required!":["\u00c8 necessaria la licenza!"],"Activate the license to modify this offer step's settings":["Attiva la licenza per modificare le impostazioni di questo passaggio dell'offerta"],"No product Selected":["Nessun prodotto selezionato"],"Once you select the product, they will be displayed here.":["Una volta selezionato il prodotto, verranno visualizzati qui."],"Shipping Rate":["Tariffa di spedizione"],"Once you have add product, it will be displayed here.":["Una volta aggiunto il prodotto, verr\u00e0 visualizzato qui."],"Coupon will apply on checkout page":["Il coupon verr\u00e0 applicato nella pagina di pagamento"],"AND":["E"],"Please Update the CartFlows Pro to the latest version to use the conditional order bump feature.":["Si prega di aggiornare CartFlows Pro all'ultima versione per utilizzare la funzione di ordine condizionale."],"Enable conditional order bump ":["Abilita l'ordine condizionale aggiuntivo"],"By enabling this option, you can create the conditions to display the order bump.":["Abilitando questa opzione, puoi creare le condizioni per visualizzare l'ordine aggiuntivo."],"Show this order bump if following conditions are true":["Mostra questo ordine aggiuntivo se le seguenti condizioni sono vere"],"Add Condition":["Aggiungi condizione"],"OR":["O"],"Add Conditions Group":["Aggiungi gruppo di condizioni"],"Order Bump Product Image":["Immagine del prodotto aggiuntivo all'ordine"],"Styles":["Stili"],"Conditions":["Condizioni"],"Save Changes":["Salva le modifiche"],"You have made changes. Do you want to save the changes?":["Hai apportato delle modifiche. Vuoi salvare le modifiche?"],"No product":["Nessun prodotto"],"Duplicate Order Bump":["Duplicare l'ordine aggiuntivo"],"Edit Order Bump":["Modifica l'Offerta Aggiuntiva"],"Trash Order Bump":["Elimina l'ordine aggiuntivo"],"Do you really want to trash this order bump permanently?":["Vuoi davvero eliminare definitivamente questo ordine aggiuntivo?"],"Delete Order Bump":["Elimina l'ordine aggiuntivo"],"Status":["Stato"],"Actions":["Azioni"],"Create an order bump.":["Crea un'offerta aggiuntiva."],"Enter order bump name":["Inserisci il nome del bump dell'ordine"],"Please enter the order bump title":["Per favore inserisci il titolo del supplemento all'ordine"],"Preview":["Anteprima"],"View in Full Screen":["Visualizza a schermo intero"],"Exit Full Screen":["Esci dalla modalit\u00e0 a schermo intero"],"Order Submitted":["Ordine inviato"],"Special Offer":["Offerta Speciale"],"Order Receipt":["Ricevuta d'ordine"],"Enable Checkout Offer":["Abilita Offerta di Checkout"],"Dynamic Conditions":["Condizioni dinamiche"],"Please Update the CartFlows Pro to the latest version to use the dynamic offers feature.":["Si prega di aggiornare CartFlows Pro all'ultima versione per utilizzare la funzione di offerte dinamiche."],"Enable Dynamic Offers":["Abilita Offerte Dinamiche"],"Redirect to: ":["Reindirizza a:"],"Search for step\u2026":["Cerca il passaggio\u2026"],"If the following conditions are true":["Se le seguenti condizioni sono vere"],"Add Dynamic Offer":["Aggiungi Offerta Dinamica"],"Search for default step\u2026":["Cerca il passaggio predefinito\u2026"],"If all of the above conditions failed.":["Se tutte le condizioni sopra menzionate falliscono."],"Label":["Etichetta"],"ID":["ID"],"Enable":["Abilita"],"Add New Field":["Aggiungi nuovo campo"],"Date & Time":["Data e Ora"],"Add Custom Field":["Aggiungi campo personalizzato"],"TextArea":["Area di testo"],"Number":["Numero"],"Checkbox":["Casella di controllo"],"Radio":["Radio"],"Select":["Seleziona"],"Hidden":["Nascosto"],"Add To":["Aggiungi a"],"Label %1$s*%2$s":["Etichetta %1$s*%2$s"],"Field value will store in this meta key. Add field id without prefix like \"billing_\" or \"shipping_\". %s Use \"_\" instead of spaces.":["Il valore del campo verr\u00e0 memorizzato in questa chiave meta. Aggiungi l'ID del campo senza prefisso come \"billing_\" o \"shipping_\". %s Usa \"_\" invece degli spazi."],"Min Value":["Valore minimo"],"Max Value":["Valore massimo"],"Enter your options separated by (|).":["Inserisci le tue opzioni separate da (|)."],"UnChecked":["Non selezionato"],"Field Input Type":["Tipo di input del campo"],"Date":["Data"],"Time":["Tempo"],"Min ":["Min"],"Max ":["Max"],"Show in Email":["Mostra nell'email"],"Billing Fields":["Campi di fatturazione"],"Shipping Fields":["Campi di spedizione"],"Delete Field":["Elimina campo"],"Are you really want to delete field?":["Vuoi davvero eliminare il campo?"],"Field Editor":["Editor di campo"],"Label is required field":["Il campo etichetta \u00e8 obbligatorio"],"WooCommerce is Required!":["WooCommerce \u00e8 richiesto!"],"To modify the %s step options, please install and activate the WooCommerce plugin.":["Per modificare le opzioni del passaggio %s, installa e attiva il plugin WooCommerce."],"Activating\u2026":["Attivazione in corso\u2026"],"Activated":["Attivato"],"Funnel Settings":["Impostazioni del funnel"],"Save Setting":["Salva impostazione"],"Disable Store Checkout":["Disabilita il checkout del negozio"],"Enable Store Checkout":["Abilita il checkout del negozio"],"Edit Title":["Modifica titolo"],"Publish":["Pubblica"],"Do you really want to publish this funnel?":["Vuoi davvero pubblicare questo funnel?"],"Draft Funnel":["Bozza di Funnel"],"Do you really want to draft this funnel?":["Vuoi davvero creare questo funnel?"],"Unique Visits":["Visite uniche"],"Conversion Rate":["Tasso di conversione"],"Total number of orders.":["Numero totale di ordini."],"Grand total of all orders.":["Totale complessivo di tutti gli ordini."],"Average total of every order.":["Totale medio di ogni ordine."],"Grand total of all order bumps.":["Totale complessivo di tutti gli aumenti d'ordine."],"Export Flow":["Flusso di esportazione"],"View Funnel":["Visualizza imbuto"],"Open Funnel Settings":["Apri Impostazioni del Funnel"],"Delete Store Checkout":["Elimina il checkout del negozio"],"Do you really want to delete store checkout?%1$1sNOTE: This action cannot be reversed.":["Vuoi davvero eliminare il checkout del negozio?%1$1sNOTA: Questa azione non pu\u00f2 essere annullata."],"archived_date":["archived_date"],"%1$sNote:%2$s The orders which are placed by the admins are not considered while calculating the analytics.":["%1$sNota:%2$s Gli ordini effettuati dagli amministratori non vengono considerati nel calcolo delle analisi."],"Reset Analytics":["Reimposta analisi"],"Are you really want to reset funnel analytics?":["Vuoi davvero reimpostare le analisi del funnel?"],"Resetting":["Reimpostazione"],"Automation for":["Automazione per"],"Create a distraction free, high-converting checkout experience without needing a page builder.":["Crea un'esperienza di pagamento senza distrazioni e ad alta conversione senza bisogno di un costruttore di pagine."],"Funnel Steps":["Fasi del funnel"],"Add New Step":["Aggiungi nuovo passaggio"],"No Steps Added.":["Nessun passaggio aggiunto."],"Seems like there are no steps created or added in this flow":["Sembra che non ci siano passaggi creati o aggiunti in questo flusso"],"Add new step":["Aggiungi nuovo passaggio"],"Select Step Type":["Seleziona il tipo di passaggio"],"Activating WooCommerce..":["Attivazione di WooCommerce.."],"Installing WooCommerce..":["Installazione di WooCommerce.."],"Successfully Installed!":["Installato con successo!"],"Installation Failed!":["Installazione fallita!"],"Import Step":["Passaggio di importazione"],"Add multiple steps to your flows today with an upgraded CartFlows plan.":["Aggiungi pi\u00f9 passaggi ai tuoi flussi oggi con un piano CartFlows aggiornato."],"Get CartFlows Higher Plan":["Ottieni il piano superiore di CartFlows"],"Add multiple steps to your flows by activating %s.":["Aggiungi pi\u00f9 passaggi ai tuoi flussi attivando %s."],"Add %1$s step to your flows by activating %2$s.":["Aggiungi il passaggio %1$s ai tuoi flussi attivando %2$s."],"Add unlimited income boosting one-click %s to your flows when you upgrade to our CartFlows Higher plan today.":["Aggiungi %s a clic singolo per aumentare illimitatamente il reddito ai tuoi flussi quando esegui l'upgrade al nostro piano CartFlows Higher oggi stesso."],"Add %1$s step to your flow by activating CartFlows license.":["Aggiungi il passaggio %1$s al tuo flusso attivando la licenza CartFlows."],"Access all of our pro templates by activating %s.":["Accedi a tutti i nostri modelli pro attivando %s."],"Access all of our pro templates when you upgrade your plan to CartFlows Pro today.":["Accedi a tutti i nostri modelli pro quando aggiorni il tuo piano a CartFlows Pro oggi."],"Get CartFlows Pro":["Ottieni CartFlows Pro"],"Add %1$s step to your flows by activating license.":["Aggiungi il passaggio %1$s ai tuoi flussi attivando la licenza."],"You need WooCommerce plugin installed and activated to import this step.":["\u00c8 necessario che il plugin WooCommerce sia installato e attivato per importare questo passaggio."],"Imported! Redirecting\u2026":["Importato! Reindirizzamento\u2026"]," Please sync the library and try importing the template again.":["Per favore, sincronizza la libreria e prova a importare di nuovo il modello."],"Import Failed! Try again.":["Importazione fallita! Riprova."],"Create Step":["Crea passaggio"],"Creating Step..":["Creazione del passaggio.."],"Step Created! Redirecting\u2026":["Passo creato! Reindirizzamento\u2026"],"Failed to Create Step!":["Creazione del passaggio non riuscita!"],"Activate license for adding more steps and other features.":["Attiva la licenza per aggiungere pi\u00f9 passaggi e altre funzionalit\u00e0."],"Close the window":["Chiudi la finestra"],"Name Your Step":["Nomina il tuo passo"],"Step Name":["Nome del passaggio"],"Enter Step Name":["Inserisci il nome del passaggio"],"Learn How":["Scopri come"],"Create from Scratch":["Crea da zero"],"Step thumbnail image":["Immagine in miniatura del passaggio"],"Import":["Importa"],"Back":["Indietro"],"Sync Library":["Sincronizza libreria"],"Importing page %d":["Importazione della pagina %d"],"Sync Complete":["Sincronizzazione completata"],"Syncing Library\u2026":["Sincronizzazione della libreria\u2026"],"Library Synced":["Libreria sincronizzata"],"Steps Library":["Biblioteca dei Passi"],"Get CartFlows Higher plan":["Ottieni il piano superiore di CartFlows"],"Activate license for adding more flows and other features.":["Attiva la licenza per aggiungere pi\u00f9 flussi e altre funzionalit\u00e0."],"Importing Step..":["Importazione del passaggio.."],"Close":["Chiudi"],"Error":["Errore"],"Add unlimited income boosting one-click upsells to your flows by activating %s":["Aggiungi upsell a un clic per aumentare il reddito illimitato ai tuoi flussi attivando %s"],"Add unlimited income boosting one-click upsells to your flows when you upgrade to our CartFlows Plus or Pro plan today.":["Aggiungi upsell con un solo clic per aumentare il reddito illimitato ai tuoi flussi quando esegui l'upgrade al nostro piano CartFlows Plus o Pro oggi stesso."],"Access all of our pro templates by activating %s":["Accedi a tutti i nostri modelli pro attivando %s"],"Templates for %s":["Modelli per %s"],"Please wait\u2026":["Attendere prego\u2026"],"Please wait. Duplicating funnel\u2026":["Attendere prego. Duplicazione del funnel in corso\u2026"],"Please wait. Drafting funnel\u2026":["Attendere prego. Creazione del funnel in corso\u2026"],"Please wait. Deleting funnel\u2026":["Attendere prego. Eliminazione del funnel in corso\u2026"],"Please wait. Restoring funnel\u2026":["Attendere prego. Ripristino dell'imbuto in corso\u2026"],"Please wait. Exporting\u2026":["Attendere. Esportazione in corso\u2026"],"Please wait. Duplicating step\u2026":["Attendere. Duplicazione del passaggio\u2026"],"Please wait. Deleting step\u2026":["Attendere. Eliminazione del passaggio\u2026"],"Please wait. Creating variation\u2026":["Attendere. Creazione della variazione in corso\u2026"],"Please wait. Archiving variation\u2026":["Attendere. Archiviazione della variazione in corso\u2026"],"Please wait. Declaring winner\u2026":["Attendere prego. Dichiarazione del vincitore in corso\u2026"],"Analytics":["Analisi"],"Draft":["Bozza"],"Name":["Nome"],"Activating":["Attivazione"],"Failed":["Fallito"],"Remove Image":["Rimuovi immagine"],"Unlock Premium Features with CartFlows PRO!":["Sblocca le funzionalit\u00e0 premium con CartFlows PRO!"],"Get the tools you need to create powerful sales funnels, increase conversions, and grow your business with ease.":["Ottieni gli strumenti necessari per creare potenti funnel di vendita, aumentare le conversioni e far crescere la tua attivit\u00e0 con facilit\u00e0."],"Select a Settings Tab":["Seleziona una scheda Impostazioni"],"Free vs Pro":["Gratuito vs Pro"],"Increase Your Revenue with Smart Order Bumps":["Aumenta il tuo fatturato con i Smart Order Bumps"],"Boost sales with CartFlows\u2019 Order Bump! Offer personalized add-ons at checkout to increase revenue effortlessly. Quick to set up, no coding needed!":["Aumenta le vendite con l'Order Bump di CartFlows! Offri componenti aggiuntivi personalizzati al checkout per aumentare le entrate senza sforzo. Facile da configurare, nessuna programmazione necessaria!"],"Show the Right Offer to the Right People \u2013 Automatically!":["Mostra l'offerta giusta alle persone giuste, automaticamente!"],"Personalize deals based on location, cart details, and more. Upgrade to CartFlows PRO and unlock this smart feature today!":["Personalizza le offerte in base alla posizione, ai dettagli del carrello e altro ancora. Passa a CartFlows PRO e sblocca questa funzione intelligente oggi stesso!"],"Boost Sales Instantly with Auto-Applied Coupons!":["Aumenta le vendite istantaneamente con i coupon applicati automaticamente!"],"No codes, no hassle\u2014discounts apply instantly at checkout. Upgrade to CartFlows PRO and start converting more customers today!":["Nessun codice, nessun problema: gli sconti si applicano istantaneamente al checkout. Passa a CartFlows PRO e inizia a convertire pi\u00f9 clienti oggi stesso!"],"Give Your Customers More Choices, Boost Your Sales":["Dai ai tuoi clienti pi\u00f9 opzioni, aumenta le tue vendite"],"Make buying easier with flexible product options. Let customers make the right choices from your checkout. Upgrade to CartFlows PRO and start customizing today!":["Rendi l'acquisto pi\u00f9 facile con opzioni di prodotto flessibili. Lascia che i clienti facciano le scelte giuste dal tuo checkout. Passa a CartFlows PRO e inizia a personalizzare oggi stesso!"],"Optin Product":["Prodotto Optin"],"Select free & virtual product only. Once you select a product, it will be displayed here.":["Seleziona solo prodotti gratuiti e virtuali. Una volta selezionato un prodotto, verr\u00e0 visualizzato qui."],"Search for a Free & Virtual Product":["Cerca un prodotto gratuito e virtuale"],"Please select a free & virtual product only.":["Si prega di selezionare solo un prodotto gratuito e virtuale."],"Free":["Gratis"],"A\/B Testing":["Test A\/B"],"Optimize your sales with A\/B testing in CartFlows! Experiment with product pricing, page layouts, messaging, and design. Create variants, analyze results, and discover new ways to boost revenue.":["Ottimizza le tue vendite con i test A\/B in CartFlows! Sperimenta con i prezzi dei prodotti, i layout delle pagine, i messaggi e il design. Crea varianti, analizza i risultati e scopri nuovi modi per aumentare i ricavi."],"Modern Cart":["Carrello moderno"],"Enable Instant Layout":["Abilita Layout Istantaneo"],"Disabled":["Disabilitato"],"upgrading to PRO":["aggiornamento a PRO"],"activating CartFlows Pro":["attivazione di CartFlows Pro"],"You're using":["Stai usando"],"CartFlows Free":["CartFlows Free"],"To unlock more features, consider":["Per sbloccare pi\u00f9 funzionalit\u00e0, considera"],"Activate CartFlows Pro":["Attiva CartFlows Pro"],"You can't edit this step directly because Instant Layout is turned on in the funnel settings. To make design changes, go to the Design tab inside this step's settings.":["Non puoi modificare direttamente questo passaggio perch\u00e9 il Layout Istantaneo \u00e8 attivato nelle impostazioni del funnel. Per apportare modifiche al design, vai alla scheda Design all'interno delle impostazioni di questo passaggio."],"Use this setting to customize the style of the Instant %s Layout.":["Usa questa impostazione per personalizzare lo stile del Layout %s istantaneo."],"Turn this on to set up rules that decide when visitors should be redirected to a special offer or the next step.":["Attiva questa opzione per impostare regole che decidano quando i visitatori devono essere reindirizzati a un'offerta speciale o al passaggio successivo."],"Your email address can't be edited when using the Modern Checkout Style.":["Il tuo indirizzo email non pu\u00f2 essere modificato quando si utilizza lo stile di pagamento moderno."],"The Company field won't be visible if you're using the Instant Layout Style.":["Il campo Azienda non sar\u00e0 visibile se stai utilizzando lo stile di layout istantaneo."],"Opt-in":["Iscriviti"],"The product previously added as an Order Bump has been deleted. Please add a new product.":["Il prodotto precedentemente aggiunto come Order Bump \u00e8 stato eliminato. Si prega di aggiungere un nuovo prodotto."],"Choose a variation":["Scegli una variante"],"For more information about order bump settings please %1$sClick here.%2$s":["Per ulteriori informazioni sulle impostazioni dell'ordine bump, si prega di %1$sCliccare qui.%2$s"],"Sum of all step views in this funnel.":["Somma di tutte le visualizzazioni dei passaggi in questo funnel."],"Total upsell\/downsell revenue.":["Entrate totali da upsell\/downsell."],"Revenue per visit.":["Ricavo per visita."],"Revenue per unique visitor.":["Entrate per visitatore unico."],"Sandbox Mode":["Modalit\u00e0 Sandbox"],"Live Mode":["Modalit\u00e0 Live"],"Learn":["Impara"],"File Size (MB)":["Dimensione del file (MB)"],"Accepted File Types":["Tipi di file accettati"],"Back to Webhooks":["Torna ai Webhook"],"Edit Webhook":["Modifica Webhook"],"Add New Webhook":["Aggiungi nuovo Webhook"],"e.g. CRM Integration":["ad es. Integrazione CRM"],"Endpoint URL":["URL dell'endpoint"],"Events":["Eventi"],"Select events that will trigger this webhook.":["Seleziona gli eventi che attiveranno questo webhook."],"Select All":["Seleziona tutto"],"Enabled":["Abilitato"],"Max Retries":["Max tentativi"],"Number of retry attempts for failed deliveries (0-5).":["Numero di tentativi di ripetizione per consegne non riuscite (0-5)."],"Secret Key":["Chiave segreta"],"Used to sign webhook payloads (HMAC-SHA256).":["Utilizzata per firmare i payload dei webhook (HMAC-SHA256)."],"Copy to clipboard":["Copia negli appunti"],"Copied!":["Copiato!"],"Please enter a webhook name.":["Inserisci un nome per il webhook."],"Please enter a webhook URL.":["Inserisci un URL per il webhook."],"Please enter a valid URL.":["Inserisci un URL valido."],"Please select at least one event.":["Seleziona almeno un evento."],"Failed to save webhook.":["Impossibile salvare il webhook."],"Something went wrong.":["Qualcosa \u00e8 andato storto."],"Update Webhook":["Aggiorna Webhook"],"Create Webhook":["Crea Webhook"],"Webhooks":["Webhook"],"Send real-time event data to external services when key funnel events occur.":["Invia dati di eventi in tempo reale a servizi esterni quando si verificano eventi chiave del funnel."],"No webhooks configured yet. Click \"Add New Webhook\" to get started.":["Nessun webhook configurato ancora. Clicca su \"Aggiungi Nuovo Webhook\" per iniziare."],"URL":["URL"],"Last Delivery":["Ultima Consegna"],"events":["eventi"],"Success":["Successo"],"Never triggered":["Mai attivato"],"Test sent!":["Test inviato!"],"Send Test":["Invia Test"],"Are you sure you want to delete this webhook?":["Sei sicuro di voler eliminare questo webhook?"],"Global CSS & Scripts":["CSS e Script Globali"],"Successfully Activated":["Attivato con successo"],"Activation Failed":["Attivazione fallita"],"File":["File"],"Enter the maximum allowed file size. Default is 5MB.":["Inserisci la dimensione massima del file consentita. Il valore predefinito \u00e8 5MB."],"Enter comma-separated file extensions (e.g. jpg, png, gif)":["Inserisci le estensioni dei file separate da virgola (es. jpg, png, gif)"],"Invalid file type(s): %s":["Tipo di file non valido: %s"],"Delete Webhook":["Elimina Webhook"]}}}
plugins/cartflows/languages/cartflows-nl_NL-7e9426301d8b905cbde2a115e9c5e3ab.json:1:{"translation-revision-date":"2025-02-04T15:33:29+00:00","generator":"WP-CLI\/2.12.0","source":"admin-core\/assets\/build\/editor-app.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"(no title)":["(geen titel)"],"Thank You":["Dank je"],"Edit":["Bewerken"],"Delete":["Verwijderen"],"Default":["Standaard"],"Funnels":["Trechters"],"Store Checkout":["Winkelafrekenen"],"Automations":["Automatiseringen"],"Add-ons":["Invoegtoepassingen"],"Dashboard":["Dashboard"],"Yes":["Ja"],"No":["Nee"],"Step":["Stap"],"Settings":["Instellingen"],"Rollback to Previous Version":["Terugzetten naar vorige versie"],"33%":["33%"],"50%":["50%"],"100%":["100%"],"Field ID":["Veld-ID"],"Checked":["Gecontroleerd"],"Options":["Opties"],"Placeholder":["Placeholder"],"Required":["Vereist"],"Collapsible":["Inklapbaar"],"Activate WooCommerce":["Activeer WooCommerce"],"Install WooCommerce":["Installeer WooCommerce"],"General":["Algemeen"],"Text":["Tekst"],"Type":["Type"],"Width":["Breedte"],"Shipping":["Verzending"],"Order Bumps":["Order Bumps"],"Search for a coupon":["Zoek naar een coupon"],"Auto Apply Coupon":["Automatisch coupon toepassen"],"Product Options":["Productopties"],"Advanced":["Geavanceerd"],"Product":["Product"],"Title":["Titel"],"Content":["Inhoud"],"Total Visits":["Totaal aantal bezoeken"],"Upgrade to CartFlows Pro":["Upgrade naar CartFlows Pro"],"Search Steps":["Zoekstappen"],"Enable Custom Field Editor":["Aangepaste veldeneditor inschakelen"],"Search for a Product":["Zoek naar een product"],"Billing":["Facturering"],"Settings Saved":["Instellingen opgeslagen"],"Saving\u2026":["Opslaan\u2026"],"Save Settings":["Instellingen opslaan"],"Regular Price of the product":["Reguliere prijs van het product"],"Price after discount.":["Prijs na korting."],"Product Name":["Productnaam"],"Use {{product_name}} and {{quantity}} to dynamically fetch respective product details.":["Gebruik {{product_name}} en {{quantity}} om dynamisch de respectieve productdetails op te halen."],"Subtext":["Subtekst"],"Use {{quantity}}, {{discount_value}}, {{discount_percent}} to dynamically fetch respective product details.":["Gebruik {{quantity}}, {{discount_value}}, {{discount_percent}} om respectievelijk productdetails dynamisch op te halen."],"Enable Highlight":["Markeren inschakelen"],"Highlight Text":["Tekst markeren"],"Create New Product":["Nieuw product maken"],"Add":["Toevoegen"],"Once you have selected products, they will be displayed here.":["Zodra je producten hebt geselecteerd, worden ze hier weergegeven."],"Items":["Artikelen"],"Quantity":["Hoeveelheid"],"Discount":["Korting"],"Adding\u2026":["Toevoegen\u2026"],"Please search and select at-lease one product to add.":["Zoek en selecteer ten minste \u00e9\u00e9n product om toe te voegen."],"Reset":["Opnieuw instellen"],"Image Preview":["Voorbeeld van afbeelding"],"Upload a file":["Een bestand uploaden"],"or drag and drop":["of slepen en neerzetten"],"PNG, JPG, GIF up to 10MB":["PNG, JPG, GIF tot 10MB"],"Select Dates":["Selecteer datums"],"Please upgrade to the %1$s CartFlows Pro %2$s to use %3$s feature.":["Upgrade alstublieft naar de %1$s CartFlows Pro %2$s om de %3$s functie te gebruiken."],"Please upgrade to the %1$s CartFlows Higher Plan %2$s to use %3$s feature.":["Upgrade alstublieft naar het %1$s CartFlows Higher Plan %2$s om de %3$s functie te gebruiken."],"Please upgrade to the CartFlows Higher Plan to use the %s feature.":["Upgrade alstublieft naar het CartFlows Hogere Plan om de %s functie te gebruiken."],"Role":["Rol"],"Access":["Toegang"],"For more information about the user role management please %1$sClick here.%2$s":["Voor meer informatie over het beheer van gebruikersrollen, %1$sklik hier.%2$s"],"Are you sure you want to rollback to %1$s v%2$s?":["Weet je zeker dat je wilt teruggaan naar %1$s v%2$s?"],"Rollback":["Terugdraaien"],"Cancel":["Annuleren"],"Experiencing an issue with the current version of CartFlows? Roll back to a previous version to help troubleshoot the problem.":["Ervaar je een probleem met de huidige versie van CartFlows? Ga terug naar een eerdere versie om het probleem te helpen oplossen."],"Regenerate Now":["Nu opnieuw genereren"],"Reset Permalinks Settings":["Permalink-instellingen opnieuw instellen"],"Activate License":["Licentie activeren"],"Deactivate License":["Licentie deactiveren"],"Please enter a valid license key!":["Voer een geldige licentiesleutel in!"],"Processing":["Verwerken"],"Unknown error occurred while activating the license.":["Er is een onbekende fout opgetreden bij het activeren van de licentie."],"Facebook Pixel":["Facebook Pixel"],"Google Analytics Pixel":["Google Analytics Pixel"],"Google Ads Pixel":["Google Ads Pixel"],"Tiktok Pixel":["Tiktok Pixel"],"Pinterest Tag":["Pinterest-tag"],"Snapchat Pixel":["Snapchat Pixel"],"Google Auto Address":["Google Auto-adres"],"Regenerate Inline CSS":["Inline CSS opnieuw genereren"]," Regenerating\u2026.":["Opnieuw genereren\u2026."],"Regenerated":["Geregeneerd"],"If you are using the CartFlows Shortcode and using the Design Settings, then this option will regenerate the steps inline CSS. To learn more, %1$1s Click here %2$2s.":["Als je de CartFlows Shortcode gebruikt en de Ontwerpinstellingen gebruikt, dan zal deze optie de stappen inline CSS regenereren. Om meer te leren, %1$1s Klik hier %2$2s."],"Updating":["Bijwerken"],"Permalinks reset successfully":["Permanente koppelingen succesvol opnieuw ingesteld"],"For more information about the CartFlows Permalink settings please %1$sClick here.%2$s":["Voor meer informatie over de CartFlows Permalink-instellingen, %1$sklik hier.%2$s"],"Oops! You don't have access to this page.":["Oeps! Je hebt geen toegang tot deze pagina."],"You don't have permission to access this page. Please reach out to your admin for help.":["Je hebt geen toestemming om deze pagina te openen. Neem contact op met je beheerder voor hulp."],"Back to Dashboard":["Terug naar Dashboard"],"Integrations":["Integraties"],"User Role Manager":["Gebruikersrolbeheerder"],"Permalink":["Permanente link"],"Version Control":["Versiebeheer"],"Order":["Bestelling"],"License":["Licentie"],"Sync Knowledge Base":["Synchroniseer kennisbank"],"Knowledge Base":["Kennisbank"],"Search knowledge base":["Zoek in de kennisbank"],"No Docs Founds":["Geen documenten gevonden"],"Please try syncing the docs library":["Probeer de documentbibliotheek te synchroniseren"],"Syncing\u2026":["Synchroniseren\u2026"],"Synced. Reloading..":["Gesynchroniseerd. Opnieuw laden.."],"Need Help?":["Hulp nodig?"],"We aim to answer all priority support requests within 2-3 hours.":["We streven ernaar om alle prioriteitsverzoeken binnen 2-3 uur te beantwoorden."],"Get Support":["Krijg ondersteuning"],"All Documentation":["Alle documentatie"],"Browse documentation, reference material, and tutorials for CartFlows.":["Blader door documentatie, referentiemateriaal en tutorials voor CartFlows."],"View documentation":["Documentatie bekijken"],"Videos":["Video's"],"Browse tutorial videos on our YouTube channel.":["Bekijk tutorialvideo's op ons YouTube-kanaal."],"Youtube Channel":["Youtube-kanaal"],"Support":["Ondersteuning"],"What's New?":["Wat is er nieuw?"],"Unlicensed":["Ongeautoriseerd"],"Licensed":["Gelicentieerd"],"Open Global Settings":["Open globale instellingen"],"Tutorial Videos":["Instructievideo's"],"More Options":["Meer opties"],"Control":["Beheer"],"Variation-%d":["Variatie-%d"],"No Product Assigned":["Geen product toegewezen"],"Store Checkout - Remove selected checkout product":["Winkelafrekenen - Geselecteerd afrekenproduct verwijderen"],"PRO":["PRO"],"Offer Accepted":["Aanbod geaccepteerd"],"Offer Rejected":["Aanbod afgewezen"],"Invalid Position":["Ongeldige positie"],"Views":["Weergaven"],"Conversions":["Conversies"],"Revenue":["Omzet"],"Upgrade to Pro":["Upgrade naar Pro"],"%s Step":["%s Stap"],"Step Editing is Disabled":["Stap bewerken is uitgeschakeld"],"Open Settings":["Instellingen openen"],"Duplicate Step":["Dubbele stap"],"Do you want to duplicate this step? Are you sure?":["Wilt u deze stap dupliceren? Weet u het zeker?"],"Delete Step":["Stap verwijderen"],"Do you want to delete this step? Are you sure?":["Wil je deze stap verwijderen? Weet je het zeker?"],"Declare Winner":["Winnaar aanwijzen"],"Do you want to declare this step as winner? Are you sure?":["Wil je deze stap als winnaar aanwijzen? Weet je het zeker?"],"Archive Step":["Archiefstap"],"Do you want to archive this step? Are you sure?":["Wil je deze stap archiveren? Weet je het zeker?"],"Saving..":["Opslaan.."],"Saved":["Opgeslagen"],"Reloading..":["Opnieuw laden.."],"Split Test Testing":["Split Test Testen"],"Stop Split Test":["Stop split-test"],"Start Split Test":["Start A\/B-test"],"Split Test":["Splittest"],"Stopping\u2026":["Stoppen\u2026"],"Starting\u2026":["Beginnen\u2026"],"Reloading\u2026":["Herladen\u2026"],"Split Test Settings":["Instellingen voor gesplitste test"],"Restore Archived Variation":["Gearchiveerde Variatie Herstellen"],"Do you want to restore this archived variation? Are you sure?":["Wil je deze gearchiveerde variant herstellen? Weet je het zeker?"],"Trash Archived Variation":["Prullenbak Gearchiveerde Variatie"],"This action will trash this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Deze actie zal deze gearchiveerde variant en de bijbehorende analyseggegevens permanent verwijderen. %1$s Wilt u deze gearchiveerde variant verwijderen?"],"Hide Archived Variation":["Gearchiveerde variant verbergen"],"This action will hide this archived variation from the list of steps, but its analytics will be visible. %1$s Do you want to hide this archived variation?":["Deze actie verbergt deze gearchiveerde variant uit de lijst met stappen, maar de analyses blijven zichtbaar. %1$s Wilt u deze gearchiveerde variant verbergen?"],"This action will delete this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Deze actie zal deze gearchiveerde variant en de bijbehorende analyseggegevens permanent verwijderen. %1$s Wilt u deze gearchiveerde variant verwijderen?"],"Deleted On: ":["Verwijderd op:"],"Archived On: ":["Gearchiveerd op:"],"Archived Steps":["Gearchiveerde stappen"],"Edit Step Name":["Bewerk stapnaam"],"Save":["Opslaan"],"Update Template":["Template bijwerken"],"Changing the template will permanently delete the current design in this step. Would you still like to proceed?":["Het wijzigen van de sjabloon zal het huidige ontwerp in deze stap permanent verwijderen. Wilt u toch doorgaan?"],"Change Template":["Template wijzigen"],"If you are using shortcodes, enable this design settings to apply styles.":["Als je shortcodes gebruikt, schakel dan deze ontwerpinstellingen in om stijlen toe te passen."],"Enable Design Settings":["Ontwerpinstellingen inschakelen"],"Activate %s":["Activeer %s"],"Activating %s":["%s activeren"],"Successfully Activated!":["Succesvol geactiveerd!"],"Failed! Activation!":["Mislukt! Activering!"],"Upgrade to Cartflows Pro":["Upgrade naar Cartflows Pro"],"Activate the License":["Activeer de licentie"],"Step Type: ":["Staptype:"],"License is required!":["Licentie is vereist!"],"Activate the license to modify this offer step's settings":["Activeer de licentie om de instellingen van deze aanbiedingsstap te wijzigen"],"No product Selected":["Geen product geselecteerd"],"Once you select the product, they will be displayed here.":["Zodra u het product selecteert, worden ze hier weergegeven."],"Shipping Rate":["Verzendtarief"],"Once you have add product, it will be displayed here.":["Zodra je een product hebt toegevoegd, wordt het hier weergegeven."],"Coupon will apply on checkout page":["De coupon wordt toegepast op de afrekenpagina"],"AND":["EN"],"Please Update the CartFlows Pro to the latest version to use the conditional order bump feature.":["Werk CartFlows Pro bij naar de nieuwste versie om de voorwaardelijke order bump-functie te gebruiken."],"Enable conditional order bump ":["Voorwaardelijke orderbump inschakelen"],"By enabling this option, you can create the conditions to display the order bump.":["Door deze optie in te schakelen, kun je de voorwaarden cre\u00ebren om de order bump weer te geven."],"Show this order bump if following conditions are true":["Toon deze orderbump als de volgende voorwaarden waar zijn"],"Add Condition":["Voorwaarde toevoegen"],"OR":["OF"],"Add Conditions Group":["Voorwaarden Groep Toevoegen"],"Order Bump Product Image":["Bestel Bump Productafbeelding"],"Styles":["Stijlen"],"Conditions":["Voorwaarden"],"Save Changes":["Wijzigingen opslaan"],"You have made changes. Do you want to save the changes?":["U heeft wijzigingen aangebracht. Wilt u de wijzigingen opslaan?"],"No product":["Geen product"],"Duplicate Order Bump":["Dubbele Bestelverhoging"],"Edit Order Bump":["Order Bump bewerken"],"Trash Order Bump":["Prullenbak Bestelling Bump"],"Do you really want to trash this order bump permanently?":["Wil je deze orderbump echt permanent verwijderen?"],"Delete Order Bump":["Order Bump verwijderen"],"Status":["Status"],"Actions":["Acties"],"Create an order bump.":["Maak een order bump."],"Enter order bump name":["Voer de naam van de orderbump in"],"Please enter the order bump title":["Voer de titel van de orderbump in"],"Preview":["Voorbeeld"],"View in Full Screen":["Volledig scherm bekijken"],"Exit Full Screen":["Volledig scherm afsluiten"],"Order Submitted":["Bestelling Verzonden"],"Special Offer":["Speciale Aanbieding"],"Order Receipt":["Bestelbevestiging"],"Enable Checkout Offer":["Aanbieding bij afrekenen inschakelen"],"Dynamic Conditions":["Dynamische voorwaarden"],"Please Update the CartFlows Pro to the latest version to use the dynamic offers feature.":["Werk alstublieft CartFlows Pro bij naar de nieuwste versie om de functie voor dynamische aanbiedingen te gebruiken."],"Enable Dynamic Offers":["Dynamische aanbiedingen inschakelen"],"Redirect to: ":["Omleiden naar:"],"Search for step\u2026":["Zoek naar stap\u2026"],"If the following conditions are true":["Als de volgende voorwaarden waar zijn"],"Add Dynamic Offer":["Dynamisch Aanbod Toevoegen"],"Search for default step\u2026":["Zoek naar standaardstap\u2026"],"If all of the above conditions failed.":["Als al de bovenstaande voorwaarden zijn mislukt."],"Label":["Label"],"ID":["ID"],"Enable":["Inschakelen"],"Add New Field":["Nieuw veld toevoegen"],"Date & Time":["Datum & Tijd"],"Add Custom Field":["Aangepast veld toevoegen"],"TextArea":["Tekstgebied"],"Number":["Nummer"],"Checkbox":["Selectievakje"],"Radio":["Radio"],"Select":["Selecteer"],"Hidden":["Verborgen"],"Add To":["Toevoegen aan"],"Label %1$s*%2$s":["Label %1$s*%2$s"],"Field value will store in this meta key. Add field id without prefix like \"billing_\" or \"shipping_\". %s Use \"_\" instead of spaces.":["Veldwaarde wordt opgeslagen in deze meta-sleutel. Voeg veld-id toe zonder voorvoegsel zoals \"billing_\" of \"shipping_\". %s Gebruik \"_\" in plaats van spaties."],"Min Value":["Minimale waarde"],"Max Value":["Maximale waarde"],"Enter your options separated by (|).":["Voer uw opties in, gescheiden door (|)."],"UnChecked":["Niet aangevinkt"],"Field Input Type":["Veld invoertype"],"Date":["Datum"],"Time":["Tijd"],"Min ":["Min"],"Max ":["Max"],"Show in Email":["Weergeven in e-mail"],"Billing Fields":["Factureringsvelden"],"Shipping Fields":["Verzendvelden"],"Delete Field":["Veld verwijderen"],"Are you really want to delete field?":["Weet je zeker dat je het veld wilt verwijderen?"],"Field Editor":["Veldeditor"],"Label is required field":["Label is een verplicht veld"],"WooCommerce is Required!":["WooCommerce is vereist!"],"To modify the %s step options, please install and activate the WooCommerce plugin.":["Om de %s stapopties te wijzigen, installeer en activeer de WooCommerce-plugin."],"Activating\u2026":["Activeren\u2026"],"Activated":["Geactiveerd"],"Funnel Settings":["Trechterinstellingen"],"Save Setting":["Instelling opslaan"],"Disable Store Checkout":["Winkelafrekenen uitschakelen"],"Enable Store Checkout":["Winkelafrekenen inschakelen"],"Edit Title":["Titel bewerken"],"Publish":["Publiceren"],"Do you really want to publish this funnel?":["Wil je deze funnel echt publiceren?"],"Draft Funnel":["Concepttrechter"],"Do you really want to draft this funnel?":["Wil je deze funnel echt opstellen?"],"Unique Visits":["Unieke bezoeken"],"Conversion Rate":["Conversieratio"],"Total number of orders.":["Totaal aantal bestellingen."],"Grand total of all orders.":["Totaalbedrag van alle bestellingen."],"Average total of every order.":["Gemiddeld totaal van elke bestelling."],"Grand total of all order bumps.":["Totaalbedrag van alle orderverhogingen."],"Export Flow":["Exportstroom"],"View Funnel":["Trechter bekijken"],"Open Funnel Settings":["Open trechterinstellingen"],"Delete Store Checkout":["Winkelafrekenen verwijderen"],"Do you really want to delete store checkout?%1$1sNOTE: This action cannot be reversed.":["Weet u zeker dat u de winkelcheckout wilt verwijderen?%1$1sOPMERKING: Deze actie kan niet ongedaan worden gemaakt."],"archived_date":["archived_date"],"%1$sNote:%2$s The orders which are placed by the admins are not considered while calculating the analytics.":["%1$sOpmerking:%2$s De bestellingen die door de beheerders worden geplaatst, worden niet meegenomen bij het berekenen van de analyses."],"Reset Analytics":["Analytics opnieuw instellen"],"Are you really want to reset funnel analytics?":["Wil je de trechteranalyse echt opnieuw instellen?"],"Resetting":["Opnieuw instellen"],"Automation for":["Automatisering voor"],"Create a distraction free, high-converting checkout experience without needing a page builder.":["Cre\u00eber een afleidingsvrije, hoog converterende afrekenervaring zonder een paginabouwer nodig te hebben."],"Funnel Steps":["Trechterstappen"],"Add New Step":["Nieuwe stap toevoegen"],"No Steps Added.":["Geen stappen toegevoegd."],"Seems like there are no steps created or added in this flow":["Het lijkt erop dat er geen stappen zijn gemaakt of toegevoegd in deze flow"],"Add new step":["Nieuwe stap toevoegen"],"Select Step Type":["Selecteer staptype"],"Activating WooCommerce..":["WooCommerce activeren.."],"Installing WooCommerce..":["WooCommerce installeren.."],"Successfully Installed!":["Succesvol ge\u00efnstalleerd!"],"Installation Failed!":["Installatie mislukt!"],"Import Step":["Importstap"],"Add multiple steps to your flows today with an upgraded CartFlows plan.":["Voeg vandaag nog meerdere stappen toe aan je flows met een ge\u00fcpgraded CartFlows-plan."],"Get CartFlows Higher Plan":["Verkrijg een hoger plan van CartFlows"],"Add multiple steps to your flows by activating %s.":["Voeg meerdere stappen toe aan je flows door %s te activeren."],"Add %1$s step to your flows by activating %2$s.":["Voeg %1$s stap toe aan je flows door %2$s te activeren."],"Add unlimited income boosting one-click %s to your flows when you upgrade to our CartFlows Higher plan today.":["Voeg onbeperkte inkomensverhogende \u00e9\u00e9n-klik %s toe aan je flows wanneer je vandaag upgrade naar ons CartFlows Higher-plan."],"Add %1$s step to your flow by activating CartFlows license.":["Voeg %1$s stap toe aan je flow door de CartFlows-licentie te activeren."],"Access all of our pro templates by activating %s.":["Toegang tot al onze pro-sjablonen door %s te activeren."],"Access all of our pro templates when you upgrade your plan to CartFlows Pro today.":["Toegang tot al onze pro-sjablonen wanneer je je plan vandaag nog upgrade naar CartFlows Pro."],"Get CartFlows Pro":["Koop CartFlows Pro"],"Add %1$s step to your flows by activating license.":["Voeg %1$s stap toe aan je flows door de licentie te activeren."],"You need WooCommerce plugin installed and activated to import this step.":["Je hebt de WooCommerce-plugin nodig die ge\u00efnstalleerd en geactiveerd is om deze stap te importeren."],"Imported! Redirecting\u2026":["Ge\u00efmporteerd! Omleiden\u2026"]," Please sync the library and try importing the template again.":["Synchroniseer alstublieft de bibliotheek en probeer de sjabloon opnieuw te importeren."],"Import Failed! Try again.":["Importeren mislukt! Probeer het opnieuw."],"Create Step":["Stap maken"],"Creating Step..":["Stap maken.."],"Step Created! Redirecting\u2026":["Stap gemaakt! Doorverwijzen\u2026"],"Failed to Create Step!":["Stap maken mislukt!"],"Activate license for adding more steps and other features.":["Activeer licentie om meer stappen en andere functies toe te voegen."],"Close the window":["Sluit het raam"],"Name Your Step":["Noem Uw Stap"],"Step Name":["Stapnaam"],"Enter Step Name":["Voer stapnaam in"],"Learn How":["Leer hoe"],"Create from Scratch":["Vanaf nul maken"],"Step thumbnail image":["Stap miniatuurafbeelding"],"Import":["Importeren"],"Back":["Terug"],"Sync Library":["Bibliotheek synchroniseren"],"Importing page %d":["Pagina %d importeren"],"Sync Complete":["Synchronisatie voltooid"],"Syncing Library\u2026":["Bibliotheek synchroniseren\u2026"],"Library Synced":["Bibliotheek gesynchroniseerd"],"Steps Library":["Stappenbibliotheek"],"Get CartFlows Higher plan":["Verkrijg het hogere CartFlows-plan"],"Activate license for adding more flows and other features.":["Activeer licentie om meer flows en andere functies toe te voegen."],"Importing Step..":["Stap importeren.."],"Close":["Sluiten"],"Error":["Fout"],"Add unlimited income boosting one-click upsells to your flows by activating %s":["Voeg onbeperkte inkomstenverhogende one-click upsells toe aan je flows door %s te activeren"],"Add unlimited income boosting one-click upsells to your flows when you upgrade to our CartFlows Plus or Pro plan today.":["Voeg onbeperkte inkomstenverhogende one-click upsells toe aan je flows wanneer je vandaag nog upgrade naar ons CartFlows Plus- of Pro-plan."],"Access all of our pro templates by activating %s":["Toegang tot al onze pro-sjablonen door %s te activeren"],"Templates for %s":["Templates voor %s"],"Please wait\u2026":["Even geduld\u2026"],"Please wait. Duplicating funnel\u2026":["Even geduld. Trechter dupliceren\u2026"],"Please wait. Drafting funnel\u2026":["Even geduld. Trechter wordt opgesteld\u2026"],"Please wait. Deleting funnel\u2026":["Even geduld. Trechter wordt verwijderd\u2026"],"Please wait. Restoring funnel\u2026":["Even geduld. Trechter wordt hersteld\u2026"],"Please wait. Exporting\u2026":["Even geduld. Exporteren\u2026"],"Please wait. Duplicating step\u2026":["Even geduld. Stap dupliceren\u2026"],"Please wait. Deleting step\u2026":["Even geduld. Stap wordt verwijderd\u2026"],"Please wait. Creating variation\u2026":["Even geduld. Variatie wordt gemaakt\u2026"],"Please wait. Archiving variation\u2026":["Even geduld. Variatie wordt gearchiveerd\u2026"],"Please wait. Declaring winner\u2026":["Even geduld. Winnaar wordt bepaald\u2026"],"Analytics":["Analytics"],"Draft":["Concept"],"Name":["Naam"],"Activating":["Activeren"],"Failed":["Mislukt"],"Remove Image":["Afbeelding verwijderen"],"Unlock Premium Features with CartFlows PRO!":["Ontgrendel Premium-functies met CartFlows PRO!"],"Get the tools you need to create powerful sales funnels, increase conversions, and grow your business with ease.":["Verkrijg de tools die je nodig hebt om krachtige verkooptrechters te cre\u00ebren, conversies te verhogen en je bedrijf moeiteloos te laten groeien."],"Select a Settings Tab":["Selecteer een instellingen tabblad"],"Free vs Pro":["Gratis vs Pro"],"Increase Your Revenue with Smart Order Bumps":["Verhoog uw omzet met slimme orderverhogingen"],"Boost sales with CartFlows\u2019 Order Bump! Offer personalized add-ons at checkout to increase revenue effortlessly. Quick to set up, no coding needed!":["Verhoog de verkoop met de Order Bump van CartFlows! Bied gepersonaliseerde extra's aan bij het afrekenen om moeiteloos de omzet te verhogen. Snel in te stellen, geen codering nodig!"],"Show the Right Offer to the Right People \u2013 Automatically!":["Toon de juiste aanbieding aan de juiste mensen \u2013 automatisch!"],"Personalize deals based on location, cart details, and more. Upgrade to CartFlows PRO and unlock this smart feature today!":["Personaliseer aanbiedingen op basis van locatie, winkelwagengegevens en meer. Upgrade naar CartFlows PRO en ontgrendel deze slimme functie vandaag nog!"],"Boost Sales Instantly with Auto-Applied Coupons!":["Verhoog de verkoop direct met automatisch toegepaste coupons!"],"No codes, no hassle\u2014discounts apply instantly at checkout. Upgrade to CartFlows PRO and start converting more customers today!":["Geen codes, geen gedoe\u2014kortingen worden direct bij het afrekenen toegepast. Upgrade naar CartFlows PRO en begin vandaag nog met het converteren van meer klanten!"],"Give Your Customers More Choices, Boost Your Sales":["Geef uw klanten meer keuzes, verhoog uw verkoop"],"Make buying easier with flexible product options. Let customers make the right choices from your checkout. Upgrade to CartFlows PRO and start customizing today!":["Maak kopen gemakkelijker met flexibele productopties. Laat klanten de juiste keuzes maken vanuit uw afrekenproces. Upgrade naar CartFlows PRO en begin vandaag nog met aanpassen!"],"Optin Product":["Optin-product"],"Select free & virtual product only. Once you select a product, it will be displayed here.":["Selecteer alleen gratis en virtueel product. Zodra je een product selecteert, wordt het hier weergegeven."],"Search for a Free & Virtual Product":["Zoek naar een Gratis & Virtueel Product"],"Please select a free & virtual product only.":["Selecteer alstublieft alleen een gratis en virtueel product."],"Free":["Gratis"],"A\/B Testing":["A\/B-test"],"Optimize your sales with A\/B testing in CartFlows! Experiment with product pricing, page layouts, messaging, and design. Create variants, analyze results, and discover new ways to boost revenue.":["Optimaliseer je verkoop met A\/B-testen in CartFlows! Experimenteer met productprijzen, paginalay-outs, berichten en ontwerp. Maak varianten, analyseer resultaten en ontdek nieuwe manieren om de omzet te verhogen."],"Modern Cart":["Moderne Kar"],"Enable Instant Layout":["Directe lay-out inschakelen"],"Disabled":["Uitgeschakeld"],"upgrading to PRO":["upgraden naar PRO"],"activating CartFlows Pro":["CartFlows Pro activeren"],"You're using":["Je gebruikt"],"CartFlows Free":["CartFlows Gratis"],"To unlock more features, consider":["Overweeg om meer functies te ontgrendelen"],"Activate CartFlows Pro":["Activeer CartFlows Pro"],"You can't edit this step directly because Instant Layout is turned on in the funnel settings. To make design changes, go to the Design tab inside this step's settings.":["Je kunt deze stap niet direct bewerken omdat Instant Layout is ingeschakeld in de trechterinstellingen. Om ontwerpwijzigingen aan te brengen, ga naar het tabblad Ontwerp in de instellingen van deze stap."],"Use this setting to customize the style of the Instant %s Layout.":["Gebruik deze instelling om de stijl van de Instant %s-indeling aan te passen."],"Turn this on to set up rules that decide when visitors should be redirected to a special offer or the next step.":["Zet dit aan om regels in te stellen die bepalen wanneer bezoekers moeten worden doorgestuurd naar een speciale aanbieding of de volgende stap."],"Your email address can't be edited when using the Modern Checkout Style.":["Je e-mailadres kan niet worden bewerkt wanneer je de Moderne Checkout-stijl gebruikt."],"The Company field won't be visible if you're using the Instant Layout Style.":["Het veld Bedrijf zal niet zichtbaar zijn als je de Instant Layout-stijl gebruikt."],"Opt-in":["Inschrijven"],"The product previously added as an Order Bump has been deleted. Please add a new product.":["Het product dat eerder als een Order Bump was toegevoegd, is verwijderd. Voeg alstublieft een nieuw product toe."],"Choose a variation":["Kies een variant"],"For more information about order bump settings please %1$sClick here.%2$s":["Voor meer informatie over de instellingen van de order bump, %1$sKlik hier.%2$s"],"Sum of all step views in this funnel.":["Som van alle stapweergaven in deze trechter."],"Total upsell\/downsell revenue.":["Totaal upsell\/downsell omzet."],"Revenue per visit.":["Omzet per bezoek."],"Revenue per unique visitor.":["Omzet per unieke bezoeker."],"Sandbox Mode":["Sandboxmodus"],"Live Mode":["Live-modus"],"Learn":["Leer"],"File Size (MB)":["Bestandsgrootte (MB)"],"Accepted File Types":["Geaccepteerde bestandstypen"],"Back to Webhooks":["Terug naar Webhooks"],"Edit Webhook":["Webhook Bewerken"],"Add New Webhook":["Nieuwe Webhook Toevoegen"],"e.g. CRM Integration":["bijv. CRM Integratie"],"Endpoint URL":["Endpoint URL"],"Events":["Evenementen"],"Select events that will trigger this webhook.":["Selecteer evenementen die deze webhook zullen activeren."],"Select All":["Selecteer Alles"],"Enabled":["Ingeschakeld"],"Max Retries":["Maximale Herhalingen"],"Number of retry attempts for failed deliveries (0-5).":["Aantal pogingen voor mislukte leveringen (0-5)."],"Secret Key":["Geheime Sleutel"],"Used to sign webhook payloads (HMAC-SHA256).":["Gebruikt om webhook payloads te ondertekenen (HMAC-SHA256)."],"Copy to clipboard":["Kopi\u00ebren naar klembord"],"Copied!":["Gekopieerd!"],"Please enter a webhook name.":["Voer alstublieft een webhook naam in."],"Please enter a webhook URL.":["Voer alstublieft een webhook URL in."],"Please enter a valid URL.":["Voer alstublieft een geldige URL in."],"Please select at least one event.":["Selecteer alstublieft ten minste \u00e9\u00e9n evenement."],"Failed to save webhook.":["Mislukt om webhook op te slaan."],"Something went wrong.":["Er is iets misgegaan."],"Update Webhook":["Webhook bijwerken"],"Create Webhook":["Webhook aanmaken"],"Webhooks":["Webhooks"],"Send real-time event data to external services when key funnel events occur.":["Stuur real-time evenementgegevens naar externe services wanneer belangrijke funnelgebeurtenissen zich voordoen."],"No webhooks configured yet. Click \"Add New Webhook\" to get started.":["Er zijn nog geen webhooks geconfigureerd. Klik op \"Nieuwe Webhook Toevoegen\" om te beginnen."],"URL":["URL"],"Last Delivery":["Laatste Levering"],"events":["evenementen"],"Success":["Succes"],"Never triggered":["Nooit geactiveerd"],"Test sent!":["Test verzonden!"],"Send Test":["Test verzenden"],"Are you sure you want to delete this webhook?":["Weet je zeker dat je deze webhook wilt verwijderen?"],"Global CSS & Scripts":["Globale CSS & Scripts"],"Successfully Activated":["Succesvol Geactiveerd"],"Activation Failed":["Activatie Mislukt"],"File":["Bestand"],"Enter the maximum allowed file size. Default is 5MB.":["Voer de maximaal toegestane bestandsgrootte in. Standaard is 5MB."],"Enter comma-separated file extensions (e.g. jpg, png, gif)":["Voer komma-gescheiden bestandsextensies in (bijv. jpg, png, gif)"],"Invalid file type(s): %s":["Ongeldig bestandstype(s): %s"],"Delete Webhook":["Verwijder Webhook"]}}}
plugins/cartflows/languages/cartflows-es_ES-7e9426301d8b905cbde2a115e9c5e3ab.json:1:{"translation-revision-date":"2025-02-04T15:33:29+00:00","generator":"WP-CLI\/2.12.0","source":"admin-core\/assets\/build\/editor-app.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"(no title)":["(sin t\u00edtulo)"],"Thank You":["Gracias"],"Edit":["Editar"],"Delete":["Eliminar"],"Default":["Predeterminado"],"Funnels":["Embudos"],"Store Checkout":["Caja de la tienda"],"Automations":["Automatizaciones"],"Add-ons":["Complementos"],"Dashboard":["Tablero"],"Yes":["S\u00ed"],"No":["No"],"Step":["Paso"],"Settings":["Configuraciones"],"Rollback to Previous Version":["Revertir a la versi\u00f3n anterior"],"33%":["33%"],"50%":["50%"],"100%":["100%"],"Field ID":["ID de campo"],"Checked":["Revisado"],"Options":["Opciones"],"Placeholder":["Marcador de posici\u00f3n"],"Required":["Requerido"],"Collapsible":["Plegable"],"Activate WooCommerce":["Activar WooCommerce"],"Install WooCommerce":["Instalar WooCommerce"],"General":["General"],"Text":["Texto"],"Type":["Escribe"],"Width":["Ancho"],"Shipping":["Env\u00edo"],"Order Bumps":["Incrementos de Pedido"],"Search for a coupon":["Buscar un cup\u00f3n"],"Auto Apply Coupon":["Aplicar cup\u00f3n autom\u00e1ticamente"],"Product Options":["Opciones de producto"],"Advanced":["Avanzado"],"Product":["Producto"],"Title":["T\u00edtulo"],"Content":["Contenido"],"Total Visits":["Total de visitas"],"Upgrade to CartFlows Pro":["Actualiza a CartFlows Pro"],"Search Steps":["Pasos de b\u00fasqueda"],"Enable Custom Field Editor":["Habilitar el Editor de Campos Personalizados"],"Search for a Product":["Buscar un producto"],"Billing":["Facturaci\u00f3n"],"Settings Saved":["Ajustes guardados"],"Saving\u2026":["Guardando\u2026"],"Save Settings":["Guardar configuraci\u00f3n"],"Regular Price of the product":["Precio regular del producto"],"Price after discount.":["Precio despu\u00e9s del descuento."],"Product Name":["Nombre del producto"],"Use {{product_name}} and {{quantity}} to dynamically fetch respective product details.":["Utiliza {{product_name}} y {{quantity}} para obtener din\u00e1micamente los detalles respectivos del producto."],"Subtext":["Subtexto"],"Use {{quantity}}, {{discount_value}}, {{discount_percent}} to dynamically fetch respective product details.":["Utiliza {{quantity}}, {{discount_value}}, {{discount_percent}} para obtener din\u00e1micamente los detalles respectivos del producto."],"Enable Highlight":["Habilitar resaltado"],"Highlight Text":["Resaltar texto"],"Create New Product":["Crear nuevo producto"],"Add":["A\u00f1adir"],"Once you have selected products, they will be displayed here.":["Una vez que hayas seleccionado productos, se mostrar\u00e1n aqu\u00ed."],"Items":["Art\u00edculos"],"Quantity":["Cantidad"],"Discount":["Descuento"],"Adding\u2026":["Agregando\u2026"],"Please search and select at-lease one product to add.":["Por favor, busca y selecciona al menos un producto para a\u00f1adir."],"Reset":["Restablecer"],"Image Preview":["Vista previa de la imagen"],"Upload a file":["Subir un archivo"],"or drag and drop":["o arrastrar y soltar"],"PNG, JPG, GIF up to 10MB":["PNG, JPG, GIF hasta 10MB"],"Select Dates":["Seleccionar fechas"],"Please upgrade to the %1$s CartFlows Pro %2$s to use %3$s feature.":["Por favor, actualice a %1$s CartFlows Pro %2$s para usar la funci\u00f3n %3$s."],"Please upgrade to the %1$s CartFlows Higher Plan %2$s to use %3$s feature.":["Por favor, actualice al %1$s Plan Superior de CartFlows %2$s para usar la funci\u00f3n %3$s."],"Please upgrade to the CartFlows Higher Plan to use the %s feature.":["Por favor, actualice al Plan Superior de CartFlows para usar la funci\u00f3n %s."],"Role":["Rol"],"Access":["Acceso"],"For more information about the user role management please %1$sClick here.%2$s":["Para obtener m\u00e1s informaci\u00f3n sobre la gesti\u00f3n de roles de usuario, por favor %1$sHaz clic aqu\u00ed.%2$s"],"Are you sure you want to rollback to %1$s v%2$s?":["\u00bfEst\u00e1s seguro de que quieres revertir a %1$s v%2$s?"],"Rollback":["Revertir"],"Cancel":["Cancelar"],"Experiencing an issue with the current version of CartFlows? Roll back to a previous version to help troubleshoot the problem.":["\u00bfExperimentas un problema con la versi\u00f3n actual de CartFlows? Revi\u00e9rtela a una versi\u00f3n anterior para ayudar a solucionar el problema."],"Regenerate Now":["Regenerar ahora"],"Reset Permalinks Settings":["Restablecer la configuraci\u00f3n de enlaces permanentes"],"Activate License":["Activar licencia"],"Deactivate License":["Desactivar licencia"],"Please enter a valid license key!":["\u00a1Por favor, introduzca una clave de licencia v\u00e1lida!"],"Processing":["Procesando"],"Unknown error occurred while activating the license.":["Se produjo un error desconocido al activar la licencia."],"Facebook Pixel":["Facebook Pixel"],"Google Analytics Pixel":["Pixel de Google Analytics"],"Google Ads Pixel":["Pixel de Google Ads"],"Tiktok Pixel":["P\u00edxel de Tiktok"],"Pinterest Tag":["Etiqueta de Pinterest"],"Snapchat Pixel":["Snapchat Pixel"],"Google Auto Address":["Direcci\u00f3n autom\u00e1tica de Google"],"Regenerate Inline CSS":["Regenerar CSS en l\u00ednea"]," Regenerating\u2026.":["Regenerando\u2026."],"Regenerated":["Regenerado"],"If you are using the CartFlows Shortcode and using the Design Settings, then this option will regenerate the steps inline CSS. To learn more, %1$1s Click here %2$2s.":["Si est\u00e1s utilizando el shortcode de CartFlows y los ajustes de dise\u00f1o, entonces esta opci\u00f3n regenerar\u00e1 los pasos del CSS en l\u00ednea. Para saber m\u00e1s, %1$1s haz clic aqu\u00ed %2$2s."],"Updating":["Actualizando"],"Permalinks reset successfully":["Enlaces permanentes restablecidos con \u00e9xito"],"For more information about the CartFlows Permalink settings please %1$sClick here.%2$s":["Para obtener m\u00e1s informaci\u00f3n sobre la configuraci\u00f3n de los enlaces permanentes de CartFlows, por favor %1$sHaz clic aqu\u00ed.%2$s"],"Oops! You don't have access to this page.":["\u00a1Vaya! No tienes acceso a esta p\u00e1gina."],"You don't have permission to access this page. Please reach out to your admin for help.":["No tienes permiso para acceder a esta p\u00e1gina. Por favor, contacta a tu administrador para obtener ayuda."],"Back to Dashboard":["Volver al panel de control"],"Integrations":["Integraciones"],"User Role Manager":["Administrador de Roles de Usuario"],"Permalink":["Enlace permanente"],"Version Control":["Control de versiones"],"Order":["Orden"],"License":["Licencia"],"Sync Knowledge Base":["Sincronizar la base de conocimientos"],"Knowledge Base":["Base de Conocimientos"],"Search knowledge base":["Buscar en la base de conocimientos"],"No Docs Founds":["No se encontraron documentos"],"Please try syncing the docs library":["Por favor, intenta sincronizar la biblioteca de documentos"],"Syncing\u2026":["Sincronizando\u2026"],"Synced. Reloading..":["Sincronizado. Recargando.."],"Need Help?":["\u00bfNecesitas ayuda?"],"We aim to answer all priority support requests within 2-3 hours.":["Nuestro objetivo es responder a todas las solicitudes de soporte prioritario dentro de 2-3 horas."],"Get Support":["Obtener soporte"],"All Documentation":["Toda la documentaci\u00f3n"],"Browse documentation, reference material, and tutorials for CartFlows.":["Consulta la documentaci\u00f3n, el material de referencia y los tutoriales de CartFlows."],"View documentation":["Ver documentaci\u00f3n"],"Videos":["Videos"],"Browse tutorial videos on our YouTube channel.":["Explora videos tutoriales en nuestro canal de YouTube."],"Youtube Channel":["Canal de Youtube"],"Support":["Soporte"],"What's New?":["\u00bfQu\u00e9 hay de nuevo?"],"Unlicensed":["Sin licencia"],"Licensed":["Con licencia"],"Open Global Settings":["Abrir configuraciones globales"],"Tutorial Videos":["Videos tutoriales"],"More Options":["M\u00e1s opciones"],"Control":["Control"],"Variation-%d":["Variaci\u00f3n-%d"],"No Product Assigned":["No hay producto asignado"],"Store Checkout - Remove selected checkout product":["Pago en tienda - Eliminar producto seleccionado del carrito"],"PRO":["PRO"],"Offer Accepted":["Oferta aceptada"],"Offer Rejected":["Oferta rechazada"],"Invalid Position":["Posici\u00f3n no v\u00e1lida"],"Views":["Vistas"],"Conversions":["Conversiones"],"Revenue":["Ingresos"],"Upgrade to Pro":["Actualizar a Pro"],"%s Step":["Paso %s"],"Step Editing is Disabled":["La edici\u00f3n de pasos est\u00e1 deshabilitada"],"Open Settings":["Abrir configuraci\u00f3n"],"Duplicate Step":["Paso duplicado"],"Do you want to duplicate this step? Are you sure?":["\u00bfQuieres duplicar este paso? \u00bfEst\u00e1s seguro?"],"Delete Step":["Eliminar paso"],"Do you want to delete this step? Are you sure?":["\u00bfQuieres eliminar este paso? \u00bfEst\u00e1s seguro?"],"Declare Winner":["Declarar ganador"],"Do you want to declare this step as winner? Are you sure?":["\u00bfQuieres declarar este paso como ganador? \u00bfEst\u00e1s seguro?"],"Archive Step":["Paso de archivo"],"Do you want to archive this step? Are you sure?":["\u00bfQuieres archivar este paso? \u00bfEst\u00e1s seguro?"],"Saving..":["Guardando.."],"Saved":["Guardado"],"Reloading..":["Recargando.."],"Split Test Testing":["Prueba de Test A\/B"],"Stop Split Test":["Detener prueba dividida"],"Start Split Test":["Iniciar prueba dividida"],"Split Test":["Prueba A\/B"],"Stopping\u2026":["Deteniendo\u2026"],"Starting\u2026":["Iniciando\u2026"],"Reloading\u2026":["Recargando\u2026"],"Split Test Settings":["Configuraci\u00f3n de Prueba Dividida"],"Restore Archived Variation":["Restaurar variaci\u00f3n archivada"],"Do you want to restore this archived variation? Are you sure?":["\u00bfQuieres restaurar esta variaci\u00f3n archivada? \u00bfEst\u00e1s seguro?"],"Trash Archived Variation":["Variaci\u00f3n archivada de basura"],"This action will trash this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Esta acci\u00f3n eliminar\u00e1 permanentemente esta variaci\u00f3n archivada y sus datos anal\u00edticos. %1$s \u00bfDesea eliminar esta variaci\u00f3n archivada?"],"Hide Archived Variation":["Ocultar variaci\u00f3n archivada"],"This action will hide this archived variation from the list of steps, but its analytics will be visible. %1$s Do you want to hide this archived variation?":["Esta acci\u00f3n ocultar\u00e1 esta variaci\u00f3n archivada de la lista de pasos, pero su an\u00e1lisis ser\u00e1 visible. %1$s \u00bfDesea ocultar esta variaci\u00f3n archivada?"],"This action will delete this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Esta acci\u00f3n eliminar\u00e1 esta variaci\u00f3n archivada y sus datos anal\u00edticos de forma permanente. %1$s \u00bfDesea eliminar esta variaci\u00f3n archivada?"],"Deleted On: ":["Eliminado el:"],"Archived On: ":["Archivado en:"],"Archived Steps":["Pasos archivados"],"Edit Step Name":["Editar nombre del paso"],"Save":["Guardar"],"Update Template":["Actualizar plantilla"],"Changing the template will permanently delete the current design in this step. Would you still like to proceed?":["Cambiar la plantilla eliminar\u00e1 permanentemente el dise\u00f1o actual en este paso. \u00bfA\u00fan deseas continuar?"],"Change Template":["Cambiar plantilla"],"If you are using shortcodes, enable this design settings to apply styles.":["Si est\u00e1s utilizando c\u00f3digos cortos, activa esta configuraci\u00f3n de dise\u00f1o para aplicar estilos."],"Enable Design Settings":["Habilitar configuraciones de dise\u00f1o"],"Activate %s":["Activar %s"],"Activating %s":["Activando %s"],"Successfully Activated!":["\u00a1Activado con \u00e9xito!"],"Failed! Activation!":["\u00a1Fallido! \u00a1Activaci\u00f3n!"],"Upgrade to Cartflows Pro":["Actualiza a Cartflows Pro"],"Activate the License":["Activar la licencia"],"Step Type: ":["Tipo de paso:"],"License is required!":["\u00a1Se requiere licencia!"],"Activate the license to modify this offer step's settings":["Activa la licencia para modificar la configuraci\u00f3n de este paso de la oferta"],"No product Selected":["No se ha seleccionado ning\u00fan producto"],"Once you select the product, they will be displayed here.":["Una vez que selecciones el producto, se mostrar\u00e1n aqu\u00ed."],"Shipping Rate":["Tarifa de env\u00edo"],"Once you have add product, it will be displayed here.":["Una vez que hayas agregado el producto, se mostrar\u00e1 aqu\u00ed."],"Coupon will apply on checkout page":["El cup\u00f3n se aplicar\u00e1 en la p\u00e1gina de pago"],"AND":["Y"],"Please Update the CartFlows Pro to the latest version to use the conditional order bump feature.":["Por favor, actualice CartFlows Pro a la \u00faltima versi\u00f3n para usar la funci\u00f3n de aumento de pedido condicional."],"Enable conditional order bump ":["Habilitar el aumento de pedido condicional"],"By enabling this option, you can create the conditions to display the order bump.":["Al habilitar esta opci\u00f3n, puedes crear las condiciones para mostrar el aumento de pedido."],"Show this order bump if following conditions are true":["Muestra este aumento de pedido si se cumplen las siguientes condiciones"],"Add Condition":["Agregar condici\u00f3n"],"OR":["O"],"Add Conditions Group":["Agregar grupo de condiciones"],"Order Bump Product Image":["Imagen del producto adicional en el pedido"],"Styles":["Estilos"],"Conditions":["Condiciones"],"Save Changes":["Guardar cambios"],"You have made changes. Do you want to save the changes?":["Has realizado cambios. \u00bfQuieres guardar los cambios?"],"No product":["Sin producto"],"Duplicate Order Bump":["Duplicar Pedido Adicional"],"Edit Order Bump":["Editar Order Bump"],"Trash Order Bump":["Basura Orden Bump"],"Do you really want to trash this order bump permanently?":["\u00bfRealmente deseas eliminar este aumento de pedido de forma permanente?"],"Delete Order Bump":["Eliminar Order Bump"],"Status":["Estado"],"Actions":["Acciones"],"Create an order bump.":["Crea un aumento de pedido."],"Enter order bump name":["Ingrese el nombre del complemento de pedido"],"Please enter the order bump title":["Por favor, introduzca el t\u00edtulo del complemento de pedido"],"Preview":["Vista previa"],"View in Full Screen":["Ver en pantalla completa"],"Exit Full Screen":["Salir de pantalla completa"],"Order Submitted":["Pedido enviado"],"Special Offer":["Oferta Especial"],"Order Receipt":["Recibo de Pedido"],"Enable Checkout Offer":["Habilitar oferta de pago"],"Dynamic Conditions":["Condiciones Din\u00e1micas"],"Please Update the CartFlows Pro to the latest version to use the dynamic offers feature.":["Por favor, actualice CartFlows Pro a la \u00faltima versi\u00f3n para usar la funci\u00f3n de ofertas din\u00e1micas."],"Enable Dynamic Offers":["Habilitar ofertas din\u00e1micas"],"Redirect to: ":["Redirigir a:"],"Search for step\u2026":["Buscar paso\u2026"],"If the following conditions are true":["Si las siguientes condiciones son verdaderas"],"Add Dynamic Offer":["Agregar oferta din\u00e1mica"],"Search for default step\u2026":["Buscar el paso predeterminado\u2026"],"If all of the above conditions failed.":["Si todas las condiciones anteriores fallaron."],"Label":["Etiqueta"],"ID":["ID"],"Enable":["Habilitar"],"Add New Field":["Agregar nuevo campo"],"Date & Time":["Fecha y hora"],"Add Custom Field":["Agregar campo personalizado"],"TextArea":["\u00c1rea de texto"],"Number":["N\u00famero"],"Checkbox":["Casilla de verificaci\u00f3n"],"Radio":["Radio"],"Select":["Seleccionar"],"Hidden":["Oculto"],"Add To":["Agregar a"],"Label %1$s*%2$s":["Etiqueta %1$s*%2$s"],"Field value will store in this meta key. Add field id without prefix like \"billing_\" or \"shipping_\". %s Use \"_\" instead of spaces.":["El valor del campo se almacenar\u00e1 en esta clave meta. Agregue el id del campo sin prefijo como \"billing_\" o \"shipping_\". %s Use \"_\" en lugar de espacios."],"Min Value":["Valor m\u00ednimo"],"Max Value":["Valor m\u00e1ximo"],"Enter your options separated by (|).":["Ingrese sus opciones separadas por (|)."],"UnChecked":["Desmarcado"],"Field Input Type":["Tipo de entrada de campo"],"Date":["Fecha"],"Time":["Tiempo"],"Min ":["Min"],"Max ":["Max"],"Show in Email":["Mostrar en correo electr\u00f3nico"],"Billing Fields":["Campos de facturaci\u00f3n"],"Shipping Fields":["Campos de env\u00edo"],"Delete Field":["Eliminar campo"],"Are you really want to delete field?":["\u00bfRealmente quieres eliminar el campo?"],"Field Editor":["Editor de Campo"],"Label is required field":["La etiqueta es un campo obligatorio"],"WooCommerce is Required!":["\u00a1Se requiere WooCommerce!"],"To modify the %s step options, please install and activate the WooCommerce plugin.":["Para modificar las opciones del paso %s, por favor instala y activa el plugin WooCommerce."],"Activating\u2026":["Activando\u2026"],"Activated":["Activado"],"Funnel Settings":["Configuraci\u00f3n del embudo"],"Save Setting":["Guardar configuraci\u00f3n"],"Disable Store Checkout":["Desactivar la caja de la tienda"],"Enable Store Checkout":["Habilitar la caja de la tienda"],"Edit Title":["Editar t\u00edtulo"],"Publish":["Publicar"],"Do you really want to publish this funnel?":["\u00bfRealmente quieres publicar este embudo?"],"Draft Funnel":["Embudo de Borrador"],"Do you really want to draft this funnel?":["\u00bfRealmente quieres redactar este embudo?"],"Unique Visits":["Visitas \u00danicas"],"Conversion Rate":["Tasa de conversi\u00f3n"],"Total number of orders.":["N\u00famero total de pedidos."],"Grand total of all orders.":["Total general de todos los pedidos."],"Average total of every order.":["Promedio total de cada pedido."],"Grand total of all order bumps.":["Total general de todos los aumentos de pedidos."],"Export Flow":["Flujo de Exportaci\u00f3n"],"View Funnel":["Ver embudo"],"Open Funnel Settings":["Abrir configuraci\u00f3n del embudo"],"Delete Store Checkout":["Eliminar pago de la tienda"],"Do you really want to delete store checkout?%1$1sNOTE: This action cannot be reversed.":["\u00bfRealmente deseas eliminar el pago de la tienda?%1$1sNOTA: Esta acci\u00f3n no se puede deshacer."],"archived_date":["archived_date"],"%1$sNote:%2$s The orders which are placed by the admins are not considered while calculating the analytics.":["%1$sNota:%2$s Los pedidos realizados por los administradores no se consideran al calcular los an\u00e1lisis."],"Reset Analytics":["Restablecer an\u00e1lisis"],"Are you really want to reset funnel analytics?":["\u00bfRealmente quieres restablecer el an\u00e1lisis del embudo?"],"Resetting":["Restableciendo"],"Automation for":["Automatizaci\u00f3n para"],"Create a distraction free, high-converting checkout experience without needing a page builder.":["Crea una experiencia de pago sin distracciones y de alta conversi\u00f3n sin necesidad de un creador de p\u00e1ginas."],"Funnel Steps":["Pasos del embudo"],"Add New Step":["Agregar nuevo paso"],"No Steps Added.":["No se han a\u00f1adido pasos."],"Seems like there are no steps created or added in this flow":["Parece que no hay pasos creados o a\u00f1adidos en este flujo"],"Add new step":["Agregar nuevo paso"],"Select Step Type":["Seleccionar tipo de paso"],"Activating WooCommerce..":["Activando WooCommerce.."],"Installing WooCommerce..":["Instalando WooCommerce.."],"Successfully Installed!":["\u00a1Instalado con \u00e9xito!"],"Installation Failed!":["\u00a1Instalaci\u00f3n fallida!"],"Import Step":["Paso de importaci\u00f3n"],"Add multiple steps to your flows today with an upgraded CartFlows plan.":["Agrega m\u00faltiples pasos a tus flujos hoy con un plan mejorado de CartFlows."],"Get CartFlows Higher Plan":["Obtener el plan superior de CartFlows"],"Add multiple steps to your flows by activating %s.":["Agrega m\u00faltiples pasos a tus flujos activando %s."],"Add %1$s step to your flows by activating %2$s.":["Agrega el paso %1$s a tus flujos activando %2$s."],"Add unlimited income boosting one-click %s to your flows when you upgrade to our CartFlows Higher plan today.":["Agrega %s de un solo clic para aumentar ingresos ilimitados a tus flujos cuando actualices a nuestro plan CartFlows Higher hoy."],"Add %1$s step to your flow by activating CartFlows license.":["Agrega el paso %1$s a tu flujo activando la licencia de CartFlows."],"Access all of our pro templates by activating %s.":["Accede a todas nuestras plantillas profesionales activando %s."],"Access all of our pro templates when you upgrade your plan to CartFlows Pro today.":["Accede a todas nuestras plantillas profesionales cuando actualices tu plan a CartFlows Pro hoy."],"Get CartFlows Pro":["Obtener CartFlows Pro"],"Add %1$s step to your flows by activating license.":["Agrega el paso %1$s a tus flujos activando la licencia."],"You need WooCommerce plugin installed and activated to import this step.":["Necesitas tener el plugin WooCommerce instalado y activado para importar este paso."],"Imported! Redirecting\u2026":["\u00a1Importado! Redirigiendo\u2026"]," Please sync the library and try importing the template again.":["Por favor, sincroniza la biblioteca e intenta importar la plantilla nuevamente."],"Import Failed! Try again.":["\u00a1La importaci\u00f3n fall\u00f3! Int\u00e9ntalo de nuevo."],"Create Step":["Crear paso"],"Creating Step..":["Creando paso.."],"Step Created! Redirecting\u2026":["\u00a1Paso creado! Redirigiendo\u2026"],"Failed to Create Step!":["\u00a1Error al crear el paso!"],"Activate license for adding more steps and other features.":["Activa la licencia para a\u00f1adir m\u00e1s pasos y otras funciones."],"Close the window":["Cierra la ventana"],"Name Your Step":["Nombre su paso"],"Step Name":["Nombre del paso"],"Enter Step Name":["Ingrese el nombre del paso"],"Learn How":["Aprende c\u00f3mo"],"Create from Scratch":["Crear desde cero"],"Step thumbnail image":["Imagen en miniatura del paso"],"Import":["Importar"],"Back":["Atr\u00e1s"],"Sync Library":["Sincronizar biblioteca"],"Importing page %d":["Importando p\u00e1gina %d"],"Sync Complete":["Sincronizaci\u00f3n completa"],"Syncing Library\u2026":["Sincronizando biblioteca\u2026"],"Library Synced":["Biblioteca sincronizada"],"Steps Library":["Biblioteca de pasos"],"Get CartFlows Higher plan":["Obtener el plan superior de CartFlows"],"Activate license for adding more flows and other features.":["Activa la licencia para a\u00f1adir m\u00e1s flujos y otras caracter\u00edsticas."],"Importing Step..":["Importando paso.."],"Close":["Cerrar"],"Error":["Error"],"Add unlimited income boosting one-click upsells to your flows by activating %s":["Agrega ventas adicionales de un solo clic que aumentan los ingresos ilimitadamente a tus flujos activando %s"],"Add unlimited income boosting one-click upsells to your flows when you upgrade to our CartFlows Plus or Pro plan today.":["Agrega ventas adicionales de un solo clic que aumentan los ingresos ilimitadamente a tus flujos cuando actualizas a nuestro plan CartFlows Plus o Pro hoy mismo."],"Access all of our pro templates by activating %s":["Accede a todas nuestras plantillas profesionales activando %s"],"Templates for %s":["Plantillas para %s"],"Please wait\u2026":["Por favor, espera\u2026"],"Please wait. Duplicating funnel\u2026":["Por favor espera. Duplicando embudo\u2026"],"Please wait. Drafting funnel\u2026":["Por favor espera. Redactando embudo\u2026"],"Please wait. Deleting funnel\u2026":["Por favor espera. Eliminando embudo\u2026"],"Please wait. Restoring funnel\u2026":["Por favor espera. Restaurando el embudo\u2026"],"Please wait. Exporting\u2026":["Por favor espera. Exportando\u2026"],"Please wait. Duplicating step\u2026":["Por favor espera. Duplicando paso\u2026"],"Please wait. Deleting step\u2026":["Por favor espera. Eliminando paso\u2026"],"Please wait. Creating variation\u2026":["Por favor espera. Creando variaci\u00f3n\u2026"],"Please wait. Archiving variation\u2026":["Por favor espera. Archivando variaci\u00f3n\u2026"],"Please wait. Declaring winner\u2026":["Por favor espera. Declarando ganador\u2026"],"Analytics":["Anal\u00edtica"],"Draft":["Borrador"],"Name":["Nombre"],"Activating":["Activando"],"Failed":["Fallido"],"Remove Image":["Eliminar imagen"],"Unlock Premium Features with CartFlows PRO!":["\u00a1Desbloquea las funciones premium con CartFlows PRO!"],"Get the tools you need to create powerful sales funnels, increase conversions, and grow your business with ease.":["Obt\u00e9n las herramientas que necesitas para crear embudos de ventas poderosos, aumentar las conversiones y hacer crecer tu negocio con facilidad."],"Select a Settings Tab":["Selecciona una pesta\u00f1a de configuraci\u00f3n"],"Free vs Pro":["Gratis vs Pro"],"Increase Your Revenue with Smart Order Bumps":["Aumenta tus ingresos con incrementos de pedido inteligentes"],"Boost sales with CartFlows\u2019 Order Bump! Offer personalized add-ons at checkout to increase revenue effortlessly. Quick to set up, no coding needed!":["Aumenta las ventas con el Order Bump de CartFlows. Ofrece complementos personalizados en el proceso de pago para aumentar los ingresos sin esfuerzo. \u00a1R\u00e1pido de configurar, sin necesidad de programaci\u00f3n!"],"Show the Right Offer to the Right People \u2013 Automatically!":["\u00a1Muestra la oferta adecuada a las personas adecuadas autom\u00e1ticamente!"],"Personalize deals based on location, cart details, and more. Upgrade to CartFlows PRO and unlock this smart feature today!":["Personaliza ofertas basadas en la ubicaci\u00f3n, los detalles del carrito y m\u00e1s. \u00a1Actualiza a CartFlows PRO y desbloquea esta funci\u00f3n inteligente hoy mismo!"],"Boost Sales Instantly with Auto-Applied Coupons!":["\u00a1Aumenta las ventas al instante con cupones aplicados autom\u00e1ticamente!"],"No codes, no hassle\u2014discounts apply instantly at checkout. Upgrade to CartFlows PRO and start converting more customers today!":["Sin c\u00f3digos, sin complicaciones: los descuentos se aplican instant\u00e1neamente al finalizar la compra. \u00a1Actualiza a CartFlows PRO y comienza a convertir m\u00e1s clientes hoy mismo!"],"Give Your Customers More Choices, Boost Your Sales":["Ofrece a tus clientes m\u00e1s opciones, aumenta tus ventas"],"Make buying easier with flexible product options. Let customers make the right choices from your checkout. Upgrade to CartFlows PRO and start customizing today!":["Haz que comprar sea m\u00e1s f\u00e1cil con opciones de productos flexibles. Permite que los clientes tomen las decisiones correctas desde tu proceso de pago. \u00a1Actualiza a CartFlows PRO y comienza a personalizar hoy!"],"Optin Product":["Producto de suscripci\u00f3n"],"Select free & virtual product only. Once you select a product, it will be displayed here.":["Seleccione solo productos gratuitos y virtuales. Una vez que seleccione un producto, se mostrar\u00e1 aqu\u00ed."],"Search for a Free & Virtual Product":["Buscar un Producto Gratuito y Virtual"],"Please select a free & virtual product only.":["Por favor, seleccione solo un producto gratuito y virtual."],"Free":["Gratis"],"A\/B Testing":["Pruebas A\/B"],"Optimize your sales with A\/B testing in CartFlows! Experiment with product pricing, page layouts, messaging, and design. Create variants, analyze results, and discover new ways to boost revenue.":["\u00a1Optimiza tus ventas con pruebas A\/B en CartFlows! Experimenta con precios de productos, dise\u00f1os de p\u00e1gina, mensajes y dise\u00f1o. Crea variantes, analiza resultados y descubre nuevas formas de aumentar los ingresos."],"Modern Cart":["Carrito Moderno"],"Enable Instant Layout":["Habilitar dise\u00f1o instant\u00e1neo"],"Disabled":["Desactivado"],"upgrading to PRO":["actualizaci\u00f3n a PRO"],"activating CartFlows Pro":["activando CartFlows Pro"],"You're using":["Est\u00e1s usando"],"CartFlows Free":["CartFlows Gratis"],"To unlock more features, consider":["Para desbloquear m\u00e1s funciones, considere"],"Activate CartFlows Pro":["Activar CartFlows Pro"],"You can't edit this step directly because Instant Layout is turned on in the funnel settings. To make design changes, go to the Design tab inside this step's settings.":["No puedes editar este paso directamente porque el Dise\u00f1o Instant\u00e1neo est\u00e1 activado en la configuraci\u00f3n del embudo. Para realizar cambios de dise\u00f1o, ve a la pesta\u00f1a de Dise\u00f1o dentro de la configuraci\u00f3n de este paso."],"Use this setting to customize the style of the Instant %s Layout.":["Utiliza esta configuraci\u00f3n para personalizar el estilo del dise\u00f1o Instant\u00e1neo %s."],"Turn this on to set up rules that decide when visitors should be redirected to a special offer or the next step.":["Activa esto para configurar reglas que decidan cu\u00e1ndo los visitantes deben ser redirigidos a una oferta especial o al siguiente paso."],"Your email address can't be edited when using the Modern Checkout Style.":["No se puede editar tu direcci\u00f3n de correo electr\u00f3nico al usar el estilo de pago moderno."],"The Company field won't be visible if you're using the Instant Layout Style.":["El campo de la empresa no ser\u00e1 visible si est\u00e1s utilizando el estilo de dise\u00f1o instant\u00e1neo."],"Opt-in":["Optar por participar"],"The product previously added as an Order Bump has been deleted. Please add a new product.":["El producto previamente a\u00f1adido como un Order Bump ha sido eliminado. Por favor, a\u00f1ade un nuevo producto."],"Choose a variation":["Elige una variaci\u00f3n"],"For more information about order bump settings please %1$sClick here.%2$s":["Para obtener m\u00e1s informaci\u00f3n sobre la configuraci\u00f3n del aumento de pedidos, por favor %1$sHaz clic aqu\u00ed.%2$s"],"Sum of all step views in this funnel.":["Suma de todas las vistas de pasos en este embudo."],"Total upsell\/downsell revenue.":["Ingresos totales por venta adicional\/venta descendente."],"Revenue per visit.":["Ingresos por visita."],"Revenue per unique visitor.":["Ingresos por visitante \u00fanico."],"Sandbox Mode":["Modo Sandbox"],"Live Mode":["Modo en vivo"],"Learn":["Aprender"],"File Size (MB)":["Tama\u00f1o de Archivo (MB)"],"Accepted File Types":["Tipos de Archivo Aceptados"],"Back to Webhooks":["Volver a Webhooks"],"Edit Webhook":["Editar Webhook"],"Add New Webhook":["Agregar nuevo Webhook"],"e.g. CRM Integration":["p. ej. Integraci\u00f3n de CRM"],"Endpoint URL":["URL del endpoint"],"Events":["Eventos"],"Select events that will trigger this webhook.":["Seleccione los eventos que activar\u00e1n este webhook."],"Select All":["Seleccionar todo"],"Enabled":["Habilitado"],"Max Retries":["M\u00e1ximas reintentos"],"Number of retry attempts for failed deliveries (0-5).":["N\u00famero de intentos de reintento para entregas fallidas (0-5)."],"Secret Key":["Clave secreta"],"Used to sign webhook payloads (HMAC-SHA256).":["Utilizada para firmar las cargas \u00fatiles del webhook (HMAC-SHA256)."],"Copy to clipboard":["Copiar al portapapeles"],"Copied!":["\u00a1Copiado!"],"Please enter a webhook name.":["Por favor, ingrese un nombre para el webhook."],"Please enter a webhook URL.":["Por favor, ingrese una URL para el webhook."],"Please enter a valid URL.":["Por favor, ingrese una URL v\u00e1lida."],"Please select at least one event.":["Por favor, seleccione al menos un evento."],"Failed to save webhook.":["Error al guardar el webhook."],"Something went wrong.":["Algo sali\u00f3 mal."],"Update Webhook":["Actualizar Webhook"],"Create Webhook":["Crear Webhook"],"Webhooks":["Webhooks"],"Send real-time event data to external services when key funnel events occur.":["Env\u00eda datos de eventos en tiempo real a servicios externos cuando ocurren eventos clave del embudo."],"No webhooks configured yet. Click \"Add New Webhook\" to get started.":["No hay webhooks configurados a\u00fan. Haz clic en \"Agregar Nuevo Webhook\" para comenzar."],"URL":["URL"],"Last Delivery":["\u00daltima Entrega"],"events":["eventos"],"Success":["\u00c9xito"],"Never triggered":["Nunca activado"],"Test sent!":["\u00a1Prueba enviada!"],"Send Test":["Enviar Prueba"],"Are you sure you want to delete this webhook?":["\u00bfEst\u00e1s seguro de que deseas eliminar este webhook?"],"Global CSS & Scripts":["CSS y Scripts Globales"],"Successfully Activated":["Activado con \u00c9xito"],"Activation Failed":["Fallo en la Activaci\u00f3n"],"File":["Archivo"],"Enter the maximum allowed file size. Default is 5MB.":["Ingresa el tama\u00f1o m\u00e1ximo de archivo permitido. El valor predeterminado es 5MB."],"Enter comma-separated file extensions (e.g. jpg, png, gif)":["Ingresa las extensiones de archivo separadas por comas (por ejemplo, jpg, png, gif)"],"Invalid file type(s): %s":["Tipo(s) de archivo no v\u00e1lidos: %s"],"Delete Webhook":["Eliminar Webhook"]}}}
plugins/cartflows/languages/cartflows-pt_PT-ee6a0bf214c77dcdac7a8e34bb625df3.json:1:{"translation-revision-date":"2025-02-04T15:33:29+00:00","generator":"WP-CLI\/2.12.0","source":"admin-core\/assets\/build\/settings-app.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"(no title)":["(sem t\u00edtulo)"],"Thank You":["Obrigado"],"View":["Ver"],"Edit":["Editar"],"Duplicate":["Duplicar"],"Export":["Exportar"],"Delete":["Excluir"],"Default":["Padr\u00e3o"],"Restore":["Restaurar"],"Edit Funnel":["Editar Funil"],"Funnels":["Funis"],"Store Checkout":["Finaliza\u00e7\u00e3o da Compra"],"Automations":["Automatiza\u00e7\u00f5es"],"Add-ons":["Complementos"],"Dashboard":["Painel de Controle"],"Cart Abandonment":["Abandono de Carrinho"],"Yes":["Sim"],"No":["N\u00e3o"],"Step":["Passo"],"Settings":["Configura\u00e7\u00f5es"],"Rollback to Previous Version":["Reverter para a Vers\u00e3o Anterior"],"33%":["33%"],"50%":["50%"],"100%":["100%"],"Field ID":["ID do campo"],"Checked":["Verificado"],"Options":["Op\u00e7\u00f5es"],"Placeholder":["Espa\u00e7o reservado"],"Required":["Obrigat\u00f3rio"],"Collapsible":["Dobr\u00e1vel"],"Activate WooCommerce":["Ativar WooCommerce"],"Install WooCommerce":["Instalar WooCommerce"],"General":["Geral"],"Text":["Texto"],"Type":["Digite"],"Width":["Largura"],"Shipping":["Envio"],"Order Bumps":["Ofertas Adicionais"],"Dynamic Offers":["Ofertas Din\u00e2micas"],"Search for a coupon":["Procure um cupom"],"Auto Apply Coupon":["Aplicar Cupom Automaticamente"],"Product Options":["Op\u00e7\u00f5es de Produto"],"Advanced":["Avan\u00e7ado"],"Product":["Produto"],"Title":["T\u00edtulo"],"Content":["Conte\u00fado"],"Total Visits":["Total de Visitas"],"All Flows":["Todos os Fluxos"],"Add New":["Adicionar Novo"],"Upgrade to CartFlows Pro":["Atualize para o CartFlows Pro"],"Search Steps":["Etapas de Pesquisa"],"Enable Custom Field Editor":["Ativar Editor de Campo Personalizado"],"Search for a Product":["Procurar um Produto"],"Billing":["Faturamento"],"Settings Saved":["Configura\u00e7\u00f5es salvas"],"Saving\u2026":["Salvando\u2026"],"Save Settings":["Salvar configura\u00e7\u00f5es"],"Regular Price of the product":["Pre\u00e7o regular do produto"],"Price after discount.":["Pre\u00e7o ap\u00f3s desconto."],"Product Name":["Nome do Produto"],"Use {{product_name}} and {{quantity}} to dynamically fetch respective product details.":["Use {{product_name}} e {{quantity}} para buscar dinamicamente os detalhes respectivos do produto."],"Subtext":["Subtexto"],"Use {{quantity}}, {{discount_value}}, {{discount_percent}} to dynamically fetch respective product details.":["Use {{quantity}}, {{discount_value}}, {{discount_percent}} para buscar dinamicamente os respectivos detalhes do produto."],"Enable Highlight":["Ativar Destaque"],"Highlight Text":["Destacar Texto"],"Create New Product":["Criar Novo Produto"],"Add":["Adicionar"],"Once you have selected products, they will be displayed here.":["Depois de selecionar os produtos, eles ser\u00e3o exibidos aqui."],"Items":["Itens"],"Quantity":["Quantidade"],"Discount":["Desconto"],"Adding\u2026":["Adicionando\u2026"],"Please search and select at-lease one product to add.":["Por favor, procure e selecione pelo menos um produto para adicionar."],"Reset":["Redefinir"],"Image Preview":["Pr\u00e9-visualiza\u00e7\u00e3o da imagem"],"Upload a file":["Carregar um arquivo"],"or drag and drop":["ou arraste e solte"],"PNG, JPG, GIF up to 10MB":["PNG, JPG, GIF at\u00e9 10MB"],"Select Dates":["Selecionar Datas"],"Please upgrade to the %1$s CartFlows Pro %2$s to use %3$s feature.":["Por favor, atualize para o %1$s CartFlows Pro %2$s para usar o recurso %3$s."],"Please upgrade to the %1$s CartFlows Higher Plan %2$s to use %3$s feature.":["Por favor, fa\u00e7a o upgrade para o %1$s Plano Superior do CartFlows %2$s para usar o recurso %3$s."],"Please upgrade to the CartFlows Higher Plan to use the %s feature.":["Por favor, fa\u00e7a upgrade para o Plano Superior do CartFlows para usar o recurso %s."],"Role":["Fun\u00e7\u00e3o"],"Access":["Acesso"],"For more information about the user role management please %1$sClick here.%2$s":["Para mais informa\u00e7\u00f5es sobre a gest\u00e3o de fun\u00e7\u00f5es de usu\u00e1rio, por favor %1$sClique aqui.%2$s"],"Are you sure you want to rollback to %1$s v%2$s?":["Tem certeza de que deseja reverter para %1$s v%2$s?"],"Rollback":["Reverter"],"Cancel":["Cancelar"],"Experiencing an issue with the current version of CartFlows? Roll back to a previous version to help troubleshoot the problem.":["Est\u00e1 a ter um problema com a vers\u00e3o atual do CartFlows? Reverter para uma vers\u00e3o anterior para ajudar a resolver o problema."],"Regenerate Now":["Regenerar agora"],"Reset Permalinks Settings":["Redefinir Configura\u00e7\u00f5es de Links Permanentes"],"Activate License":["Ativar Licen\u00e7a"],"Deactivate License":["Desativar Licen\u00e7a"],"Please enter a valid license key!":["Por favor, insira uma chave de licen\u00e7a v\u00e1lida!"],"Processing":["Processando"],"Unknown error occurred while activating the license.":["Ocorreu um erro desconhecido ao ativar a licen\u00e7a."],"Facebook Pixel":["Pixel do Facebook"],"Google Analytics Pixel":["Pixel do Google Analytics"],"Google Ads Pixel":["Pixel do Google Ads"],"Tiktok Pixel":["Tiktok Pixel"],"Pinterest Tag":["Tag do Pinterest"],"Snapchat Pixel":["Snapchat Pixel"],"Google Auto Address":["Endere\u00e7o Autom\u00e1tico do Google"],"Regenerate Inline CSS":["Regenerar CSS Inline"]," Regenerating\u2026.":["Regenerando\u2026."],"Regenerated":["Regenerado"],"If you are using the CartFlows Shortcode and using the Design Settings, then this option will regenerate the steps inline CSS. To learn more, %1$1s Click here %2$2s.":["Se voc\u00ea estiver usando o Shortcode do CartFlows e as Configura\u00e7\u00f5es de Design, esta op\u00e7\u00e3o ir\u00e1 regenerar o CSS inline dos passos. Para saber mais, %1$1s Clique aqui %2$2s."],"Updating":["Atualizando"],"Permalinks reset successfully":["Links permanentes redefinidos com sucesso"],"For more information about the CartFlows Permalink settings please %1$sClick here.%2$s":["Para mais informa\u00e7\u00f5es sobre as configura\u00e7\u00f5es de Permalink do CartFlows, por favor %1$sClique aqui.%2$s"],"Oops! You don't have access to this page.":["Ops! Voc\u00ea n\u00e3o tem acesso a esta p\u00e1gina."],"You don't have permission to access this page. Please reach out to your admin for help.":["Voc\u00ea n\u00e3o tem permiss\u00e3o para acessar esta p\u00e1gina. Por favor, entre em contato com o seu administrador para obter ajuda."],"Back to Dashboard":["Voltar para o Painel"],"Integrations":["Integra\u00e7\u00f5es"],"User Role Manager":["Gerenciador de Fun\u00e7\u00f5es do Usu\u00e1rio"],"Permalink":["Link permanente"],"Version Control":["Controle de Vers\u00e3o"],"Order":["Pedido"],"License":["Licen\u00e7a"],"Sync Knowledge Base":["Sincronizar Base de Conhecimento"],"Knowledge Base":["Base de Conhecimento"],"Search knowledge base":["Pesquisar na base de conhecimento"],"No Docs Founds":["Nenhum documento encontrado"],"Please try syncing the docs library":["Por favor, tente sincronizar a biblioteca de documentos"],"Syncing\u2026":["Sincronizando\u2026"],"Synced. Reloading..":["Sincronizado. Recarregando.."],"Need Help?":["Precisa de ajuda?"],"We aim to answer all priority support requests within 2-3 hours.":["Nosso objetivo \u00e9 responder a todas as solicita\u00e7\u00f5es de suporte priorit\u00e1rio dentro de 2-3 horas."],"Get Support":["Obter Suporte"],"All Documentation":["Toda a documenta\u00e7\u00e3o"],"Browse documentation, reference material, and tutorials for CartFlows.":["Navegue pela documenta\u00e7\u00e3o, material de refer\u00eancia e tutoriais para CartFlows."],"View documentation":["Ver documenta\u00e7\u00e3o"],"Videos":["V\u00eddeos"],"Browse tutorial videos on our YouTube channel.":["Navegue por v\u00eddeos tutoriais no nosso canal do YouTube."],"Youtube Channel":["Canal do Youtube"],"Support":["Suporte"],"What's New?":["O que h\u00e1 de novo?"],"Unlicensed":["Sem licen\u00e7a"],"Licensed":["Licenciado"],"Open Global Settings":["Abrir Configura\u00e7\u00f5es Globais"],"Tutorial Videos":["V\u00eddeos Tutoriais"],"More Options":["Mais op\u00e7\u00f5es"],"Control":["Controle"],"Variation-%d":["Varia\u00e7\u00e3o-%d"],"No Product Assigned":["Nenhum Produto Atribu\u00eddo"],"Store Checkout - Remove selected checkout product":["Finaliza\u00e7\u00e3o da Compra - Remover produto selecionado do carrinho"],"PRO":["PRO"],"Offer Accepted":["Oferta Aceita"],"Offer Rejected":["Oferta Rejeitada"],"Invalid Position":["Posi\u00e7\u00e3o Inv\u00e1lida"],"Views":["Visualiza\u00e7\u00f5es"],"Conversions":["Convers\u00f5es"],"Revenue":["Receita"],"Upgrade to Pro":["Atualizar para Pro"],"%s Step":["Etapa %s"],"Step Editing is Disabled":["A edi\u00e7\u00e3o de etapas est\u00e1 desativada"],"Open Settings":["Abrir Configura\u00e7\u00f5es"],"Duplicate Step":["Etapa Duplicada"],"Do you want to duplicate this step? Are you sure?":["Voc\u00ea quer duplicar esta etapa? Voc\u00ea tem certeza?"],"Delete Step":["Excluir Etapa"],"Do you want to delete this step? Are you sure?":["Voc\u00ea quer excluir esta etapa? Tem certeza?"],"Declare Winner":["Declarar Vencedor"],"Do you want to declare this step as winner? Are you sure?":["Voc\u00ea quer declarar esta etapa como vencedora? Tem certeza?"],"Archive Step":["Etapa de Arquivo"],"Do you want to archive this step? Are you sure?":["Voc\u00ea quer arquivar esta etapa? Voc\u00ea tem certeza?"],"Saving..":["Salvando.."],"Saved":["Salvo"],"Reloading..":["Recarregando.."],"Split Test Testing":["Teste de Divis\u00e3o"],"Stop Split Test":["Parar Teste A\/B"],"Start Split Test":["Iniciar Teste A\/B"],"Split Test":["Teste A\/B"],"Stopping\u2026":["Parando\u2026"],"Starting\u2026":["Iniciando\u2026"],"Reloading\u2026":["Recarregando\u2026"],"Split Test Settings":["Configura\u00e7\u00f5es de Teste A\/B"],"Restore Archived Variation":["Restaurar Varia\u00e7\u00e3o Arquivada"],"Do you want to restore this archived variation? Are you sure?":["Voc\u00ea quer restaurar esta varia\u00e7\u00e3o arquivada? Tem certeza?"],"Trash Archived Variation":["Varia\u00e7\u00e3o Arquivada do Lixo"],"This action will trash this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Esta a\u00e7\u00e3o ir\u00e1 descartar permanentemente esta varia\u00e7\u00e3o arquivada e seus dados anal\u00edticos. %1$s Voc\u00ea deseja excluir esta varia\u00e7\u00e3o arquivada?"],"Hide Archived Variation":["Ocultar Varia\u00e7\u00e3o Arquivada"],"This action will hide this archived variation from the list of steps, but its analytics will be visible. %1$s Do you want to hide this archived variation?":["Esta a\u00e7\u00e3o ocultar\u00e1 esta varia\u00e7\u00e3o arquivada da lista de etapas, mas suas an\u00e1lises estar\u00e3o vis\u00edveis. %1$s Voc\u00ea deseja ocultar esta varia\u00e7\u00e3o arquivada?"],"This action will delete this archived variation and its analytics data permanently. %1$s Do you want to delete this archived variation?":["Esta a\u00e7\u00e3o excluir\u00e1 permanentemente esta varia\u00e7\u00e3o arquivada e seus dados anal\u00edticos. %1$s Deseja excluir esta varia\u00e7\u00e3o arquivada?"],"Deleted On: ":["Exclu\u00eddo em:"],"Archived On: ":["Arquivado em:"],"Archived Steps":["Passos Arquivados"],"Edit Step Name":["Editar Nome do Passo"],"Save":["Salvar"],"Update Template":["Atualizar Modelo"],"Changing the template will permanently delete the current design in this step. Would you still like to proceed?":["Alterar o modelo excluir\u00e1 permanentemente o design atual nesta etapa. Voc\u00ea ainda gostaria de continuar?"],"Change Template":["Alterar Modelo"],"If you are using shortcodes, enable this design settings to apply styles.":["Se voc\u00ea estiver usando shortcodes, ative estas configura\u00e7\u00f5es de design para aplicar estilos."],"Enable Design Settings":["Ativar Configura\u00e7\u00f5es de Design"],"Activate %s":["Ativar %s"],"Activating %s":["Ativando %s"],"Successfully Activated!":["Ativado com sucesso!"],"Failed! Activation!":["Falhou! Ativa\u00e7\u00e3o!"],"Upgrade to Cartflows Pro":["Atualize para o Cartflows Pro"],"Activate the License":["Ativar a Licen\u00e7a"],"Step Type: ":["Tipo de Etapa:"],"License is required!":["\u00c9 necess\u00e1ria uma licen\u00e7a!"],"Activate the license to modify this offer step's settings":["Ative a licen\u00e7a para modificar as configura\u00e7\u00f5es desta etapa da oferta"],"No product Selected":["Nenhum produto selecionado"],"Once you select the product, they will be displayed here.":["Assim que voc\u00ea selecionar o produto, eles ser\u00e3o exibidos aqui."],"Shipping Rate":["Taxa de Envio"],"Once you have add product, it will be displayed here.":["Assim que voc\u00ea adicionar o produto, ele ser\u00e1 exibido aqui."],"Coupon will apply on checkout page":["O cupom ser\u00e1 aplicado na p\u00e1gina de finaliza\u00e7\u00e3o da compra"],"AND":["E"],"Please Update the CartFlows Pro to the latest version to use the conditional order bump feature.":["Por favor, atualize o CartFlows Pro para a vers\u00e3o mais recente para usar o recurso de oferta adicional condicional."],"Enable conditional order bump ":["Ativar aumento de pedido condicional"],"By enabling this option, you can create the conditions to display the order bump.":["Ao ativar esta op\u00e7\u00e3o, voc\u00ea pode criar as condi\u00e7\u00f5es para exibir o aumento de pedido."],"Show this order bump if following conditions are true":["Mostre este aumento de pedido se as seguintes condi\u00e7\u00f5es forem verdadeiras"],"Add Condition":["Adicionar Condi\u00e7\u00e3o"],"OR":["OU"],"Add Conditions Group":["Adicionar Grupo de Condi\u00e7\u00f5es"],"Order Bump Product Image":["Imagem do Produto de Venda Adicional"],"Styles":["Estilos"],"Conditions":["Condi\u00e7\u00f5es"],"Save Changes":["Salvar altera\u00e7\u00f5es"],"You have made changes. Do you want to save the changes?":["Voc\u00ea fez altera\u00e7\u00f5es. Deseja salvar as altera\u00e7\u00f5es?"],"No product":["Sem produto"],"Duplicate Order Bump":["Duplicar Aumento de Pedido"],"Edit Order Bump":["Editar Bump de Pedido"],"Trash Order Bump":["Ordem de Lixo Adicional"],"Do you really want to trash this order bump permanently?":["Voc\u00ea realmente deseja descartar este adicional de pedido permanentemente?"],"Delete Order Bump":["Excluir Order Bump"],"Status":["Status"],"Actions":["A\u00e7\u00f5es"],"Create an order bump.":["Crie um aumento de pedido."],"Enter order bump name":["Insira o nome do aumento de pedido"],"Please enter the order bump title":["Por favor, insira o t\u00edtulo do complemento de pedido"],"Preview":["Pr\u00e9-visualiza\u00e7\u00e3o"],"View in Full Screen":["Ver em Tela Cheia"],"Exit Full Screen":["Sair da Tela Cheia"],"Order Submitted":["Pedido Enviado"],"Special Offer":["Oferta Especial"],"Order Receipt":["Recibo de Pedido"],"Enable Checkout Offer":["Ativar Oferta de Checkout"],"Dynamic Conditions":["Condi\u00e7\u00f5es Din\u00e2micas"],"Please Update the CartFlows Pro to the latest version to use the dynamic offers feature.":["Por favor, atualize o CartFlows Pro para a vers\u00e3o mais recente para usar o recurso de ofertas din\u00e2micas."],"Enable Dynamic Offers":["Ativar Ofertas Din\u00e2micas"],"Redirect to: ":["Redirecionar para:"],"Search for step\u2026":["Procurar por etapa\u2026"],"If the following conditions are true":["Se as seguintes condi\u00e7\u00f5es forem verdadeiras"],"Add Dynamic Offer":["Adicionar Oferta Din\u00e2mica"],"Search for default step\u2026":["Procurar pelo passo padr\u00e3o\u2026"],"If all of the above conditions failed.":["Se todas as condi\u00e7\u00f5es acima falharem."],"Label":["Etiqueta"],"ID":["ID"],"Enable":["Habilitar"],"Add New Field":["Adicionar Novo Campo"],"Date & Time":["Data e Hora"],"Add Custom Field":["Adicionar Campo Personalizado"],"TextArea":["\u00c1rea de Texto"],"Number":["N\u00famero"],"Checkbox":["Caixa de sele\u00e7\u00e3o"],"Radio":["R\u00e1dio"],"Select":["Selecionar"],"Hidden":["Oculto"],"Add To":["Adicionar a"],"Label %1$s*%2$s":["R\u00f3tulo %1$s*%2$s"],"Field value will store in this meta key. Add field id without prefix like \"billing_\" or \"shipping_\". %s Use \"_\" instead of spaces.":["O valor do campo ser\u00e1 armazenado nesta chave meta. Adicione o id do campo sem o prefixo como \"billing_\" ou \"shipping_\". %s Use \"_\" em vez de espa\u00e7os."],"Min Value":["Valor M\u00ednimo"],"Max Value":["Valor M\u00e1ximo"],"Enter your options separated by (|).":["Insira suas op\u00e7\u00f5es separadas por (|)."],"UnChecked":["Desmarcado"],"Field Input Type":["Tipo de Entrada do Campo"],"Date":["Data"],"Time":["Tempo"],"Min ":["Min"],"Max ":["Max"],"Show in Email":["Mostrar no Email"],"Billing Fields":["Campos de Faturamento"],"Shipping Fields":["Campos de Envio"],"Delete Field":["Excluir Campo"],"Are you really want to delete field?":["Tem certeza de que deseja excluir o campo?"],"Field Editor":["Editor de Campo"],"Label is required field":["O r\u00f3tulo \u00e9 um campo obrigat\u00f3rio"],"WooCommerce is Required!":["WooCommerce \u00e9 necess\u00e1rio!"],"To modify the %s step options, please install and activate the WooCommerce plugin.":["Para modificar as op\u00e7\u00f5es do passo %s, por favor, instale e ative o plugin WooCommerce."],"Activating\u2026":["Ativando\u2026"],"Activated":["Ativado"],"Funnel Settings":["Configura\u00e7\u00f5es do Funil"],"Save Setting":["Salvar Configura\u00e7\u00e3o"],"Disable Store Checkout":["Desativar finaliza\u00e7\u00e3o de compra na loja"],"Enable Store Checkout":["Ativar finaliza\u00e7\u00e3o de compra na loja"],"Edit Title":["Editar T\u00edtulo"],"Publish":["Publicar"],"Do you really want to publish this funnel?":["Voc\u00ea realmente deseja publicar este funil?"],"Draft Funnel":["Funil de Rascunho"],"Do you really want to draft this funnel?":["Voc\u00ea realmente quer elaborar este funil?"],"Unique Visits":["Visitas \u00danicas"],"Conversion Rate":["Taxa de Convers\u00e3o"],"Total number of orders.":["N\u00famero total de pedidos."],"Grand total of all orders.":["Total geral de todos os pedidos."],"Average total of every order.":["M\u00e9dia total de cada pedido."],"Grand total of all order bumps.":["Total geral de todos os acr\u00e9scimos de pedidos."],"Export Flow":["Fluxo de Exporta\u00e7\u00e3o"],"View Funnel":["Ver Funil"],"Open Funnel Settings":["Abrir Configura\u00e7\u00f5es do Funil"],"Delete Store Checkout":["Excluir Checkout da Loja"],"Do you really want to delete store checkout?%1$1sNOTE: This action cannot be reversed.":["Voc\u00ea realmente deseja excluir o checkout da loja?%1$1sNOTA: Esta a\u00e7\u00e3o n\u00e3o pode ser desfeita."],"archived_date":["data_arquivada"],"%1$sNote:%2$s The orders which are placed by the admins are not considered while calculating the analytics.":["%1$sNota:%2$s As encomendas feitas pelos administradores n\u00e3o s\u00e3o consideradas ao calcular as an\u00e1lises."],"Reset Analytics":["Redefinir An\u00e1lises"],"Are you really want to reset funnel analytics?":["Voc\u00ea realmente quer redefinir a an\u00e1lise do funil?"],"Resetting":["Redefinindo"],"Automation for":["Automa\u00e7\u00e3o para"],"Create a distraction free, high-converting checkout experience without needing a page builder.":["Crie uma experi\u00eancia de checkout sem distra\u00e7\u00f5es e de alta convers\u00e3o sem precisar de um construtor de p\u00e1ginas."],"Funnel Steps":["Etapas do Funil"],"Add New Step":["Adicionar Novo Passo"],"No Steps Added.":["Nenhum passo adicionado."],"Seems like there are no steps created or added in this flow":["Parece que n\u00e3o h\u00e1 etapas criadas ou adicionadas neste fluxo"],"Add new step":["Adicionar novo passo"],"Select Step Type":["Selecionar Tipo de Etapa"],"Activating WooCommerce..":["Ativando o WooCommerce.."],"Installing WooCommerce..":["Instalando o WooCommerce.."],"Successfully Installed!":["Instalado com sucesso!"],"Installation Failed!":["Instala\u00e7\u00e3o falhou!"],"Import Step":["Etapa de Importa\u00e7\u00e3o"],"Add multiple steps to your flows today with an upgraded CartFlows plan.":["Adicione v\u00e1rias etapas aos seus fluxos hoje com um plano CartFlows atualizado."],"Get CartFlows Higher Plan":["Obtenha o Plano Superior do CartFlows"],"Add multiple steps to your flows by activating %s.":["Adicione v\u00e1rias etapas aos seus fluxos ativando %s."],"Add %1$s step to your flows by activating %2$s.":["Adicione o passo %1$s aos seus fluxos ativando %2$s."],"Add unlimited income boosting one-click %s to your flows when you upgrade to our CartFlows Higher plan today.":["Adicione %s de aumento de renda ilimitado com um clique aos seus fluxos quando voc\u00ea fizer upgrade para o nosso plano CartFlows Higher hoje."],"Add %1$s step to your flow by activating CartFlows license.":["Adicione o passo %1$s ao seu fluxo ativando a licen\u00e7a do CartFlows."],"Access all of our pro templates by activating %s.":["Acesse todos os nossos modelos profissionais ativando %s."],"Access all of our pro templates when you upgrade your plan to CartFlows Pro today.":["Acesse todos os nossos modelos profissionais quando voc\u00ea atualizar seu plano para o CartFlows Pro hoje."],"Get CartFlows Pro":["Obtenha o CartFlows Pro"],"Add %1$s step to your flows by activating license.":["Adicione o passo %1$s aos seus fluxos ativando a licen\u00e7a."],"You need WooCommerce plugin installed and activated to import this step.":["Voc\u00ea precisa do plugin WooCommerce instalado e ativado para importar esta etapa."],"Imported! Redirecting\u2026":["Importado! Redirecionando\u2026"]," Please sync the library and try importing the template again.":["Por favor, sincronize a biblioteca e tente importar o modelo novamente."],"Import Failed! Try again.":["Falha na importa\u00e7\u00e3o! Tente novamente."],"Create Step":["Criar Etapa"],"Creating Step..":["Criando etapa.."],"Step Created! Redirecting\u2026":["Etapa Criada! Redirecionando\u2026"],"Failed to Create Step!":["Falha ao criar etapa!"],"Activate license for adding more steps and other features.":["Ative a licen\u00e7a para adicionar mais etapas e outros recursos."],"Close the window":["Feche a janela"],"Name Your Step":["Nomeie Seu Passo"],"Step Name":["Nome da Etapa"],"Enter Step Name":["Insira o Nome da Etapa"],"Learn How":["Aprenda Como"],"Create from Scratch":["Criar do Zero"],"Step thumbnail image":["Imagem em miniatura do passo"],"Import":["Importar"],"Back":["Voltar"],"Sync Library":["Sincronizar Biblioteca"],"Importing page %d":["Importando p\u00e1gina %d"],"Sync Complete":["Sincroniza\u00e7\u00e3o Completa"],"Syncing Library\u2026":["Sincronizando Biblioteca\u2026"],"Library Synced":["Biblioteca Sincronizada"],"Steps Library":["Biblioteca de Passos"],"Get CartFlows Higher plan":["Obtenha o plano superior do CartFlows"],"Activate license for adding more flows and other features.":["Ative a licen\u00e7a para adicionar mais fluxos e outros recursos."],"Importing Step..":["Importando etapa.."],"Close":["Fechar"],"Error":["Erro"],"Add unlimited income boosting one-click upsells to your flows by activating %s":["Adicione upsells de um clique para aumentar a renda ilimitada aos seus fluxos ativando %s"],"Add unlimited income boosting one-click upsells to your flows when you upgrade to our CartFlows Plus or Pro plan today.":["Adicione upsells de um clique para aumentar a renda ilimitada aos seus fluxos quando voc\u00ea fizer o upgrade para o nosso plano CartFlows Plus ou Pro hoje."],"Access all of our pro templates by activating %s":["Acesse todos os nossos modelos profissionais ativando %s"],"Templates for %s":["Modelos para %s"],"Please wait\u2026":["Por favor, aguarde\u2026"],"Please wait. Duplicating funnel\u2026":["Por favor, aguarde. Duplicando funil\u2026"],"Please wait. Drafting funnel\u2026":["Por favor, aguarde. Elaborando funil\u2026"],"Please wait. Deleting funnel\u2026":["Por favor, aguarde. Excluindo funil\u2026"],"Please wait. Restoring funnel\u2026":["Por favor, aguarde. Restaurando o funil\u2026"],"Please wait. Exporting\u2026":["Por favor, aguarde. Exportando\u2026"],"Please wait. Duplicating step\u2026":["Por favor, aguarde. Duplicando etapa\u2026"],"Please wait. Deleting step\u2026":["Por favor, aguarde. Excluindo etapa\u2026"],"Please wait. Creating variation\u2026":["Por favor, aguarde. Criando varia\u00e7\u00e3o\u2026"],"Please wait. Archiving variation\u2026":["Por favor, aguarde. Arquivando varia\u00e7\u00e3o\u2026"],"Please wait. Declaring winner\u2026":["Por favor, aguarde. Declarando o vencedor\u2026"],"Getting Started":["Come\u00e7ando"],"Introduction to CartFlows":["Introdu\u00e7\u00e3o ao CartFlows"],"Modernizing WordPress eCommerce!":["Modernizando o eCommerce do WordPress!"],"Create Your First Flow":["Crie Seu Primeiro Fluxo"],"Go To Setup Wizard":["Ir para o Assistente de Configura\u00e7\u00e3o"],"Import Funnel":["Importar Funil"],"Click for more info":["Clique para mais informa\u00e7\u00f5es"],"You need WooCommerce plugin installed and activated to import this funnel.":["Voc\u00ea precisa do plugin WooCommerce instalado e ativado para importar este funil."],"Access all of our pro templates by activating CartFlows Pro.":["Acesse todos os nossos modelos profissionais ativando o CartFlows Pro."],"Access all of our pro templates when you activate CartFlows Pro license.":["Acesse todos os nossos modelos profissionais quando voc\u00ea ativar a licen\u00e7a do CartFlows Pro."],"Importing Complete Funnel..":["Importa\u00e7\u00e3o do Funil Completa.."],"Design Your Funnel":["Desenhe o Seu Funil"],"Created! Redirecting\u2026":["Criado! Redirecionando\u2026"],"Failed to Create Flow!":["Falha ao Criar Fluxo!"],"Upgrade To CartFlows Pro":["Atualize para o CartFlows Pro"],"Name Your Funnel":["Nomeie Seu Funil"],"Funnel Name":["Nome do Funil"],"Enter Funnel Name":["Insira o Nome do Funil"],"Welcome to CartFlows ":["Bem-vindo ao CartFlows"],"Sales funnel builder turns your WordPress website into an optimized selling machine.":["O construtor de funil de vendas transforma seu site WordPress em uma m\u00e1quina de vendas otimizada."],"Create Your First Funnel":["Crie Seu Primeiro Funil"],"A sales funnel is the sequence of steps a buyer takes to make a purchase. CartFlows helps optimize funnels to turn visitors into customers.":["Um funil de vendas \u00e9 a sequ\u00eancia de etapas que um comprador segue para fazer uma compra. O CartFlows ajuda a otimizar funis para transformar visitantes em clientes."],"Create New Funnel":["Criar Novo Funil"],"Total Page Views":["Total de visualiza\u00e7\u00f5es de p\u00e1gina"],"Total Revenue":["Receita Total"],"Total Orders":["Total de Pedidos"],"Offer Revenue":["Receita de Oferta"],"Total Views":["Total de visualiza\u00e7\u00f5es"],"Overview":["Vis\u00e3o geral"],"WooCommerce plugin is required.":["\u00c9 necess\u00e1rio o plugin WooCommerce."],"You need WooCommerce plugin installed and activated to view the overview":["Voc\u00ea precisa do plugin WooCommerce instalado e ativado para visualizar a vis\u00e3o geral"],"Recent Orders":["Pedidos Recentes"],"View All":["Ver tudo"],"Customer":["Cliente"],"Payment Method":["M\u00e9todo de Pagamento"],"Value":["Valor"],"at":["em"],"Find recent order here":["Encontre o pedido recente aqui"],"Once you have received orders, come back here to find it again easily":["Assim que receber as encomendas, volte aqui para encontr\u00e1-las facilmente"],"You need WooCommerce plugin installed and activated to view the recent orders":["Voc\u00ea precisa do plugin WooCommerce instalado e ativado para visualizar os pedidos recentes"],"Quick Actions":["A\u00e7\u00f5es R\u00e1pidas"],"Create a Funnel":["Criar um Funil"],"Analytics":["An\u00e1lise"],"Create a Product":["Criar um Produto"],"Create new Product":["Criar novo Produto"],"All Funnels":["Todos os Funis"],"View all funnels":["Ver todos os funis"],"Previous":["Anterior"],"Next":["Pr\u00f3ximo"],"First":["Primeiro"],"Last":["\u00daltimo"],"You can specify a file to import by either dragging it into the drag and drop area.(Maximum file size of 5MB; .json file extensions only.)":["Voc\u00ea pode especificar um arquivo para importar arrastando-o para a \u00e1rea de arrastar e soltar. (Tamanho m\u00e1ximo do arquivo de 5MB; apenas extens\u00f5es de arquivo .json.)"],"Change a file":["Alterar um arquivo"],"JSON file up to 5MB":["Arquivo JSON de at\u00e9 5MB"],"File Selected: %s":["Arquivo selecionado: %s"],"Please select the valid json file.":["Por favor, selecione o arquivo json v\u00e1lido."],"Importing..":["Importando.."],"Export All":["Exportar tudo"],"Exporting\u2026":["Exportando\u2026"],"Search Funnels":["Funis de Pesquisa"],"Filter Funnels by Date":["Filtrar Funis por Data"],"Publish ":["Publicar"],"Draft ":["Rascunho"],"Trash ":["Lixo"],"Mode":["Modo"],"All":["Todos"],"Live":["Ao vivo"],"SandBox":["SandBox"],"Reset Filters":["Redefinir Filtros"],"%s This Flow":["%s Este Fluxo"],"Do you want to %s this flow? Are you sure?":["Voc\u00ea quer %s este fluxo? Tem certeza?"],"items selected":["itens selecionados"],"Applying changes\u2026":["Aplicando altera\u00e7\u00f5es\u2026"]," Published ":["Publicado"],"Duplicate Funnel":["Duplicar Funil"],"Do you really want to duplicate this funnel?":["Voc\u00ea realmente deseja duplicar este funil?"],"Trash Funnel":["Funil de Lixo"],"Do you really want to trash this funnel?":["Voc\u00ea realmente quer descartar este funil?"],"Do you really want to trash this Funnel?":["Voc\u00ea realmente deseja descartar este Funil?"],"Restore Funnel":["Restaurar Funil"],"Do you really want to restore this funnel?":["Voc\u00ea realmente deseja restaurar este funil?"],"Draft":["Rascunho"],"Last Modified: %s":["\u00daltima modifica\u00e7\u00e3o: %s"],"Updated ":["Atualizado"],"Sandbox":["Caixa de areia"],"WooCommerce Required to display the revenue.":["WooCommerce necess\u00e1rio para exibir a receita."],"Restore Flow":["Restaurar Fluxo"],"Delete Flow":["Excluir Fluxo"],"Upgrade to Pro for this feature.":["Atualize para o Pro para ter este recurso."],"Duplicate (Pro)":["Duplicar (Pro)"],"Trash Flow":["Fluxo de Lixo"],"Trash":["Lixo"],"Name":["Nome"],"Sales":["Vendas"],"Move to Trash":["Mover para o Lixo"],"No matching results found for the search term \"%s\".":["Nenhum resultado correspondente encontrado para o termo de pesquisa \"%s\"."],"No flows found for the selected filter.":["Nenhum fluxo encontrado para o filtro selecionado."],"Please try using different keywords, date range, or filters to refine your results.":["Por favor, tente usar palavras-chave diferentes, intervalo de datas ou filtros para refinar seus resultados."],"Create New":["Criar Novo"]," %d items":["%d itens"],"Create your first funnel":["Crie seu primeiro funil"],"Build a sales funnel with everything you need to generate leads and grow sales.":["Construa um funil de vendas com tudo o que voc\u00ea precisa para gerar leads e aumentar as vendas."],"One Click Upsells":["Upsells com Um Clique"],"A\/B Split Testing":["Teste A\/B"],"Conversion Templates":["Modelos de Convers\u00e3o"],"Checkout Editor":["Editor de Checkout"],"Insights":["Insights"],"Create Funnel":["Criar Funil"],"Plugin Required":["Plugin Necess\u00e1rio"],"You need WooCommerce plugin installed and activated to access this page.":["Voc\u00ea precisa do plugin WooCommerce instalado e ativado para acessar esta p\u00e1gina."],"Installing":["Instalando"],"Activating":["Ativando"],"Failed":["Falhou"],"Redirecting":["Redirecionando"],"Create Store Checkout":["Criar Checkout da Loja"],"Name Your Store Checkout":["Nomeie o Checkout da Sua Loja"],"You can't create more than 3 flows in free version. Upgrade to CartFlows Pro for adding more flows and other features.":["Voc\u00ea n\u00e3o pode criar mais de 3 fluxos na vers\u00e3o gratuita. Fa\u00e7a o upgrade para o CartFlows Pro para adicionar mais fluxos e outros recursos."],"Upgrade To Cartflows Pro":["Atualize para o Cartflows Pro"],"Store Checkout Name":["Nome do Checkout da Loja"],"Enter Store Checkout Name":["Insira o Nome do Caixa da Loja"],"Create a global store checkout":["Criar um checkout de loja global"],"A well-designed checkout page can help streamline the checkout process, reduce cart abandonment rates and increase conversions.":["Uma p\u00e1gina de checkout bem projetada pode ajudar a simplificar o processo de checkout, reduzir as taxas de abandono de carrinho e aumentar as convers\u00f5es."],"Improved user experience":["Experi\u00eancia do usu\u00e1rio aprimorada"],"Brand consistency":["Consist\u00eancia da marca"],"Increased trust and credibility":["Maior confian\u00e7a e credibilidade"],"Flexibility and customization":["Flexibilidade e personaliza\u00e7\u00e3o"],"Competitive advantage":["Vantagem competitiva"],"Active":["Ativo"],"Activate":["Ativar"],"Install":["Instalar"],"Installing\u2026":["Instalando\u2026"],"Installed":["Instalado"],"Let's Go":["Vamos"],"Recommended Plugins":["Plugins Recomendados"],"Recommended Themes":["Temas Recomendados"],"View All Steps":["Ver todas as etapas"],"Funnel thumbnail image":["Imagem em miniatura do funil"],"Funnel Preview":["Pr\u00e9-visualiza\u00e7\u00e3o do Funil"],"Live Preview":["Pr\u00e9-visualiza\u00e7\u00e3o ao vivo"],"Funnel Templates":["Modelos de Funil"],"Start from scratch":["Come\u00e7ar do zero"],"It seems that the page builder you selected is inactive.":["Parece que o construtor de p\u00e1ginas que voc\u00ea selecionou est\u00e1 inativo."]," to see CartFlows templates. If you prefer another page builder tool, you can ":["para ver os modelos do CartFlows. Se preferir outra ferramenta de cria\u00e7\u00e3o de p\u00e1ginas, voc\u00ea pode"],"select it here":["selecione-o aqui"],"Are you using any other page builder? No worries. CartFlows works well with every other page builder. Right now we do not have ready templates for every page builder but we are planning to add it very soon.":["Voc\u00ea est\u00e1 usando algum outro construtor de p\u00e1ginas? N\u00e3o se preocupe. O CartFlows funciona bem com qualquer outro construtor de p\u00e1ginas. No momento, n\u00e3o temos modelos prontos para todos os construtores de p\u00e1ginas, mas estamos planejando adicion\u00e1-los em breve."],"Learn How ":["Aprenda como"],"No Results Found.":["Nenhum resultado encontrado."],"Don't see a funnel that you would like to import?":["N\u00e3o v\u00ea um funil que gostaria de importar?"],"Please suggest us ":["Por favor, sugira-nos"],"Choose a Funnel Templates":["Escolha um Modelo de Funil"],"Search Templates":["Pesquisar Modelos"],"Start from Scratch":["Come\u00e7ar do zero"],"It seems that you are using the Bricks Builder.":["Parece que voc\u00ea est\u00e1 usando o Bricks Builder."],"It seems that you are using the page builder other than Elementor, Beaver Builder, Block Builder.":["Parece que voc\u00ea est\u00e1 usando um construtor de p\u00e1ginas diferente do Elementor, Beaver Builder, Block Builder."],"Are you using Bricks Builder? No worries. CartFlows works well with Bricks Builder. Right now we do not have ready templates for Bricks Builder but we are planning to add it very soon.":["Voc\u00ea est\u00e1 usando o Bricks Builder? N\u00e3o se preocupe. O CartFlows funciona bem com o Bricks Builder. No momento, n\u00e3o temos modelos prontos para o Bricks Builder, mas estamos planejando adicion\u00e1-los em breve."],"Checkout Page":["P\u00e1gina de Finaliza\u00e7\u00e3o de Compra"],"Oops!!! No template Found.":["Ops!!! Nenhum modelo encontrado."],"Seems like no template is available for chosen editor.":["Parece que n\u00e3o h\u00e1 modelo dispon\u00edvel para o editor escolhido."],"Store Checkout Templates":["Modelos de Checkout da Loja"],"No CartFlows Logs Found.":["Nenhum registro do CartFlows encontrado."],"CartFlows Logs":["Registros do CartFlows"],"Copied":["Copiado"],"Copy":["Copiar"],"Downloading":["Baixando"],"Download":["Baixar"],"Deleting":["Excluindo"],"Deleted":["Exclu\u00eddo"],"Email Marketing Automation":["Automa\u00e7\u00e3o de Email Marketing"],"Automate email marketing campaigns based on customer actions, such as abandoned carts or completed purchases in WooCommerce.":["Automatize campanhas de marketing por e-mail com base nas a\u00e7\u00f5es dos clientes, como carrinhos abandonados ou compras conclu\u00eddas no WooCommerce."],"Customer Birthday Campaigns":["Campanhas de Anivers\u00e1rio de Clientes"],"Automatically send personalized birthday offers or discounts to customers based on their birthdate stored in WooCommerce.":["Envie automaticamente ofertas ou descontos personalizados de anivers\u00e1rio para os clientes com base na data de nascimento armazenada no WooCommerce."],"Order Notification":["Notifica\u00e7\u00e3o de Pedido"],"Receive instant notifications via SMS, Slack, WhatsApp, or messaging apps when new orders are placed in your WooCommerce store.":["Receba notifica\u00e7\u00f5es instant\u00e2neas via SMS, Slack, WhatsApp ou aplicativos de mensagens quando novos pedidos forem feitos na sua loja WooCommerce."],"Payment and Accounting Integration":["Integra\u00e7\u00e3o de Pagamentos e Contabilidade"],"Sync WooCommerce sales data with your accounting software for streamlined financial management.":["Sincronize os dados de vendas do WooCommerce com seu software de contabilidade para uma gest\u00e3o financeira simplificada."],"Coupon Code Marketing":["Marketing de C\u00f3digo de Cupom"],"Automate the creation and distribution of coupon codes based on specific conditions or customer actions in WooCommerce.":["Automatize a cria\u00e7\u00e3o e distribui\u00e7\u00e3o de c\u00f3digos de cupom com base em condi\u00e7\u00f5es espec\u00edficas ou a\u00e7\u00f5es dos clientes no WooCommerce."],"Upsell and Cross-sell Campaigns":["Campanhas de Upsell e Cross-sell"],"Automate targeted upsell and cross-sell offers based on customers' purchase history or product interactions in WooCommerce.":["Automatize ofertas direcionadas de upsell e cross-sell com base no hist\u00f3rico de compras dos clientes ou intera\u00e7\u00f5es com produtos no WooCommerce."],"Connect Your Website":["Conecte seu site"],"Reloading":["Recarregando"],"Connecting":["Conectando"],"Integrate WooCommerce and CartFlows with Anything":["Integre WooCommerce e CartFlows com qualquer coisa"],"Integrate all your apps, plugins, and services to automate repetitive tasks.":["Integre todos os seus aplicativos, plugins e servi\u00e7os para automatizar tarefas repetitivas."],"These are just some examples. The possibilities are truly endless!":["Estes s\u00e3o apenas alguns exemplos. As possibilidades s\u00e3o realmente infinitas!"],"Trusted by World's Top Brands to Connect Their Apps":["Confiado pelas Principais Marcas do Mundo para Conectar Seus Aplicativos"],"Connect your apps and automate your business.":["Conecte seus aplicativos e automatize seu neg\u00f3cio."],"Remove Image":["Remover imagem"],"Unlock Premium Features with CartFlows PRO!":["Desbloqueie Recursos Premium com o CartFlows PRO!"],"Get the tools you need to create powerful sales funnels, increase conversions, and grow your business with ease.":["Obtenha as ferramentas necess\u00e1rias para criar funis de vendas poderosos, aumentar as convers\u00f5es e expandir seu neg\u00f3cio com facilidade."],"Select a Settings Tab":["Selecione uma Aba de Configura\u00e7\u00f5es"],"Free vs Pro":["Gr\u00e1tis vs Pro"],"Increase Your Revenue with Smart Order Bumps":["Aumente sua receita com ofertas adicionais inteligentes"],"Boost sales with CartFlows\u2019 Order Bump! Offer personalized add-ons at checkout to increase revenue effortlessly. Quick to set up, no coding needed!":["Aumente as vendas com o Order Bump do CartFlows! Ofere\u00e7a complementos personalizados no checkout para aumentar a receita sem esfor\u00e7o. R\u00e1pido de configurar, sem necessidade de codifica\u00e7\u00e3o!"],"Show the Right Offer to the Right People \u2013 Automatically!":["Mostre a oferta certa para as pessoas certas \u2013 automaticamente!"],"Personalize deals based on location, cart details, and more. Upgrade to CartFlows PRO and unlock this smart feature today!":["Personalize ofertas com base na localiza\u00e7\u00e3o, detalhes do carrinho e mais. Fa\u00e7a o upgrade para o CartFlows PRO e desbloqueie este recurso inteligente hoje!"],"Boost Sales Instantly with Auto-Applied Coupons!":["Aumente as Vendas Instantaneamente com Cupons Aplicados Automaticamente!"],"No codes, no hassle\u2014discounts apply instantly at checkout. Upgrade to CartFlows PRO and start converting more customers today!":["Sem c\u00f3digos, sem complica\u00e7\u00f5es\u2014os descontos s\u00e3o aplicados instantaneamente no checkout. Fa\u00e7a o upgrade para o CartFlows PRO e comece a converter mais clientes hoje!"],"Give Your Customers More Choices, Boost Your Sales":["D\u00ea Mais Op\u00e7\u00f5es aos Seus Clientes, Aumente Suas Vendas"],"Make buying easier with flexible product options. Let customers make the right choices from your checkout. Upgrade to CartFlows PRO and start customizing today!":["Torne a compra mais f\u00e1cil com op\u00e7\u00f5es de produtos flex\u00edveis. Deixe os clientes fazerem as escolhas certas no seu checkout. Fa\u00e7a o upgrade para o CartFlows PRO e comece a personalizar hoje!"],"Optin Product":["Produto de Opt-in"],"Select free & virtual product only. Once you select a product, it will be displayed here.":["Selecione apenas produtos gratuitos e virtuais. Assim que voc\u00ea selecionar um produto, ele ser\u00e1 exibido aqui."],"Search for a Free & Virtual Product":["Procure por um Produto Gratuito e Virtual"],"Please select a free & virtual product only.":["Por favor, selecione apenas um produto gratuito e virtual."],"Free":["Gr\u00e1tis"],"A\/B Testing":["Teste A\/B"],"Optimize your sales with A\/B testing in CartFlows! Experiment with product pricing, page layouts, messaging, and design. Create variants, analyze results, and discover new ways to boost revenue.":["Otimize suas vendas com testes A\/B no CartFlows! Experimente com pre\u00e7os de produtos, layouts de p\u00e1gina, mensagens e design. Crie variantes, analise os resultados e descubra novas maneiras de aumentar a receita."],"Finish Setup":["Concluir Configura\u00e7\u00e3o"],"Setup CartFlows":["Configurar CartFlows"],"Setup Store Checkout":["Configurar Checkout da Loja"],"Create":["Criar"],"Build Your Funnel":["Construa o Seu Funil"],"Start From Scratch":["Come\u00e7ar do Zero"],"Go To Library":["Ir Para a Biblioteca"],"Offer add-ons with Order Bump.":["Ofere\u00e7a complementos com Order Bump."],"Increase Revenue with Upsells.":["Aumente a Receita com Vendas Adicionais."],"Almost There! Let's Go Live.":["Quase l\u00e1! Vamos ao vivo."],"%d out of 5 completed":["%d de 5 conclu\u00eddos"],"Upgrade to PRO":["Atualize para PRO"],"Completed":["Conclu\u00eddo"],"Upgrade your plan anytime and get more detailed analytics data.":["Atualize seu plano a qualquer momento e obtenha dados anal\u00edticos mais detalhados."],"Total Page Views is a Premium Feature":["Total de visualiza\u00e7\u00f5es de p\u00e1gina \u00e9 um recurso premium"],"Offer Revenue is a Premium Feature":["Receita de Oferta \u00e9 um Recurso Premium"],"Custom Filter:":["Filtro Personalizado:"],"Checkout Features":["Recursos de Checkout"],"Modern Checkout Styles":["Estilos Modernos de Checkout"],"Optimized replacement for the standard WooCommerce checkout page designed for higher conversion":["Substitui\u00e7\u00e3o otimizada para a p\u00e1gina padr\u00e3o de finaliza\u00e7\u00e3o de compra do WooCommerce, projetada para maior convers\u00e3o"],"Custom Checkout Fields":["Campos Personalizados de Checkout"],"Have complete control over the field editor to manage the fields as required":["Tenha controle total sobre o editor de campos para gerenciar os campos conforme necess\u00e1rio"],"One-Click Upsells \/ Downsells":["Upsells \/ Downsells com um clique"],"Dynamic One-Click Upsells":["Upsells Din\u00e2micos com Um Clique"],"Use cart contents or customer data to display relevant upsells for maximum conversion":["Use o conte\u00fado do carrinho ou os dados do cliente para exibir upsells relevantes para a m\u00e1xima convers\u00e3o"],"Dynamic Upsell Templates":["Modelos Din\u00e2micos de Venda Cruzada"],"Professional templates to help you sell more even if you\u2019re not a designer":["Modelos profissionais para ajud\u00e1-lo a vender mais, mesmo que voc\u00ea n\u00e3o seja um designer"],"Order Bump Features":["Recursos de Incremento de Pedido"],"Dynamic Order Bumps":["Incrementos de Pedido Din\u00e2micos"],"Smart order bumps using customer data to display most relevant products or offers":["Ofertas adicionais inteligentes usando dados do cliente para exibir os produtos ou ofertas mais relevantes"],"Advanced Funnel Features":["Recursos Avan\u00e7ados de Funil"],"A \/ B Split Testing":["Teste A \/ B"],"Increase conversions and sales with CartFlows A\/B Testing by running simple tests":["Aumente as convers\u00f5es e vendas com o teste A\/B do CartFlows realizando testes simples"],"Analyze transactions and user behavior to refine conversions and make more profit":["Analisar transa\u00e7\u00f5es e o comportamento dos usu\u00e1rios para refinar convers\u00f5es e obter mais lucro"],"Cloud-based automation tools that intelligently links your websites, stores, plugins and apps":["Ferramentas de automa\u00e7\u00e3o baseadas em nuvem que conectam inteligentemente seus sites, lojas, plugins e aplicativos"],"SkillJet Academy Access":["Acesso \u00e0 SkillJet Academy"],"CartFlows offers full training to help you make more profit with SkillJet academy":["CartFlows oferece treinamento completo para ajud\u00e1-lo a obter mais lucro com a academia SkillJet"],"Others Benefits":["Outros Benef\u00edcios"],"Premium Support":["Suporte Premium"],"Professional Support, Professional Support Team or Dedicated Support Team":["Suporte Profissional, Equipe de Suporte Profissional ou Equipe de Suporte Dedicada"],"Amazing User Community":["Comunidade de Usu\u00e1rios Incr\u00edvel"],"Amazing User Community is already a great message unless you\u2019re looking for a different meaning":["Amazing User Community j\u00e1 \u00e9 uma \u00f3tima mensagem, a menos que voc\u00ea esteja procurando um significado diferente"],"Great Documentation & Video Tutorials":["\u00d3tima documenta\u00e7\u00e3o e tutoriais em v\u00eddeo"],"Comprehensive Documentation and Video Tutorials or Comprehensive Documentation and Video Guides":["Documenta\u00e7\u00e3o abrangente e tutoriais em v\u00eddeo ou Documenta\u00e7\u00e3o abrangente e guias em v\u00eddeo"],"Free Plugins":["Plugins Gratuitos"],"Variation Swatches":["Amostras de Varia\u00e7\u00e3o"],"Give customers choice by including relevant product variations including size, color and more":["D\u00ea aos clientes a op\u00e7\u00e3o, incluindo varia\u00e7\u00f5es relevantes de produtos, como tamanho, cor e mais"],"Stripe Payment Gateway":["Gateway de Pagamento Stripe"],"Accepting multiple payment methods gives customers choice and can significantly increase conversion":["Aceitar m\u00faltiplos m\u00e9todos de pagamento oferece escolha aos clientes e pode aumentar significativamente a convers\u00e3o"],"Features":["Recursos"],"See all CartFlows Pro features":["Veja todos os recursos do CartFlows Pro"],"Sell More with CartFlows Pro":["Venda mais com o CartFlows Pro"],"Get access to powerful features for painless WordPress designing, without the high costs. With all the time you will save, it\u2019s a product that pays for itself!":["Obtenha acesso a recursos poderosos para um design de WordPress sem complica\u00e7\u00f5es, sem os altos custos. Com todo o tempo que voc\u00ea economizar\u00e1, \u00e9 um produto que se paga sozinho!"],"Modern Cart":["Carrinho Moderno"],"Enable Instant Layout":["Ativar Layout Instant\u00e2neo"],"Disabled":["Desativado"],"upgrading to PRO":["atualizando para PRO"],"activating CartFlows Pro":["ativando o CartFlows Pro"],"You're using":["Voc\u00ea est\u00e1 usando"],"CartFlows Free":["CartFlows Gr\u00e1tis"],"To unlock more features, consider":["Para desbloquear mais recursos, considere"],"Activate CartFlows Pro":["Ativar CartFlows Pro"],"You can't edit this step directly because Instant Layout is turned on in the funnel settings. To make design changes, go to the Design tab inside this step's settings.":["Voc\u00ea n\u00e3o pode editar esta etapa diretamente porque o Layout Instant\u00e2neo est\u00e1 ativado nas configura\u00e7\u00f5es do funil. Para fazer altera\u00e7\u00f5es de design, v\u00e1 para a guia Design dentro das configura\u00e7\u00f5es desta etapa."],"Use this setting to customize the style of the Instant %s Layout.":["Use esta configura\u00e7\u00e3o para personalizar o estilo do Layout Instant\u00e2neo %s."],"Turn this on to set up rules that decide when visitors should be redirected to a special offer or the next step.":["Ative isto para configurar regras que decidem quando os visitantes devem ser redirecionados para uma oferta especial ou para o pr\u00f3ximo passo."],"Your email address can't be edited when using the Modern Checkout Style.":["Seu endere\u00e7o de e-mail n\u00e3o pode ser editado ao usar o Estilo de Checkout Moderno."],"The Company field won't be visible if you're using the Instant Layout Style.":["O campo Empresa n\u00e3o estar\u00e1 vis\u00edvel se voc\u00ea estiver usando o Estilo de Layout Instant\u00e2neo."],"This shows the total amount of money earned from all your funnels combined.":["Isso mostra o valor total de dinheiro ganho de todos os seus funis combinados."],"This shows the total number of orders placed through your CartFlows checkout pages.":["Isso mostra o n\u00famero total de pedidos feitos atrav\u00e9s das suas p\u00e1ginas de checkout do CartFlows."],"This shows the total number of times people visited any step in your funnel.":["Isso mostra o n\u00famero total de vezes que as pessoas visitaram qualquer etapa no seu funil."],"This shows the total amount of money earned from your Upsell and Downsell offers.":["Isso mostra o valor total de dinheiro ganho com suas ofertas de Upsell e Downsell."],"Set up a Store Checkout in just one click:":["Configure um Checkout de Loja com apenas um clique:"],"Thank You Page":["P\u00e1gina de Agradecimento"],"Use ready-made templates from the CartFlows Library, our custom widget, or shortcodes on each page to set this up easily\u2014no coding needed!":["Use modelos prontos da Biblioteca CartFlows, nosso widget personalizado ou shortcodes em cada p\u00e1gina para configurar isso facilmente\u2014sem necessidade de codifica\u00e7\u00e3o!"],"Install OttoKit for Free":["Instale o OttoKit gratuitamente"],"Visit OttoKit Website":["Visite o site OttoKit"],"Here are a few simple examples of what OttoKit can do on your WooCommerce store:":["Aqui est\u00e3o alguns exemplos simples do que o OttoKit pode fazer na sua loja WooCommerce:"],"Join Thousands of Entrepreneurs Already Using OttoKit.":["Junte-se a milhares de empreendedores que j\u00e1 utilizam o OttoKit."],"Bonus ($200 Value)":["B\u00f4nus (Valor de $200)"],"Access to OttoKit Pro Plan":["Acesso ao Plano Pro do OttoKit"],"Plus - Annual":["Plus - Anual"],"\/ year":["\/ ano"],"Pro - Annual":["Pro - Anual"],"Pro - Lifetime (One Time Pay)":["Pro - Vital\u00edcio (Pagamento \u00danico)"],"for Lifetime":["para toda a vida"],"Pro - Lifetime (11 x Split Pay)":["Pro - Vital\u00edcio (11 x Pagamento Parcelado)"],"x 11 Months":["x 11 Meses"],"Explore the key differences between Plus and Pro to find the perfect fit for your needs.":["Explore as principais diferen\u00e7as entre Plus e Pro para encontrar a op\u00e7\u00e3o perfeita para suas necessidades."],"CartFlows Free vs Pro Image":["Imagem do CartFlows Free vs Pro"],"Unlock Pro Features":["Desbloquear Recursos Pro"],"Generate More Sales With CartFlows Pro!":["Gere Mais Vendas com o CartFlows Pro!"],"And More\u2026":["E mais\u2026"],"Buy Now":["Compre Agora"],"View plans":["Ver planos"],"Moderncart":["Moderncart"],"Trusted by Top Brands to Boost Conversions Instantly":["Confiado pelas Principais Marcas para Aumentar as Convers\u00f5es Instantaneamente"],"Brand logo":["Logotipo da marca"],"Stop Losing Sales at the Cart \u2014 Fix It in Minutes!":["Pare de perder vendas no carrinho \u2014 resolva isso em minutos!"],"Modern Cart is your instant upgrade for more sales, bigger orders, and smoother checkouts.":["Modern Cart \u00e9 sua atualiza\u00e7\u00e3o instant\u00e2nea para mais vendas, pedidos maiores e checkouts mais suaves."],"Opt-in":["Participar"],"The product previously added as an Order Bump has been deleted. Please add a new product.":["O produto anteriormente adicionado como um Order Bump foi exclu\u00eddo. Por favor, adicione um novo produto."],"Choose a variation":["Escolha uma varia\u00e7\u00e3o"],"For more information about order bump settings please %1$sClick here.%2$s":["Para mais informa\u00e7\u00f5es sobre as configura\u00e7\u00f5es de aumento de pedido, por favor %1$sClique aqui.%2$s"],"Sum of all step views in this funnel.":["Soma de todas as visualiza\u00e7\u00f5es de etapas neste funil."],"Total upsell\/downsell revenue.":["Receita total de upsell\/downsell."],"Revenue per visit.":["Receita por visita."],"Revenue per unique visitor.":["Receita por visitante \u00fanico."],"Sandbox Mode":["Modo Sandbox"],"Live Mode":["Modo ao Vivo"],"No. of Orders":["N.\u00ba de Pedidos"],"Opt-in Step":["Etapa de ades\u00e3o"],"Opt-in Form":["Formul\u00e1rio de Inscri\u00e7\u00e3o"],"Popup":["Janela pop-up"],"Lead Magnets":["Im\u00e3s de Leads"],"Top Performing Funnels":["Funis de Melhor Desempenho"],"Find top performing funnels here":["Encontre os funis de melhor desempenho aqui"],"Once you set up funnels, come back here to top performing funnels":["Depois de configurar os funis, volte aqui para os funis de melhor desempenho"],"Top Performing Funnels is a Premium Feature":["Funis de Alto Desempenho \u00e9 um Recurso Premium"],"View sales analytics":["Ver an\u00e1lises de vendas"],"Fast and customizable cart for your website.":["Carrinho r\u00e1pido e personaliz\u00e1vel para o seu site."],"Recover abandonded carts with ease.":["Recupere carrinhos abandonados com facilidade."],"Automate your repititive tasks, effortlessly!":["Automatize suas tarefas repetitivas, sem esfor\u00e7o!"],"Product choices made visual and clickable.":["Escolhas de produtos tornadas visuais e clic\u00e1veis."],"Extend Your Store":["Expanda Sua Loja"],"Replace Store Checkout Funnel?":["Substituir o Funil de Checkout da Loja?"],"A Store Checkout funnel already exists. Importing will replace the current Store Checkout funnel.":["J\u00e1 existe um funil de Checkout da Loja. A importa\u00e7\u00e3o substituir\u00e1 o atual funil de Checkout da Loja."],"Replace & Import":["Substituir e Importar"],"Import from JSON file":["Importar de arquivo JSON"],"Average Order Value":["Valor M\u00e9dio do Pedido"],"Average Order Value is a Premium Feature":["O Valor M\u00e9dio do Pedido \u00e9 um Recurso Premium"],"Bump Offer Revenue":["Receita de Oferta de Impulso"],"Bump Offer Revenue is a Premium Feature":["A Receita de Oferta Adicional \u00e9 um Recurso Premium"],"Revenue Per Visit":["Receita Por Visita"],"Revenue Per Visit is a Premium Feature":["Receita Por Visita \u00e9 um Recurso Premium"],"RPUV":["RPUV"],"Revenue Per Unique Visitor is a Premium Feature":["Receita Por Visitante \u00danico \u00e9 um Recurso Premium"],"Loading flows\u2026":["Carregando fluxos\u2026"],"Select Flow":["Selecionar Fluxo"],"No data available":["N\u00e3o h\u00e1 dados dispon\u00edveis"],"All Funnels is a Premium Feature":["Todos os Funis \u00e9 um Recurso Premium"],"Previous Period":["Per\u00edodo Anterior"],"Previous Year":["Ano Anterior"],"Total Visitors":["Total de visitantes"],"This shows the total amount of money earned from all steps combined.":["Isso mostra o valor total de dinheiro ganho de todas as etapas combinadas."],"Avg. Order Value":["Valor M\u00e9dio do Pedido"],"Average value of each order (Total Revenue \/ Total Orders).":["Valor m\u00e9dio de cada pedido (Receita Total \/ Total de Pedidos)."],"Bump Revenue":["Aumentar Receita"],"This shows the total amount of money earned from all order bump offers.":["Isso mostra o valor total de dinheiro ganho com todas as ofertas de aumento de pedido."],"Revenue per each visit (Total Revenue \/ Total Visitors).":["Receita por cada visita (Receita Total \/ Total de Visitantes)."],"This shows average revenue generated per individual visitor.":["Isso mostra a receita m\u00e9dia gerada por visitante individual."],"Total Submissions":["Total de Envios"],"Total Submissions is a Premium Feature":["Total de Envios \u00e9 um Recurso Premium"],"Conversion Rate is a Premium Feature":["A Taxa de Convers\u00e3o \u00e9 um Recurso Premium"],"List Growth":["Crescimento da Lista"],"Optin Overview is a Premium Feature":["Vis\u00e3o Geral de Optin \u00e9 um Recurso Premium"],"This shows the total opt-in form submissions.":["Isso mostra o total de envios do formul\u00e1rio de ades\u00e3o."],"This shows the percentage of visitors who completed the opt-in.":["Isso mostra a porcentagem de visitantes que completaram a inscri\u00e7\u00e3o."],"Laptop Conversions":["Convers\u00f5es de Laptop"],"Laptop Conversions is a Premium Feature":["Convers\u00f5es de Laptop \u00e9 um Recurso Premium"],"Mobile Conversions":["Convers\u00f5es M\u00f3veis"],"Mobile Conversions is a Premium Feature":["Convers\u00f5es M\u00f3veis \u00e9 um Recurso Premium"],"Total Conversions":["Total de convers\u00f5es"],"Total Conversions is a Premium Feature":["Total de Convers\u00f5es \u00e9 um Recurso Premium"],"Bump Conversions":["Aumentar Convers\u00f5es"],"Bump Conversions is a Premium Feature":["Bump Conversions \u00e9 um recurso premium"],"Offer Conversions":["Convers\u00f5es de Ofertas"],"Offer Conversions is a Premium Feature":["Convers\u00f5es de Ofertas \u00e9 um Recurso Premium"],"Steps":["Passos"],"This section lists funnel conversion data.":["Esta se\u00e7\u00e3o lista os dados de convers\u00e3o do funil."],"This is where your funnel drop-off statistics will appear":["\u00c9 aqui que as estat\u00edsticas de abandono do seu funil aparecer\u00e3o"],"Step Drop-off is a Premium Feature":["O recurso de entrega por etapas \u00e9 uma funcionalidade premium"],"Product Details":["Detalhes do Produto"],"This section lists product conversion data.":["Esta se\u00e7\u00e3o lista os dados de convers\u00e3o de produtos."],"Product Drop-off is a Premium Feature":["A entrega de produtos \u00e9 um recurso premium"],"This shows the total number of visitors for the selected funnel\/s.":["Isso mostra o n\u00famero total de visitantes para o(s) funil(is) selecionado(s)."],"This shows the total conversions for the selected funnel.":["Isso mostra as convers\u00f5es totais para o funil selecionado."],"This shows the order bump conversions for the selected funnel.":["Isso mostra as convers\u00f5es de aumento de pedido para o funil selecionado."],"This shows the total offer conversions from Upsell and Downsell combined for the selected funnel.":["Isso mostra as convers\u00f5es totais de ofertas de Upsell e Downsell combinadas para o funil selecionado."],"This shows the orders completed on large-screen devices (over 1024px).":["Isso mostra os pedidos conclu\u00eddos em dispositivos de tela grande (acima de 1024px)."],"This shows orders completed on mobile and small-screen devices (under 1024px).":["Isso mostra pedidos conclu\u00eddos em dispositivos m\u00f3veis e de tela pequena (menos de 1024px)."],"Hot":["Quente"],"Get ModernCart Now":["Obtenha o ModernCart agora"],"Your WooCommerce Cart, Reinvented %sto Sell More.":["Seu Carrinho WooCommerce, Reinventado %spara Vender Mais."],"ModernCart replaces redirects and reloads with a smooth slide-out cart \u2014 fewer steps, fewer drop-offs, more conversions.":["O ModernCart substitui redirecionamentos e recarregamentos por um carrinho deslizante suave \u2014 menos etapas, menos desist\u00eancias, mais convers\u00f5es."],"See Plans & Pricing \u2192":["Veja Planos e Pre\u00e7os \u2192"],"Here's What ModernCart Does for Your Store":["Aqui est\u00e1 o que o ModernCart faz pela sua loja"],"Slide-Out Cart":["Carrinho Deslizante"],"Keep shoppers on the same page while adding or editing items, reducing steps and boosting completed purchases.":["Mantenha os compradores na mesma p\u00e1gina enquanto adicionam ou editam itens, reduzindo etapas e aumentando as compras conclu\u00eddas."],"Smart Product Recommendations":["Recomenda\u00e7\u00f5es Inteligentes de Produtos"],"Show relevant product suggestions inside the cart, automatically increasing order value with simple, effective upsells.":["Mostre sugest\u00f5es de produtos relevantes dentro do carrinho, aumentando automaticamente o valor do pedido com upsells simples e eficazes."],"Free Shipping Progress Bar":["Barra de Progresso de Frete Gr\u00e1tis"],"Motivate customers to spend more by clearly showing how close they are to unlocking free shipping.":["Incentive os clientes a gastar mais, mostrando claramente o qu\u00e3o perto est\u00e3o de desbloquear o frete gr\u00e1tis."],"Smooth Coupon Management":["Gest\u00e3o Suave de Cupons"],"Make discounts effortless \u2014 shoppers can quickly apply or remove coupon codes without page reloads or confusion.":["Torne os descontos descomplicados \u2014 os compradores podem aplicar ou remover rapidamente c\u00f3digos de cupom sem recarregar a p\u00e1gina ou confus\u00e3o."],"Instant Updates, No Reloads":["Atualiza\u00e7\u00f5es Instant\u00e2neas, Sem Recarregamentos"],"Deliver a seamless, app-like cart experience with real-time updates that keep customers engaged without interruptions.":["Ofere\u00e7a uma experi\u00eancia de carrinho fluida, semelhante a um aplicativo, com atualiza\u00e7\u00f5es em tempo real que mant\u00eam os clientes engajados sem interrup\u00e7\u00f5es."],"Customize Everything":["Personalize Tudo"],"Easily change cart icons, labels, colors, and texts to perfectly match your brand and store's style.":["Altere facilmente os \u00edcones do carrinho, r\u00f3tulos, cores e textos para combinar perfeitamente com a sua marca e o estilo da sua loja."],"Learn":["Aprender"],"File Size (MB)":["Tamanho do Arquivo (MB)"],"Accepted File Types":["Tipos de Arquivos Aceitos"],"Back to Webhooks":["Voltar para Webhooks"],"Edit Webhook":["Editar Webhook"],"Add New Webhook":["Adicionar Novo Webhook"],"e.g. CRM Integration":["por exemplo, Integra\u00e7\u00e3o CRM"],"Endpoint URL":["URL do Endpoint"],"Events":["Eventos"],"Select events that will trigger this webhook.":["Selecione os eventos que acionar\u00e3o este webhook."],"Select All":["Selecionar Todos"],"Enabled":["Habilitado"],"Max Retries":["M\u00e1ximo de Tentativas"],"Number of retry attempts for failed deliveries (0-5).":["N\u00famero de tentativas de reenvio para entregas falhadas (0-5)."],"Secret Key":["Chave Secreta"],"Used to sign webhook payloads (HMAC-SHA256).":["Usada para assinar cargas \u00fateis do webhook (HMAC-SHA256)."],"Copy to clipboard":["Copiar para a \u00e1rea de transfer\u00eancia"],"Copied!":["Copiado!"],"Please enter a webhook name.":["Por favor, insira um nome para o webhook."],"Please enter a webhook URL.":["Por favor, insira uma URL para o webhook."],"Please enter a valid URL.":["Por favor, insira uma URL v\u00e1lida."],"Please select at least one event.":["Por favor, selecione pelo menos um evento."],"Failed to save webhook.":["Falha ao salvar o webhook."],"Something went wrong.":["Algo deu errado."],"Update Webhook":["Atualizar Webhook"],"Create Webhook":["Criar Webhook"],"Webhooks":["Webhooks"],"Send real-time event data to external services when key funnel events occur.":["Envie dados de eventos em tempo real para servi\u00e7os externos quando eventos-chave do funil ocorrerem."],"No webhooks configured yet. Click \"Add New Webhook\" to get started.":["Nenhum webhook configurado ainda. Clique em \"Adicionar Novo Webhook\" para come\u00e7ar."],"URL":["URL"],"Last Delivery":["\u00daltima Entrega"],"events":["eventos"],"Success":["Sucesso"],"Never triggered":["Nunca acionado"],"Test sent!":["Teste enviado!"],"Send Test":["Enviar Teste"],"Are you sure you want to delete this webhook?":["Voc\u00ea tem certeza de que deseja excluir este webhook?"],"Global CSS & Scripts":["CSS & Scripts Globais"],"Successfully Activated":["Ativado com Sucesso"],"Activation Failed":["Falha na Ativa\u00e7\u00e3o"],"File":["Arquivo"],"Enter the maximum allowed file size. Default is 5MB.":["Insira o tamanho m\u00e1ximo de arquivo permitido. O padr\u00e3o \u00e9 5MB."],"Enter comma-separated file extensions (e.g. jpg, png, gif)":["Insira extens\u00f5es de arquivo separadas por v\u00edrgula (por exemplo, jpg, png, gif)"],"Invalid file type(s): %s":["Tipo(s) de arquivo inv\u00e1lido(s): %s"],"Processing\u2026":["Processando\u2026"],"Install %s":["Instalar %s"],"Mark %s as not completed":["Marcar %s como n\u00e3o conclu\u00eddo"],"Mark %s as completed":["Marcar %s como conclu\u00eddo"],"Learn how: %s":["Aprenda como: %s"],"%1$s - %2$s":["%1$s - %2$s"],"%1$s - %2$d of %3$d steps completed":["%1$s - %2$d de %3$d etapas conclu\u00eddas"],"%1$d of %2$d steps completed":["%1$d de %2$d etapas conclu\u00eddas"],"No sections available.":["Nenhuma se\u00e7\u00e3o dispon\u00edvel."],"Close video":["Fechar v\u00eddeo"],"Learn CartFlows":["Aprender CartFlows"],"Set up high-converting funnels in CartFlows with step-by-step guidance and launch with confidence.":["Configure funis de alta convers\u00e3o no CartFlows com orienta\u00e7\u00e3o passo a passo e lance com confian\u00e7a."],"Watch video: Learn CartFlows":["Assistir v\u00eddeo: Aprender CartFlows"],"Watch Video":["Assistir V\u00eddeo"],"Delete Webhook":["Excluir Webhook"],"Failed!":[""]}}}
