    68		 * @return void
    69		 */
    70		public function enqueue_assets() {
    71	
    72			global $pagenow;
    73	
    74			if ( ! is_admin() || 'admin.php' !== $pagenow || empty( $_GET['page'] ) || 'create-course' !== $_GET['page'] ) { // phpcs:ignore WordPress.Security.NonceVerification.Recommended
    75				return;
    76			}
    77	
    78			$course_id = isset( $_GET['course_id'] ) ? absint( $_GET['course_id'] ) : 0; // phpcs:ignore WordPress.Security.NonceVerification.Recommended
    79	
    80			if ( ! $course_id ) {
    81				return;
    82			} 
    83	
    84			wp_enqueue_style(
    85				'cartflows-tutor-course-template',
    86				CARTFLOWS_URL . 'compatibilities/plugins/tutor-lms/tutor-course-template.css',
    87				array(),
    88				CARTFLOWS_VER
    89			);
