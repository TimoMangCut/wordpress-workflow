   122		/**
   123		 * Redirect from default to the global checkout page
   124		 *
   125		 * @since 1.10.0
   126		 */
   127		public function global_checkout_template_redirect() {
   128	
   129			if ( wcf()->utils->is_step_post_type() ) {
   130				return;
   131			}
   132	
   133			if ( is_product() || ! is_checkout() || is_order_received_page() || is_checkout_pay_page() ) {
   134				return;
   135			}
   136	
   137			// Return if the key OR Order parameter is found in the URL for certain Payment gateways.
   138			if ( $this->should_show_global_checkout() ) {
   139				return;
   140			}
   141	
   142			// redirect only for cartflows checkout pages.
   143			$common = Cartflows_Helper::get_common_settings();
   144	
   145			$global_checkout          = $common['global_checkout'];
   146			$override_global_checkout = $common['override_global_checkout'];
   147	
   148			if ( ! empty( $global_checkout ) && 'enable' !== $override_global_checkout ) {
   149	
   150				$link = apply_filters( 'cartflows_global_checkout_url', get_permalink( $global_checkout ) );
   151	
   152				if ( ! empty( $link ) ) {
   153	
   154					wp_safe_redirect( $link );
   155					exit;
   156				}
   157			}
   158		}
