    61		/**
    62		 * Get ajax end points.
    63		 *
    64		 * @param string $endpoint_url end point URL.
    65		 * @param string $request end point request.
    66		 * @return string
    67		 */
    68		public function get_ajax_endpoint( $endpoint_url, $request ) {
    69			global $post;
    70	
    71			if ( ! empty( $post ) && ! empty( $_SERVER['REQUEST_URI'] ) ) {
    72	
    73				if ( _is_wcf_checkout_type() ) {
    74	
    75					$query_args = array();
    76					$url        = $endpoint_url;
    77	
    78					if ( mb_strpos( $endpoint_url, 'checkout', 0, 'utf-8' ) === false ) {
    79	
    80						if ( '' === $request ) {
    81							$query_args = array(
    82								'wc-ajax' => '%%endpoint%%',
    83							);
    84						} else {
    85							$query_args = array(
    86								'wc-ajax' => $request,
    87							);
    88						}
    89	
    90						$uri = explode( '?', esc_url_raw( $_SERVER['REQUEST_URI'] ), 2 );
    91						$url = esc_url( $uri[0] );
    92					}
    93	
    94					$query_args['wcf_checkout_id'] = $post->ID;
    95	
    96					$endpoint_url = add_query_arg( $query_args, $url );
    97				}
    98			}
    99	
   100			return $endpoint_url;
   101		}
