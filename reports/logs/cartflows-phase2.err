   191		/**
   192		 * Handles AJAX request to save the selected CartFlows template.
   193		 *
   194		 * Validates nonce, permissions, and template ID before persisting.
   195		 *
   196		 * @return void
   197		 */
   198		public function ajax_save_course_template() {
   199	
   200			if (
   201			empty( $_POST['nonce'] ) || ! wp_verify_nonce( sanitize_text_field( wp_unslash( $_POST['nonce'] ) ), self::NONCE_NAME ) ) {
   202				wp_send_json_error(
   203					array( 'message' => 'Invalid nonce.' ),
   204					403
   205				);
   206			}
   207	
   208			$course_id = isset( $_POST['course_id'] ) ? absint( $_POST['course_id'] ) : 0;
   209	
   210			if ( ! $course_id ) {
   211				wp_send_json_error(
   212					array( 'message' => 'Invalid course ID.' ),
   213					400
   214				);
   215			}
   216	
   217			if ( ! current_user_can( 'edit_post', $course_id ) ) {
   218				wp_send_json_error(
   219					array( 'message' => 'Permission denied.' ),
   220					403
   221				);
   222			}
   223	
   224			$template_raw = isset( $_POST['template_id'] ) ? sanitize_text_field( wp_unslash( $_POST['template_id'] ) ) : 'none';
   225	
   226			$template = $this->validate_template_id( $template_raw );
   227	
   228			update_post_meta( $course_id, self::META_KEY, $template );
   229	
   230			wp_send_json_success(
   231				array(
   232					'template' => $template,
   233					'message'  => 'Template saved.',
   234				)
   235			);

