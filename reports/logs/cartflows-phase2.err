   156		/**
   157		 * Remove cart item.
   158		 */
   159		public function wcf_woo_remove_cart_product() {
   160			check_ajax_referer( 'wcf-remove-cart-product', 'security' );
   161			$product_key   = isset( $_POST['p_key'] ) ? sanitize_text_field( wp_unslash( $_POST['p_key'] ) ) : false;
   162			$product_id    = isset( $_POST['p_id'] ) ? sanitize_text_field( wp_unslash( $_POST['p_id'] ) ) : '';
   163			$product_title = get_the_title( $product_id );
   164	
   165			$needs_shipping = false;
   166			$is_order_bump  = false;
   167			$order_bump_id  = '';
   168	
   169			// Check if the product is an order bump before removing it.
   170			if ( ! empty( $product_key ) ) {
   171				$cart_item = WC()->cart->get_cart_item( $product_key );
   172				if ( isset( $cart_item['cartflows_bump'] ) && $cart_item['cartflows_bump'] ) {
   173					$is_order_bump = true;
   174					$order_bump_id = isset( $cart_item['ob_id'] ) ? $cart_item['ob_id'] : '';
   175				}
   176				
   177				WC()->cart->remove_cart_item( $product_key );
   178				$msg = "<div class='woocommerce-message'>" . $product_title . __( ' has been removed.', 'cartflows' ) . '</div>';
   179			} else {
   180				$msg = "<div class='woocommerce-message'>" . __( 'Sorry there was a problem removing ', 'cartflows' ) . $product_title;
   181			}
   182	
   183			foreach ( WC()->cart->get_cart() as $cart_item_key => $values ) {
   184				if ( $values['data']->needs_shipping() ) {
   185					$needs_shipping = true;
   186					break;
   187				}
   188			}
   189	
   190			$response = array(
   191				'need_shipping' => $needs_shipping,
   192				'msg'           => $msg,
   193				'is_order_bump' => $is_order_bump,
   194				'order_bump_id' => $order_bump_id,
   195			);
   196	
   197			echo wp_json_encode( $response );
   198			wp_die();
   199		}
