      "suggested_field_corrections": {
        "verdict": "FP",
        "vuln_type": "False positive: intended public REST contact/subscription submission route, not packet-local Broken Access Control",
        "severity": "info",
        "confidence": 0.94,
        "auth_required": "Valid `X-WP-Nonce` for `wp_rest` plus successful Reach connection-status check before `post_contact()` is reached; no capability check is present",
