/bin/zsh -lc "python3 - <<'PY'
import json, collections
p='reports/phase1/cartflows-ir.json'
with open(p) as f: data=json.load(f)
source_by_ep=collections.defaultdict(list)
for s in data['sources']:
    source_by_ep[s.get('entry_point_id')].append(s)
guards_by_ep=collections.defaultdict(list)
for g in data['guards']:
    guards_by_ep[g.get('entry_point_id')].append(g)
for ep_id, sinks in sorted(collections.defaultdict(list, ((s.get('entry_point_id'), []) for s in [] )).items()):
    pass
sink_by_ep=collections.defaultdict(list)
for s in data['sinks']:
    if s.get('category') in ('option_update','meta_update'):
        sink_by_ep[s.get('entry_point_id')].append(s)
for ep_id, sinks in sorted(sink_by_ep.items(), key=lambda kv:(-len(kv[1]), kv[0])):
    sources=source_by_ep.get(ep_id, [])
    src_types=collections.Counter(s.get('type') for s in sources)
    if not sources:
        continue
    print('\\nEP', ep_id, 'writes', len(sinks), 'sources', len(sources), 'src_types', dict(src_types))
    for s in sinks[:5]:
        print(' sink', s['id'], s['file'], s['line'], s.get('function_called'))
    for s in sources[:5]:
        print(' src', s['id'], s['file'], s['line'], s.get('type'), s.get('name') or s.get('param') or s.get('key'))
    for g in guards_by_ep.get(ep_id, [])[:5]:
        print(' guard', g.get('guard_type'), 'effective=', g.get('is_effective'), 'line', g.get('line'), g.get('file'))
