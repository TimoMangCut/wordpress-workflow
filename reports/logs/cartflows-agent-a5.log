		if ( wcf()->utils->is_step_post_type() ) {
			return;
		}

		if ( is_product() || ! is_checkout() || is_order_received_page() || is_checkout_pay_page() ) {
			return;
		}

		// Return if the key OR Order parameter is found in the URL for certain Payment gateways.
