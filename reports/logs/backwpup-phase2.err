+      "verdict": "TP",
+      "vuln_type": "Broken Access Control",
+      "cwe_id": "CWE-862",
+      "severity": "high",
+      "auth_required": "plugin-defined read-only role backwpup_check",
+      "confidence": "high",
+      "entry_point_id": "ep_rest___cloudsaveandtest",
