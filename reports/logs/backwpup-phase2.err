+      "reason": "Unlike the broader Jobs REST routes, `/save_site_option` already uses a narrower permission callback: `current_user_can( 'backwpup_jobs_edit' ) || current_user_can( 'backwpup_settings' )` in `src/Jobs/API/Rest.php:331-339`. The handler also blocks critical keys including `backwpup_jobs`, `backwpup_version`, `backwpup_previous_version`, and `backwpup_messages` in `src/Jobs/API/Rest.php:797-814`.",
+      "code_refs": [
+        "src/Jobs/API/Rest.php:331",
+        "src/Jobs/API/Rest.php:338",
+        "src/Jobs/API/Rest.php:792",
+        "src/Jobs/API/Rest.php:797"
+      ]
+    }
+  ],
+  "out_of_scope": [
