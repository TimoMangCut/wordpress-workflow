   148		/**
   149		 * Starts the backup process.
   150		 *
   151		 * This function is triggered by a WP REST API request to initiate a backup.
   152		 * If a job ID is provided, it will start the backup for that job. Otherwise, it will start the backup for the file job.
   153		 *
   154		 * @param WP_REST_Request $request
   155		 * @return WP_REST_Response|WP_Error|WP_HTTP_Response The response object on success, or WP_Error on failure.
   156		 */
   157		public function start_backup( WP_REST_Request $request ) {
   158			$params = $request->get_params();
   159	
   160			if ( ! empty( $params['first_backup'] ) ) {
   161				if ( false === get_site_transient( 'backwpup_first_backup' ) ) {
   162					set_site_transient( 'backwpup_first_backup', true, HOUR_IN_SECONDS );
   163				} else {
   164					return new WP_REST_Response(
   165						[
   166							'status' => 301,
   167							'url'    => network_admin_url( 'admin.php?page=backwpup' ),
   168						],
   169						200,
   170						[ 'Content-Type' => 'text/json' ]
   171					);
   172				}
   173			}
   174	
   175			$create_backup_now_job = true;
   176			$jobs                  = $this->job_adapter->get_jobs();
   177			foreach ( $jobs as $job ) {
   178				if (
   179					isset( $job['backup_now'] ) && true === $job['backup_now']
   180					&& ! empty( $job['activetype'] )
   181				) {
   182					$create_backup_now_job = false;
   183				}
   184			}
   185	
   186			$jobid = $params['job_id'] ?? false;
   187			if ( $create_backup_now_job && false === $jobid ) {
   188				$jobid = $this->get_job_id_when_no_available_job();
   189			}
   190	
   191			// check temp folder.
   192			$temp_folder_message = $this->file_adapter->check_folder( $this->backwpup_adapter->get_plugin_data( 'TEMP' ), true );
   193			if ( ! empty( $temp_folder_message ) ) {
   194				return new WP_HTTP_Response(
   195					[
   196						'status'  => 500,
   197						'message' => $temp_folder_message,
   198					],
   199					200,
   200					[ 'Content-Type' => 'text/json' ]
   201				);
   202			}
   203	
   204			// check log folder.
   205			$log_folder         = get_site_option( 'backwpup_cfg_logfolder' );
   206			$log_folder         = $this->file_adapter->get_absolute_path( $log_folder );
   207			$log_folder_message = $this->file_adapter->check_folder( $log_folder );
   208			if ( ! empty( $log_folder_message ) ) {
   209				return new WP_HTTP_Response(
   210					[
   211						'status'  => 500,
   212						'message' => $log_folder_message,
   213					],
   214					200,
   215					[ 'Content-Type' => 'text/json' ]
   216				);
   217			}
   218	
   219			// check backup destinations.
   220			$job_types    = $this->backwpup_adapter->get_job_types();
   221			$job_data     = $this->option_adapter->get_job( $jobid );
   222			$creates_file = false;
   223			foreach ( $job_types as $id => $job_type_class ) {
   224				if ( in_array( $id, $job_data['type'], true ) && $job_type_class->creates_file() ) {
   225					$creates_file = true;
   226					break;
   227				}
   228			}
   229			if ( $creates_file ) {
   230				$destinations = 0;
   231				foreach ( $job_data['destinations'] as $dest_key ) {
   232					$dest = $this->backwpup_adapter->get_destination( $dest_key );
   233					if ( ! $dest || ! $dest->can_run( $job_data ) ) {
   234						continue;
   235					}
   236					++$destinations;
   237				}
   238	
   239				if ( ! $destinations ) {
   240					return new WP_HTTP_Response(
   241						[
   242							'status'  => 500,
   243							// translators: %s: Job name.
   244							'message' => sprintf( __( 'No backup destination available for "%s" or properly configured!', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   245						],
   246						200,
   247						[ 'Content-Type' => 'text/json' ]
   248					);
   249				}
   250			}
   251	
   252			// check if wp cron is working.
   253			$current_time    = time() - HOUR_IN_SECONDS;
   254			$next_cron_times = array_keys( _get_cron_array() );
   255			sort( $next_cron_times );
   256			if ( isset( $next_cron_times[0] ) && $next_cron_times[0] < $current_time ) {
   257				\BackWPup_Admin::message( __( 'WP-Cron does not seem to be working properly, because it has not run in the last hour. Please check your server settings.', 'backwpup' ), true );
   258			}
   259	
   260			$this->job_adapter->get_jobrun_url( 'runnow', $jobid );
   261	
   262			sleep( 1 ); // Wait for the job to start.
   263			$start_file_name = trailingslashit( $this->backwpup_adapter->get_plugin_data( 'TEMP' ) ) . '.backwpup_job_started';
   264			if ( file_exists( $start_file_name ) ) {
   265				wp_delete_file( $start_file_name );
   266			} else {
   267				return new WP_HTTP_Response(
   268					[
   269						'status'  => 500,
   270						'message' => __( 'The backup process could not be started! Please try to contact our support.', 'backwpup' ),
   271					],
   272					200,
   273					[ 'Content-Type' => 'text/json' ]
   274				);
   275			}
   276	
   277			if ( file_exists( $this->backwpup_adapter->get_plugin_data( 'running_file' ) ) ) {
   278				return new WP_HTTP_Response(
   279					[
   280						'status'  => 200,
   281						// translators: %s: Job name.
   282						'message' => sprintf( __( 'Job "%s" started.', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   283					],
   284					200,
   285					[ 'Content-Type' => 'text/json' ]
   286				);
   287			}
   288	
   289			return new WP_HTTP_Response(
   290				[
   291					'status'  => 201,
   292					// translators: %s: Job name.
   293					'message' => sprintf( __( 'Job "%s" executed.', 'backwpup' ), esc_attr( $job_data['name'] ) ),
   294				],
   295				200,
   296				[ 'Content-Type' => 'text/json' ]
   297			);
   298		}
