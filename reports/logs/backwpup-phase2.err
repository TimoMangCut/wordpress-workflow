new file mode 100644
index 0000000000000000000000000000000000000000..2f842419c06111d47af4a8cbcf95c8d3e1b0d7ce
--- /dev/null
+++ b//Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH/reports/phase2/backwpup-phase2.codex.json
@@ -0,0 +1,180 @@
+{
+  "plugin_slug": "backwpup",
+  "analysis_summary": "Reviewed the Phase 1 anomalies plus the highest-value AJAX and REST mutation surfaces in BackWPup 5.6.7. No unauthenticated or subscriber/customer-reachable issue was confirmed. Two broken-authorization findings were confirmed for the shipped read-only plugin role `backwpup_check`; major Phase 1 backup-download, logfile-read, and arbitrary-option-update signals were refuted by downstream capability, nonce, and path validation.",
+  "overall_risk": "medium",
+  "total_findings_analyzed": 6,
+  "true_positives": 2,
+  "false_positives": 4,
+  "needs_review": 0,
+  "findings": [
+    {
+      "finding_id": "BWPUP-P2-001",
+      "verdict": "TP",
+      "vuln_type": "Broken Access Control",
+      "cwe_id": "CWE-862",
+      "severity": "high",
+      "auth_required": "plugin-defined read-only role backwpup_check",
+      "confidence": "high",
+      "entry_point_id": "ep_rest___cloudsaveandtest",
+      "source_function": "WPMedia\\BackWPup\\StorageProviders\\API\\Rest::cloud_save_and_test",
+      "sink_function": "BackWPup_Destination_S3::job_run_archive",
+      "source_file_path": "src/StorageProviders/API/Rest.php",
+      "source_line_number": 262,
+      "sink_file_path": "inc/class-destination-s3.php",
+      "sink_line_number": 551,
+      "file_path": "inc/class-destination-s3.php",
+      "line_number": 551,
+      "storage_key": "backwpup_jobs",
+      "reasoning": {
+        "hypothesis": "A user assigned the shipped read-only `backwpup_check` role can reconfigure backup storage and trigger a backup upload to attacker-controlled cloud storage because multiple REST write routes only require the broad `backwpup` capability instead of the narrower edit/start capabilities used elsewhere in the plugin.",
+        "trace": [
+          "`backwpup_check` is created with `backwpup=true`, `backwpup_jobs=true`, and `backwpup_backups=true`, but `backwpup_jobs_edit=false`, `backwpup_jobs_start=false`, and `backwpup_settings=false` in `inc/class-install.php:142-158`.",
+          "The read-only role can still access BackWPup admin pages because the Jobs page requires `backwpup_jobs` and the Backups page requires `backwpup_backups` in `inc/class-admin.php:542-547` and `inc/class-admin.php:684-689`.",
+          "Any BackWPup admin page receives the REST nonce and write-route URLs because `enqueue_admin_assets()` localizes `backwpupApi` for every screen whose ID contains `backwpup` in `inc/class-admin.php:100-129`, and `get_backwpup_api_data()` exposes `cloudsaveandtest`, `updatejob`, `storages`, and `startbackup` plus `wp_rest` nonce in `inc/class-admin.php:1225-1253`.",
+          "The storage write route `/cloudsaveandtest` is registered with `permission_callback => [ $this, 'has_permission' ]` in `src/StorageProviders/API/Rest.php:112-119`, and `has_permission()` only checks `current_user_can('backwpup')` in `src/StorageProviders/API/Rest.php:138-139`.",
+          "On a successful call, `cloud_save_and_test()` invokes `$cloud->edit_form_post_save( $jobs )` in `src/StorageProviders/API/Rest.php:262-304`. For S3, `BackWPup_Destination_S3::edit_form_post_save()` persists attacker-controlled `s3accesskey`, `s3secretkey`, `s3bucket`, and `s3dir` into the job record stored under `backwpup_jobs` in `inc/class-destination-s3.php:161-243`.",
+          "The same low-privileged actor can then enable that destination because `/updatejob` and `/storages` also use `current_user_can('backwpup')` only, in `src/Jobs/API/Rest.php:87-88`, `src/Jobs/API/Rest.php:97-103`, `src/Jobs/API/Rest.php:381-418`, and `src/StorageProviders/API/Rest.php:122-129`, `src/StorageProviders/API/Rest.php:316-355`.",
+          "The same actor can trigger execution with `/startbackup`, which again only uses `current_user_can('backwpup')` in `src/Backups/API/Rest.php:81-82` and `src/Backups/API/Rest.php:94-100`. `start_backup()` calls `$this->job_adapter->get_jobrun_url( 'runnow', $jobid )` in `src/Backups/API/Rest.php:157-260`, which reaches `wp_remote_post()` to `wp-cron.php` in `inc/class-job.php:1850-1887`.",
+          "When the job runs with the attacker-controlled S3 settings, `BackWPup_Destination_S3::job_run_archive()` uploads the produced archive via `putObject()` or multipart `uploadPart()` in `inc/class-destination-s3.php:511-551` and `inc/class-destination-s3.php:608-643`, and logs the resulting object URL in `inc/class-destination-s3.php:679-685`."
+        ],
+        "defenses": [
+          "The legacy UI consistently treats edit/run actions as privileged: Jobs UI only renders edit/delete for `backwpup_jobs_edit` and run-now for `backwpup_jobs_start` in `inc/class-page-jobs.php:298-304`.",
+          "The issue is therefore not intended behavior for the read-only role; the REST layer is weaker than the rest of the plugin's authorization model."
+        ],
+        "refutation": [
+          {
+            "attempt": "Check whether the shipped `backwpup_check` role already includes the narrower edit/start/settings capabilities, which would make the route checks consistent.",
+            "result": "not_refuted",
+            "details": "`inc/class-install.php:142-158` explicitly sets `backwpup_jobs_edit`, `backwpup_jobs_start`, and `backwpup_settings` to `false` for `backwpup_check`."
+          },
+          {
+            "attempt": "Check whether a read-only role can realistically obtain the REST nonce and route URLs needed to invoke these endpoints.",
+            "result": "not_refuted",
+            "details": "The role can open BackWPup jobs/backups pages, and `enqueue_admin_assets()` plus `get_backwpup_api_data()` expose `wp_rest` nonce and the relevant write endpoints on any BackWPup screen in `inc/class-admin.php:100-129` and `inc/class-admin.php:1225-1253`."
+          },
+          {
+            "attempt": "Check whether the storage save path is only reachable through a request shape that would not populate `$_POST`, which the destination save methods rely on.",
+            "result": "not_refuted",
+            "details": "The plugin's own client code sends form-encoded POST data to `cloudsaveandtest` through jQuery AJAX in `assets/js/backwpup-admin.js:826-839` and `assets/js/backwpup-admin.js:1317-1329`, matching the `$_POST` reads in `inc/class-destination-s3.php:163-243`."
+          }
+        ],
+        "conclusion": "This is a confirmed privilege escalation inside the plugin's own role model. A user who should only inspect jobs/backups can store attacker-controlled cloud credentials, bind them to a job, and trigger a backup upload to attacker-controlled storage, disclosing the site's backup contents."
+      },
+      "poc_description": "Assign a test account the shipped `backwpup_check` role. Log in and open any BackWPup page to obtain `backwpupApi.nonce`. Use that nonce to POST attacker-controlled S3 parameters to `/wp-json/backwpup/v1/cloudsaveandtest`, then enable S3 for an existing job via `/wp-json/backwpup/v1/updatejob` or `/wp-json/backwpup/v2/storages`, and finally POST `/wp-json/backwpup/v1/startbackup` for that job. The generated archive is uploaded to the attacker-controlled S3 bucket.",
+      "cvss_vector": "AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:L/A:L",
+      "remediation": "Do not gate write routes with the broad `backwpup` capability. Require route-specific capabilities: storage configuration and destination changes should require `backwpup_jobs_edit` and/or `backwpup_settings`, while backup execution should require `backwpup_jobs_start`. Mirror those checks inside the mutation methods so UI-only gating cannot be bypassed through REST.",
+      "patchstack_eligible": false
+    },
+    {
+      "finding_id": "BWPUP-P2-002",
+      "verdict": "TP",
+      "vuln_type": "Broken Access Control",
+      "cwe_id": "CWE-862",
+      "severity": "medium",
+      "auth_required": "plugin-defined read-only role backwpup_check",
+      "confidence": "high",
+      "entry_point_id": "ep_rest_backwpup_v1__process_bulk_actions",
+      "source_function": "WPMedia\\BackWPup\\Backups\\API\\Rest::process_bulk_actions",
+      "sink_function": "BackWPup_Destination_Folder::file_delete",
+      "source_file_path": "src/Backups/API/Rest.php",
+      "source_line_number": 360,
+      "sink_file_path": "inc/class-destination-folder.php",
+      "sink_line_number": 75,
+      "file_path": "inc/class-destination-folder.php",
+      "line_number": 75,
+      "reasoning": {
+        "hypothesis": "A `backwpup_check` user can delete stored backup archives through the REST bulk-action endpoint even though the role intentionally lacks `backwpup_backups_delete`.",
+        "trace": [
+          "`backwpup_check` is created with `backwpup_backups=true` but `backwpup_backups_delete=false` in `inc/class-install.php:143-157`.",
+          "The REST bulk-delete route `/process_bulk_actions` is exposed with `permission_callback => [ $this, 'has_permission' ]` in `src/Backups/API/Rest.php:122-128`, and `has_permission()` only checks `current_user_can('backwpup')` in `src/Backups/API/Rest.php:81-82`.",
+          "`process_bulk_actions()` calls `delete_backup()` for each supplied item in `src/Backups/API/Rest.php:360-385`.",
+          "`delete_backup()` resolves the destination from the attacker-supplied `data-url` payload and dispatches to `$dest_class->file_delete( $jobdest, $file )` in `src/Backups/API/Rest.php:395-410`.",
+          "For the default local-folder destination, `BackWPup_Destination_Folder::file_delete()` resolves the selected archive under the configured backup directory and deletes it with `wp_delete_file()` in `inc/class-destination-folder.php:62-75`."
+        ],
+        "defenses": [
+          "The legacy Backups UI uses the stricter capability consistently: delete buttons are only rendered for `backwpup_backups_delete` in `inc/class-page-backups.php:390-391`, and the legacy delete action dies if that capability is missing in `inc/class-page-backups.php:503-540`."
+        ],
+        "refutation": [
+          {
+            "attempt": "Check whether the role mismatch is only cosmetic in the UI and the backend ultimately enforces `backwpup_backups_delete`.",
+            "result": "not_refuted",
+            "details": "The REST backend never checks `backwpup_backups_delete`; it only requires `backwpup` before calling `file_delete()`."
+          },
+          {
+            "attempt": "Check whether the sink is actually an arbitrary-file-delete primitive rather than a backup-only delete path.",
+            "result": "refuted_as_different_issue",
+            "details": "`inc/class-destination-folder.php:69-75` constrains deletion to `basename()` under the configured backup directory and requires a real file. The confirmed issue is authorization bypass for backup deletion, not path traversal."
+          }
+        ],
+        "conclusion": "This is a confirmed authorization bypass for destructive backup actions. The shipped read-only role can delete existing backup archives through REST even though both the role definition and the legacy controller treat backup deletion as a separate privileged action."
+      },
+      "poc_description": "Assign `backwpup_check` to a test user, log in, load a BackWPup page to obtain `backwpupApi.nonce`, then POST to `/wp-json/backwpup/v1/process_bulk_actions` with `action=delete` and a `backups[0][dataset][data-url]` value copied from a backup row. The selected local backup archive is deleted although the role lacks `backwpup_backups_delete`.",
+      "cvss_vector": "AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H",
+      "remediation": "Require `backwpup_backups_delete` for destructive backup routes, both in the REST route registration and inside the delete handler. Do not reuse the general `backwpup` capability for state-changing operations.",
+      "patchstack_eligible": false
+    }
+  ],
+  "negative_findings": [
+    {
+      "finding_id": "NEG-001",
+      "verdict": "FP",
+      "title": "AJAX backup download looked unauthenticated at the entry point",
+      "entry_point_id": "ep_ajax_priv_wp_ajax_download_backup_file",
+      "reason": "The outer AJAX handler in `inc/class-destination-downloader.php:58-99` only parses query arguments, but control immediately reaches `BackWPup_Destinations::file_download()`, which wraps the download in `BackWpup_Download_Handler::verify_request()`. That verifier enforces `check_admin_referer( 'backwpup_action_nonce' )` and `current_user_can( 'backwpup_backups_download' )` before the file is served.",
+      "code_refs": [
+        "inc/class-destination-downloader.php:58",
+        "inc/class-destinations.php:147",
+        "inc/class-download-handler.php:67"
+      ]
+    },
+    {
+      "finding_id": "NEG-002",
+      "verdict": "FP",
+      "title": "AJAX job-progress logfile read as LFI",
+      "entry_point_id": "ep_ajax_priv_wp_ajax_backwpup_working",
+      "reason": "The candidate at `inc/class-page-jobs.php:1076-1267` is protected by a capability gate plus nonce, and the `logfile` parameter is reduced to `basename()` and must match a `backwpup_log_*.ext` pattern before path construction. That refutes arbitrary-file read and leaves only intended logfile access.",
+      "code_refs": [
+        "inc/class-page-jobs.php:1076",
+        "inc/class-page-jobs.php:1103",
+        "inc/class-page-jobs.php:1123",
+        "inc/class-page-jobs.php:1253"
+      ]
+    },
+    {
+      "finding_id": "NEG-003",
+      "verdict": "FP",
+      "title": "AJAX log viewer as arbitrary log/file read",
+      "entry_point_id": "ep_ajax_priv_wp_ajax_backwpup_view_log",
+      "reason": "The log viewer requires `backwpup_logs`, verifies a per-log nonce, sanitizes the requested name with `sanitize_file_name()`, and only accepts names containing `backwpup_log_` before resolving the file beneath the configured log directory. No bypass to arbitrary files was confirmed.",
+      "code_refs": [
+        "inc/class-page-logs.php:512",
+        "inc/class-page-logs.php:516",
+        "inc/class-page-logs.php:520",
+        "inc/class-page-logs.php:522"
+      ]
+    },
+    {
+      "finding_id": "NEG-004",
+      "verdict": "FP",
+      "title": "REST save_site_option as low-priv arbitrary option update",
+      "entry_point_id": "ep_rest___save_site_option",
+      "reason": "Unlike the broader Jobs REST routes, `/save_site_option` already uses a narrower permission callback: `current_user_can( 'backwpup_jobs_edit' ) || current_user_can( 'backwpup_settings' )` in `src/Jobs/API/Rest.php:331-339`. The handler also blocks critical keys including `backwpup_jobs`, `backwpup_version`, `backwpup_previous_version`, and `backwpup_messages` in `src/Jobs/API/Rest.php:797-814`.",
+      "code_refs": [
+        "src/Jobs/API/Rest.php:331",
+        "src/Jobs/API/Rest.php:338",
+        "src/Jobs/API/Rest.php:792",
+        "src/Jobs/API/Rest.php:797"
+      ]
+    }
+  ],
+  "out_of_scope": [
+    {
+      "finding_id": "BWPUP-P2-001",
+      "reason": "Exploit requires the shipped custom role `backwpup_check`, not an unauthenticated, subscriber, or customer-equivalent actor."
+    },
+    {
+      "finding_id": "BWPUP-P2-002",
+      "reason": "Exploit requires the shipped custom role `backwpup_check`, not an unauthenticated, subscriber, or customer-equivalent actor."
