        backwpupApi.updatejob,
        {
          'job_id': job_id,
          'activ': checked
        },
        function (response) {
            $(`#backwpup-${job_id}-options div span.label-scheduled`).html(response.message);
            $tooltip.html(tooltip_text + ' ' + spanHTML);
        },
        "POST"
    );
  });


