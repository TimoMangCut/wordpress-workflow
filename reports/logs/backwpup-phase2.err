	public function track_delete_job( $job_id ) {
		if ( ! $this->optin->is_enabled() ) {
			return;
		}

		$user = wp_get_current_user();

		$this->mixpanel->identify( $user->user_email );

		$job = $this->option_adapter->get_job( $job_id );

