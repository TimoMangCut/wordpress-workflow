					'status'  => 200,
					// translators: %s: Job name.
					'message' => sprintf( __( 'Job "%s" started.', 'backwpup' ), esc_attr( $job_data['name'] ) ),
				],
				200,
				[ 'Content-Type' => 'text/json' ]
			);
		}

		return new WP_HTTP_Response(
