	/**
	 * Register the settings page.
	 *
	 * @param array $page_hooks The page hooks list.
	 *
	 * @return mixed
	 */
	public function admin_page_settings( $page_hooks ) {
		$this->page_hooks['backwpupsettings'] = add_submenu_page(
			'backwpup_null',
			esc_html__( 'Settings', 'backwpup' ),
			esc_html__( 'Settings', 'backwpup' ),
			'backwpup_settings',
			'backwpupsettings',
			[ $this->settings, 'page' ]
		);
