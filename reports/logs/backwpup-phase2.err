   295				}
   296				$return['message']   = __( 'Connection successful', 'backwpup' );
   297				$return['connected'] = $should_be_connected;
   298			}
   299			catch ( Exception $e ) {
   300				$return['error'] = $e->getMessage();
   301				$status          = 422;
   302			}
   303	
   304			return rest_ensure_response( new \WP_REST_Response( $return, $status ) );
   305		}
