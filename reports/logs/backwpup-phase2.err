   268				if ( ! isset( $params['cloud_name'] ) || '' === $params['cloud_name'] ) {
   269					throw new Exception( __( 'Cloud not set', 'backwpup' ) );
   270				}
   271				$cloud = $this->backwpup_adapter->get_destination( $params['cloud_name'] );
   272				if ( null === $cloud ) {
   273					throw new Exception( __( 'Cloud not found', 'backwpup' ) );
   274				}
   275				// If no job ID is set, it's from onboarding so we use only the first back job id.
   276				if ( ! isset( $params['job_id'] ) || '' === $params['job_id'] ) {
   277					$first_backup_job_id = get_site_option( Plugin::FIRST_JOB_ID, false );
   278					if ( false === $first_backup_job_id ) {
   279						throw new Exception( __( 'Files job not found', 'backwpup' ) );
   280					}
   281					$jobs = [
   282						$first_backup_job_id,
   283					];
   284				} else {
   285					$jobs = [ $params['job_id'] ];
   286				}
   287	
   288				$should_be_connected = true;
   289				if ( isset( $params['delete_auth'] ) && 'true' === $params['delete_auth'] ) {
   290					$should_be_connected = false;
   291				}
   292				$cloud->edit_form_post_save( $jobs );
