				) . "\n";
				$server_connect['html'] = sprintf(
					/* translators: %s: HTTP error message. */
					__( 'WP Http Error: <code>%s</code>', 'backwpup' ),
					esc_html( $raw_response->get_error_message() )
				) . '<br>';
			} else {
