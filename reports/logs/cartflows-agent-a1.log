          },
          "poc_description":      { "type": ["string", "null"] },
          "storage_key":          { "type": ["string", "null"], "description": "For stored/second-order flows" },
          "patchstack_eligible":  { "type": ["boolean", "null"] },
          "remediation":          { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "TP" } } },
