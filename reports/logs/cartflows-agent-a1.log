  1937		/**
  1938		 * Sanitize accepted file types input against the master allowlist.
  1939		 *
  1940		 * Strips any extensions not in the allowlist and returns a clean comma-separated string.
  1941		 *
  1942		 * @param string $raw_types Comma-separated file extensions from user input.
  1943		 * @return string Sanitized comma-separated file extensions.
  1944		 */
  1945		public static function sanitize_accepted_file_types( $raw_types ) {
  1946			if ( empty( $raw_types ) ) {
  1947				return '';
  1948			}
  1949	
  1950			$allowed   = self::get_allowed_file_extensions();
  1951			$input     = array_map( 'trim', explode( ',', sanitize_text_field( $raw_types ) ) );
  1952			$validated = array();
  1953	
  1954			foreach ( $input as $ext ) {
  1955				$ext = strtolower( $ext );
  1956				if ( ! empty( $ext ) && in_array( $ext, $allowed, true ) ) {
  1957					$validated[] = $ext;
  1958				}
  1959			}
  1960	
  1961			return implode( ', ', array_unique( $validated ) );
  1962		}
