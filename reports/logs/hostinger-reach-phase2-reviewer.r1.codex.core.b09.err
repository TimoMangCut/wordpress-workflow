   242	    public function post_contact( array $data ): WP_REST_Response {
   243	        if ( ! $this->get_connection_status_handler() ) {
   244	            $this->api_key_manager->clear_token();
   245	
   246	            return $this->handle_wp_error( new WP_Error( $this->get_not_connected_error_message(), 'You cannot perform this action' ) );
   247	        }
   248	
   249	        $contact    = $this->parse_contact( $data );
   250	        $group_name = $data['group'] ? $data['group'] : HOSTINGER_REACH_DEFAULT_CONTACT_LIST;
   251	        $tag_ids    = $this->get_tag_ids( $data['tags'] ?? '', $group_name );
   252	
   253	        if ( empty( $tag_ids ) ) {
   254	            $group_tag = $this->create_tag_from_group( $group_name );
   255	            if ( ! empty( $group_tag ) ) {
   256	                $tag_ids[] = $group_tag;
   257	            }
   258	        }
   259	
   260	        $args = array(
   261	            'tagUuids'  => $tag_ids,
   262	            'groupName' => $group_name,
   263	            'contacts'  => array( $contact ),
   264	        );
   265	
   266	        $response = $this->post(
   267	            'contacts',
   268	            $args
   269	        );
   270	
   271	        if ( is_wp_error( $response ) ) {
   272	            do_action( 'hostinger_reach_contact_failed', $data );
   273	
   274	            return $this->handle_wp_error( $response );
   275	        }
   276	
   277	        do_action( 'hostinger_reach_contact_submitted', $data );
   278	
   279	        return $this->handle_response( $response );
   280	    }
