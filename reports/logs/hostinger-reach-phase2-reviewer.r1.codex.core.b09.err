   389	    private function parse_contact( array $data ): array {
   390	        $contact = array(
   391	            'email' => sanitize_email( $data['email'] ),
   392	        );
   393	
   394	        if ( ! empty( $data['name'] ) ) {
   395	            $contact['name'] = $data['name'];
   396	        }
   397	
   398	        if ( ! empty( $data['surname'] ) ) {
   399	            $contact['surname'] = $data['surname'];
   400	        }
   401	
   402	        $metadata = $data['metadata'] ?? array();
   403	        if ( ! is_array( $metadata ) ) {
   404	            $metadata = array();
   405	        }
   406	
   407	        // phpcs:ignore WordPress.WP.CapitalPDangit.MisspelledInText -- Internal metadata key.
   408	        $metadata['platform'] = 'wordpress';
   409	
   410	        if ( ! isset( $metadata['plugin'] ) ) {
   411	            $metadata['plugin'] = ReachFormIntegration::INTEGRATION_NAME;
   412	        }
   413	
   414	        $contact['metadata'] = $metadata;
   415	
   416	        return $contact;
   417	    }
