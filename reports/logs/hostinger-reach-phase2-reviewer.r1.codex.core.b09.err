    42	        $request_args = array(
    43	            'method'  => 'GET',
    44	            'headers' => array_merge( $this->get_default_headers(), $headers ),
    45	            'timeout' => $timeout,
    46	        );
    47	
    48	        if ( ! empty( $params ) ) {
    49	            $url = add_query_arg( $params, $url );
