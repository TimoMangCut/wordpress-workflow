   108	        return $summary;
   109	    }
   110	
   111	    public function get_contacts( mixed $form_id = null, ?int $limit = 100, ?int $offset = 0 ): array {
   112	        $campaign_slug = $form_id;
   113	        $post          = get_post( $form_id );
   114	        if ( $post ) {
