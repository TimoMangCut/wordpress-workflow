    91	        }
    92	
    93	        return $this->handle_response( 200, array( 'message' => 'success' ) );
    94	    }
    95	
    96	    public function get_import_summary(): array {
    97	        $leads     = $this->do_request( 'v2', 'leads' );
    98	        $campaigns = $leads?->campaigns ?? array();
    99	        $summary   = array();
