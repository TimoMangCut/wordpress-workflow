/bin/zsh -lc "python3 - <<'PY'
import json
from pathlib import Path
schema_path=Path('contracts/phase2-review-core-output.schema.json')
out_path=Path('reports/phase2/hostinger-reach-phase2.review.r1.core.b11.json')
with schema_path.open() as f:
    schema=json.load(f)
with out_path.open() as f:
    data=json.load(f)
try:
    import jsonschema
except Exception as e:
    print('JSONSCHEMA_MISSING', e)
    raise SystemExit(0)
jsonschema.validate(data, schema)
print('SCHEMA_OK')
PY" in /Volumes/External_Disk/timo/WORDPRESS-PLUGIN-RESEARCH
