    13	use Duplicator\Libs\Snap\SnapIO;
    14	use Duplicator\Libs\Snap\SnapUtil;
    15	use Exception;
    16	
    17	class AjaxWrapper
    18	{
    19	    /**
    20	     * This function wrap a callback and return always a json well formatted output.
    21	     *
    22	     * check nonce and capability if passed and return a json with this format
    23	     * [
    24	     *      success : bool
    25	     *      data : [
    26	     *          funcData : mixed    // callback return data
    27	     *          message : string    // a message for jvascript func (for example an exception message)
    28	     *          output : string     // all normal output wrapped between ob_start and ob_get_clean
    29	     *                              // if $errorUnespectedOutput is true and output isn't empty the json return an error
    30	     *      ]
    31	     * ]
    32	     *
    33	     * @param callable $callback              callback function
    34	     * @param string   $nonceaction           if action is null don't verify nonce
    35	     * @param string   $nonce                 nonce string
    36	     * @param string   $capability            if capability is null don't verify capability
    37	     * @param bool     $errorUnespectedOutput if true thorw exception with unespected optput
    38	     *
    39	     * @return void
    40	     */
    41	    public static function json(
    42	        $callback,
    43	        $nonceaction = null,
    44	        $nonce = null,
    45	        $capability = null,
    46	        $errorUnespectedOutput = true
    47	    ) {
    48	        $error = false;
    49	
    50	        $result = array(
    51	            'funcData' => null,
    52	            'output'   => '',
    53	            'message'  => ''
    54	        );
    55	
    56	        ob_start();
    57	        try {
    58	            DUP_Handler::init_error_handler();
    59	            $nonce = SnapUtil::sanitizeNSCharsNewline($nonce);
    60	            if (is_null($nonceaction) || !wp_verify_nonce($nonce, $nonceaction)) {
    61	                DUP_Log::trace('Security issue');
    62	                throw new Exception('Security issue');
    63	            }
    64	            if (!is_null($capability)) {
    65	                DUP_Util::hasCapability($capability, DUP_Util::SECURE_ISSUE_THROW);
    66	            }
    67	
    68	            // execute ajax function
    69	            $result['funcData'] = call_user_func($callback);
    70	        } catch (Exception $e) {
    71	            $error             = true;
    72	            $result['message'] = $e->getMessage();
    73	        }
    74	
    75	        $result['output'] = ob_get_clean();
    76	        if ($errorUnespectedOutput && !empty($result['output'])) {
    77	            $error = true;
    78	        }
    79	
    80	        if ($error) {
    81	            wp_send_json_error($result);
    82	        } else {
    83	            wp_send_json_success($result);
    84	        }
    85	    }
    86	
    87	    /**
    88	     * This function wrap a callback and start a chunked file download.
    89	     * The callback must return a file path.
    90	     *
    91	     * @param callable():false|array{path:string,name:string} $callback              Callback function that return a file path for download or false on error
    92	     * @param string                                          $nonceaction           if action is null don't verify nonce
    93	     * @param string                                          $nonce                 nonce string
    94	     * @param bool                                            $errorUnespectedOutput if true thorw exception with unespected optput
    95	     *
    96	     * @return never
    97	     */
    98	    public static function fileDownload(
    99	        $callback,
   100	        $nonceaction = null,
   101	        $nonce = null,
   102	        $errorUnespectedOutput = true
   103	    ) {
   104	        ob_start();
   105	        try {
   106	            DUP_Handler::init_error_handler();
   107	            $nonce = SnapUtil::sanitizeNSCharsNewline($nonce);
   108	            if (!is_null($nonceaction) && !wp_verify_nonce($nonce, $nonceaction)) {
   109	                DUP_Log::trace('Security issue');
   110	                throw new Exception('Security issue');
   111	            }
   112	
   113	            // execute ajax function
   114	            if (($fileInfo = call_user_func($callback)) === false) {
   115	                throw new Exception('Error generating file');
   116	            }
   117	
   118	            if (!@file_exists($fileInfo['path'])) {
   119	                throw new Exception('File ' . $fileInfo['path'] . ' not found');
   120	            }
   121	
   122	            $result['output'] = ob_get_clean();
   123	            if ($errorUnespectedOutput && !empty($result['output'])) {
   124	                throw new Exception('Unespected output');
   125	            }
   126	
   127	            SnapIO::serveFileForDownload($fileInfo['path'], $fileInfo['name'], DUPLICATOR_BUFFER_READ_WRITE_SIZE);
   128	        } catch (Exception $e) {
   129	            DUP_Log::trace($e->getMessage());
   130	            SnapIO::serverError500();
   131	        }
   132	    }
   133	}

