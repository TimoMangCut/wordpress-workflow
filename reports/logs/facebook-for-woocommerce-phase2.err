+      "source_file_path": "includes/Handlers/Connection.php",
+      "source_line_number": 1514,
+      "sink_file_path": "includes/Handlers/Connection.php",
+      "sink_line_number": 1533,
+      "file_path": "includes/Handlers/Connection.php",
+      "line_number": 1533,
+      "reasoning": {
+        "hypothesis": "The App Store login redirect flow may allow a privileged user to supply an external redirect target.",
+        "trace": "handle_fbe_redirect() base64-decodes $_REQUEST['redirect_uri'] at Connection.php:1514, validates it with preg_match('/https?:\\/\\/(www\\.|m\\.|l\\.)?(\\d{5}\\.od\\.)?(facebook|instagram|whatsapp)\\.com(\\/.*)?/') at line 1516, then forwards it to wp_redirect($redirect_url) at line 1533. Because the regex is not anchored to the end of the string, values such as https://facebook.com@evil.com/path and https://facebook.com.evil.com still satisfy the check.",
+        "defenses": "The flow requires current_user_can('manage_woocommerce') at lines 1511-1512. On the success branch it appends only get_connect_parameters_extras(), which contains onboarding metadata such as external_business_id, timezone, currency, domain, and business name at Connection.php:1100-1122, not access tokens.",
+        "refutation": "I validated the regex behavior separately and confirmed it matches attacker-controlled hosts that merely begin with a facebook.com or instagram.com prefix. parse_url('https://facebook.com@evil.com/path') resolves host = evil.com, so the redirect can leave the intended allowlist.",
+        "conclusion": "This is a real open redirect, but it is low severity and not Patchstack-eligible in this context because exploitation already requires a privileged manage_woocommerce account and does not expose secret tokens in the reviewed code path."
+      },
+      "poc_description": "Log in as a Shop Manager or Administrator and browse to /?wc-api=wc_fbe_redirect&success=1&redirect_uri=<base64 of https://facebook.com@evil.com/path>. The regex allowlist accepts the value and wp_redirect() sends the browser to evil.com with an extras= JSON blob appended.",
+      "cvss_vector": null,
+      "remediation": "Parse the decoded URL and compare the normalized host exactly against an allowlist of expected domains, or replace the regex with strict host validation and wp_safe_redirect().",
+      "patchstack_eligible": false
+    }
+  ]
+}

