	/**
	 * Gets Commerce Partner Integration ID value.
	 *
	 * @since 3.4.8
	 *
	 * @return string
	 */
	public function get_commerce_partner_integration_id() {
		return get_option( self::OPTION_COMMERCE_PARTNER_INTEGRATION_ID, '' );
	}


