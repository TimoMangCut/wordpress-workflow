    83	
    84			// Verify signature.
    85			$signature     = self::urlsafe_b64_decode( $sig_b64 );
    86			$der_signature = self::signature_to_der( $signature );
    87			$digest        = self::SUPPORTED_ALGS[ $algorithm ];
    88			$msg           = $head_b64 . '.' . $body_b64;
    89	
    90			$result = openssl_verify( $msg, $der_signature, $public_key, $digest );
    91			if ( 1 !== $result ) {
    92				if ( -1 === $result ) {
    93					throw new \UnexpectedValueException( 'OpenSSL error: ' . openssl_error_string() );
    94				}
    95				throw new JWTSignatureInvalidException( 'Signature verification failed' );
    96			}
    97	
    98			// Check expiration.
    99			if ( isset( $payload['exp'] ) && time() >= $payload['exp'] ) {
   100				throw new JWTExpiredException( 'Expired token' );
   101			}

