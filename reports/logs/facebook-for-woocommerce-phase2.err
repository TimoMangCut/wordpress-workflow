@@ -0,0 +1,197 @@
+{
+  "plugin_slug": "facebook-for-woocommerce",
+  "analysis_summary": "Validated eight Phase 1 and semgrep candidates across public REST routes, AJAX handlers, admin bootstrap paths, settings saves, and connection flows. No Patchstack-eligible source-to-sink vulnerability survived refutation. One real but low-impact open redirect exists in the privileged wc_fbe_redirect flow; it requires manage_woocommerce and only appends non-secret onboarding metadata, so it is tracked as out of scope.",
+  "overall_risk": "low",
+  "total_findings_analyzed": 8,
+  "true_positives": 0,
+  "false_positives": 7,
+  "needs_review": 0,
+  "findings": [],
+  "negative_findings": [
+    {
+      "finding_id": "codex-fp-offer-management-public-route",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Public /fb_api/offers registration is backed by Meta-signed JWT validation and catalog binding",
+      "entry_point_id": "ep_rest__",
+      "source_function": "OfferManagementEndpointBase::execute_with_validation",
+      "sink_function": "CreateOffersEndpoint::execute_endpoint",
+      "source_file_path": "includes/OfferManagement/OfferManagementEndpointBase.php",
+      "source_line_number": 122,
+      "sink_file_path": "includes/OfferManagement/CreateOffersEndpoint.php",
+      "sink_line_number": 34,
+      "reasoning": {
+        "hypothesis": "permission_callback = __return_true on /fb_api/offers might expose coupon create, read, and delete operations to unauthenticated callers.",
+        "trace": "The route is registered publicly at OfferManagementEndpointBase.php:84-90, but execute_with_validation() refuses requests unless feature flags are enabled, jwt_params is present, RequestVerification::decode_jwt_with_retries() accepts the token, and the decoded aud claim matches the configured catalog ID before execute_endpoint() is reached.",
+        "defenses": "RequestVerification selects Meta public keys by project, retries with refreshed keys when needed, and JWTCodec::decode() verifies algorithm, ECDSA signature, and exp before returning claims.",
+        "refutation": "I traced the only privileged sinks reachable from this route to coupon creation at CreateOffersEndpoint.php:29-34 and coupon deletion at DeleteOffersEndpoint.php:27-35. Both stay behind the JWT and catalog checks in OfferManagementEndpointBase.php:128-145, so the Phase 1 'public REST' signal does not produce an unauthenticated exploit path on its own.",
+        "conclusion": "Rejected as a false positive. The route is intentionally public at the WordPress layer, but it implements an application-layer trust boundary using Meta-signed JWTs and store-specific catalog binding.",
+        "reopen_if": "Show a practical way for an attacker without Meta's signing key to forge a token accepted by RequestVerification, or a reachable code path that invokes execute_endpoint() before the JWT and aud checks."
+      }
+    },
+    {
+      "finding_id": "codex-fp-dismiss-notice-current-user-only",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "wc_facebook_dismiss_notice only mutates the caller's own user meta",
+      "entry_point_id": "ep_ajax_priv_wp_ajax_wc_facebook_dismiss_notice",
+      "source_function": "WC_Facebookcommerce_Admin_Notice::ajax_dismiss_notice",
+      "sink_function": "WC_Facebookcommerce_Admin_Notice::ajax_dismiss_notice",
+      "source_file_path": "facebook-commerce-admin-notice.php",
+      "source_line_number": 52,
+      "sink_file_path": "facebook-commerce-admin-notice.php",
+      "sink_line_number": 54,
+      "reasoning": {
+        "hypothesis": "The AJAX dismiss handler lacks current_user_can() and might let lower-privileged users perform an admin-only action.",
+        "trace": "The handler checks a per-action nonce at facebook-commerce-admin-notice.php:52-53 and then writes update_user_meta(get_current_user_id(), self::NOTICE_ID, 1) at line 54.",
+        "defenses": "The sink is hard-coded to the current session user. No user_id, option key, or capability-controlled object can be chosen by the caller.",
+        "refutation": "Even if another logged-in user can hit wp_ajax_wc_facebook_dismiss_notice, the only effect is dismissing this notice for that same account. I found no path to alter another user's state or any site-wide setting.",
+        "conclusion": "Rejected as a false positive because the missing capability check does not create measurable security impact.",
+        "reopen_if": "Show a code path where the handler can target another user or mutate shared/plugin-wide state."
+      }
+    },
+    {
+      "finding_id": "codex-fp-sync-ajax-handlers-guarded",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Product and feed sync AJAX handlers are protected by manage_woocommerce and action-specific nonces",
+      "entry_point_ids": [
+        "ep_ajax_priv_wp_ajax_wc_facebook_sync_products",
+        "ep_ajax_priv_wp_ajax_wc_facebook_sync_coupons",
+        "ep_ajax_priv_wp_ajax_wc_facebook_sync_shipping_profiles",
+        "ep_ajax_priv_wp_ajax_wc_facebook_sync_navigation_menu",
+        "ep_ajax_priv_wp_ajax_wc_facebook_get_sync_status"
+      ],
+      "source_function": "AJAX::sync_products",
+      "sink_function": "WC_Facebookcommerce_Utils::is_legit_ajax_call",
+      "source_file_path": "includes/AJAX.php",
+      "source_line_number": 109,
+      "sink_file_path": "includes/fbutils.php",
+      "sink_line_number": 502,
+      "reasoning": {
+        "hypothesis": "Phase 1 classified several wp_ajax_* sync endpoints as subscriber-reachable and potentially capable of triggering catalog sync actions.",
+        "trace": "Each sync/status entry point immediately calls WC_Facebookcommerce_Utils::is_legit_ajax_call() before any privileged action: sync_products() at AJAX.php:109-121, sync_coupons() at 134-140, sync_shipping_profiles() at 153-159, sync_navigation_menu() at 172-179, and get_sync_status() at 192-216.",
+        "defenses": "is_legit_ajax_call() is defined in fbutils.php:502-503 as current_user_can('manage_woocommerce') && check_ajax_referer($action, $nonce).",
+        "refutation": "Because check_ajax_referer() aborts on failure and manage_woocommerce is checked first, I could not trace any subscriber or unauthenticated path into the sync sinks.",
+        "conclusion": "Rejected as a false positive. These endpoints are not exploitable by subscriber-level users despite the coarse IR auth heuristic.",
+        "reopen_if": "Show a call site that exposes one of these nonces to a lower-privileged role or a code path where is_legit_ajax_call() is bypassed."
+      }
+    },
+    {
+      "finding_id": "codex-fp-pluginrender-nopriv-hooks-guarded",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "PluginRender nopriv AJAX hooks still require a manage_woocommerce session plus nonce",
+      "entry_point_ids": [
+        "ep_ajax_nopriv_wp_ajax_nopriv_wc_facebook_opt_out_of_sync",
+        "ep_ajax_nopriv_wp_ajax_nopriv_wc_facebook_sync_all_products"
+      ],
+      "source_function": "PluginRender::opt_out_of_sync_clicked",
+      "sink_function": "WC_Facebookcommerce_Utils::is_legit_ajax_call",
+      "source_file_path": "includes/Handlers/PluginRender.php",
+      "source_line_number": 205,
+      "sink_file_path": "includes/fbutils.php",
+      "sink_line_number": 502,
+      "reasoning": {
+        "hypothesis": "The presence of wp_ajax_nopriv_* hooks in PluginRender might let anonymous users toggle sync behavior or banner state.",
+        "trace": "The nopriv hooks are registered at PluginRender.php:86-95, but every state-changing callback immediately gates on is_legit_ajax_call(): opt_out_of_sync_clicked() at 205-212, sync_all_clicked() at 215-221, product_set_banner_closed() at 224-229, and both banner-reset methods at 236-266.",
+        "defenses": "is_legit_ajax_call() requires current_user_can('manage_woocommerce') and a valid action nonce, so anonymous requests fail before any option or transient write.",
+        "refutation": "I traced the supposedly dangerous sinks update_option(self::MASTER_SYNC_OPT_OUT_TIME, ...) and set_transient(...) and found no path from the nopriv registration to those sinks without the manage_woocommerce guard succeeding.",
+        "conclusion": "Rejected as a false positive. The nopriv registrations are noisy, but they do not create an anonymous state-change primitive.",
+        "reopen_if": "Show any PluginRender callback reachable from a nopriv hook that does not call is_legit_ajax_call() first."
+      }
+    },
+    {
+      "finding_id": "codex-fp-rest-routes-have-permission-callbacks",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Settings, WhatsApp, extras, and webhook REST routes do define manage_woocommerce permission callbacks",
+      "source_function": "AbstractRESTEndpoint::permission_callback",
+      "sink_function": "Connection::extras_permission_callback",
+      "source_file_path": "includes/API/Plugin/AbstractRESTEndpoint.php",
+      "source_line_number": 40,
+      "sink_file_path": "includes/Handlers/Connection.php",
+      "sink_line_number": 1484,
+      "reasoning": {
+        "hypothesis": "Semgrep reported several wc-facebook/v1 routes as missing permission callbacks or being effectively public.",
+        "trace": "Settings routes register permission_callback => [ $this, 'permission_callback' ] at Settings/Handler.php:35-52, WhatsApp routes do the same at WhatsAppSettings/Handler.php:35-63, the extras route uses extras_permission_callback at Connection.php:1463-1470 and 1484-1485, and the webhook route uses permission_callback at WebHook.php:41-48 and 63-64.",
+        "defenses": "The shared AbstractRESTEndpoint::permission_callback() returns current_user_can('manage_woocommerce') at AbstractRESTEndpoint.php:40-41; Connection::extras_permission_callback() and WebHook::permission_callback() do the same explicitly.",
+        "refutation": "I verified the source rather than relying on the static rule messages. These routes are not missing permission callbacks in the shipped code.",
+        "conclusion": "Rejected as false positives caused by rule overmatching or stale assumptions.",
+        "reopen_if": "Show a concrete wc-facebook/v1 route in this plugin that reaches a sensitive callback without any permission_callback check."
+      }
+    },
+    {
+      "finding_id": "codex-fp-is-admin-used-for-bootstrap-not-auth",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "is_admin() is used for admin bootstrap and migration, not as the sole authorization check for writes",
+      "source_function": "WC_Facebookcommerce::init",
+      "sink_function": "Settings::save",
+      "source_file_path": "class-wc-facebookcommerce.php",
+      "source_line_number": 259,
+      "sink_file_path": "includes/Admin/Settings.php",
+      "sink_line_number": 260,
+      "reasoning": {
+        "hypothesis": "Phase 1 and semgrep flagged is_admin() usage as broken access control because subscribers can reach wp-admin/admin-ajax.php.",
+        "trace": "The flagged branches at class-wc-facebookcommerce.php:259-267 and facebook-commerce.php:315-388 and 455-479 are bootstrap/migration logic that instantiate admin handlers, enqueue admin assets, or synchronize pixel settings. The state-changing save paths later enforce capability and nonces: Settings::save() at Settings.php:249-263 and Enhanced_Settings::save() at Enhanced_Settings.php:265-283.",
+        "defenses": "Both save handlers require Helper::get_requested_value('page') === 'wc-facebook', current_user_can('manage_woocommerce'), and check_admin_referer(...).",
+        "refutation": "I did not find a write sink reachable only because is_admin() evaluated true. The actual sinks remain guarded inside the invoked admin handlers.",
+        "conclusion": "Rejected as a false positive. The is_admin() calls are not the final authorization boundary in the reviewed flows.",
+        "reopen_if": "Show a concrete state-changing method inside one of these bootstrap branches that executes without its own capability or nonce checks."
+      }
+    },
+    {
+      "finding_id": "codex-fp-fixed-option-writes-not-arbitrary-option-update",
+      "state": "REJECTED",
+      "verdict": "FP",
+      "title": "Flagged option updates write fixed plugin keys after guarded validation, not attacker-chosen option names",
+      "source_function": "Product_Attributes::process_form_submission",
+      "sink_function": "Product_Attributes::process_form_submission",
+      "source_file_path": "includes/Admin/Settings_Screens/Product_Attributes.php",
+      "source_line_number": 892,
