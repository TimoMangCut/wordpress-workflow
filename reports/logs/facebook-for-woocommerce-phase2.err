	/**
	 * Determines if the unmapped attributes banner should be shown.
	 *
	 * @return bool
	 */
	private function should_show_unmapped_attributes_banner() {
		// Only show to users who can manage WooCommerce
		if ( ! current_user_can( 'manage_woocommerce' ) ) {
			return false;
		}

		return true;
	}

