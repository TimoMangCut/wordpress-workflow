     1	import { useGeneralDataStore } from '@/stores/generalDataStore';
     2	import { Header } from '@/types/enums';
     3	import type { AuthorizeRequestHeaders } from '@/types/models';
     4	import type { OverviewData } from '@/types/models/reachDataModels';
     5	import { generateCorrelationId } from '@/utils/helpers';
     6	import httpService from '@/utils/services/httpService';
     7	
     8	const URL = `${hostinger_reach_reach_data.rest_base_url}hostinger-reach/v1`;
     9	
    10	export const reachRepo = {
    11		generateAuthUrl: (headers?: AuthorizeRequestHeaders) => {
    12			const { nonce } = useGeneralDataStore();
    13	
    14			const config = {
    15				headers: {
    16					[Header.CORRELATION_ID]: headers?.[Header.CORRELATION_ID] || generateCorrelationId(),
    17					[Header.WP_NONCE]: nonce
    18				}
    19			};
    20	
    21			return httpService.post<{ authUrl: string; success: boolean }>(`${URL}/generate-auth-url`, {}, config);
    22		},
    23	
