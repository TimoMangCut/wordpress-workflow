    40	     */
    41	    public static function checkIsPluginActiveMultiSite( string $plugin_relative_path ): bool {
    42	        // Check network-wide active plugins
    43	        $activePlugins = get_site_option( 'active_sitewide_plugins', [] );
    44	        if ( in_array( $plugin_relative_path, $activePlugins ) ) {
    45	            return true;
    46	        }
    47	
    48	        // Check each site in the network
    49	        $sites = get_sites();
    50	        foreach ( $sites as $site ) {
    51	            switch_to_blog( $site->blog_id );
    52	            $activePlugins = get_option( 'active_plugins', [] );
    53	            if ( in_array( $plugin_relative_path, $activePlugins ) ) {
    54	                restore_current_blog();
    55	
    56	                return true;
    57	            }
    58	            restore_current_blog();
    59	        }
    60	
    61	        return false;
    62	    }
