+{
+  "plugin_slug": "hostinger-reach",
+  "reviews": [
+    {
+      "finding_id": "HOSTINGER-REACH-P2-REV-001",
+      "vuln_type": "Broken Access Control",
+      "minimum_role_capability": "none, but only if the attacker first obtains a valid linking secret from either the manage_options flow or the server-held /.api_token file",
+      "status_transition": "UNCERTAIN -> downgrade",
+      "original_status": "UNCERTAIN",
+      "verdict_change": "downgrade",
+      "suggested_field_corrections": {
+        "entry_point_id": "ep_rest__token",
+        "source_file_path": "plugins/hostinger-reach/src/Api/Handlers/ReachApiHandler.php",
+        "source_line_number": 212,
+        "sink_file_path": "plugins/hostinger-reach/src/Api/ApiKeyManager.php",
+        "sink_line_number": 18,
+        "storage_key": "hostinger_reach_api_key"
+      },
+      "reason": "The public /token route is real and the Phase 2 sink line should be corrected to ApiKeyManager::store_token() at line 18, but the repository does not expose either accepted secret to an unauthenticated actor. The short-lived transient is only minted behind current_user_can('manage_options'), and the /.api_token fallback is only read from a server-derived filesystem path that the plugin never localizes or returns to clients.",
+      "counter_evidence": [
+        {
+          "type": "guard",
+          "file": "plugins/hostinger-reach/src/Api/Routes/ReachRoutes.php",
+          "line": 86,
+          "detail": "The public /token route does not run unconditionally; its permission_callback requires a caller-supplied csrf_field that passes ApiKeyManager::validate_csrf() before the handler executes."
+        },
+        {
+          "type": "guard",
+          "file": "plugins/hostinger-reach/src/Api/Routes/ReachRoutes.php",
+          "line": 104,
+          "detail": "The transient branch of validate_csrf() is only created by POST /generate-auth-url, and that route inherits permission_check() which returns current_user_can('manage_options')."
+        },
+        {
+          "type": "guard",
+          "file": "plugins/hostinger-reach/src/Api/Handlers/ReachApiHandler.php",
+          "line": 215,
+          "detail": "post_token_handler() repeats validate_csrf() before calling ApiKeyManager::store_token(), so the secret check is enforced twice on the write path."
+        },
+        {
+          "type": "unreachable",
+          "file": "plugins/hostinger-reach/src/Api/ApiKeyManager.php",
+          "line": 80,
+          "detail": "get_api_token_path() derives the fallback file as '/<segment1>/<segment2>/.api_token', i.e. from a server/account-root-style path rather than a plugin or wp-content URL path; this is a counter-indicator for direct web disclosure and should be verified on the target deployment."
+        },
+        {
+          "type": "unreachable",
+          "file": "plugins/hostinger-reach/src/Providers/SurveysProvider.php",
+          "line": 34,
+          "detail": "The same /.api_token value is reused only as an outbound Hostinger header in server-side clients; this code search found no wp_localize_script(), REST response, or template path that returns the token value to browsers."
+        },
+        {
+          "type": "unreachable",
+          "file": "plugins/hostinger-reach/vendor/hostinger/hostinger-wp-menu-manager/src/templates/menu.php",
+          "line": 67,
+          "detail": "The menu template only checks whether Utils::getApiToken() is non-empty to decide whether to show a Go to hPanel link; it does not echo the token contents."
+        }
+      ],
+      "missing_evidence": [
+        "Need a concrete disclosure path that lets an unauthenticated or low-privileged web actor obtain either the manage_options-generated transient token or the contents of the resolved /.api_token file.",
+        "Need deployment evidence showing the resolved /.api_token path is actually reachable from the web tier or another attacker-controlled channel, rather than remaining a server-side-only file.",
+        "Need an end-to-end run showing that the attacker can overwrite option hostinger_reach_api_key and measurably rebind subsequent Reach API calls to their own Reach tenant."
+      ],
+      "dynamic_test_plan": [
+        "Step 1: As an administrator, send POST /wp-json/hostinger-reach/v1/generate-auth-url with a valid X-WP-Nonce header and capture the returned auth_url plus its token query parameter; this verifies the only repo-visible transient minting path is manage_options-gated.",
+        "Step 2: As an unauthenticated client, send POST /wp-json/hostinger-reach/v1/token with body {\"csrf_field\":\"invalid\",\"token\":\"attacker-reach-token\"} and confirm the request is rejected and option hostinger_reach_api_key is unchanged.",
+        "Step 3: Only if you can legitimately obtain one accepted secret out of band, repeat POST /wp-json/hostinger-reach/v1/token with that exact csrf_field and token=<attacker Reach API token>; then, from an administrator session, request GET /wp-json/hostinger-reach/v1/overview with X-WP-Nonce to verify whether the site is now bound to the attacker Reach workspace.",
+        "Step 4: To resolve the main uncertainty, instrument the target with a one-off debug log or shell check to print ApiKeyManager::get_api_token_path(), confirm whether that filesystem path is outside the document root, and separately review delivered HTML/JS plus unauthenticated REST responses for any leak of the accepted secret."
+      ]
+    }
+  ]
+}

