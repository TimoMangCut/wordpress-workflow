    28				headers: {
    29					[Header.CORRELATION_ID]: headers?.[Header.CORRELATION_ID] || generateCorrelationId(),
    30					[Header.WP_NONCE]: nonce
    31				}
    32			};
    33	
    34			return httpService.get<OverviewData>(`${URL}/overview`, config);
    35		}
    36	};

