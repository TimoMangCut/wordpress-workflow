    12	
    13	class Assets {
    14	    private Functions $functions;
    15	    private ReachApiHandler $reach_api_handler;
    16	
    17	    public function __construct( Functions $functions, ReachApiHandler $reach_api_handler ) {
    18	        $this->functions         = $functions;
    19	        $this->reach_api_handler = $reach_api_handler;
    20	    }
    21	
    22	    public function init(): void {
    23	        add_action( 'admin_enqueue_scripts', array( $this, 'admin_enqueue_scripts' ) );
    24	    }
    25	
    26	    public function admin_enqueue_scripts(): void {
    27	
    28	        if ( ! $this->functions->need_to_load_assets() ) {
    29	            return;
    30	        }
    31	
    32	        if ( file_exists( $this->functions->get_frontend_dir() . 'main.js' ) === false ) {
    33	            return;
    34	        }
    35	
    36	        wp_enqueue_script(
    37	            'hostinger-reach',
    38	            Functions::get_frontend_url() . 'main.js',
    39	            array(),
    40	            filemtime( $this->functions->get_frontend_dir() . 'main.js' ),
    41	            true
    42	        );
    43	
    44	        $css_file = $this->functions->get_frontend_dir() . 'main.css';
    45	        if ( file_exists( $css_file ) ) {
    46	            wp_enqueue_style(
    47	                'hostinger-reach-styles',
    48	                Functions::get_frontend_url() . 'main.css',
    49	                array(),
    50	                filemtime( $css_file )
    51	            );
    52	        }
    53	
    54	        wp_localize_script(
    55	            'hostinger-reach',
    56	            'hostinger_reach_reach_data',
    57	            array(
    58	                'site_url'              => get_site_url(),
    59	                'rest_base_url'         => esc_url_raw( rest_url() ),
    60	                'ajax_url'              => admin_url( 'admin-ajax.php' ),
    61	                'nonce'                 => wp_create_nonce( 'wp_rest' ),
    62	                'plugin_url'            => HOSTINGER_REACH_PLUGIN_URL,
    63	                'translations'          => $this->get_translations(),
    64	                'is_connected'          => $this->reach_api_handler->is_connected(),
    65	                'is_hostinger_user'     => $this->functions->is_hostinger_user(),
    66	                'is_staging'            => $this->functions->is_staging(),
    67	                'total_form_pages'      => (int) wp_count_posts( 'page' )->publish,
    68	                'has_valid_resource_id' => ! empty( $this->reach_api_handler->get_resource_id() ) && $this->reach_api_handler->get_resource_id() !== ResourceIdManager::NON_EXISTENT_RESOURCE_ID,
    69	                'resource_id'           => $this->reach_api_handler->get_resource_id(),
    70	                'domain'                => $this->functions->get_host_info(),
    71	            )
    72	        );
    73	    }
