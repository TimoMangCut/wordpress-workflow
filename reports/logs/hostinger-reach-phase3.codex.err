    97			$site_url = get_site_url();
    98			$site_url = preg_replace( '#^https?://#', '', $site_url );
    99			$site_url = preg_replace( '/^www\./', '', $site_url );
   100			
   101			if ( ! empty( $site_url ) && ! empty( $host ) && strpos( $site_url, $host ) === 0 ) {
   102				if ( $site_url === $host ) {
   103					return $host;
   104				} else {
   105					return substr( $site_url, strlen( $host ) + 1 );
   106				}
   107			}
   108	
   109			return $host;
