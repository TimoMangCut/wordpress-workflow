    25		// Check if a specific plugin is active by its slug
    26	    public static function isPluginActive( string $pluginSlug ): bool {
    27	        $plugin_relative_path = $pluginSlug . '/' . $pluginSlug . '.php';
    28	
    29	        if ( is_multisite() ) {
    30	            return self::checkIsPluginActiveMultiSite( $plugin_relative_path );
    31	        }
    32	
    33	        return self::checkIsPluginActive( $plugin_relative_path );
