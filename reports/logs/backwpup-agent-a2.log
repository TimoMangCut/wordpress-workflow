      waitingMessageVisibilityTo("block");

      data = {
        action: "encrypt_key_handler",
        task: "generate_asymmetric_key_pair",
        _ajax_nonce: nonce(),
      };
      onDone = function (response) {
        var publicKeyDownloader;
        var privateKeyDownloader;

        var data = response.data;
