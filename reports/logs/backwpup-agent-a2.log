class BackWPup_Destination_MSAzure_Downloader implements BackWPup_Destination_Downloader_Interface {

	/**
	 * Downloader data object.
	 *
	 * @var BackWpUp_Destination_Downloader_Data
	 */
	private $data;

	/**
	 * Local file handler.
