        /** @var string[] $list */
        $list = include \BackWPup::get_plugin_data('plugindir') . '/vendor/inpsyde/backwpup-restore-shared/inc/localize-restore-api.php';

        $localizer = new LocalizeScripts($list);
        $localizer->output();
    }

