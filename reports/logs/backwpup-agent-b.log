	/**
	 * Save for user role adding.
	 *
	 * @param int $user_id User ID.
	 */
	public function save_profile_update( $user_id ) {
		global $wp_roles;

		if ( ! is_super_admin() && ! current_user_can( 'backwpup_admin' ) ) {
			return;
