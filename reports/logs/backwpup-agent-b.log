	/**
	 * Called on save form. Only POST allowed.
	 *
	 * @throws Exception If the files job is not found.
	 */
	public function save_post_form() {
		// TODO delete backwpupsettings option in $allowed_pages.
		$allowed_pages = [
			'backwpupeditjob',
			'backwpupinformation',
			'backwpupsettings',
			'backwpup',
			'backwpupfirstbackup',
