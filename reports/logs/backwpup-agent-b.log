			$order = SORT_ASC;
		} else {
			$order = SORT_DESC;
		}

		if ( empty( $orderby_param ) || ! in_array( strtolower( (string) $orderby_param ), [ 'jobname', 'type', 'dest', 'next', 'last' ], true ) ) {
			$orderby = 'jobname';
		} else {
			$orderby = strtolower( (string) $orderby_param );
