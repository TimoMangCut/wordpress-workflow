   208	  /**
   209	   * Generates a JWT (JSON Web Token), signed by the stored secret token.
   210	   *
   211	   * @access public
   212	   * @param array $payload Payload data.
   213	   * @param string $secret Used to sign the JWT.
   214	   * @return string The generated JWT.
   215	   */
   216	  public static function generate_jwt($payload, $secret = false) {
   217	    if($secret === false) {
   218	      $secret = get_option('prli_authenticator_secret_token');
   219	    }
   220	
   221	    // Create token header.
   222	    $header = array(
   223	      'typ' => 'JWT',
   224	      'alg' => 'HS256'
   225	    );
   226	
   227	    $header = json_encode($header);
   228	    $header = self::base64url_encode($header);
   229	
   230	    // Create token payload.
   231	    $payload = json_encode($payload);
   232	    $payload = self::base64url_encode($payload);
   233	
   234	    // Create Signature Hash.
   235	    $signature = hash_hmac('sha256', "{$header}.{$payload}", $secret);
   236	    $signature = json_encode($signature);
   237	    $signature = self::base64url_encode($signature);
   238	
   239	    // Create JWT.
   240	    $jwt = "{$header}.{$payload}.{$signature}";
   241	    return $jwt;
   242	  }
   243	
   244	  /**
   245	   * Creates a Base64 encoded string so that it can be passed within URLs without any URL encoding.
   246	   *
   247	   * @access public
   248	   * @param string $value The string to encode.
   249	   * @return string The Base64 encoded string.
   250	   */
   251	  public static function base64url_encode($value) {
   252	    return rtrim( strtr( base64_encode( $value ), '+/', '-_' ), '=' );
   253	  }
