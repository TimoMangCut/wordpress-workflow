   152	  /**
   153	   * Processes a disconnect to the Authenticator service.
   154	   *
   155	   * @access public
   156	   * @return void
   157	   */
   158	  public function process_disconnect() {
   159	    // Make sure we've entered our Authenticator process.
   160	    if(!isset($_GET['prli-disconnect']) || $_GET['prli-disconnect'] !== 'true') {
   161	      return;
   162	    }
   163	
   164	    // Validate the nonce on the WP side of things.
   165	    if(!isset($_GET['nonce']) || !wp_verify_nonce($_GET['nonce'], 'prli-disconnect')) {
   166	      return;
   167	    }
   168	
   169	    // Make sure the user is authorized.
   170	    if(!PrliUtils::is_authorized()) {
   171	      return;
   172	    }
   173	
   174	    $site_email = get_option('prli_authenticator_account_email');
   175	    $site_uuid = get_option('prli_authenticator_site_uuid');
   176	
   177	    do_action('prli_pretty_link_com_pre_disconnect', $site_uuid, $site_email);
   178	
   179	    // Create token payload.
   180	    $payload = array(
   181	      'email'     => $site_email,
   182	      'site_uuid' => $site_uuid
   183	    );
   184	
   185	    // Create JWT.
   186	    $jwt = self::generate_jwt($payload);
   187	
   188	    // DELETE request to obtain token.
   189	    $response = wp_remote_request(PRLI_AUTH_SERVICE_URL . "/api/disconnect/prettylinks", array(
   190	      'method'    => 'DELETE',
   191	      'sslverify' => false,
   192	      'headers'   => PrliUtils::jwt_header($jwt, PRLI_AUTH_SERVICE_DOMAIN)
   193	    ));
   194	
   195	    $body = json_decode(wp_remote_retrieve_body($response), true);
   196	
   197	    if(isset($body['disconnected']) && $body['disconnected'] === true) {
   198	      delete_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_EMAIL );
   199	      delete_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_SECRET );
   200	      delete_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_SITE_UUID );
   201	      delete_option( PrliAuthConnectHelper::OPTION_KEY_AUTH_ACCOUNT_USER_UUID );
   202	    }
   203	
   204	    wp_redirect(remove_query_arg(array('prli-disconnect', 'nonce')));
   205	    exit;
   206	  }
