   199	    public function get_connection_status_handler(): bool {
   200	        if ( ! $this->is_connected() ) {
   201	            return false;
   202	        }
   203	
   204	        $status = $this->get( 'connection/status' );
   205	        if ( is_wp_error( $status ) || wp_remote_retrieve_response_code( $status ) >= 400 ) {
   206	            return false;
   207	        }
   208	
   209	        return true;
   210	    }
