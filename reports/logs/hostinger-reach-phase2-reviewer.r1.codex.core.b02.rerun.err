   184	            array(
   185	                'redirectUrl' => urlencode( $reach_url ),
   186	            ),
   187	            $this->hostinger_auth_url
   188	        );
   189	
   190	        return new WP_REST_Response(
   191	            array(
   192	                'auth_url' => $auth_url,
   193	                'success'  => true,
   194	            ),
   195	            200
   196	        );
   197	    }
