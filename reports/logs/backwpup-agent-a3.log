   293				if ( $should_be_connected !== $cloud->can_run( $this->option_adapter->get_job( $jobs[0] ) ) ) {
   294					throw new Exception( __( 'Connection failed', 'backwpup' ) );
   295				}
   296				$return['message']   = __( 'Connection successful', 'backwpup' );
   297				$return['connected'] = $should_be_connected;
   298			}
   299			catch ( Exception $e ) {
   300				$return['error'] = $e->getMessage();
   301				$status          = 422;
   302			}
   303	
   304			return rest_ensure_response( new \WP_REST_Response( $return, $status ) );
   305		}
   306	
   307		/**
   308		 * Check if the cloud is authenticated.
   309		 *
   310		 * @param WP_REST_Request $request The request object.
   311		 * @throws Exception If the Storage name is not set.
   312		 * @throws Exception If the job id is not set.
   313		 * @throws Exception If the storage not found.
   314		 * @throws Exception If the job has only one storage and it is the one to be removed.
   315		 */
   316		public function update_job_storage_options( WP_REST_Request $request ) {
   317			$params = $request->get_params();
   318			try {
   319				if ( ! isset( $params['name'] ) || '' === $params['name'] ) {
   320					throw new Exception( __( 'Storage not set', 'backwpup' ) );
   321				}
   322				$storage_name  = $params['name'];
   323				$storage_class = $this->backwpup_adapter->get_destination( strtolower( $storage_name ) );
   324	
   325				if ( null === $storage_class ) {
   326					throw new Exception( __( 'Storage not found', 'backwpup' ) );
   327				}
   328	
   329				if ( ! isset( $params['job_id'] ) || '' === $params['job_id'] ) {
   330					throw new Exception( __( 'Job id not set', 'backwpup' ) );
   331				}
   332				$checked       = (bool) $params['checked'];
   333				$job_id        = $params['job_id'];
   334				$backwpup_jobs = $this->option_adapter->get_job( $job_id );
   335				$destinations  = $backwpup_jobs['destinations'];
   336	
   337				if ( ! $checked ) {
   338					$destinations[] = strtoupper( $storage_name );
   339				} else {
   340					$destinations = array_filter(
   341						$destinations,
   342						function ( $value ) use ( $storage_name ) {
   343							return $value !== $storage_name;
   344						}
   345					);
   346				}
   347	
   348				$destinations = array_unique( array_values( $destinations ) );
   349	
   350				if ( count( $destinations ) < 1 ) {
   351					throw new Exception( __( 'At least one storage is required for a job to run', 'backwpup' ) );
   352				}
   353	
   354				$this->option_adapter->update( $job_id, 'destinations', $destinations );
   355	
   356				$return['message'] = __( 'Connection successful', 'backwpup' );
   357				$return['status']  = WP_Http::OK;
   358	
   359			} catch ( Exception $e ) {
   360				$return['status'] = WP_Http::INTERNAL_SERVER_ERROR;
   361	
   362				$return['error'] = $e->getMessage();
   363			}
   364	
   365			return rest_ensure_response( $return );
   366		}
   367	}

