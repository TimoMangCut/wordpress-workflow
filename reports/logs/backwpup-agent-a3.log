   173					if ( is_array( $dest_object ) ) {
   174						continue;
   175					}
   176					$items   = $dest_object->file_get_list( $a_job_id . '_' . $dest );
   177					$items   = $this->helpers_adapter->process_backup_items( $items, $job_data, $dest, $page );
