   778		/**
   779		 * Save site option via REST API.
   780		 *
   781		 * This method handles the saving of site options based on the provided parameters
   782		 * from the WP_REST_Request. It updates the site options accordingly.
   783		 * The value is encrypted if the secure flag is set to true.
   784		 * Exemple : {"option_name":{"value":"thevalue","secure":false}}
   785		 *
   786		 * @param WP_REST_Request $request The REST request object containing the parameters.
   787		 *
   788		 * @return WP_REST_Response The response object containing the status and message.
   789		 *
   790		 * @throws \RuntimeException If an update of a site option is not allowed.
   791		 */
   792		public function save_site_option( WP_REST_Request $request ) {
   793			$params = $request->get_params();
   794			$return = [];
   795			$status = 200;
   796			try {
   797				foreach ( $params as $key => $values ) {
   798					if ( strpos( $key, 'backwpup' ) !== 0 || in_array( $key, [ 'backwpup_jobs', 'backwpup_version', 'backwpup_previous_version', 'backwpup_messages' ], true ) ) {
   799						// translators: %s = site option name.
   800						throw new \RuntimeException( sprintf( __( 'Update of site option with name is "%s" not allowed!', 'backwpup' ), $key ) );
   801					}
   802					if ( ! is_array( $values ) || ! array_key_exists( 'value', $values ) ) {
   803						// translators: %s = site option name.
   804						throw new \RuntimeException( sprintf( __( 'Invalid data format for site option "%s".', 'backwpup' ), $key ) );
   805					}
   806					if ( '' !== trim( $values['value'] ) ) {
   807						$value = sanitize_text_field( $values['value'] );
   808						if ( isset( $values['secure'] ) && true === filter_var( $values['secure'], FILTER_VALIDATE_BOOLEAN ) ) {
   809							$value = $this->encryption_adapter->encrypt( sanitize_text_field( $value ) );
   810						}
   811						update_site_option( $key, $value );
   812					} else {
   813						delete_site_option( $key );
   814					}
   815					$return['message'] = __( 'Site option saved successfully.', 'backwpup' );
   816				}
   817			} catch ( Exception $e ) {
   818				$status          = 500;
   819				$return['error'] = $e->getMessage();
   820			}
   821			$response = rest_ensure_response( $return );
   822			$response->set_status( $status );
   823			return $response;
   824		}
   825	}

