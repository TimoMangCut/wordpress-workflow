   679			$return = [];
   680	
   681			try {
   682				// Extract parameters from the request.
   683				$job_id         = $params['job_id'];
   684				$archive_format = ! isset( $params['archiveformat'] ) ? get_site_option( 'backwpup_archiveformat', '.tar' ) : strtolower( $params['archiveformat'] );
   685				$archive_name   = ! isset( $params['archivename'] ) ? $this->option_adapter->defaults_job( 'archivename' ) : $params['archivename'];
   686				$archive_name   = trim( \BackWPup_Job::sanitize_file_name( $archive_name ) );
   687	
   688				if ( empty( $job_id ) ) {
   689					throw new Exception( __( 'Invalid parameter(s): job_id', 'backwpup' ) );
   690				}
   691	
   692				if ( empty( $archive_format ) ) {
   693					throw new Exception( __( 'Invalid parameter(s): archiveformat', 'backwpup' ) );
   694				}
   695	
   696				if ( ! in_array( $archive_format, [ '.tar', '.zip', '.tar.gz' ], true ) ) {
   697					throw new Exception( __( 'Invalid job archive format.', 'backwpup' ) );
   698				}
   699	
   700				if ( strpos( $archive_name, '%hash%' ) === false ) {
   701					throw new Exception( __( 'The hash must be defined in archive name.', 'backwpup' ) );
   702				}
   703	
   704				if ( strlen( $archive_name ) > 200 ) {
   705					throw new Exception( __( 'The archive name must be shorter then 200 chars.', 'backwpup' ) );
   706				}
   707	
   708				$this->option_adapter->update( $job_id, 'archiveformat', $archive_format );
   709				$this->option_adapter->update( $job_id, 'archivename', $archive_name );
   710	
   711				$return['status']  = 200;
   712				$return['message'] = __('Job settings saved successfully.', 'backwpup'); // @phpcs:ignore
   713	
   714			} catch ( Exception $e ) {
   715				// Handle errors.
   716				$return['status'] = 500;
   717				$return['error']  = $e->getMessage();
   718			}
   719	
   720			// Return response as a valid WP REST API response.
   721			return rest_ensure_response( $return );
   722		}
