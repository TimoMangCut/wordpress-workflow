    46		 *
    47		 * @return void
    48		 */
    49		public function register_routes(): void {
    50			register_rest_route(
    51				self::ROUTE_NAMESPACE,
    52				self::CHATBOT_ENDPOINT,
    53				[
    54					[
    55						'methods'             => 'POST',
    56						'callback'            => [ $this, 'create_context' ],
    57						'permission_callback' => [ $this, 'has_permission' ],
    58					],
    59					[
    60						'methods'             => 'GET',
    61						'callback'            => [ $this, 'get_context' ],
    62						'permission_callback' => [ $this, 'has_context_token_permission' ],
    63						'args'                => [
    64							'context_id'    => [
    65								'required'          => true,
    66								'sanitize_callback' => 'sanitize_text_field',
    67							],
    68							'context_token' => [
    69								'required'          => true,
    70								'sanitize_callback' => 'sanitize_text_field',
    71							],
    72						],
    73					],
    74				]
    75			);
    76		}
    77	
    78		/**
    79		 * Creates a context snapshot.
    80		 *
    81		 * @param WP_REST_Request $request
    82		 * @return \WP_Error|WP_HTTP_Response|\WP_REST_Response
    83		 */
    84		public function create_context( WP_REST_Request $request ) {
    85			$context_id    = wp_generate_uuid4();
    86			$context_token = wp_generate_password( 32, false, false );
    87			$ttl           = 10 * MINUTE_IN_SECONDS;
    88	
    89			$context = $this->snapshot_builder->build( 5 );
    90	
    91			set_site_transient(
    92				'backwpup_chatbot_context_' . $context_id,
    93				[
    94					'token'   => $context_token,
    95					'payload' => $context,
    96				],
    97				$ttl
    98			);
    99	
   100			/**
   101			 * Fires when the context is created (after the contact support button is clicked).
   102			 */
   103			do_action( 'backwpup_track_support_tool_button_clicked' );
   104	
   105			return new \WP_REST_Response(
   106				[
   107					'context_id'    => $context_id,
   108					'context_token' => $context_token,
   109					'expires_in'    => $ttl,
   110					'payload'       => $context,
   111				],
   112				201
   113			);
   114		}
   115	
   116		/**
   117		 * Only allow read if token matches the stored one.
   118		 *
   119		 * @param WP_REST_Request $request
   120		 * @return bool
   121		 */
   122		public function has_context_token_permission( WP_REST_Request $request ): bool {
   123			$context_id    = (string) $request->get_param( 'context_id' );
   124			$context_token = (string) $request->get_param( 'context_token' );
   125	
   126			if ( '' === $context_id || '' === $context_token ) {
   127				return false;
   128			}
   129	
   130			$stored = get_site_transient( 'backwpup_chatbot_context_' . $context_id );
   131			if ( ! is_array( $stored ) || empty( $stored['token'] ) ) {
   132				return false;
   133			}
   134	
   135			return hash_equals( (string) $stored['token'], $context_token );
   136		}
   137	
   138		/**
   139		 * Returns the context snapshot associated with context_id.
   140		 *
   141		 * @param WP_REST_Request $request
   142		 * @return \WP_Error|WP_HTTP_Response|\WP_REST_Response
   143		 */
   144		public function get_context( WP_REST_Request $request ) {
   145			$context_id = (string) $request->get_param( 'context_id' );
   146			$stored     = get_site_transient( 'backwpup_chatbot_context_' . $context_id );
   147	
   148			if ( ! is_array( $stored ) || empty( $stored['payload'] ) ) {
   149				return new \WP_REST_Response(
   150					[ 'message' => __( 'Context not found or expired.', 'backwpup' ) ],
   151					404
   152				);
   153			}
   154	
   155			return new \WP_REST_Response( $stored['payload'], 200 );
   156		}
   157	}

