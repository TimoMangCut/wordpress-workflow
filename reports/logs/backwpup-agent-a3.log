   581		/**
   582		 * Save the job frequency settings via the REST API.
   583		 *
   584		 * This function updates the cron schedule for a given job and reschedules it accordingly.
   585		 * It generates a new cron expression based on user input and stores it in the database.
   586		 *
   587		 * @param WP_REST_Request $request The REST API request containing job settings.
   588		 *
   589		 * @return WP_REST_Response|WP_Error|WP_HTTP_Response The response containing the updated job schedule or an error message.
   590		 */
   591		public function save_job_settings( WP_REST_Request $request ) {
   592			$params = $request->get_params(); // Get request parameters.
   593			$return = [];
   594	
   595			try {
   596				// Extract parameters from the request.
   597				$job_id    = $params['job_id'];
   598				$frequency = $params['frequency'];
   599	
   600				// Set default values if parameters are not provided.
   601				$params['start_time']        = isset( $params['start_time'] ) ? $params['start_time'] : '00:00';
   602				$params['hourly_start_time'] = isset( $params['hourly_start_time'] ) ? (int) $params['hourly_start_time'] : 0;
   603				$day_of_week                 = (int) isset( $params['day_of_week'] ) ? $params['day_of_week'] : 0;
   604				$day_of_month                = isset( $params['day_of_month'] ) ? $params['day_of_month'] : '';
   605	
   606				// Convert start_time into hour and minute parts.
   607				$start_time = explode( ':', $params['start_time'] );
   608	
   609				// Adjust start time for hourly jobs.
   610				if ( 'hourly' === $frequency ) {
   611					$start_time = [ '*', $params['hourly_start_time'] ];
   612				}
   613	
   614				// Update frequency.
   615				$this->option_adapter->update( $job_id, 'frequency', $frequency );
   616	
   617				if ( 'link' === $frequency ) {
   618					$next_backup = __( 'External link', 'backwpup' );
   619					// Update activetype.
   620					$this->option_adapter->update( $job_id, 'activetype', $frequency );
   621	
   622				} else {
   623					// Generate new cron expression based on the selected frequency and time settings.
   624					$new_cron_expression = $this->cron_adapter->get_basic_cron_expression(
   625						$frequency,
   626						$start_time[0],
   627						$start_time[1],
   628						$day_of_week,
   629						$day_of_month
   630					);
   631	
   632					// Update the cron expression in the job settings.
   633					$this->option_adapter->update( $job_id, 'cron', $new_cron_expression );
   634	
   635					// Re-schedule the job with the updated cron schedule.
   636					$this->job_adapter->schedule_job( $job_id );
   637	
   638					// Get the next scheduled execution time.
   639					$cron_next = $this->cron_adapter->cron_next( $new_cron_expression );
   640	
   641					// Update activetype.
   642					$this->option_adapter->update( $job_id, 'activetype', 'wpcron' );
   643	
   644					// Prepare response with next backup schedule.
   645					$next_backup = sprintf(
   646					// translators: %1$s = date, %2$s = time.
   647						__( '%1$s at %2$s', 'backwpup' ),
   648						wp_date( get_option( 'date_format' ), $cron_next ),
   649						wp_date( get_option( 'time_format' ), $cron_next )
   650					);
   651				}
   652	
   653				$return['next_backup'] = $next_backup;
   654				$return['status']      = 200;
   655				$return['message']     = __('Job settings saved successfully.', 'backwpup'); // @phpcs:ignore
   656	
   657			} catch ( Exception $e ) {
   658				// Handle errors.
   659				$return['status'] = 500;
   660				$return['error']  = $e->getMessage();
   661			}
   662	
   663			// Return response as a valid WP REST API response.
   664			return rest_ensure_response( $return );
   665		}
