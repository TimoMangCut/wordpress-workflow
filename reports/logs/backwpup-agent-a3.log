   208			if ( $page > $total_pages ) {
   209				$page = $total_pages;
   210			}
   211			$start        = $page * $length - $length;
   212			$backups_list = array_slice( $backups, $start, $length );
   213			$html         = '';
   214	
   215			foreach ( $backups_list as $backup ) {
   216				if ( 'wpcron' === $backup['type'] ) {
   217					$backup['type'] = __( 'Scheduled', 'backwpup' );
   218				}
   219				$html .= $this->helpers_adapter->component( 'table-row-backups', [ 'backup' => $backup ], true );
   220			}
   221			$html .= $this->helpers_adapter->component(
   222				'form/hidden',
   223				[
   224					'name'  => 'nb_backups',
   225					'value' => $nb_totalbackups,
   226				],
   227				true
   228			);
   229	
   230			if ( empty( $html ) ) {
   231				return rest_ensure_response(
   232					[
   233						'success' => false,
   234						'data'    => '',
   235						'message' => __( 'No backups found.', 'backwpup' ),
   236						'page'    => 1,
   237					]
   238				);
   239			}
   240	
   241			return rest_ensure_response(
   242				[
   243					'success' => true,
   244					'data'    => $html,
   245					'page'    => $page,
   246				]
   247			);
   248		}
   249	
   250		/**
