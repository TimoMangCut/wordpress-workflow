    25		 * Rest instance.
    26		 *
    27		 * @param ContextSnapshotBuilder $snapshot_builder Instance.
    28		 */
    29		public function __construct(
    30			ContextSnapshotBuilder $snapshot_builder
    31		) {
    32			$this->snapshot_builder = $snapshot_builder;
    33		}
    34	
    35		/**
    36		 * Check permissions.
    37		 *
    38		 * @return bool
    39		 */
    40		public function has_permission(): bool {
    41			return is_user_logged_in() && current_user_can( 'backwpup' );
    42		}
    43	
