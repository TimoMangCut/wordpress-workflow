   395		private function delete_backup( $backup ) {
   396			if ( empty( $backup['dataset']['data-url'] ) ) {
   397				throw new Exception( __( 'Invalid backup data.', 'backwpup' ) ); // @phpcs:ignore
   398			}
   399	
   400			// Parse the dataset URL.
   401			$query = wp_parse_url( $backup['dataset']['data-url'], PHP_URL_QUERY );
   402			parse_str( $query, $params );
   403	
   404			// Validate required params.
   405			if ( empty( $params['jobdest-top'] ) || empty( $params['backupfiles'] ) ) {
   406				throw new Exception( __( 'Missing required parameters.', 'backwpup' ) ); // @phpcs:ignore
   407			}
   408	
   409			$jobdest = sanitize_text_field( $params['jobdest-top'] );
   410			$file    = esc_attr( $params['backupfiles'][0] ); // Handle array format.
   411	
   412			[$jobid, $dest] = explode( '_', $jobdest );
   413			$dest_class     = $this->backwpup_adapter->get_destination( $dest );
   414	
   415			if ( ! $dest_class ) {
   416				throw new Exception( __( 'Invalid destination class.', 'backwpup' ) ); // @phpcs:ignore
   417			}
   418	
   419			// Perform the deletion.
   420			$dest_class->file_delete( $jobdest, $file );
