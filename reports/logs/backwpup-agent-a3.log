   256		 */
   257		public function get_pagination( WP_REST_Request $request ): WP_REST_Response {
   258			$params    = $request->get_params();
   259			$page      = empty( $params['page'] ) ? 1 : $params['page'];
   260			$max_pages = empty( $params['max_pages'] ) ? 10 : $params['max_pages'];
   261			$html      = $this->helpers_adapter->component(
