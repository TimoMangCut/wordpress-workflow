<?xml version="1.0"?>
<psalm
    errorLevel="6"
    resolveFromConfigFile="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
>
    <!--
        WP-AUDIT-SYSTEM Psalm Taint Analysis Config

        resolveFromConfigFile="false" means ALL relative paths resolve from cwd.
        scan-psalm.sh ALWAYS runs psalm with: cd tools/ && psalm ...
        Therefore paths here are relative to tools/ directory:
          vendor/...  = tools/vendor/...
          config/...  = tools/config/...
          __PLUGIN_DIR__  = replaced by scan-psalm.sh per plugin

        Usage (always from tools/):
	cd tools && vendor/bin/psalm [taint-analysis] [config=config/psalm-wp.xml]
    -->

    <!-- Replaced by scan-psalm.sh per plugin via sed -->
    <projectFiles>
        <directory name="__PLUGIN_DIR__" />
        <ignoreFiles allowMissingFiles="true">
            <directory name="__PLUGIN_DIR__/vendor" />
            <directory name="__PLUGIN_DIR__/vendor_prefixed" />
            <directory name="__PLUGIN_DIR__/lib/vendor" />
            <directory name="__PLUGIN_DIR__/dependencies/vendor" />
            <directory name="__PLUGIN_DIR__/node_modules" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" preloadClasses="true" />
        <file name="config/psalm-wp-taint-stubs.php" preloadClasses="true" />
        <file name="config/psalm-generated-stubs.php" preloadClasses="true" />
    </stubs>

    <plugins>
        <pluginClass class="PsalmWordPress\Plugin" />
    </plugins>

    <!--
        Suppress non-security issues to reduce noise.
        We only care about taint flows, not type correctness.
    -->
    <issueHandlers>
        <UndefinedFunction errorLevel="suppress" />
        <UndefinedClass errorLevel="suppress" />
        <UndefinedVariable errorLevel="suppress" />
        <UndefinedGlobalVariable errorLevel="suppress" />
        <UndefinedConstant errorLevel="suppress" />
        <UndefinedPropertyFetch errorLevel="suppress" />
        <UndefinedPropertyAssignment errorLevel="suppress" />
        <UndefinedMethod errorLevel="suppress" />
        <UndefinedMagicMethod errorLevel="suppress" />
        <MissingFile errorLevel="suppress" />
        <MissingReturnType errorLevel="suppress" />
        <MissingParamType errorLevel="suppress" />
        <MissingPropertyType errorLevel="suppress" />
        <MixedAssignment errorLevel="suppress" />
        <MixedArgument errorLevel="suppress" />
        <MixedArrayAccess errorLevel="suppress" />
        <MixedMethodCall errorLevel="suppress" />
        <MixedReturnStatement errorLevel="suppress" />
        <PossiblyUndefinedVariable errorLevel="suppress" />
        <PossiblyNullArgument errorLevel="suppress" />
        <PossiblyNullReference errorLevel="suppress" />
        <PossiblyInvalidArgument errorLevel="suppress" />
    </issueHandlers>
</psalm>
