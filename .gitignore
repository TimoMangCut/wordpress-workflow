# Runtime environments (rebuild locally)
/tmmc/
/tools/vendor/

# Generated databases (rebuild from Phase 1)
/data/audit.db
/data/audit.db-shm
/data/audit.db-wal

# Plugin source code (sync separately)
/plugins/

# Local scratch
/_/

# Git worktrees
.claude/worktrees/

# Pipeline outputs (regenerated per run)
/reports/
/testing/reports/

# macOS artifacts
.DS_Store
**/.DS_Store

# Tool local overrides (machine-specific paths, auth, session state)
# Shared/portable config (e.g., .codex/config.toml, .claude/settings.json) stays tracked.
.claude/settings.local.json
*.local.toml
*.local.json

# Python bytecode
__pycache__/
*.pyc

# Generated per Psalm run by tools/bin/generate_missing_class_stubs.py
/tools/config/psalm-generated-stubs.php

# Local backups taken before a forced overwrite
*.serial-backup

# Local python venv
/pyenv-codex-lb/

# Scratch
/zz.php
