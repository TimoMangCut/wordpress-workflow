{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase2-review-terminal-core-output.schema.json",
  "version": "1.0.0",
  "title": "Phase 2 Terminal Core Review Output Schema",
  "description": "Structured final-round packet closure from the Phase 2 terminal core reviewer. Terminal core review must close each packet as TP or FP and must not preserve REVIEW ambiguity.",
  "type": "object",
  "required": ["plugin_slug", "review_round", "review_mode", "review_status", "summary", "finding_reviews"],
  "properties": {
    "plugin_slug": { "type": "string" },
    "review_round": { "type": "integer", "minimum": 1 },
    "review_mode": { "enum": ["terminal_core"] },
    "review_status": { "enum": ["stable"] },
    "summary": {
      "type": "object",
      "required": ["worker_findings_reviewed", "material_issues_found"],
      "properties": {
        "worker_findings_reviewed": { "type": "integer", "minimum": 0 },
        "material_issues_found": { "type": "boolean" },
        "new_candidate_count": { "type": "integer", "minimum": 0, "maximum": 0 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "finding_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "packet_id",
          "assessment",
          "closure_verdict",
          "reason",
          "required_changes",
          "counter_evidence",
          "missing_evidence",
          "expansion_attempts"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "packet_id": { "type": "string" },
          "parent_finding_id": { "type": ["string", "null"] },
          "assessment": { "enum": ["keep", "downgrade", "retract", "field_fix"] },
          "closure_verdict": { "enum": ["TP", "FP"] },
          "reason": { "type": "string" },
          "required_changes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "counter_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "file", "line", "detail"],
              "properties": {
                "type": { "enum": ["guard", "sanitizer", "unreachable", "scope", "impact", "other"] },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "detail": { "type": "string" }
              }
            }
          },
          "missing_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expansion_attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target", "reason", "outcome"],
              "properties": {
                "type": { "enum": ["optional_file", "out_of_band_file"] },
                "target": { "type": "string" },
                "reason": { "type": "string" },
                "outcome": { "type": "string" }
              }
            }
          },
          "suggested_field_corrections": {
            "type": ["object", "null"]
          }
        }
      }
    },
    "missed_findings": false
  }
}
