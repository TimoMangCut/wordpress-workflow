{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ir-slice.schema.json",
  "version": "1.1.0",
  "title": "IR Slice Schema",
  "description": "Per-EP-group subset of ir-output, produced by slice_ir_for_group() in tools/bin/prepare_agent_inputs.py. Canonical source: multi-agent-plan.md:251-268.",
  "type": "object",
  "required": ["metadata", "entry_points", "sources", "sinks", "guards", "anomalies", "unresolved_hooks", "coverage_gaps"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Unchanged from ir-output (full plugin metadata passed through).",
      "required": ["plugin_slug"],
      "properties": {
        "plugin_slug":        { "type": "string" },
        "active_installs":    { "type": ["integer", "null"] },
        "files_analyzed":     { "type": "integer" },
        "total_loc":          { "type": "integer" },
        "extraction_time_ms": { "type": "integer" },
        "extractor_version":  { "type": "string" }
      }
    },
    "entry_points": {
      "type": "array",
      "description": "Filtered to only EPs matching the group's ep_types set.",
      "items": {
        "type": "object",
        "required": ["id", "type", "hook_name", "auth_level", "file", "line", "callback"],
        "properties": {
          "id":         { "type": "string" },
          "type":       { "type": "string" },
          "hook_name":  { "type": "string" },
          "auth_level": {
            "enum": ["none", "subscriber", "contributor", "author", "editor", "admin", "system", "unknown"]
          },
          "file":       { "type": "string" },
          "line":       { "type": "integer" },
          "callback": {
            "description": "Same shape as ir-output entry_points[].callback. oneOf: method|closure|unresolved.",
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "name", "file", "line_start", "line_end"],
                "properties": {
                  "type":       { "const": "method" },
                  "name":       { "type": ["string", "null"] },
                  "class":      { "type": ["string", "null"] },
                  "file":       { "type": "string" },
                  "line_start": { "type": "integer" },
                  "line_end":   { "type": "integer" }
                }
              },
              {
                "type": "object",
                "required": ["type", "file", "line_start", "line_end"],
                "properties": {
                  "type":       { "const": "closure" },
                  "name":       { "type": ["string", "null"] },
                  "class":      { "type": ["string", "null"] },
                  "file":       { "type": "string" },
                  "line_start": { "type": "integer" },
                  "line_end":   { "type": "integer" }
                }
              },
              {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "unresolved" }
                }
              }
            ]
          },
          "nonce_verified": { "type": ["boolean", "null"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Sources whose entry_point_id appears in the filtered entry_points.",
      "items": {
        "type": "object",
        "required": ["id", "entry_point_id", "type", "variable", "file", "line"],
        "properties": {
          "id":             { "type": "string" },
          "entry_point_id": { "type": "string" },
          "type":           { "type": "string" },
          "variable":       { "type": "string" },
          "key":            { "type": ["string", "null"] },
          "file":           { "type": "string" },
          "line":           { "type": "integer" }
        }
      }
    },
    "sinks": {
      "type": "array",
      "description": "Sinks whose entry_point_id appears in the filtered entry_points.",
      "items": {
        "type": "object",
        "required": ["id", "entry_point_id", "category", "function_called", "file", "line"],
        "properties": {
          "id":                    { "type": "string" },
          "entry_point_id":        { "type": "string" },
          "category":              { "type": "string" },
          "function_called":       { "type": "string" },
          "uses_prepared_statement": { "type": ["boolean", "null"] },
          "file":                  { "type": "string" },
          "line":                  { "type": "integer" },
          "key":                   { "type": ["string", "null"] }
        }
      }
    },
    "guards": {
      "type": "array",
      "description": "Guards whose entry_point_id appears in the filtered entry_points.",
      "items": {
        "type": "object",
        "required": ["entry_point_id", "type", "function_called", "file", "line", "is_effective"],
        "properties": {
          "entry_point_id":  { "type": "string" },
          "type":            { "type": "string" },
          "function_called": { "type": "string" },
          "file":            { "type": "string" },
          "line":            { "type": "integer" },
          "is_effective":    { "type": ["boolean", "null"] }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "description": "Anomalies whose entry_point_id appears in the filtered entry_points.",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "type", "severity", "cwe_id", "entry_point_id", "description", "evidence"],
        "properties": {
          "id":             { "type": "string" },
          "rule_id":        { "type": "string" },
          "type":           { "type": "string" },
          "severity":       { "enum": ["critical", "high", "medium", "low", "informational"] },
          "cwe_id":         { "type": ["string", "null"] },
          "entry_point_id": { "type": ["string", "null"] },
          "description":    { "type": "string" },
          "evidence":       { "type": "object" }
        }
      }
    },
    "unresolved_hooks": {
      "type": "array",
      "description": "Always empty array in slices — unresolved hooks are handled by Agent D which receives full IR.",
      "maxItems": 0,
      "items": {}
    },
    "coverage_gaps": {
      "type": "array",
      "description": "Always empty array in slices — coverage gaps are handled by Agent D which receives full IR.",
      "maxItems": 0,
      "items": {}
    }
  }
}
