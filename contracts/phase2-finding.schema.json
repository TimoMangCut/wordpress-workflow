{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase2-finding.schema.json",
  "version": "1.0.0",
  "title": "Phase 2 Finding Schema",
  "description": "Per-finding output from Phase 2 agents. Referenced in contracts/README.md table and skill-sets-framework.md:121. This schema defines the shape of individual finding objects — it is the item schema for agent-output.schema.json findings[]. Kept as a standalone file so the gate and merge script can reference the finding shape independently. Canonical source: skill-sets-framework.md:189-300 (finding item within agent-output).",
  "type": "object",
  "required": ["finding_id", "verdict", "vuln_type", "severity"],
  "properties": {
    "finding_id": { "type": "string" },
    "verdict": {
      "enum": ["TP", "FP", "REVIEW"],
      "description": "TP = true positive (confirmed exploitable), FP = false positive (defense found), REVIEW = uncertain (needs human review)"
    },
    "vuln_type":  { "type": "string" },
    "cwe_id":     { "type": ["string", "null"] },
    "severity":   { "enum": ["critical", "high", "medium", "low", "informational"] },
    "auth_required": {
      "enum": ["none", "subscriber", "contributor", "author", "editor", "admin", "system", "unknown"]
    },
    "confidence":           { "type": "number", "minimum": 0, "maximum": 1 },
    "entry_point_id":       { "type": ["string", "null"] },
    "store_entry_point_id": { "type": ["string", "null"] },
    "load_entry_point_id":  { "type": ["string", "null"] },
    "source_function":      { "type": ["string", "null"] },
    "source_file_path":     { "type": ["string", "null"] },
    "source_line_number":   { "type": ["integer", "null"] },
    "sink_function":        { "type": ["string", "null"] },
    "sink_file_path":       { "type": ["string", "null"] },
    "sink_line_number":     { "type": ["integer", "null"] },
    "reasoning":            { "type": ["string", "null"], "description": "Required for TP and REVIEW" },
    "fp_reason":            { "type": ["string", "null"], "description": "Required for FP" },
    "fp_evidence":          { "type": ["object", "null"], "description": "Required for FP: {defense, file, line}" },
    "review_reason":        { "type": ["string", "null"], "description": "Required for REVIEW" },
    "poc_description":      { "type": ["string", "null"] },
    "storage_key":          { "type": ["string", "null"] },
    "patchstack_eligible":  { "type": ["boolean", "null"] },
    "remediation":          { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "TP" } } },
      "then": {
        "required": [
          "entry_point_id", "reasoning",
          "source_file_path", "source_line_number", "source_function",
          "sink_file_path", "sink_line_number", "sink_function"
        ]
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "FP" } } },
      "then": { "required": ["fp_reason", "fp_evidence"] }
    },
    {
      "if": { "properties": { "verdict": { "const": "REVIEW" } } },
      "then": { "required": ["review_reason"] }
    }
  ]
}
