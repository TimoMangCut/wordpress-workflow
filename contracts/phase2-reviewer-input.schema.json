{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase2-reviewer-input.schema.json",
  "version": "1.0.0",
  "title": "Phase 2 Reviewer Input Schema",
  "description": "JSON-first reviewer input for core claim-review and exploration review rounds in Phase 2.",
  "type": "object",
  "required": [
    "plugin_slug",
    "review_round",
    "review_mode",
    "task",
    "artifacts",
    "worker_summary",
    "worker_findings",
    "finding_packets",
    "phase1_context",
    "evidence"
  ],
  "properties": {
    "plugin_slug": { "type": "string" },
    "review_round": { "type": "integer", "minimum": 1 },
    "review_mode": { "enum": ["core", "terminal_core", "explore", "skeptical", "forced_exploration"] },
    "task": {
      "type": "object",
      "required": ["role", "goal", "output_schema", "output_path", "constraints", "packet_schema", "allow_missed_findings"],
      "properties": {
        "role": { "type": "string" },
        "goal": { "type": "string" },
        "output_schema": { "type": "string" },
        "output_path": { "type": "string" },
        "packet_schema": { "type": "string" },
        "allow_missed_findings": { "type": "boolean" },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_candidates": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["worker_output_path", "ir_path", "source_root"],
      "properties": {
        "worker_output_path": { "type": ["string", "null"] },
        "ir_path": { "type": ["string", "null"] },
        "semgrep_path": { "type": ["string", "null"] },
        "psalm_path": { "type": ["string", "null"] },
        "threat_context_path": { "type": ["string", "null"] },
        "source_root": { "type": "string" }
      }
    },
    "worker_summary": {
      "type": "object",
      "required": [
        "total_findings",
        "true_positive_count",
        "false_positive_count",
        "needs_review_count",
        "negative_findings_count",
        "overall_risk"
      ],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "true_positive_count": { "type": "integer", "minimum": 0 },
        "false_positive_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "negative_findings_count": { "type": "integer", "minimum": 0 },
        "overall_risk": { "type": ["string", "null"] },
        "analysis_summary": { "type": ["string", "null"] }
      }
    },
    "worker_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "verdict",
          "vuln_type",
          "auth_required",
          "confidence",
          "source_anchor",
          "sink_anchor"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "verdict": { "type": "string" },
          "vuln_type": { "type": "string" },
          "severity": { "type": ["string", "null"] },
          "auth_required": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"] },
          "entry_point_id": { "type": ["string", "null"] },
          "source_anchor": { "type": "string" },
          "sink_anchor": { "type": "string" },
          "patchstack_eligible": { "type": ["boolean", "null"] }
        }
      }
    },
    "finding_packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packet_id",
          "parent_finding_id",
          "finding_id",
          "verdict",
          "vuln_type",
          "auth_required",
          "confidence",
          "claimed_impact",
          "worker_context",
          "scope_policy",
          "anchors",
          "primary_files",
          "primary_snippets",
          "optional_files",
          "optional_snippets",
          "review_questions"
        ],
        "properties": {
          "packet_id": { "type": "string" },
          "parent_finding_id": { "type": "string" },
          "packet_kind": { "type": ["string", "null"] },
          "focus_anchor": { "type": ["string", "null"] },
          "finding_id": { "type": "string" },
          "verdict": { "type": "string" },
          "vuln_type": { "type": "string" },
          "severity": { "type": ["string", "null"] },
          "auth_required": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"] },
          "entry_point_id": { "type": ["string", "null"] },
          "patchstack_eligible": { "type": ["boolean", "null"] },
          "claimed_impact": { "type": ["string", "null"] },
          "worker_context": {
            "type": "object",
            "required": ["reasoning_excerpt"],
            "properties": {
              "source_function": { "type": ["string", "null"] },
              "sink_function": { "type": ["string", "null"] },
              "fp_reason": { "type": ["string", "null"] },
              "reasoning_excerpt": {
                "type": "object",
                "properties": {
                  "hypothesis": { "type": ["string", "null"] },
                  "trace": { "type": ["string", "null"] },
                  "defenses": { "type": "array", "items": { "type": "string" } },
                  "refutation": { "type": "array", "items": { "type": "string" } },
                  "conclusion": { "type": ["string", "null"] }
                }
              }
            }
          },
          "scope_policy": {
            "type": "object",
            "required": ["allowed_primary_files", "allowed_optional_files", "max_out_of_band_files"],
            "properties": {
              "allowed_primary_files": { "type": "array", "items": { "type": "string" } },
              "allowed_optional_files": { "type": "array", "items": { "type": "string" } },
              "max_out_of_band_files": { "type": "integer", "minimum": 0 }
            }
          },
          "anchors": {
            "type": "object",
            "required": [
              "entry_point_anchor",
              "source_anchor",
              "sink_anchor",
              "review_anchor_candidates"
            ],
            "properties": {
              "entry_point_anchor": { "type": ["string", "null"] },
              "source_anchor": { "type": "string" },
              "sink_anchor": { "type": "string" },
              "review_anchor_candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "anchor"],
                  "properties": {
                    "kind": { "type": "string" },
                    "anchor": { "type": "string" },
                    "note": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "primary_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "primary_snippets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "anchor", "focus_line", "line_start", "line_end", "kind", "code"],
              "properties": {
                "file": { "type": "string" },
                "anchor": { "type": "string" },
                "focus_line": { "type": "integer", "minimum": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "kind": { "type": "string" },
                "code": { "type": "string" }
              }
            }
          },
          "optional_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "optional_snippets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "anchor", "focus_line", "line_start", "line_end", "kind", "code"],
              "properties": {
                "file": { "type": "string" },
                "anchor": { "type": "string" },
                "focus_line": { "type": "integer", "minimum": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "kind": { "type": "string" },
                "code": { "type": "string" }
              }
            }
          },
          "review_questions": {
            "type": "object",
            "required": [
              "reachability",
              "authorization",
              "dataflow",
              "impact",
              "missing_evidence"
            ],
            "properties": {
              "reachability": { "type": "string" },
              "authorization": { "type": "string" },
              "dataflow": { "type": "string" },
              "impact": { "type": "string" },
              "missing_evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "phase1_context": {
      "type": "object",
      "required": [
        "entry_point_count",
        "anomaly_count",
        "unresolved_hook_count",
        "related_entry_points",
        "top_anomalies",
        "unresolved_hooks"
      ],
      "properties": {
        "entry_point_count": { "type": "integer", "minimum": 0 },
        "anomaly_count": { "type": "integer", "minimum": 0 },
        "unresolved_hook_count": { "type": "integer", "minimum": 0 },
        "related_entry_points": {
          "type": "array",
          "items": { "type": "object" }
        },
        "top_anomalies": {
          "type": "array",
          "items": { "type": "object" }
        },
        "unresolved_hooks": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "primary_anchors",
        "primary_files",
        "primary_snippets",
        "optional_evidence"
      ],
      "properties": {
        "primary_anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "anchor"],
            "properties": {
              "kind": { "type": "string" },
              "anchor": { "type": "string" },
              "finding_id": { "type": ["string", "null"] },
              "entry_point_id": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "primary_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "primary_snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "anchor", "focus_line", "line_start", "line_end", "kind", "code"],
            "properties": {
              "file": { "type": "string" },
              "anchor": { "type": "string" },
              "focus_line": { "type": "integer", "minimum": 1 },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "kind": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        },
        "optional_evidence": {
          "type": "object",
          "required": ["anchors", "files", "snippets"],
          "properties": {
            "anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "anchor"],
                "properties": {
                  "kind": { "type": "string" },
                  "anchor": { "type": "string" },
                  "entry_point_id": { "type": ["string", "null"] },
                  "note": { "type": ["string", "null"] }
                }
              }
            },
            "files": {
              "type": "array",
              "items": { "type": "string" }
            },
            "snippets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file", "anchor", "focus_line", "line_start", "line_end", "kind", "code"],
                "properties": {
                  "file": { "type": "string" },
                  "anchor": { "type": "string" },
                  "focus_line": { "type": "integer", "minimum": 1 },
                  "line_start": { "type": "integer", "minimum": 1 },
                  "line_end": { "type": "integer", "minimum": 1 },
                  "kind": { "type": "string" },
                  "code": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "threat_context_summary": {
      "type": ["object", "null"],
      "properties": {
        "matched_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority_vulns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
